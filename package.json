{
  "name": "evacwar",
  "version": "1.0.0",
  "description": "EvacWar UI/UX.",
  "main": "app.js",
  "scripts": {
    "dev": "node app.js",
    "start": "node app.js",
    "lora:bridge": "python lora-gateway/gateway_bridge.py",
    "cap:build": "node scripts/build-capacitor-resident.js && npx cap sync android",
    "cap:sync": "node scripts/build-capacitor-resident.js && npx cap sync android",
    "cap:android": "npx cap open android",
    "postinstall": "node -e \"if(!process.env.RENDER && !process.env.PUPPETEER_SKIP_DOWNLOAD){try{require('child_process').execSync('npx puppeteer browsers install chrome',{stdio:'inherit'})}catch(e){}}\""
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "dexie": "^4.4.5",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.4.1",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "puppeteer": "^24.4.0",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.4"
  }
}
