        Cancel
      </button>
      <button type="button" onclick="confirmRedSubmit()"
        class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl text-xs font-black shadow-md flex items-center gap-1.5 transition-colors cursor-pointer">
