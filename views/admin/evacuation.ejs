            </div>
            <% if (locals.eligibleStaff && locals.eligibleStaff.length> 0) { %>
              <div
                class="max-h-36 overflow-y-auto p-2.5 bg-slate-50 border border-slate-200 rounded-2xl space-y-1.5 custom-scrollbar">
                <% locals.eligibleStaff.forEach(st=> { %>
                  <label
