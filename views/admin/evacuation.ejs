                      <i class="ph ${badgeIcon} text-base font-bold"></i>
                    </div>
                    <div class="min-w-0">
                      <div class="text-xs font-extrabold text-slate-900 leading-tight truncate">${featName}</div>
                      <div class="text-[10px] font-semibold ${subColor} mt-0.5">${subLabel}</div>
                    </div>
                  </div>
                  <button type="button" onclick="event.stopPropagation(); deleteSelectedDraw()" class="w-full py-2 px-3 rounded-xl bg-red-600 hover:bg-red-700 active:scale-[0.98] text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-sm shadow-red-600/20 transition-all cursor-pointer">
                    <i class="ph ph-trash text-sm"></i>
                    <span>${btnLabel}</span>
                  </button>
                </div>
              `)
              .addTo(map);
          }
        }
        window.selectMaplibreFeature = selectMaplibreFeature;

        function handleFeatureSelectionClick(e) {
          if (currentDrawingMode) return;
          if (!e.features || !e.features.length) return;
          featureClickedJustNow = true;

          const clicked = e.features[0];
          const clickedId = (clicked.properties && clicked.properties.featureId) || clicked.id;
          let idx = -1;

          if (clickedId) {
            idx = (adminGeoJsonFeatures.features || []).findIndex(f => {
              return (f.properties && String(f.properties.featureId) === String(clickedId)) || (f.id && String(f.id) === String(clickedId));
            });
          }

          if (idx === -1 && clicked.geometry && clicked.geometry.coordinates) {
            const getFirstPt = (geom) => {
              if (!geom || !geom.coordinates || !geom.coordinates.length) return null;
              if (geom.type === 'Polygon') return geom.coordinates[0] && geom.coordinates[0][0];
              if (geom.type === 'LineString') return geom.coordinates[0];
              return null;
            };
            const cPt = getFirstPt(clicked.geometry);
            if (cPt) {
              idx = (adminGeoJsonFeatures.features || []).findIndex(f => {
                if (!f || !f.geometry) return false;
                const fPt = getFirstPt(f.geometry);
                if (!fPt) return false;
                return Math.abs(fPt[0] - cPt[0]) < 0.001 && Math.abs(fPt[1] - cPt[1]) < 0.001;
              });
            }
          }

          if (idx >= 0) {
            selectMaplibreFeature(idx, e.lngLat);
            if (e.originalEvent && typeof e.originalEvent.stopPropagation === 'function') e.originalEvent.stopPropagation();
          }
        }

        map.on('click', 'admin-saved-features-line', handleFeatureSelectionClick);
        map.on('click', 'admin-saved-features-line-hit', handleFeatureSelectionClick);
        map.on('click', 'admin-saved-features-fill', handleFeatureSelectionClick);
        map.on('click', 'admin-boundary-dashed-line', handleFeatureSelectionClick);
        map.on('click', 'admin-zone-dashed-line', handleFeatureSelectionClick);
        map.on('click', 'admin-selected-feature-line', handleFeatureSelectionClick);
        map.on('click', 'admin-selected-feature-fill', handleFeatureSelectionClick);

        ['admin-saved-features-line', 'admin-saved-features-line-hit', 'admin-saved-features-fill', 'admin-boundary-dashed-line', 'admin-zone-dashed-line', 'admin-selected-feature-line', 'admin-selected-feature-fill'].forEach(layerId => {
          map.on('mouseenter', layerId, () => {
            if (!currentDrawingMode) map.getCanvas().style.cursor = 'pointer';
          });
          map.on('mouseleave', layerId, () => {
            if (!currentDrawingMode) map.getCanvas().style.cursor = '';
          });
        });

        // Initialize zone badge markers on map if any zones exist
        if (typeof window.updateZoneLabelsOnMap === 'function') {
          window.updateZoneLabelsOnMap(map, adminGeoJsonFeatures);
        }

        // Fallback for offline IndexedDB if features were empty on page load
        if ((!adminGeoJsonFeatures || !adminGeoJsonFeatures.features || adminGeoJsonFeatures.features.length === 0) &&
          window.EvakWarDB && typeof window.EvakWarDB.getMapData === 'function') {
          window.EvakWarDB.getMapData().then(cached => {
            if (cached && cached.mapFeatures && Array.isArray(cached.mapFeatures.features) && cached.mapFeatures.features.length > 0) {
              adminGeoJsonFeatures = cached.mapFeatures;
              const src = map.getSource('admin-saved-features');
              if (src) src.setData(adminGeoJsonFeatures);
            }
          }).catch(err => console.warn('EvakWarDB map features read error:', err));
        }

        checkAdminUrlForSosFocus();
      });

      // MapLibre click handler for interactive drawing
      map.on('click', (e) => {
        if (currentDrawingMode) {
          const pt = [e.lngLat.lng, e.lngLat.lat];
          activeDrawPoints.push(pt);
          updateDrawingHudPoints();
          updateMaplibreDrawPreview();
          return;
        }
        if (featureClickedJustNow) {
          featureClickedJustNow = false;
          return;
        }
        // If clicked on empty space, deselect any selected feature
        if (selectedMaplibreFeatureIndex >= 0) {
          if (typeof window.selectMaplibreFeature === 'function') {
            window.selectMaplibreFeature(-1);
          }
        }
      });

      map.on('dblclick', (e) => {
        if (currentDrawingMode) {
          if (e && typeof e.preventDefault === 'function') e.preventDefault();
          finishActiveDrawing();
        }
      });

      // Socket sync (deduplicated to prevent redundant listeners)
      // Also restore any offline LoRa SOS alerts cached in localStorage + listen for live direct BLE/USB LoRa SOS packets
      if (!window.__adminEvacLoraSosListenerBound) {
        window.__adminEvacLoraSosListenerBound = true;
        window.addEventListener('evakwar:lora-sos', (ev) => {
          const data = ev && ev.detail;
          if (!data) return;
          const st = String(data.status || '').toUpperCase();
          if (st === 'CANCELLED' || st === 'RESOLVED') {
            removeSosMarker(data.id || data.sos_id, data.resident_id || data.residentId);
          } else {
            addOrUpdateSosMarker(data, true);
          }
        });
      }
      try {
        const offlineSos = loadFreshOfflineLoraSos();
        offlineSos.forEach(alert => addOrUpdateSosMarker(alert, false));
      } catch (_) {}

      if (typeof io !== 'undefined' && !window.__adminEvacSocketInitialized) {
        window.__adminEvacSocketInitialized = true;
        const socket = window.__appSocket || (window.__appSocket = io());

        socket.on('sos:new', (data) => {
          if (data) {
            addOrUpdateSosMarker(data, true);
            if ((data.handled_by || data.responder_name || data.handler_name) && isFinite(Number(data.rescuer_lat)) && isFinite(Number(data.rescuer_lng))) {
              addOrUpdateRescuerMarker({
                sos_id: data.id || data.sos_id,
                rescuer_user_id: data.handled_by || null,
                rescuer_name: data.handler_name || data.responder_name,
                rescuer_photo: data.rescuer_photo || data.handler_photo || null,
                latitude: Number(data.rescuer_lat),
                longitude: Number(data.rescuer_lng),
                status: data.status || 'ACKNOWLEDGED',
                updated_at: data.updated_at || new Date().toISOString()
              }, false);
            }
          }
        });

        socket.on('sos:update', (data) => {
          if (data) addOrUpdateSosMarker(data, false);
        });

        socket.on('sos:update_status', (data) => {
          if (data) {
            const status = (data.status || '').toUpperCase();
            if (status === 'RESOLVED' || status === 'CANCELLED') {
              removeSosMarker(data.id || data.sos_id, data.resident_id || data.residentId);
              if (typeof window.dismissGlobalDistressBanner === 'function') {
                window.dismissGlobalDistressBanner(data.id || data.sos_id, data.resident_id || data.residentId);
              }
            } else {
              const alertObj = data.alert || data;
              addOrUpdateSosMarker(alertObj, false);
              const rLat = data.rescuer_lat !== undefined ? data.rescuer_lat : alertObj.rescuer_lat;
              const rLng = data.rescuer_lng !== undefined ? data.rescuer_lng : alertObj.rescuer_lng;
              if ((data.handled_by || data.responder_name || alertObj.handled_by || alertObj.handler_name) && isFinite(Number(rLat)) && isFinite(Number(rLng))) {
                addOrUpdateRescuerMarker({
                  sos_id: data.id || data.sos_id || alertObj.id,
                  rescuer_user_id: data.handled_by || alertObj.handled_by || null,
                  rescuer_name: data.responder_name || data.handler_name || alertObj.handler_name,
                  rescuer_photo: data.rescuer_photo || data.handler_photo || alertObj.rescuer_photo || alertObj.handler_photo || null,
                  latitude: Number(rLat),
                  longitude: Number(rLng),
                  status: status || 'ACKNOWLEDGED',
                  updated_at: new Date().toISOString()
                }, false);
              }
            }
          }
        });

        socket.on('sos:cancel', (data) => {
          if (data) {
            removeSosMarker(data.id || data.sos_id, data.resident_id || data.residentId);
            if (typeof window.dismissGlobalDistressBanner === 'function') {
              window.dismissGlobalDistressBanner(data.id || data.sos_id, data.resident_id || data.residentId);
            }
          }
        });

        socket.on('sos:resolve', (data) => {
          if (data) {
            removeSosMarker(data.id || data.sos_id, data.resident_id || data.residentId);
            if (typeof window.dismissGlobalDistressBanner === 'function') {
              window.dismissGlobalDistressBanner(data.id || data.sos_id, data.resident_id || data.residentId);
            }
          }
        });

        socket.on('rescuer:location_update', (data) => {
          if (data) addOrUpdateRescuerMarker(data);
        });

        socket.on('rescuer:location_cleared', (data) => {
          if (data && (data.sos_id || data.rescuer_user_id)) {
            removeRescuerMarker(data.sos_id, data.rescuer_user_id);
          }
        });

        socket.on('center_updated', (data) => {
          const occEl = document.getElementById('occupancy-' + data.centerId);
          if (occEl) {
            occEl.innerText = data.occupancy;
            const evacEl = document.getElementById('evacuees-' + data.centerId);
            if (evacEl) {
              if (evacEl.innerHTML.includes('No residents')) {
                evacEl.innerHTML = '<div class="max-h-24 overflow-y-auto pr-1 no-scrollbar space-y-1"></div>';
              }
              const listContainer = evacEl.querySelector('div');
              if (listContainer) {
                listContainer.insertAdjacentHTML('afterbegin', `<div class="flex items-center gap-1.5 animate-pulse text-green-600"><div class="w-1.5 h-1.5 rounded-full bg-green-500"></div><span class="text-xs font-bold">${data.newResident}</span></div>`);
              }
            }
          }
        });

        socket.on('map_features_updated', (data) => {
          if (currentDrawingMode) return;
          if (typeof data === 'string') {
            try { data = JSON.parse(data); } catch (e) { }
          }
          adminGeoJsonFeatures = data;
          const src = map.getSource('admin-saved-features');
          if (src) src.setData(adminGeoJsonFeatures);
          if (typeof window.refreshTempShapesList === 'function') window.refreshTempShapesList();
          if (typeof window.updateZoneLabelsOnMap === 'function') window.updateZoneLabelsOnMap(map, adminGeoJsonFeatures);
        });

        async function fetchAndRefreshAdminMaplibreCenters() {
          try {
            const res = await fetch('/api/centers/active');
            const data = await res.json();
            if (data.success && Array.isArray(data.centers)) {
              if (adminMapInstance) renderAdminCenterMarkers(data.centers, adminMapInstance);
              updateAdminCentersPanelList(data.centers);
            }
          } catch (e) {
            console.warn('[AdminMap] Failed to refresh centers live:', e);
          }
        }

        socket.on('center_updated', (data) => {
          if (data && Array.isArray(data.centers)) {
            if (adminMapInstance) renderAdminCenterMarkers(data.centers, adminMapInstance);
            updateAdminCentersPanelList(data.centers);
          } else {
            fetchAndRefreshAdminMaplibreCenters();
          }
        });

        socket.on('ec_board_updated', (data) => {
          if (data && Array.isArray(data.centers)) {
            if (adminMapInstance) renderAdminCenterMarkers(data.centers, adminMapInstance);
            updateAdminCentersPanelList(data.centers);
          } else {
            fetchAndRefreshAdminMaplibreCenters();
          }
        });

        socket.on('checkin:new', () => {
          fetchAndRefreshAdminMaplibreCenters();
        });

        socket.on('map_centers_updated', (data) => {
          if (data && Array.isArray(data.centers)) {
            if (adminMapInstance) renderAdminCenterMarkers(data.centers, adminMapInstance);
            updateAdminCentersPanelList(data.centers);
          } else {
            fetchAndRefreshAdminMaplibreCenters();
          }
        });
      }

      return map;
    }

    // Intercept Add/Edit/Delete forms with AJAX to avoid full-page reloads and duplicate Google Maps loading
    document.addEventListener('DOMContentLoaded', () => {
      const createForm = document.getElementById('createCenterForm');
      if (createForm) {
        createForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = createForm.querySelector('button[type="submit"]');
          if (submitBtn) { submitBtn.disabled = true; submitBtn.classList.add('opacity-50'); }

          try {
            const formData = new FormData(createForm);
            const phone = (formData.get('contact_number') || '').trim();
            if (phone && !/^09\d{9}$/.test(phone)) {
              alert('Contact number must be an 11-digit Philippine mobile number starting with 09 (e.g. 09123456789).');
              if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('opacity-50'); }
              return;
            }
            const bodyData = new URLSearchParams(formData);

            const res = await fetch(createForm.action, {
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
              },
              body: bodyData.toString()
            });

            const data = await res.json();
            if (data.success && Array.isArray(data.centers)) {
              renderAdminCenterMarkers(data.centers, adminMapInstance);
              updateAdminCentersPanelList(data.centers);
              closeCenterModal();
              createForm.reset();
            } else {
              alert(data.error || 'Failed to create evacuation center.');
            }
          } catch (err) {
            console.error('Error creating center:', err);
            alert('An unexpected error occurred while saving the evacuation center.');
          } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('opacity-50'); }
          }
        });
      }

      const editForm = document.getElementById('editCenterForm');
      if (editForm) {
        editForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = editForm.querySelector('button[type="submit"]');
          if (submitBtn) { submitBtn.disabled = true; submitBtn.classList.add('opacity-50'); }

          try {
            const formData = new FormData(editForm);
            const phone = (formData.get('contact_number') || '').trim();
            if (phone && !/^09\d{9}$/.test(phone)) {
              alert('Contact number must be an 11-digit Philippine mobile number starting with 09 (e.g. 09123456789).');
              if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('opacity-50'); }
              return;
            }
            const bodyData = new URLSearchParams(formData);

            const res = await fetch(editForm.action, {
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
              },
              body: bodyData.toString()
            });

            const data = await res.json();
            if (data.success && Array.isArray(data.centers)) {
              renderAdminCenterMarkers(data.centers, adminMapInstance);
              updateAdminCentersPanelList(data.centers);
              closeEditCenterModal();
            } else {
              alert(data.error || 'Failed to update evacuation center.');
            }
          } catch (err) {
            console.error('Error updating center:', err);
            alert('An unexpected error occurred while updating the evacuation center.');
          } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('opacity-50'); }
          }
        });
      }

      const deleteForm = document.getElementById('deleteCenterForm');
      if (deleteForm) {
        deleteForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = deleteForm.querySelector('button[type="submit"]');
          if (submitBtn) { submitBtn.disabled = true; submitBtn.classList.add('opacity-50'); }

          try {
            const res = await fetch(deleteForm.action, {
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
              }
            });

            const data = await res.json();
            if (data.success && Array.isArray(data.centers)) {
              renderAdminCenterMarkers(data.centers, adminMapInstance);
              updateAdminCentersPanelList(data.centers);
              closeDeleteCenterModal();
            } else {
              alert(data.error || 'Failed to delete evacuation center.');
            }
          } catch (err) {
            console.error('Error deleting center:', err);
            alert('An unexpected error occurred while deleting the evacuation center.');
          } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('opacity-50'); }
          }
        });
      }
    });

    if (window.MAP_CONFIG && window.MAP_CONFIG.provider === 'maplibre') {
      if (document.getElementById('evacMap')) {
        initEvacuationAdminMaplibre();
      } else if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initEvacuationAdminMaplibre);
      } else {
        initEvacuationAdminMaplibre();
      }
    } else {
      whenGoogleMapsReady(initEvacuationAdminMap);
    }
  </script>

  <%- include('../partials/footer') %>