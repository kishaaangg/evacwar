<%- include('../partials/header') %>

  <div class="app-main-layout">
    <%- include('../partials/sidebar') %>

      <main
        class="app-content h-[calc(100dvh-4rem)] max-h-[calc(100dvh-4rem)] overflow-hidden relative !p-0 !m-0 flex-1">

        <!-- Full Width Fixed Edge-to-Edge Map -->
        <div class="absolute inset-0 w-full h-full z-0">
          <div id="evacMap" class="w-full h-full"></div>

          <!-- Floating Overlay Top Toolbar -->
          <div
            class="absolute top-2 sm:top-4 inset-x-2 sm:inset-x-4 z-10 flex items-center gap-2 pointer-events-none min-w-0 max-w-full">

            <!-- Left: Live Status Badge "Evacuation Map" -->
            <div
              class="bg-white/95 backdrop-blur-md shadow-md px-2.5 sm:px-3.5 py-1.5 rounded-full border border-white/60 flex items-center gap-1.5 shrink-0 pointer-events-auto">
              <span class="relative flex h-2.5 w-2.5">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span class="font-extrabold text-slate-800 text-[11px] sm:text-xs tracking-wide">
                <span class="hidden xl:inline">Evacuation Map</span>
                <span class="xl:hidden">Map</span>
              </span>
            </div>

            <!-- Right: Action & Map Tools Toolbar (Eliminates negative overflow bug, scrolls right smoothly when narrow) -->
            <div
              class="flex-1 min-w-0 flex items-center overflow-x-auto no-scrollbar py-0.5 pointer-events-auto overscroll-contain">
              <div class="flex items-center gap-1 sm:gap-1.5 ml-auto shrink-0">

                <!-- Register New Center Button beside Draw Route -->
                <button type="button" onclick="openCenterModal()"
                  class="px-2.5 sm:px-3.5 py-1.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-[11px] sm:text-xs font-bold transition-all flex items-center gap-1.5 shadow-md active:scale-95 shrink-0"
                  title="Register New Center">
                  <i class="ph ph-plus-circle text-sm sm:text-base"></i>
                  <span class="hidden xl:inline">Register Center</span>
                  <span class="xl:hidden hidden sm:inline">Register</span>
                </button>

                <!-- Route & Hazard Draw Tools -->
                <div
                  class="bg-white/95 backdrop-blur-md shadow-md rounded-full p-1 border border-slate-200/80 flex items-center gap-0.5 shrink-0">
                  <button id="btnDrawRoute" type="button" onclick="toggleDrawMode('route')"
                    title="Create Evacuation Route"
                    class="px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-all bg-amber-50 text-amber-700 hover:bg-amber-100 border border-amber-200 flex items-center gap-1 cursor-pointer">
                    <i class="ph ph-path text-sm text-amber-600"></i>
                    <span class="hidden 2xl:inline">Draw Route</span>
                    <span class="2xl:hidden hidden sm:inline">Route</span>
                  </button>

                  <button id="btnDrawHazard" type="button" onclick="toggleDrawMode('hazard')"
                    title="Add Hazard Zone Polygon"
                    class="px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-all bg-purple-50 text-purple-700 hover:bg-purple-100 border border-purple-200 flex items-center gap-1 cursor-pointer">
                    <i class="ph ph-polygon text-sm text-purple-600"></i>
                    <span class="hidden 2xl:inline">Hazard Zone</span>
                    <span class="2xl:hidden hidden sm:inline">Hazard</span>
                  </button>



                  <button type="button" onclick="clearAllDrawFeatures()" title="Clear All Drawn Routes & Hazard Zones"
                    class="p-1.5 rounded-full text-slate-500 hover:bg-slate-100 flex items-center justify-center cursor-pointer">
                    <i class="ph ph-arrow-counter-clockwise text-sm sm:text-base"></i>
                  </button>
                </div>

                <!-- Centers Panel Toggle Button -->
                <button id="btnToggleCentersPanel" type="button" onclick="toggleCentersPanel()"
                  class="px-2.5 sm:px-3 py-1.5 rounded-full bg-white/95 backdrop-blur-md shadow-md hover:bg-blue-50 text-slate-700 border border-slate-200/80 text-[11px] sm:text-xs font-bold flex items-center gap-1.5 transition-all shrink-0 cursor-pointer"
                  title="Toggle Evacuation Centers Panel">
                  <i class="ph ph-buildings text-sm sm:text-base text-blue-600"></i>
                  <span class="hidden sm:inline">Centers</span> (<%= locals.centers ? locals.centers.length : 0 %>)
                </button>

                <!-- SOS Distress Radar Toggle Button -->
                <% const initialSosAlertCount=(locals.activeSosAlerts && locals.activeSosAlerts.length) ?
                  locals.activeSosAlerts.length : 0; %>
                  <button id="btnToggleSosPanel" type="button" onclick="toggleSosRadarPanel()"
                    class="px-2.5 sm:px-3 py-1.5 rounded-full <%= initialSosAlertCount > 0 ? 'bg-red-600 hover:bg-red-700 text-white shadow-red-600/30' : 'bg-white/95 backdrop-blur-md text-slate-700 hover:bg-red-50 border border-slate-200/80' %> shadow-md text-[11px] sm:text-xs font-bold flex items-center gap-1.5 transition-all shrink-0 cursor-pointer"
                    title="Toggle Emergency SOS Distress Radar">
                    <span class="relative flex h-2 w-2 <%= initialSosAlertCount > 0 ? '' : 'hidden' %>"
                      id="sosRadarLiveDot">
                      <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
                    </span>
                    <i
                      class="ph ph-warning-octagon text-sm sm:text-base <%= initialSosAlertCount > 0 ? 'text-white' : 'text-red-600' %>"></i>
                    <span class="hidden sm:inline">SOS</span>
                    (<span id="adminSosBadgeCount">
                      <%= initialSosAlertCount %>
                    </span>)
                  </button>

                  <!-- Basemap Mode Switcher (Selectable Hybrid, No Labels & Roads) -->
                  <div
                    class="bg-white/95 backdrop-blur-md shadow-md rounded-full p-1 border border-slate-200/80 flex items-center gap-0.5 shrink-0">
                    <button id="btnAdminMapHybrid" type="button" onclick="setAdminMapStyle('hybrid')"
                      class="px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-all bg-blue-600 text-white shadow-xs flex items-center gap-1"
                      title="Hybrid Satellite & Labels">
                      <i class="ph ph-planet text-sm"></i> <span class="hidden sm:inline">Hybrid</span>
                    </button>
                    <button id="btnAdminMapSatellite" type="button" onclick="setAdminMapStyle('satellite')"
                      class="px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-all bg-slate-100 text-slate-700 hover:bg-slate-200 flex items-center gap-1"
                      title="Pure Satellite Imagery (No Labels)">
                      <i class="ph ph-globe text-sm"></i> <span class="hidden sm:inline">No Labels</span>
                    </button>
                    <button id="btnAdminMapRoad" type="button" onclick="setAdminMapStyle('roads')"
                      class="px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-all bg-slate-100 text-slate-700 hover:bg-slate-200 flex items-center gap-1"
                      title="Roads Basemap">
                      <i class="ph ph-map-trifold text-sm"></i> <span class="hidden sm:inline">Roads</span>
                    </button>
                  </div>

                  <!-- Map Tilt Toggle -->
                  <button id="btnToggle3D" type="button" onclick="toggle3DPitch()"
                    class="bg-white/95 backdrop-blur-md shadow-md hover:bg-emerald-50 text-slate-700 border border-slate-200/80 rounded-full px-2.5 sm:px-3 py-1.5 text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 transition-transform active:scale-95 shrink-0 cursor-pointer"
                    title="Toggle Map Tilt">
                    <i class="ph ph-cube text-sm text-emerald-600"></i>
                    <span>Tilt</span>
                  </button>

                  <!-- Rotate 45° -->
                  <button id="btnRotateMap" type="button" onclick="rotateMapBearing(45)"
                    class="bg-white/95 backdrop-blur-md shadow-md hover:bg-amber-50 text-amber-700 border border-slate-200/80 rounded-full p-1.5 sm:px-2.5 text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 transition-transform active:scale-95 shrink-0"
                    title="Rotate Map 45°">
                    <i class="ph ph-arrows-clockwise text-sm text-amber-600"></i>
                  </button>

                  <!-- GPS My Location Button -->
                  <button id="btnAdminMyLocation" type="button" onclick="locateAdminUser(adminMapInstance, true)"
                    class="bg-white/95 backdrop-blur-md shadow-md hover:bg-blue-50 text-blue-900 border border-slate-200/80 rounded-full px-2.5 sm:px-3 py-1.5 text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 transition-transform active:scale-95 shrink-0 cursor-pointer"
                    title="My Location">
                    <i class="ph ph-navigation-arrow text-sm text-blue-600"></i>
                    <span class="hidden xl:inline"></span>
                  </button>
              </div>
            </div>

          </div>

          <!-- Floating Interactive Drawing Status & Control HUD -->
          <div id="drawingModeHud"
            class="hidden absolute top-14 sm:top-18 inset-x-0 mx-auto w-fit max-w-[95vw] z-30 pointer-events-auto transition-all duration-300">
            <div
              class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 bg-slate-900/95 text-white backdrop-blur-md px-3.5 sm:px-4 py-2 rounded-2xl shadow-2xl border border-white/20">
              <div class="flex items-center gap-2">
                <div id="drawingHudIcon"
                  class="flex h-7 w-7 items-center justify-center rounded-xl bg-amber-500 text-white shadow-xs shrink-0">
                  <i class="ph ph-pencil-simple-line text-base animate-pulse"></i>
                </div>
                <div class="text-left">
                  <div id="drawingHudTitle" class="text-xs font-extrabold text-amber-300 leading-tight">Drawing Active
                  </div>
                  <div id="drawingHudSubtitle" class="text-[10px] text-slate-300 leading-tight hidden xs:block">Click on
                    map to place points • Double-click or click Finish</div>
                </div>
              </div>
              <div class="hidden sm:block h-6 w-px bg-white/20"></div>
              <div class="flex items-center gap-1.5 shrink-0">
                <span id="drawingPointsCount"
                  class="text-[11px] font-mono font-bold bg-white/10 px-2 py-0.5 rounded-lg text-slate-200">0 pts</span>
                <button type="button" onclick="undoLastDrawPoint()"
                  class="px-2 py-1 rounded-lg text-[10px] font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-all flex items-center gap-1 cursor-pointer"
                  title="Undo Last Point">
                  <i class="ph ph-arrow-u-up-left text-xs"></i> <span class="hidden sm:inline">Undo</span>
                </button>
                <button type="button" onclick="finishActiveDrawing()"
                  class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-xs transition-all flex items-center gap-1 cursor-pointer"
                  title="Finish and Save Shape">
                  <i class="ph ph-check-bold text-xs"></i> Finish
                </button>
                <button type="button" onclick="cancelActiveDrawing()"
                  class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-all cursor-pointer"
                  title="Cancel Drawing">
                  <i class="ph ph-x text-sm"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Floating Map Legend (Right Side - Open by default on PC, collapsible) -->
          <div id="mapLegendContainer"
            class="absolute top-16 sm:top-20 right-2 sm:right-4 z-20 pointer-events-none flex flex-col items-end">
            <!-- Toggle Button -->
            <button id="btnToggleLegend" type="button" onclick="toggleMapLegend()"
              class="bg-white/95 backdrop-blur-md shadow-md hover:bg-slate-50 text-slate-800 border border-slate-200/90 rounded-full px-3 py-1.5 text-[11px] sm:text-xs font-extrabold flex items-center gap-1.5 transition-all active:scale-95 cursor-pointer pointer-events-auto shrink-0 mb-1.5"
              title="Toggle Map Legend">
              <i class="ph ph-map-trifold text-sm text-blue-600 font-bold"></i>
              <span>Legend</span>
              <i id="legendChevronIcon"
                class="ph ph-caret-down text-xs text-slate-400 transition-transform duration-200"></i>
            </button>

            <!-- Legend Card Panel -->
            <div id="mapLegendCard"
              class="hidden pointer-events-auto bg-white/95 backdrop-blur-md shadow-xl border border-slate-200/90 rounded-2xl p-3 sm:p-3.5 w-60 sm:w-64 transition-all duration-200 origin-top-right">

              <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100">
                <div class="flex items-center gap-1.5">
                  <div class="w-5 h-5 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center text-xs">
                    <i class="ph ph-map-trifold font-bold"></i>
                  </div>
                  <span class="text-xs font-black text-slate-900 tracking-wide uppercase">Map Legend</span>
                </div>
                <button type="button" onclick="toggleMapLegend(false)"
                  class="text-slate-400 hover:text-slate-600 p-0.5 rounded-md hover:bg-slate-100 transition-colors cursor-pointer"
                  title="Close Legend">
                  <i class="ph ph-x font-bold text-xs"></i>
                </button>
              </div>

              <div class="space-y-2 text-[11px] sm:text-xs">
                <!-- 1. Evacuation Route (Orange line) -->
                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-1.5 rounded-full bg-orange-500 shadow-xs shrink-0"></div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Evacuation Route</span>
                    <span class="text-[10px] text-slate-500">Orange designated safety path</span>
                  </div>
                </div>

                <!-- 2. Barangay Boundary (--- dashed line) -->
                <div class="flex items-center gap-2.5">
                  <div class="w-6 border-t-2 border-dashed border-red-400 shrink-0"></div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Boundary (<span
                        class="font-mono text-red-500 font-extrabold">- - -</span>)</span>
                    <span class="text-[10px] text-slate-500">San Rafael (Ikpan) perimeter</span>
                  </div>
                </div>

                <!-- 3. Flood / Hazard Area Polygon -->
                <div class="flex items-center gap-2.5">
                  <div
                    class="w-6 h-5 rounded border border-red-500 bg-red-500/25 flex items-center justify-center shrink-0">
                    <i class="ph ph-warning text-xs text-red-600"></i>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Hazard Danger Zone</span>
                    <span class="text-[10px] text-slate-500">Flood / hazard risk area</span>
                  </div>
                </div>

                <div class="pt-1 border-t border-slate-100/80"></div>

                <!-- 4. Evacuation Sites (Green = Available, Red = Full) -->
                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-6 flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 36 46" class="w-4 h-5 drop-shadow-xs">
                      <path d="M18 1 C8.6 1 1 8.6 1 18 C1 29 18 45 18 45 C18 45 35 29 35 18 C35 8.6 27.4 1 18 1 Z"
                        fill="#10b981" stroke="#FFFFFF" stroke-width="2.5" />
                      <path d="M11 19 L18 12 L25 19 L23 19 L23 24 L13 24 L13 19 Z" fill="#FFFFFF" />
                    </svg>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Available Evac Site</span>
                    <span class="text-[10px] text-emerald-600 font-semibold">Green marker (Space available)</span>
                  </div>
                </div>

                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-6 flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 36 46" class="w-4 h-5 drop-shadow-xs">
                      <path d="M18 1 C8.6 1 1 8.6 1 18 C1 29 18 45 18 45 C18 45 35 29 35 18 C35 8.6 27.4 1 18 1 Z"
                        fill="#ef4444" stroke="#FFFFFF" stroke-width="2.5" />
                      <path d="M11 19 L18 12 L25 19 L23 19 L23 24 L13 24 L13 19 Z" fill="#FFFFFF" />
                    </svg>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Full Evac Site</span>
                    <span class="text-[10px] text-red-600 font-semibold">Red marker (100% full)</span>
                  </div>
                </div>

                <!-- 5. Ikpan Elementary School special pin -->
                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-6 flex items-center justify-center shrink-0 relative">
                    <svg viewBox="0 0 38 48" class="w-5 h-6 drop-shadow-xs">
                      <path d="M19 1 C9.1 1 1 9.1 1 19 C1 31 19 47 19 47 C19 47 37 31 37 19 C37 9.1 28.9 1 19 1 Z"
                        fill="#10b981" stroke="#FFFFFF" stroke-width="2.5" />
                      <circle cx="19" cy="18" r="9" fill="#FFFFFF" />
                      <polygon points="19,11 12,15.5 19,19 26,15.5" fill="#10b981" />
                      <path d="M15,17 L15,20.5 C15,20.5 17,22 19,22 C21,22 23,20.5 23,20.5 L23,17" fill="none"
                        stroke="#10b981" stroke-width="1.3" />
                    </svg>

                    <span
                      class="absolute -top-1 -right-1 bg-amber-500 text-white text-[7.5px] font-black rounded-full px-1 border border-white leading-tight">
                      ES
                    </span>
                  </div>

                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">
                      Ikpan Elementary School
                    </span>
                    <span class="text-[10px] text-slate-500 font-semibold">
                      Special School Icon
                    </span>
                  </div>
                </div>

                <!-- 6. SOS Distress Alert -->
                <div class="flex items-center gap-2.5 pt-0.5">
                  <div class="w-6 h-6 flex items-center justify-center shrink-0 relative">
                    <span
                      class="animate-ping absolute inline-flex h-3.5 w-3.5 rounded-full bg-red-400 opacity-75"></span>
                    <span
                      class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-600 border border-white shadow-xs"></span>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">SOS Distress Alert</span>
                    <span class="text-[10px] text-slate-500">Live emergency distress signal</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </main>
  </div>

  <!-- Manage Evacuation Centers Centered Modal -->
  <div id="adminCentersPanel"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-3 sm:p-5 md:p-6 overflow-y-auto transition-all"
    onclick="if (event.target === this) toggleCentersPanel()">
    <div
      class="bg-white rounded-2xl sm:rounded-3xl w-full max-w-4xl shadow-2xl overflow-hidden max-h-[86vh] sm:max-h-[88vh] flex flex-col border border-slate-100 animate-in fade-in zoom-in-95 duration-200 my-auto"
      onclick="event.stopPropagation()">

      <!-- Modal Header -->
      <div
        class="p-3.5 sm:p-5 border-b border-slate-100 flex items-center justify-between gap-3 bg-slate-50/80 shrink-0">
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
          <div
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center font-bold shrink-0 shadow-xs">
            <i class="ph ph-buildings text-xl sm:text-2xl"></i>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="font-extrabold text-slate-900 text-sm sm:text-base md:text-lg leading-tight truncate">Manage
                Evacuation Sites</h3>
              <span id="adminCentersPanelBadge"
                class="text-[11px] sm:text-xs font-bold px-2 sm:px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-700 whitespace-nowrap">
                <span id="adminCentersPanelCount">
                  <%= locals.centers ? locals.centers.length : 0 %>
                </span> Sites
              </span>
            </div>
            <p class="text-[11px] sm:text-xs text-slate-500 font-medium truncate hidden xs:block sm:block">
              Registered evacuation centers, live occupancy & assigned personnel in San Rafael
            </p>
          </div>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          <button type="button" onclick="openCenterModal()"
            class="px-2.5 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold text-xs flex items-center gap-1.5 shadow-sm transition-all cursor-pointer whitespace-nowrap">
            <i class="ph ph-plus-circle text-sm sm:text-base"></i>
            <span class="hidden sm:inline">Register Site</span>
            <span class="sm:hidden">New</span>
          </button>
          <button type="button" onclick="toggleCentersPanel()"
            class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white hover:bg-slate-200 text-slate-500 flex items-center justify-center border border-slate-200 shadow-xs transition-colors cursor-pointer shrink-0"
            title="Close Modal">
            <i class="ph ph-x text-sm sm:text-base"></i>
          </button>
        </div>
      </div>

      <!-- Search Bar & Filter Controls Toolbar -->
      <div
        class="px-3.5 sm:px-5 py-2.5 sm:py-3 border-b border-slate-100 bg-white flex flex-col sm:flex-row items-center gap-2 shrink-0">
        <div class="relative flex-1 w-full">
          <i
            class="ph ph-magnifying-glass absolute left-3 sm:left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm sm:text-base"></i>
          <input type="text" id="adminCentersSearchInput"
            placeholder="Search by shelter name, zone/address, contact, or assigned staff..."
            oninput="handleAdminCentersSearch(this.value)"
            class="w-full pl-9 sm:pl-10 pr-8 sm:pr-9 py-1.5 sm:py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm font-medium text-slate-800 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all placeholder:text-slate-400" />
          <button type="button" id="btnAdminCentersSearchClear" onclick="clearAdminCentersSearch()"
            class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-slate-200 hover:bg-slate-300 text-slate-600 flex items-center justify-center text-xs transition-colors cursor-pointer"
            title="Clear search">
            <i class="ph ph-x"></i>
          </button>
        </div>
        <div class="text-[11px] font-semibold text-slate-500 whitespace-nowrap self-end sm:self-center shrink-0">
          <span id="adminCentersSearchResultText">Showing <span id="adminCentersVisibleCount"
              class="font-bold text-slate-700">
              <%= locals.centers ? locals.centers.length : 0 %>
            </span> shelters</span>
        </div>
      </div>

      <!-- Scrollable Centers Grid Container -->
      <div id="adminCentersListContainer" class="flex-1 overflow-y-auto p-3 sm:p-5 custom-scrollbar bg-slate-50/50">
        <% if (locals.centers && locals.centers.length> 0) { %>
          <div id="adminCentersCardsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
            <% locals.centers.forEach(center=> { %>
              <% const percentage=Math.round((center.current_occupancy / center.max_capacity) * 100); const
                barWidthStyle='style="width: ' + Math.min(percentage, 100) + '%;"' ; let barColor='bg-emerald-500' ; let
                textColor='text-emerald-700 bg-emerald-50 border-emerald-200' ; let statusText='Available' ; if
                (percentage>= 100) {
                barColor = 'bg-red-500';
                textColor = 'text-red-700 bg-red-50 border-red-200';
                statusText = 'Full Capacity';
                } else if (percentage >= 80) {
                barColor = 'bg-orange-500';
                textColor = 'text-orange-700 bg-orange-50 border-orange-200';
                statusText = 'Near Full';
                }
                %>
                <div
                  class="bg-white rounded-2xl p-3.5 sm:p-4 shadow-sm border border-slate-200/80 hover:border-blue-300 hover:shadow-md transition-all flex flex-col justify-between group">
                  <div>
                    <!-- Header of Card -->
                    <div class="flex justify-between items-start gap-2 mb-2">
                      <button type="button" data-lat="<%= center.latitude %>" data-lng="<%= center.longitude %>"
                        data-id="<%= center.id %>" onclick="handleCenterCardClick(this)"
                        class="text-left font-bold text-slate-800 text-xs sm:text-sm hover:text-blue-600 transition-colors line-clamp-1 flex items-center gap-1.5 cursor-pointer"
                        title="Click to locate on map">
                        <i class="ph ph-buildings text-blue-500 text-sm shrink-0"></i>
                        <span class="truncate">
                          <%= center.name %>
                        </span>
                      </button>
                      <div class="flex items-center gap-1 shrink-0">
                        <button type="button" data-lat="<%= center.latitude %>" data-lng="<%= center.longitude %>"
                          data-id="<%= center.id %>" onclick="handleCenterCardClick(this)"
                          class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg sm:rounded-xl bg-slate-100 hover:bg-blue-100 text-slate-600 hover:text-blue-600 flex items-center justify-center transition-colors cursor-pointer"
                          title="Locate on Map">
                          <i class="ph ph-crosshair text-xs"></i>
                        </button>
                        <button type="button" data-id="<%= center.id %>" data-name="<%= center.name || '' %>"
                          data-address="<%= center.address || '' %>" data-contact="<%= center.contact_number || '' %>"
                          data-capacity="<%= center.max_capacity %>" data-lat="<%= center.latitude %>"
                          data-lng="<%= center.longitude %>"
                          data-staff-ids="<%= JSON.stringify((center.assigned_staff || []).map(s => s.user_id)) %>"
                          onclick="openEditCenterModal(this)"
                          class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg sm:rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-600 flex items-center justify-center transition-colors cursor-pointer"
                          title="Edit Center">
                          <i class="ph ph-pencil-simple text-xs"></i>
                        </button>
                        <button type="button" data-id="<%= center.id %>" data-name="<%= center.name || '' %>"
                          onclick="confirmDeleteCenter(this)"
                          class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg sm:rounded-xl bg-red-50 hover:bg-red-100 text-red-500 flex items-center justify-center transition-colors cursor-pointer"
                          title="Delete Center">
                          <i class="ph ph-trash text-xs"></i>
                        </button>
                      </div>
                    </div>

                    <!-- Address & Phone -->
                    <div class="space-y-1 mb-2">
                      <p class="text-[11px] sm:text-xs font-semibold text-slate-600 flex items-center gap-1.5">
                        <i class="ph ph-map-pin text-blue-500 text-xs shrink-0"></i>
                        <span class="truncate">
                          <%= center.address || 'San Rafael' %>
                        </span>
                      </p>
                      <p class="text-[11px] font-mono font-bold text-indigo-700 flex items-center gap-1.5">
                        <i class="ph ph-compass text-indigo-600 text-xs shrink-0"></i>
                        <span><%= Number(center.latitude || 13.5102).toFixed(5) %>° N, <%= Number(center.longitude || 123.3470).toFixed(5) %>° E</span>
                        <span id="distance-<%= center.id %>" class="text-emerald-700 font-extrabold"></span>
                      </p>
                      <p class="text-[11px] sm:text-xs font-bold text-blue-700 flex items-center gap-1.5 font-mono">
                        <i class="ph ph-phone text-blue-600 text-xs shrink-0"></i>
                        <a href="tel:<%= center.contact_number || '(054) 881-2345' %>" class="hover:underline">
                          <%= center.contact_number || '(054) 881-2345' %>
                        </a>
                      </p>
                    </div>

                    <!-- Assigned Staff -->
                    <div class="mb-2.5 bg-slate-50/80 p-2 sm:p-2.5 rounded-xl border border-slate-100">
                      <div class="flex items-center justify-between text-[11px] font-semibold text-slate-600 mb-1">
                        <span class="flex items-center gap-1">
                          <i class="ph ph-users text-xs text-indigo-500"></i> Assigned Staff
                        </span>
                        <span
                          class="text-[10px] px-1.5 py-0.2 rounded-full bg-white border border-slate-200 text-slate-600 font-bold">
                          <%= (center.assigned_staff || []).length %>
                        </span>
                      </div>
                      <% if (center.assigned_staff && center.assigned_staff.length> 0) { %>
                        <div class="space-y-1 max-h-20 sm:max-h-24 overflow-y-auto custom-scrollbar pr-1">
                          <% center.assigned_staff.forEach(st=> { %>
                            <div
                              class="flex items-center justify-between bg-white rounded-lg px-2 py-1 text-[10px] border border-slate-100 shadow-xs">
                              <span class="font-bold text-slate-700 truncate max-w-[130px]">
                                <%= st.full_name %>
                              </span>
                              <a href="tel:<%= st.contact_number %>"
                                class="font-mono font-bold text-blue-600 hover:text-blue-800 flex items-center gap-0.5">
                                <i class="ph ph-phone text-[10px]"></i>
                                <%= st.contact_number %>
                              </a>
                            </div>
                            <% }) %>
                        </div>
                        <% } else { %>
                          <p class="text-[10px] text-slate-400 italic">No staff assigned to this center</p>
                          <% } %>
                    </div>
                  </div>

                  <!-- Occupancy & Footer -->
                  <div class="pt-2 border-t border-slate-100 space-y-1.5">
                    <div class="space-y-1">
                      <div class="flex justify-between items-center text-[11px] sm:text-xs">
                        <span class="text-slate-500 font-semibold">Occupancy</span>
                        <span class="font-bold text-slate-800 font-mono">
                          <%= center.current_occupancy %> / <%= center.max_capacity %>
                        </span>
                      </div>
                      <div class="w-full bg-slate-100 rounded-full h-1.5 sm:h-2 overflow-hidden shadow-inner">
                        <div class="<%= barColor %> h-full rounded-full transition-all duration-500" <%- barWidthStyle
                          %>></div>
                      </div>
                    </div>

                    <div class="flex justify-between items-center pt-0.5">
                      <span
                        class="inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded-md font-bold text-[9px] sm:text-[10px] border <%= textColor %>">
                        <%= percentage %>% • <%= statusText %>
                      </span>
                    </div>
                  </div>
                </div>
                <% }) %>
          </div>
          <% } else { %>
            <div class="text-center py-12 text-slate-400">
              <div
                class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 mx-auto flex items-center justify-center mb-3">
                <i class="ph ph-buildings text-2xl"></i>
              </div>
              <p class="text-sm font-bold text-slate-700">No evacuation centers registered yet.</p>
              <p class="text-xs text-slate-400 mt-1">Click "Register Site" above to add your first shelter.</p>
            </div>
            <% } %>
      </div>
    </div>
  </div>

  <!-- Live Emergency SOS Distress Radar Modal for Admin -->
  <div id="adminSosPanel"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-3 sm:p-5 md:p-6 overflow-y-auto transition-all"
    onclick="if (event.target === this) toggleSosRadarPanel()">
    <div
      class="bg-white rounded-2xl sm:rounded-3xl w-full max-w-4xl shadow-2xl overflow-hidden max-h-[86vh] sm:max-h-[88vh] flex flex-col border border-slate-100 animate-in fade-in zoom-in-95 duration-200 my-auto"
      onclick="event.stopPropagation()">

      <!-- Modal Header -->
      <div
        class="p-3.5 sm:p-5 border-b border-slate-100 flex items-center justify-between gap-3 bg-gradient-to-r from-red-600 via-rose-600 to-red-700 text-white shrink-0">
        <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
          <div
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl bg-white/20 text-white flex items-center justify-center font-bold shrink-0 shadow-inner">
            <i class="ph ph-warning-octagon text-xl sm:text-2xl animate-pulse"></i>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="font-extrabold text-white text-sm sm:text-base md:text-lg leading-tight truncate">
                Emergency SOS Distress Signals & Situations
              </h3>
              <span id="adminSosModalBadge"
                class="text-[11px] sm:text-xs font-black px-2.5 py-0.5 rounded-full bg-white/25 text-white border border-white/40 whitespace-nowrap">
                <span id="adminSosModalCount">
                  <%= (locals.activeSosAlerts && locals.activeSosAlerts.length) ? locals.activeSosAlerts.length : 0 %>
                </span> Active Signals
              </span>
            </div>
            <p class="text-[11px] sm:text-xs text-red-100 font-medium truncate hidden xs:block sm:block">
              Real-time distress signals, assigned staff responders, and response status
            </p>
          </div>
        </div>

        <button type="button" onclick="toggleSosRadarPanel()"
          class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center border border-white/30 shadow-xs transition-colors cursor-pointer shrink-0"
          title="Close Modal">
          <i class="ph ph-x text-sm sm:text-base"></i>
        </button>
      </div>

      <!-- Search Bar & Filter Controls Toolbar -->
      <div
        class="px-3.5 sm:px-5 py-2.5 sm:py-3 border-b border-slate-100 bg-white flex flex-col sm:flex-row items-center gap-2 shrink-0">
        <div class="relative flex-1 w-full">
          <i
            class="ph ph-magnifying-glass absolute left-3 sm:left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm sm:text-base"></i>
          <input type="text" id="adminSosSearchInput"
            placeholder="Search by resident name, location, contact, situation, or assigned staff..."
            oninput="handleAdminSosSearch(this.value)"
            class="w-full pl-9 sm:pl-10 pr-4 py-2 sm:py-2.5 bg-slate-50 border border-slate-200 rounded-xl sm:rounded-2xl text-xs sm:text-sm focus:bg-white focus:border-red-500 focus:ring-4 focus:ring-red-500/10 transition-all outline-none text-slate-800 placeholder-slate-400">
        </div>
      </div>

      <!-- Scrollable SOS Cards List -->
      <div class="p-3.5 sm:p-5 overflow-y-auto flex-1 custom-scrollbar bg-slate-50/50" id="adminSosListContainer">
        <!-- Rendered dynamically by JavaScript or populated from data -->
      </div>
    </div>
  </div>

  <!-- Add Center Modal -->
  <div id="centerModal"
    class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm px-4">
    <div class="bg-white rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/80 shrink-0">
        <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <i class="ph ph-buildings text-blue-600 text-xl"></i> Register Center
        </h3>
        <button onclick="closeCenterModal()" type="button"
          class="w-8 h-8 rounded-full bg-white hover:bg-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 transition-colors border border-slate-200 shadow-sm">
          <i class="ph ph-x text-lg"></i>
        </button>
      </div>

      <!-- Form -->
      <form id="createCenterForm" action="/admin/evacuation/create" method="POST"
        class="flex flex-col flex-1 overflow-hidden">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <div class="p-6 space-y-4 overflow-y-auto flex-1 custom-scrollbar text-sm">
          <!-- Center Name -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Center Name</label>
            <input type="text" name="name" required placeholder="Barcelona Site"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none font-medium text-slate-800">
          </div>

          <!-- Zone Selection (Zone 1 to Zone 7 max) -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Zone Selection (Zone 1
              - 7)</label>
            <div class="relative">
              <select name="address" required
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none font-medium text-slate-800 appearance-none cursor-pointer pr-10">
                <option value="" disabled selected>Select Zone</option>
                <% for (let z=1; z <=7; z++) { %>
                  <option value="Zone <%= z %>">Zone <%= z %>
                  </option>
                  <% } %>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-400">
                <i class="ph ph-caret-down text-base"></i>
              </div>
            </div>
          </div>

          <!-- Contact Number (Strictly 11 Digits) -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Contact Number</label>
            <input type="tel" name="contact_number" required maxlength="11" pattern="09[0-9]{9}"
              placeholder="09123456789" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11)"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none font-medium text-slate-800"
              title="11-digit Philippine mobile number starting with 09">
          </div>

          <!-- Max Capacity (No Default, Empty) -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Max Capacity
              (Persons)</label>
            <input type="number" name="max_capacity" required min="1" placeholder="Enter capacity..."
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all outline-none font-medium text-slate-800">
          </div>

          <!-- Assign Staff Members -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Assign Staff
                Members</label>
              <span class="text-[11px] text-slate-400 font-medium">Up to 3 sites per staff</span>
            </div>
            <% if (locals.eligibleStaff && locals.eligibleStaff.length> 0) { %>
              <div
                class="max-h-36 overflow-y-auto p-2.5 bg-slate-50 border border-slate-200 rounded-2xl space-y-1.5 custom-scrollbar">
                <% locals.eligibleStaff.forEach(st=> { %>
                  <label
                    class="flex items-center justify-between p-2 rounded-xl bg-white hover:bg-blue-50/50 transition-colors cursor-pointer border border-slate-100 shadow-xs">
                    <div class="flex items-center gap-2">
                      <input type="checkbox" name="assigned_staff_ids[]" value="<%= st.user_id %>"
                        class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500 border-slate-300">
                      <div>
                        <span class="text-xs font-bold text-slate-800 block leading-tight">
                          <%= st.full_name %>
                        </span>
                        <span class="text-[10px] text-slate-500 block">
                          <%= st.occupation || st.staff_type %>
                        </span>
                      </div>
                    </div>
                    <span class="text-[10px] font-mono text-blue-700 font-bold bg-blue-50 px-2 py-0.5 rounded-full">
                      <%= st.contact_number %>
                    </span>
                  </label>
                  <% }) %>
              </div>
              <% } else { %>
                <p class="text-xs text-slate-400 italic bg-slate-50 p-2.5 rounded-xl border border-slate-200">No staff
                  accounts available for assignment.</p>
                <% } %>
          </div>

          <!-- Pin Location on Map -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Pin Location on
              Map</label>
            <div id="modalMap"
              class="w-full h-48 rounded-2xl border border-slate-200 overflow-hidden relative shadow-inner z-10"></div>
            <p class="text-xs text-slate-500 mt-1.5 flex items-center gap-1">
              <i class="ph ph-info text-blue-500"></i> Click anywhere on the map to set the evacuation center's
              location.
            </p>
          </div>

          <!-- Coordinates Grid (Lat/Lng) -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Latitude</label>
              <input type="text" id="modalLat" name="latitude" required value="13.510200" readonly
                class="w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-xl font-mono text-xs text-slate-600 outline-none">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Longitude</label>
              <input type="text" id="modalLng" name="longitude" required value="123.347000" readonly
                class="w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-xl font-mono text-xs text-slate-600 outline-none">
            </div>
          </div>
        </div>

        <!-- Footer Actions -->
        <div class="p-4 border-t border-slate-100 flex gap-3 bg-slate-50/80 shrink-0">
          <button type="button" onclick="closeCenterModal()"
            class="flex-1 px-4 py-2.5 rounded-xl font-bold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 transition-all text-xs">CANCEL</button>
          <button type="submit"
            class="flex-1 px-4 py-2.5 rounded-xl font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-md shadow-blue-600/20 transition-all text-xs">REGISTER
            CENTER</button>
        </div>
      </form>
    </div>
  </div>

