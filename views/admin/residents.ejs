                              <%= res.contact %>
                            </div>
                            <div
                              class="text-xs <%= isWalkin ? 'text-amber-700 font-semibold' : 'text-slate-500 font-medium' %> tracking-wide mt-0.5 flex items-center gap-1 truncate">
                              <i
                                class="ph <%= isWalkin ? 'ph-footprints text-amber-500' : 'ph-envelope-simple text-slate-400' %>"></i>
                              <%= isWalkin ? 'Walk-In (No Login)' : (res.email || 'N/A' ) %>
