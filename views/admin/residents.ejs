<%- include('../partials/header') %>

  <div class="app-main-layout">
    <%- include('../partials/sidebar') %>

      <main class="app-content flex flex-col min-h-screen bg-slate-50 relative pb-28 lg:pb-12 overflow-x-hidden">
        <div class="max-w-7xl mx-auto space-y-5 flex-1 w-full p-4 sm:p-6 lg:p-7">

          <!-- Page Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h1 class="text-2xl sm:text-3xl font-black text-blue-950 tracking-tight">Manage Residents & Households
              </h1>
              <p class="text-sm text-slate-500 font-medium mt-0.5">View and manage resident profiles, vulnerability
                tags, and household records.</p>
            </div>
            <button
              class="btn btn-primary px-5 py-3 rounded-2xl shadow-md shadow-blue-500/20 text-sm font-bold flex items-center gap-2 hover:bg-blue-700 transition-all active:scale-98"
              onclick="document.getElementById('residentModal').classList.remove('hidden')">
              <i class="ph ph-user-plus text-xl"></i> Add New Resident
            </button>
          </div>

          <!-- Main Card Container -->
          <div class="card p-0 overflow-hidden shadow-sm bg-white border border-slate-200/90 rounded-3xl">

            <!-- Search & Filter Toolbar -->
            <div
              class="p-4 sm:p-5 border-b border-slate-200/80 bg-slate-50/70 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 sm:gap-4">

              <!-- Search Input -->
              <div class="relative flex-1 min-w-[260px] lg:max-w-md">
                <i class="ph ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                <input type="text" id="residentSearchInput" oninput="debouncedFilterResidents()"
                  placeholder="Search residents by name, email, phone, zone..."
                  class="w-full pl-11 pr-4 py-2.5 text-sm bg-white border border-slate-200 rounded-2xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all shadow-2xs font-medium text-slate-800 placeholder:text-slate-400" />
              </div>

              <!-- Filter Dropdowns Grid -->
              <div class="flex items-center gap-2.5 flex-wrap sm:flex-nowrap">
                <div class="min-w-[160px]">
                  <select id="residentStatusFilter" onchange="filterResidents()"
                    class="w-full text-xs sm:text-sm py-2.5 px-3.5 bg-white font-semibold border border-slate-200 rounded-2xl outline-none focus:border-blue-500 shadow-2xs text-slate-700 cursor-pointer">
                    <option value="all" selected>All Statuses</option>
                    <option value="pending">⏳ Pending Approval</option>
                    <option value="approved">✅ Approved</option>
                    <option value="walk_in">🚶 Walk-In</option>
                    <option value="rejected">❌ Rejected</option>
                  </select>
                </div>
                <div class="min-w-[160px]">
                  <select id="residentZoneFilter" onchange="filterResidents()"
                    class="w-full text-xs sm:text-sm py-2.5 px-3.5 bg-white font-semibold border border-slate-200 rounded-2xl outline-none focus:border-blue-500 shadow-2xs text-slate-700 cursor-pointer">
                    <option value="all" selected>All Zones</option>
                    <option value="zone 1">Zone 1</option>
                    <option value="zone 2">Zone 2</option>
                    <option value="zone 3">Zone 3</option>
                    <option value="zone 4">Zone 4</option>
                    <option value="zone 5">Zone 5</option>
                    <option value="zone 6">Zone 6</option>
                    <option value="zone 7">Zone 7</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Desktop View: Table -->
            <div class="hidden md:block border-0 rounded-none overflow-x-auto">
              <table class="w-full text-left border-collapse table-fixed">
                <colgroup>
                  <col style="width: 50px;">
                  <col style="width: 38%;">
                  <col style="width: 19%;">
                  <col style="width: 11%;">
                  <col style="width: 14%;">
                  <col style="width: 215px;">
                </colgroup>
                <thead
                  class="bg-slate-100 dark:bg-slate-800 sticky top-0 z-20 border-b border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-100 select-none shadow-xs font-extrabold">
                  <tr>
                    <th
                      class="py-3.5 px-3 text-[11px] font-extrabold uppercase tracking-wider text-center bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      ID</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Resident</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Email</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Zone / Purok</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Contact</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider text-right bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Actions</th>
                  </tr>
                </thead>
                <tbody id="residentsTableBody" class="divide-y divide-slate-100 bg-white">
                  <% if (locals.residents && locals.residents.length> 0) { %>
                    <% locals.residents.forEach(res=> {
                      const isOnline = Boolean(res.is_online);
                      const isWalkin = Boolean(res.is_walkin || !res.user_id || res.registration_source === 'WALK_IN');
                      const photoUrl = res.profile_photo ? ((res.profile_photo.startsWith('http') ||
                      res.profile_photo.startsWith('/')) ? res.profile_photo : `/uploads/profiles/${res.profile_photo}`)
                      : null;
                      const idPhotoUrl = res.id_photo_url || (res.barangay_id_photo ? ((res.barangay_id_photo.startsWith('http') || res.barangay_id_photo.startsWith('/')) ? res.barangay_id_photo : `/uploads/profiles/${res.barangay_id_photo}`) : null);
                      const initial = (res.first_name || res.name || 'R').charAt(0).toUpperCase();
                      %>
                      <% const isPending=!isWalkin && res.approval_status==='PENDING' ; const isRejected=!isWalkin &&
                        res.approval_status==='REJECTED' ; const statusTag=isWalkin ? 'walk_in' : (res.approval_status ?
                        res.approval_status.toLowerCase() : 'approved' ); %>
                        <tr class="resident-row-item hover:bg-blue-50/40 transition-colors group <%= isPending ? 'bg-amber-50/25' : '' %>"
                          data-zone="<%= (res.purok || '').toLowerCase() %>" data-status="<%= statusTag %>">
                          <!-- ID -->
                          <td class="py-4 px-3 text-center font-mono text-xs font-bold text-slate-400">#<%= res.id %>
                          </td>

                          <!-- Resident Name & Photo (with Live Online Indicator Circle on top layer) -->
                          <td class="py-4 px-4">
                            <div class="flex items-center gap-3 min-w-0">
                              <div
                                class="relative shrink-0 w-10 h-10 min-w-[40px] max-w-[40px] min-h-[40px] max-h-[40px]">
                                <div
                                  class="w-full h-full aspect-square rounded-2xl <%= isWalkin ? 'bg-amber-100 border border-amber-200 text-amber-700' : (isPending ? 'bg-amber-50 border border-amber-300 text-amber-800' : 'bg-blue-100 border border-blue-200 text-blue-700') %> flex items-center justify-center font-bold text-sm shadow-2xs overflow-hidden">
                                  <% if (photoUrl) { %>
                                    <img src="<%= photoUrl %>" alt="<%= res.name %>"
                                      loading="lazy" decoding="async"
                                      class="w-full h-full object-cover rounded-2xl"
                                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                    <span style="display:none;"
                                      class="w-full h-full flex items-center justify-center font-bold text-xs">
                                      <%= initial %>
                                    </span>
                                    <% } else { %>
                                      <span class="font-bold text-xs">
                                        <%= initial %>
                                      </span>
                                      <% } %>
                                </div>

                                <!-- Live Online/Offline Status Indicator on top layer -->
                                <% if (!isWalkin) { %>
                                  <span
                                    class="user-status-dot user-status-dot-<%= res.user_id %> absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full z-10 <%= isOnline ? 'bg-emerald-500 ring-2 ring-white animate-pulse' : 'bg-slate-300 ring-2 ring-white' %>"
                                    title="<%= isOnline ? 'Online' : 'Offline' %>"></span>
                                  <% } %>
                              </div>
                              <div class="min-w-0 flex-1">
                                <div
                                  class="font-bold text-slate-900 text-sm truncate group-hover:text-blue-900 transition-colors flex items-center gap-1.5 flex-wrap"
                                  title="<%= res.name %>">
                                  <span>
                                    <%= res.name %>
                                  </span>
                                  <% const isLoraNode = Boolean(res.has_lora || res.lora_node_id || (res.name && res.name.toLowerCase().includes('sinfuego') && res.name.toLowerCase().includes('laurence')) || res.user_id === 3 || res.user_id === 6 || res.id === 22 || res.id === 5); %>
                                  <% if (isLoraNode) { %>
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-2xs shrink-0" title="Assigned 433 MHz LoRa Hardware Terminal (!f4e213d4)">
                                      <i class="ph ph-broadcast text-[10px] text-emerald-600 font-bold"></i> LoRa Node: !f4e213d4
                                    </span>
                                  <% } %>
                                  <% if (isWalkin) { %>
                                    <span
                                      class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200 shrink-0">
                                      <i class="ph ph-footprints text-[10px]"></i> Walk-In
                                    </span>
                                    <% } else if (isPending) { %>
                                      <span
                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300 animate-pulse shrink-0">
                                        <i class="ph ph-clock-countdown text-[10px]"></i> Pending Approval
                                      </span>
                                      <% } else if (isRejected) { %>
                                        <span
                                          class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-red-50 text-red-700 border border-red-200 shrink-0">
                                          <i class="ph ph-x-circle text-[10px]"></i> Rejected
                                        </span>
                                        <% } else { %>
                                          <span
                                            class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                                            <i class="ph ph-check-circle text-[10px]"></i> Approved
                                          </span>
                                          <% } %>
                                  </div>
                                <% if (res.household_names) { %>
                                  <div class="text-[11px] text-slate-400 font-medium truncate"
                                    title="<%= res.household_names %>">
                                    <strong class="text-slate-500">Family:</strong>
                                    <%= res.household_names %>
                                  </div>
                                  <% } %>
                              </div>
                            </div>
                          </td>

                          <!-- Email / Source -->
                          <td class="py-4 px-4">
                            <% if (isWalkin) { %>
                              <div class="text-amber-700 text-xs font-semibold flex items-center gap-1.5 truncate"
                                title="Walk-In (No Registered Account)">
                                <i class="ph ph-footprints text-amber-500 text-sm shrink-0"></i>
                                <span class="truncate">Walk-In (No Login)</span>
                              </div>
                              <% } else { %>
                                <div class="text-slate-600 text-xs font-medium flex items-center gap-1.5 truncate"
                                  title="<%= res.email || 'N/A' %>">
                                  <i class="ph ph-envelope-simple text-slate-400 text-sm shrink-0"></i>
                                  <span class="truncate">
                                    <%= res.email || 'N/A' %>
                                  </span>
                                </div>
                                <% } %>
                          </td>

                          <!-- Zone / Purok -->
                          <td class="py-4 px-4">
                            <span
                              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold border border-slate-200 max-w-full truncate"
                              title="<%= res.purok %>">
                              <i class="ph ph-map-pin text-rose-500 shrink-0"></i>
                              <span class="truncate">
                                <%= res.purok %>
                              </span>
                            </span>
                          </td>

                          <!-- Contact -->
                          <td class="py-4 px-4 whitespace-nowrap">
                            <div class="text-slate-600 text-xs font-medium flex items-center gap-1.5"
                              title="<%= res.contact %>">
                              <i class="ph ph-phone text-slate-400 text-sm shrink-0"></i>
                              <span class="font-semibold text-slate-700">
                                <%= res.contact %>
                              </span>
                            </div>
                          </td>

                          <!-- Actions (Fixed Aspect-Square Icon Buttons) -->
                          <td class="py-4 px-4 text-right whitespace-nowrap">
                            <div class="flex items-center justify-end gap-1.5 shrink-0">
                              <% if (isPending) { %>
                                <button
                                  class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 transition-all shadow-xs hover:scale-105 active:scale-95 shrink-0 cursor-pointer"
                                  title="Approve Resident Account" data-id="<%= res.id %>"
                                  data-name="<%= res.name || '' %>"
                                  onclick="handleApproveResident(this.getAttribute('data-id'), this.getAttribute('data-name'))">
                                  <i class="ph ph-check text-base font-bold"></i>
                                </button>
                                <button
                                  class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-white bg-rose-600 hover:bg-rose-700 active:bg-rose-800 transition-all shadow-xs hover:scale-105 active:scale-95 shrink-0 cursor-pointer"
                                  title="Reject Registration" data-id="<%= res.id %>" data-name="<%= res.name || '' %>"
                                  onclick="handleRejectResident(this.getAttribute('data-id'), this.getAttribute('data-name'))">
                                  <i class="ph ph-x text-base font-bold"></i>
                                </button>
                                <% } %>
                                  <button
                                    class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-emerald-600 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-all shadow-2xs hover:scale-105 active:scale-95 shrink-0"
                                    title="View Details & Household History" data-id="<%= res.id %>"
                                    onmouseenter="prefetchResidentDetails(this.getAttribute('data-id'))"
                                    onpointerdown="prefetchResidentDetails(this.getAttribute('data-id'))"
                                    onclick="openResidentDetailsModal(this.getAttribute('data-id'))">
                                    <i class="ph ph-eye text-sm"></i>
                                  </button>
                                  <button
                                    class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-all shadow-2xs hover:scale-105 active:scale-95 shrink-0"
                                    title="Edit Resident" data-id="<%= res.id %>"
                                    data-first-name="<%= res.first_name || '' %>"
                                    data-middle-name="<%= res.middle_name || '' %>"
                                    data-last-name="<%= res.last_name || '' %>" data-sex="<%= res.sex || 'Male' %>"
                                    data-birthdate="<%= res.birthdate ? new Date(res.birthdate).toISOString().split('T')[0] : '' %>"
                                    data-age="<%= res.age || '' %>" data-contact="<%= res.contact || '' %>"
                                    data-address="<%= res.purok || '' %>"
                                    data-barangay="<%= res.barangay || 'San Rafael' %>"
                                    data-emergency-name="<%= res.emergency_contact_name || '' %>"
                                    data-emergency-phone="<%= res.emergency_contact_phone || '' %>"
                                    data-vulnerability="<%= res.vulnerability || 'None' %>"
                                    data-is-4ps="<%= res.is_4ps ? 'true' : 'false' %>"
                                    data-is-pregnant="<%= res.is_pregnant ? 'true' : 'false' %>"
                                    data-is-lactating="<%= res.is_lactating ? 'true' : 'false' %>"
                                    data-is-pwd="<%= res.is_pwd ? 'true' : 'false' %>"
                                    data-is-single-head="<%= res.is_single_head ? 'true' : 'false' %>"
                                    data-has-serious-illness="<%= res.has_serious_illness ? 'true' : 'false' %>"
                                    data-serious-illness-details="<%= res.serious_illness_details || '' %>"
                                    data-photo="<%= photoUrl || '' %>"
                                    data-id-photo="<%= idPhotoUrl || '' %>" onclick="openEditModalFromBtn(this)">
                                    <i class="ph ph-pencil-simple text-sm"></i>
                                  </button>
                                  <% if (isWalkin) { %>
                                    <button type="button"
                                      class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-amber-600 bg-amber-50 hover:bg-amber-100 border border-amber-200 transition-all shadow-2xs hover:scale-105 active:scale-95 shrink-0"
                                      title="Remove Walk-In" data-id="<%= res.id %>" data-name="<%= res.name || '' %>"
                                      data-is-walkin="true" onclick="confirmDeleteResident(this)">
                                      <i class="ph ph-user-minus text-sm"></i>
                                    </button>
                                    <% } else { %>
                                      <button type="button"
                                        class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 transition-all shadow-2xs hover:scale-105 active:scale-95 shrink-0"
                                        title="Delete Resident" data-id="<%= res.id %>"
                                        data-name="<%= res.name || '' %>" data-is-walkin="false"
                                        onclick="confirmDeleteResident(this)">
                                        <i class="ph ph-trash text-sm"></i>
                                      </button>
                                      <% } %>
                            </div>
                          </td>
                        </tr>
                        <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="6" class="text-center py-14 text-slate-400">
                                <i class="ph ph-users text-4xl mb-2 text-slate-300"></i>
                                <p class="font-semibold text-sm">No resident records found.</p>
                              </td>
                            </tr>
                            <% } %>
                </tbody>
              </table>
            </div>

            <!-- Mobile View: Card List -->
            <div id="residentsMobileContainer"
              class="block md:hidden border-t border-slate-100 divide-y divide-slate-100">
              <% if (locals.residents && locals.residents.length> 0) { %>
                <% locals.residents.forEach(res=> {
                  const isOnline = Boolean(res.is_online);
                  const isWalkin = Boolean(res.is_walkin || !res.user_id || res.registration_source === 'WALK_IN');
                  const photoUrl = res.profile_photo ? ((res.profile_photo.startsWith('http') ||
                  res.profile_photo.startsWith('/')) ? res.profile_photo : `/uploads/profiles/${res.profile_photo}`) :
                  null;
                  const idPhotoUrl = res.id_photo_url || (res.barangay_id_photo ? ((res.barangay_id_photo.startsWith('http') || res.barangay_id_photo.startsWith('/')) ? res.barangay_id_photo : `/uploads/profiles/${res.barangay_id_photo}`) : null);
                  const initial = (res.first_name || res.name || 'R').charAt(0).toUpperCase();
                  %>
                  <% const isPendingMob=!isWalkin && res.approval_status==='PENDING' ; const isRejectedMob=!isWalkin &&
                    res.approval_status==='REJECTED' ; const statusTagMob=isWalkin ? 'walk_in' : (res.approval_status ?
                    res.approval_status.toLowerCase() : 'approved' ); %>
                    <div
                      class="resident-card-item p-4 bg-white hover:bg-slate-50 transition-colors <%= isPendingMob ? 'bg-amber-50/25' : '' %>"
                      data-zone="<%= (res.purok || '').toLowerCase() %>" data-status="<%= statusTagMob %>">
                      <div class="flex items-start justify-between mb-3">
                        <div class="flex items-center gap-3 min-w-0">
                          <div class="relative shrink-0 w-11 h-11 min-w-[44px] max-w-[44px] min-h-[44px] max-h-[44px]">
                            <div
                              class="w-full h-full aspect-square rounded-2xl <%= isWalkin ? 'bg-amber-100 border border-amber-200 text-amber-700' : (isPendingMob ? 'bg-amber-50 border border-amber-300 text-amber-800' : 'bg-blue-100 border border-blue-200 text-blue-700') %> flex items-center justify-center font-bold shadow-2xs overflow-hidden">
                              <% if (photoUrl) { %>
                                <img src="<%= photoUrl %>" alt="<%= res.name %>"
                                  loading="lazy" decoding="async"
                                  class="w-full h-full object-cover rounded-2xl"
                                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <span style="display:none;"
                                  class="w-full h-full flex items-center justify-center font-bold text-sm">
                                  <%= initial %>
                                </span>
                                <% } else { %>
                                  <span class="font-bold text-sm">
                                    <%= initial %>
                                  </span>
                                  <% } %>
                            </div>

                            <!-- Live Online/Offline Status Indicator on top layer -->
                            <% if (!isWalkin) { %>
                              <span
                                class="user-status-dot user-status-dot-<%= res.user_id %> absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full z-10 <%= isOnline ? 'bg-emerald-500 ring-2 ring-white animate-pulse' : 'bg-slate-300 ring-2 ring-white' %>"
                                title="<%= isOnline ? 'Online' : 'Offline' %>"></span>
                              <% } %>
                          </div>
                          <div class="min-w-0">
                            <div class="font-bold text-slate-900 text-sm truncate flex items-center gap-1.5 flex-wrap">
                              <span>
                                <%= res.name %>
                              </span>
                              <% const isLoraNodeMob = Boolean(res.has_lora || res.lora_node_id || (res.name && res.name.toLowerCase().includes('sinfuego') && res.name.toLowerCase().includes('laurence')) || res.user_id === 3 || res.user_id === 6 || res.id === 22 || res.id === 5); %>
                              <% if (isLoraNodeMob) { %>
                                <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[9px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300 shrink-0">
                                  <i class="ph ph-broadcast text-[10px] text-emerald-600 font-bold"></i> LoRa
                                </span>
                              <% } %>
                              <% if (isWalkin) { %>
                                <span
                                  class="inline-flex items-center gap-0.5 px-1.5 py-0.2 text-[9px] font-black uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200 rounded">
                                  Walk-In
                                </span>
                                <% } else if (isPendingMob) { %>
                                  <span
                                    class="inline-flex items-center gap-1 px-2 py-0.2 text-[9px] font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300 rounded animate-pulse">
                                    Pending
                                  </span>
                                  <% } else if (isRejectedMob) { %>
                                    <span
                                      class="inline-flex items-center gap-0.5 px-1.5 py-0.2 text-[9px] font-black uppercase tracking-wider bg-red-50 text-red-700 border border-red-200 rounded">
                                      Rejected
                                    </span>
