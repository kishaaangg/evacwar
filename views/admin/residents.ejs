  </div>

  <%- include('../partials/footer') %>

    <script>
      // Avatar Instant Previews
      function previewAddResidentAvatar(input) {
        if (input.files && input.files[0]) {
          const file = input.files[0];
          const reader = new FileReader();
          reader.onload = function (e) {
            const img = document.getElementById('add_resident_avatar_preview');
            const icon = document.getElementById('add_resident_avatar_icon');
            if (img && icon) {
              img.src = e.target.result;
              img.classList.remove('hidden');
              icon.classList.add('hidden');
            }
          };
          reader.readAsDataURL(file);

          const label = document.getElementById('add_avatar_btn_label');
          const info = document.getElementById('add_avatar_file_info');
          if (label) label.textContent = 'Change Photo';
          if (info) {
            const sizeKb = (file.size / 1024).toFixed(0);
            info.textContent = `${file.name} (${sizeKb} KB)`;
            info.className = 'text-[11px] text-blue-600 font-semibold truncate max-w-xs';
          }
        }
      }

      function previewEditResidentAvatar(input) {
        if (input.files && input.files[0]) {
          const file = input.files[0];
          const reader = new FileReader();
          reader.onload = function (e) {
            const img = document.getElementById('edit_resident_avatar_preview');
            const icon = document.getElementById('edit_resident_avatar_icon');
            if (img && icon) {
              img.src = e.target.result;
              img.classList.remove('hidden');
              icon.classList.add('hidden');
            }
          };
          reader.readAsDataURL(file);

          const nameEl = document.getElementById('edit_avatar_filename');
          const badgeEl = document.getElementById('edit_avatar_status_badge');
          if (nameEl) nameEl.textContent = file.name + ' (' + (file.size / 1024).toFixed(0) + ' KB)';
          if (badgeEl) {
            badgeEl.textContent = 'New Photo';
            badgeEl.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300';
          }
        }
      }

      function previewAddResidentId(input) {
        if (input.files && input.files[0]) {
          const file = input.files[0];
          const img = document.getElementById('add_resident_id_preview');
          const icon = document.getElementById('add_resident_id_icon');
          if (file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function(e) {
              if (img && icon) {
                img.src = e.target.result;
                img.classList.remove('hidden');
                icon.classList.add('hidden');
              }
            };
            reader.readAsDataURL(file);
          } else {
            if (img && icon) {
              img.classList.add('hidden');
              icon.classList.remove('hidden');
              icon.className = 'ph ph-file-pdf text-xl text-rose-600';
            }
          }
        }
      }

      function previewEditResidentId(input) {
        if (input.files && input.files[0]) {
          const file = input.files[0];
          const img = document.getElementById('edit_resident_id_preview');
          const icon = document.getElementById('edit_resident_id_icon');
          const viewBtn = document.getElementById('edit_resident_id_view_btn');
          if (file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function(e) {
              if (img && icon) {
                img.src = e.target.result;
                img.classList.remove('hidden');
                icon.classList.add('hidden');
                if (viewBtn) viewBtn.classList.remove('hidden');
              }
            };
            reader.readAsDataURL(file);
          } else {
            if (img && icon) {
              img.classList.add('hidden');
              icon.classList.remove('hidden');
              icon.className = 'ph ph-file-pdf text-xl text-rose-600';
            }
          }
        }
      }

      function viewCurrentEditResidentId() {
        const idImg = document.getElementById('edit_resident_id_preview');
        if (idImg && idImg.src && !idImg.classList.contains('hidden')) {
          previewResidentIdModal(idImg.src, 'Resident ID');
        }
      }

      function calculateAgeFromBirthdate(bdateStr) {
        if (!bdateStr) return;
        const bdate = new Date(bdateStr);
        const diff = Date.now() - bdate.getTime();
        const ageDate = new Date(diff);
        const calculatedAge = Math.abs(ageDate.getUTCFullYear() - 1970);
        if (!isNaN(calculatedAge) && calculatedAge >= 0) {
          document.getElementById('edit_age').value = calculatedAge;
        }
      }

      const residentDetailsCache = new Map();

      window.prefetchResidentDetails = function (residentId) {
        if (!residentId || residentDetailsCache.has(String(residentId))) return;
        const basePath = window.location.pathname.startsWith('/staff') ? '/staff' : '/admin';
        fetch(basePath + '/residents/details/' + residentId)
          .then(res => res.ok ? res.json() : null)
          .then(data => {
            if (data && data.success) {
              residentDetailsCache.set(String(residentId), data);
            }
          })
          .catch(() => {});
      };

      window.openResidentDetailsModal = function (residentId) {
        const modal = document.getElementById('viewResidentDetailsModal');
        const container = document.getElementById('residentDetailsContent');
        if (modal) modal.classList.remove('hidden');

        // Instant rendering if already cached in memory
        const cached = residentDetailsCache.get(String(residentId));
        if (cached) {
          renderResidentDetailsModal(cached, container);
          return;
        }

        if (container) container.innerHTML = '<div class="text-center py-12 text-slate-500 font-medium"><i class="ph ph-spinner animate-spin text-3xl mb-2 text-blue-600 block"></i>Loading resident profile and household history...</div>';

        const basePath = window.location.pathname.startsWith('/staff') ? '/staff' : '/admin';
        fetch(basePath + '/residents/details/' + residentId)
          .then(res => {
            if (!res.ok) {
              throw new Error('HTTP ' + res.status + ' ' + res.statusText);
            }
            return res.json();
          })
          .then(data => {
            if (!data.success) {
              container.innerHTML = '<div class="text-center py-8 text-red-500 font-bold"><i class="ph ph-warning-circle text-2xl"></i> ' + (data.message || 'Error loading details') + '</div>';
              return;
            }
            residentDetailsCache.set(String(residentId), data);
            renderResidentDetailsModal(data, container);
          })
          .catch(err => {
            console.error("Error fetching resident details modal:", err);
            container.innerHTML = '<div class="text-center py-8 text-red-500 font-bold">Failed to load resident details.</div>';
          });
      };

      function renderResidentDetailsModal(data, container) {
        if (!container) container = document.getElementById('residentDetailsContent');
        if (!container) return;

        const resObj = data.resident;
        const members = data.members || [];
        const history = data.history || [];

        let membersRows = '';
            if (members.length > 0) {
              members.forEach(m => {
                let statusBadges = '';
                if (m.status && m.status !== 'None') {
                  m.status.split(',').forEach(st => {
                    if (st.trim()) {
                      statusBadges += `<span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded bg-amber-100 text-amber-700 border border-amber-200 mr-1">${st.trim()}</span>`;
                    }
                  });
                }
                const photoHtml = m.profile_photo
                  ? `<img src="${m.profile_photo}" class="w-8 h-8 rounded-full object-cover border border-slate-200 shrink-0" alt="${m.name}" onerror="this.outerHTML='<div class=\\'w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs shrink-0\\'>${(m.first_name || 'M').charAt(0).toUpperCase()}</div>'"/>`
                  : `<div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs shrink-0">${(m.first_name || 'M').charAt(0).toUpperCase()}</div>`;
                const displayAge = (m.age !== null && m.age !== undefined && m.age !== 'N/A') ? (m.age + ' yrs') : 'N/A';

                membersRows += `
              <tr class="hover:bg-slate-50 border-b border-slate-100">
                <td class="py-2.5 px-3">
                  <div class="flex items-center gap-2.5">
                    ${photoHtml}
                    <div>
                      <div class="font-semibold text-slate-800 text-xs sm:text-sm">${m.name}</div>
                      <div class="text-[11px] text-slate-400 font-medium">${m.sex || 'Male'}</div>
                    </div>
                  </div>
                </td>
                <td class="py-2.5 px-3 text-slate-600 font-semibold">${displayAge}</td>
                <td class="py-2.5 px-3">
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200/80">
                    <i class="ph ph-tag text-xs text-blue-500"></i> ${m.relation || 'Family'}
                  </span>
                </td>
                <td class="py-2.5 px-3">${statusBadges || '<span class="text-slate-400 text-xs">None</span>'}</td>
              </tr>
            `;
              });
            } else {
              membersRows = `<tr><td colspan="4" class="text-center py-4 text-slate-400 text-xs font-medium">No secondary family members registered.</td></tr>`;
            }

            let historyRows = '';
            if (history.length > 0) {
              history.forEach(h => {
                const isCurrent = h.status === 'ACTIVE';
                const methodBadge = (h.method === 'MANUAL')
                  ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider bg-amber-50 text-amber-700 border border-amber-200"><i class="ph ph-footprints"></i> Walk-In</span>`
                  : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200"><i class="ph ph-qr-code"></i> QR Pass</span>`;
                historyRows += `
              <tr class="hover:bg-slate-50 border-b border-slate-100">
                <td class="py-2.5 px-3 font-bold text-slate-800">${h.person_name}</td>
                <td class="py-2.5 px-3 text-slate-700 font-semibold">${h.center_name}</td>
                <td class="py-2.5 px-3 text-slate-600 text-xs">${h.check_in_time}</td>
                <td class="py-2.5 px-3">${methodBadge}</td>
                <td class="py-2.5 px-3">
                  <div class="font-bold text-slate-800 text-xs">${h.staff_name || h.staff_email || 'Staff'}</div>
                  ${h.staff_email && h.staff_name && h.staff_name !== h.staff_email ? `<div class="text-[10px] text-slate-400 font-medium truncate max-w-[160px]">${h.staff_email}</div>` : ''}
                </td>
                <td class="py-2.5 px-3">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold ${isCurrent ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-slate-100 text-slate-600 border border-slate-200'}">
                    ${h.status}
                  </span>
                </td>
              </tr>
            `;
              });
            } else {
              historyRows = `<tr><td colspan="6" class="text-center py-4 text-slate-400 text-xs font-medium">No check-in history records found.</td></tr>`;
            }

            let vulnerabilityBadges = '';
            if (resObj.vulnerability && resObj.vulnerability !== 'None') {
              vulnerabilityBadges += `<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200 flex items-center gap-1"><i class="ph ph-warning"></i> ${resObj.vulnerability}</span>`;
            }
            if (resObj.is_4ps) {
              vulnerabilityBadges += `<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1"><i class="ph ph-hand-heart"></i> 4Ps Beneficiary</span>`;
            }
            if (resObj.is_pwd) {
              vulnerabilityBadges += `<span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-purple-100 text-purple-800 border border-purple-200 flex items-center gap-1"><i class="ph ph-wheelchair"></i> PWD</span>`;
            }
            if (resObj.is_pregnant) {
