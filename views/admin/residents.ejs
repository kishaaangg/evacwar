      function openEditModalFromBtn(btn) {
        const id = btn.getAttribute('data-id');
        const firstName = btn.getAttribute('data-first-name');
        const middleName = btn.getAttribute('data-middle-name');
        const lastName = btn.getAttribute('data-last-name');
        const sex = btn.getAttribute('data-sex');
        const birthdate = btn.getAttribute('data-birthdate');
        const age = btn.getAttribute('data-age');
        const contact = btn.getAttribute('data-contact');
        const address = btn.getAttribute('data-address');
        const barangay = btn.getAttribute('data-barangay');
        const emergencyName = btn.getAttribute('data-emergency-name');
        const emergencyPhone = btn.getAttribute('data-emergency-phone');
        const vulnerability = btn.getAttribute('data-vulnerability');
        const is4ps = btn.getAttribute('data-is-4ps') === 'true';
        const isPregnant = btn.getAttribute('data-is-pregnant') === 'true';
        const isLactating = btn.getAttribute('data-is-lactating') === 'true';
        const isPwd = btn.getAttribute('data-is-pwd') === 'true';
        const isSingleHead = btn.getAttribute('data-is-single-head') === 'true';
        const hasSeriousIllness = btn.getAttribute('data-has-serious-illness') === 'true';
        const seriousIllnessDetails = btn.getAttribute('data-serious-illness-details');
        const photo = btn.getAttribute('data-photo');
        const idPhoto = btn.getAttribute('data-id-photo');

        openEditModal(id, firstName, middleName, lastName, sex, birthdate, age, contact, address, barangay, emergencyName, emergencyPhone, vulnerability, is4ps, isPregnant, isLactating, isPwd, isSingleHead, hasSeriousIllness, seriousIllnessDetails, photo, idPhoto);
      }

      function openEditModal(id, firstName, middleName, lastName, sex, birthdate, age, contact, address, barangay, emergencyName, emergencyPhone, vulnerability, is4ps, isPregnant, isLactating, isPwd, isSingleHead, hasSeriousIllness, seriousIllnessDetails, photo, idPhoto) {
        document.getElementById('editResidentForm').action = '/admin/residents/edit/' + id;
        document.getElementById('edit_first_name').value = firstName || '';
        document.getElementById('edit_middle_name').value = middleName || '';
        document.getElementById('edit_last_name').value = lastName || '';
        document.getElementById('edit_sex').value = sex || 'Male';
        document.getElementById('edit_birthdate').value = birthdate || '';
        document.getElementById('edit_age').value = age || '';
        document.getElementById('edit_contact_number').value = contact || '';
        const zoneSelect = document.getElementById('edit_home_address');
        if (zoneSelect) {
          const targetZone = address || '';
          let found = Array.from(zoneSelect.options).some(opt => opt.value.toLowerCase() === targetZone.toLowerCase());
          if (!found && targetZone) {
            const opt = new Option(targetZone, targetZone, true, true);
            zoneSelect.add(opt);
          }
          zoneSelect.value = targetZone;
        }
        document.getElementById('edit_barangay').value = barangay || 'San Rafael';
        document.getElementById('edit_emergency_contact_name').value = emergencyName || '';
        document.getElementById('edit_emergency_contact_phone').value = emergencyPhone || '';

        document.getElementById('edit_is_4ps').checked = !!is4ps;
        document.getElementById('edit_is_pregnant').checked = !!isPregnant;
        document.getElementById('edit_is_lactating').checked = !!isLactating;
        document.getElementById('edit_is_pwd').checked = !!isPwd;
        document.getElementById('edit_is_single_head').checked = !!isSingleHead;
        document.getElementById('edit_has_serious_illness').checked = !!hasSeriousIllness;
        document.getElementById('edit_serious_illness_details').value = seriousIllnessDetails || '';

        // Reset file input and preview avatar if exists
        const fileInput = document.getElementById('edit_resident_avatar_input');
        if (fileInput) fileInput.value = '';
        const nameEl = document.getElementById('edit_avatar_filename');
        const badgeEl = document.getElementById('edit_avatar_status_badge');
        if (badgeEl) {
          badgeEl.textContent = (photo && photo.trim() !== '') ? 'Current' : 'Default';
          badgeEl.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100/80 text-blue-700 border border-blue-200';
        }
        if (nameEl) {
          nameEl.textContent = (photo && photo.trim() !== '') ? 'Current photo on file • Click to change (Max 5MB)' : 'Click to upload picture • JPG, PNG or WEBP (Max 5MB)';
        }

        const img = document.getElementById('edit_resident_avatar_preview');
        const icon = document.getElementById('edit_resident_avatar_icon');
        if (photo && photo.trim() !== '') {
          img.src = photo;
          img.classList.remove('hidden');
          icon.classList.add('hidden');
        } else {
          img.src = '';
          img.classList.add('hidden');
          icon.classList.remove('hidden');
        }



        toggleIllnessDetails();
        document.getElementById('editResidentModal').classList.remove('hidden');
      }

      function toggleIllnessDetails() {
        const checkbox = document.getElementById('edit_has_serious_illness');
        const container = document.getElementById('edit_illness_details_container');
        if (checkbox && container) {
          if (checkbox.checked) {
            container.classList.remove('hidden');
          } else {
            container.classList.add('hidden');
          }
        }
      }

      // Valid ID Lightbox & Direct Upload Handlers
      window.previewResidentIdModal = function(url, residentName) {
        if (!url) return;
        const modal = document.getElementById('residentIdPreviewModal');
        const img = document.getElementById('residentIdPreviewImg');
        const title = document.getElementById('residentIdPreviewTitle');
        const dlBtn = document.getElementById('residentIdPreviewDownloadBtn');
        const fallback = document.getElementById('residentIdPreviewFallback');
        const fallbackLink = document.getElementById('residentIdPreviewFallbackLink');

        if (title) title.textContent = residentName ? `Valid ID: ${residentName}` : 'Resident Valid ID';
        if (dlBtn) dlBtn.href = url;
        if (fallbackLink) fallbackLink.href = url;

        const isPdf = url.toLowerCase().endsWith('.pdf');
        if (isPdf) {
          if (img) img.classList.add('hidden');
          if (fallback) fallback.classList.remove('hidden');
        } else {
          if (fallback) fallback.classList.add('hidden');
          if (img) {
            img.src = url;
            img.classList.remove('hidden');
            img.onerror = function() {
              img.classList.add('hidden');
              if (fallback) fallback.classList.remove('hidden');
            };
          }
        }

        if (modal) {
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      };

      window.closeResidentIdModal = function() {
        const modal = document.getElementById('residentIdPreviewModal');
        if (modal) modal.classList.add('hidden');
        document.body.style.overflow = '';
      };
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeResidentIdModal();
        }
      });

      // High-performance debounced live search & pagination controller
      let residentCurrentPage = 1;
      const residentPageSize = 25;
      let matchedRows = [];
      let matchedCards = [];

      let searchDebounceTimer = null;
      function debouncedFilterResidents() {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(filterResidents, 200);
      }

      function filterResidents() {
        const searchEl = document.getElementById('residentSearchInput');
        const zoneEl = document.getElementById('residentZoneFilter');
        const statusEl = document.getElementById('residentStatusFilter');

        const query = (searchEl && searchEl.value) ? searchEl.value.toLowerCase().trim() : '';
        const zone = (zoneEl && zoneEl.value) ? zoneEl.value.toLowerCase().trim() : 'all';
        const status = (statusEl && statusEl.value) ? statusEl.value.toLowerCase().trim() : 'all';

        const tableRows = Array.from(document.querySelectorAll('#residentsTableBody tr.resident-row-item'));
        const cards = Array.from(document.querySelectorAll('#residentsMobileContainer > div.resident-card-item'));

        matchedRows = [];
        matchedCards = [];

        tableRows.forEach(row => {
          const text = (row.textContent || '').toLowerCase();
          const rowZone = (row.getAttribute('data-zone') || '').toLowerCase();
          const rowStatus = (row.getAttribute('data-status') || '').toLowerCase();

          const matchesSearch = !query || text.includes(query);
          const matchesZone = zone === 'all' || rowZone.includes(zone) || text.includes(zone);
          const matchesStatus = status === 'all' || rowStatus === status;

          if (matchesSearch && matchesZone && matchesStatus) {
            matchedRows.push(row);
          } else {
            row.style.display = 'none';
          }
        });

        cards.forEach(card => {
          const text = (card.textContent || '').toLowerCase();
          const cardZone = (card.getAttribute('data-zone') || '').toLowerCase();
          const cardStatus = (card.getAttribute('data-status') || '').toLowerCase();

          const matchesSearch = !query || text.includes(query);
          const matchesZone = zone === 'all' || cardZone.includes(zone) || text.includes(zone);
          const matchesStatus = status === 'all' || cardStatus === status;

          if (matchesSearch && matchesZone && matchesStatus) {
            matchedCards.push(card);
          } else {
            card.style.display = 'none';
          }
        });

        residentCurrentPage = 1;
        renderPaginatedView();
      }

      function renderPaginatedView() {
        const total = Math.max(matchedRows.length, matchedCards.length);
        const totalPages = Math.ceil(total / residentPageSize) || 1;
        if (residentCurrentPage > totalPages) residentCurrentPage = totalPages;
        if (residentCurrentPage < 1) residentCurrentPage = 1;

        const startIdx = (residentCurrentPage - 1) * residentPageSize;
        const endIdx = startIdx + residentPageSize;

        matchedRows.forEach((row, idx) => {
          row.style.display = (idx >= startIdx && idx < endIdx) ? '' : 'none';
        });

        matchedCards.forEach((card, idx) => {
          card.style.display = (idx >= startIdx && idx < endIdx) ? '' : 'none';
        });

        const pagStart = document.getElementById('pagStart');
        const pagEnd = document.getElementById('pagEnd');
        const pagTotal = document.getElementById('pagTotal');
        const prevBtn = document.getElementById('prevPageBtn');
        const nextBtn = document.getElementById('nextPageBtn');
        const numContainer = document.getElementById('paginationPageNumbers');

        if (pagStart) pagStart.textContent = total > 0 ? (startIdx + 1) : 0;
        if (pagEnd) pagEnd.textContent = Math.min(endIdx, total);
        if (pagTotal) pagTotal.textContent = total;

        if (prevBtn) prevBtn.disabled = (residentCurrentPage <= 1);
        if (nextBtn) nextBtn.disabled = (residentCurrentPage >= totalPages);

        if (numContainer) {
          numContainer.innerHTML = '';
          const maxVisiblePages = 5;
          let pStart = Math.max(1, residentCurrentPage - 2);
          let pEnd = Math.min(totalPages, pStart + maxVisiblePages - 1);
          if (pEnd - pStart < maxVisiblePages - 1) {
            pStart = Math.max(1, pEnd - maxVisiblePages + 1);
          }

          for (let p = pStart; p <= pEnd; p++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `w-7 h-7 rounded-lg text-xs font-bold transition-all ${p === residentCurrentPage ? 'bg-blue-600 text-white shadow-xs' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'}`;
            btn.textContent = p;
            btn.onclick = () => { residentCurrentPage = p; renderPaginatedView(); };
            numContainer.appendChild(btn);
          }
        }
      }

      function changeResidentPage(direction) {
        residentCurrentPage += direction;
        renderPaginatedView();
      }

      document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const searchParam = urlParams.get('search');
        const statusParam = urlParams.get('status');
        if (searchParam) {
          const searchEl = document.getElementById('residentSearchInput');
          if (searchEl) searchEl.value = searchParam;
        }
        if (statusParam) {
          const statusEl = document.getElementById('residentStatusFilter');
          if (statusEl) statusEl.value = statusParam;
        }
        filterResidents();
      });

      window.closeResidentDetailsModal = function () {
        const modal = document.getElementById('viewResidentDetailsModal');
        if (modal) modal.classList.add('hidden');
      };

      window.handleApproveResident = async function (id, name) {
        if (!confirm(`Are you sure you want to APPROVE resident "${name || 'resident'}"?\n\nThis will verify their residency and grant immediate web app access and QR pass generation.`)) {
          return;
        }
        const basePath = window.location.pathname.startsWith('/staff') ? '/staff' : '/admin';
        try {
          const csrfToken = document.querySelector('input[name="_csrf"]')?.value || '';
          const res = await fetch(`${basePath}/residents/approve/${id}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ _csrf: csrfToken })
          });
          const data = await res.json();
          if (data.success) {
            alert(data.message || 'Resident approved successfully.');
            window.location.reload();
          } else {
            alert(data.message || 'Failed to approve resident.');
          }
        } catch (err) {
          console.error('Error approving resident:', err);
          alert('Network error while approving resident.');
        }
      };

      window.handleRejectResident = async function (id, name) {
        if (!confirm(`Are you sure you want to REJECT the registration for resident "${name || 'resident'}"?\n\nThis resident will be restricted from logging in.`)) {
          return;
        }
        const basePath = window.location.pathname.startsWith('/staff') ? '/staff' : '/admin';
        try {
          const csrfToken = document.querySelector('input[name="_csrf"]')?.value || '';
          const res = await fetch(`${basePath}/residents/reject/${id}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ _csrf: csrfToken })
          });
          const data = await res.json();
          if (data.success) {
            alert(data.message || 'Resident registration rejected.');
            window.location.reload();
          } else {
            alert(data.message || 'Failed to reject resident.');
          }
        } catch (err) {
          console.error('Error rejecting resident:', err);
          alert('Network error while rejecting resident.');
        }
      };

      window.confirmDeleteResident = function (id, name, isWalkin) {
        if (id && typeof id === 'object') {
          const btn = id;
          id = btn.getAttribute('data-id');
          name = btn.getAttribute('data-name');
          isWalkin = btn.getAttribute('data-is-walkin') === 'true';
        }
        const form = document.getElementById('deleteResidentForm');
        const text = document.getElementById('deleteResidentModalText');
        const title = document.getElementById('deleteResidentModalTitle');
        const iconContainer = document.getElementById('deleteResidentModalIconContainer');
        const icon = document.getElementById('deleteResidentModalIcon');
        const submitBtn = document.getElementById('deleteResidentSubmitBtn');

        if (form) form.action = '/admin/residents/delete/' + id;
        if (isWalkin) {
          if (title) title.textContent = 'Remove Walk-In Resident';
          if (text) text.innerHTML = `Are you sure you want to remove walk-in resident <strong>${name}</strong> from the active resident directory?<br><span class="text-amber-700 font-semibold block mt-1.5 text-[11px]"><i class="ph ph-shield-check"></i> Shelter check-in and evacuation logs will remain safely preserved.</span>`;
          if (iconContainer) iconContainer.className = 'w-14 h-14 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto text-2xl shadow-inner';
          if (icon) icon.className = 'ph ph-user-minus font-bold';
          if (submitBtn) {
            submitBtn.textContent = 'Yes, Remove Walk-In';
            submitBtn.className = 'flex-1 px-4 py-2.5 rounded-xl font-bold text-white bg-amber-600 hover:bg-amber-700 shadow-md shadow-amber-600/20 transition-all text-xs uppercase tracking-wider';
          }
        } else {
          if (title) title.textContent = 'Delete Resident Account';
          if (text) text.innerHTML = `Are you sure you want to delete resident <strong>${name}</strong>?<br><span class="text-slate-500 font-semibold block mt-1.5 text-[11px]"><i class="ph ph-shield-check"></i> Historical records will remain safely archived.</span>`;
          if (iconContainer) iconContainer.className = 'w-14 h-14 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto text-2xl shadow-inner';
          if (icon) icon.className = 'ph ph-warning-circle font-bold';
          if (submitBtn) {
            submitBtn.textContent = 'Yes, Delete';
            submitBtn.className = 'flex-1 px-4 py-2.5 rounded-xl font-bold text-white bg-red-600 hover:bg-red-700 shadow-md shadow-red-600/20 transition-all text-xs uppercase tracking-wider';
          }
        }
        const modal = document.getElementById('deleteResidentModal');
        if (modal) modal.classList.remove('hidden');
      };

      window.closeDeleteResidentModal = function () {
        const modal = document.getElementById('deleteResidentModal');
        if (modal) modal.classList.add('hidden');
      };

      // Live Real-Time Online / Offline Status Synchronizer & Client Side Validation
      document.addEventListener('DOMContentLoaded', () => {
        if (typeof io !== 'undefined') {
          const socket = window.__appSocket || io();
          window.__appSocket = socket;

          socket.on('user:status_change', (data) => {
            if (!data || !data.userId) return;
            const dots = document.querySelectorAll('.user-status-dot-' + data.userId);
            dots.forEach((dot) => {
              if (data.isOnline) {
                dot.className = 'user-status-dot user-status-dot-' + data.userId + ' absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full z-10 bg-emerald-500 ring-2 ring-white animate-pulse';
                dot.title = 'Online';
              } else {
                dot.className = 'user-status-dot user-status-dot-' + data.userId + ' absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full z-10 bg-slate-300 ring-2 ring-white';
                dot.title = 'Offline';
              }
            });
          });
        }

        const addForm = document.getElementById('addResidentForm');
        if (addForm) {
          addForm.addEventListener('submit', function (e) {
            const phoneInput = document.getElementById('add_resident_contact');
            const phone = (phoneInput ? phoneInput.value : '').trim();
            if (!/^09\d{9}$/.test(phone)) {
              e.preventDefault();
              alert('Mobile number must be a valid 11-digit Philippine number starting with 09 (e.g. 09123456789).');
              if (phoneInput) phoneInput.focus();
              return;
            }
            const zoneInput = document.getElementById('add_resident_home_address');
            const zone = zoneInput ? zoneInput.value : '';
            const validZones = ['Zone 1', 'Zone 2', 'Zone 3', 'Zone 4', 'Zone 5', 'Zone 6', 'Zone 7'];
            if (!zone || !validZones.includes(zone)) {
              e.preventDefault();
              alert('Please select a valid Barangay Zone from the dropdown (Zone 1 to Zone 7).');
              if (zoneInput) zoneInput.focus();
              return;
            }
            const passInput = document.getElementById('add_resident_password');
            const pass = passInput ? passInput.value : '';
            if (pass && (pass.length < 8 || !/[a-zA-Z]/.test(pass) || !/[0-9]/.test(pass))) {
              e.preventDefault();
              alert('Temporary password must be at least 8 characters long and contain both letters and numbers.');
              if (passInput) passInput.focus();
              return;
            }
          });
        }

        const editForm = document.getElementById('editResidentForm');
        if (editForm) {
          editForm.addEventListener('submit', function (e) {
            const phoneInput = document.getElementById('edit_contact_number');
            const phone = (phoneInput ? phoneInput.value : '').trim();
            if (phone && !/^09\d{9}$/.test(phone)) {
              e.preventDefault();
              alert('Mobile number must be a valid 11-digit Philippine number starting with 09 (e.g. 09123456789).');
              if (phoneInput) phoneInput.focus();
              return;
            }
            const emergInput = document.getElementById('edit_emergency_contact_phone');
            const emergPhone = (emergInput ? emergInput.value : '').trim();
            if (emergPhone && !/^09\d{9}$/.test(emergPhone)) {
              e.preventDefault();
              alert('Emergency contact phone must be a valid 11-digit Philippine number starting with 09 (e.g. 09123456789).');
              if (emergInput) emergInput.focus();
              return;
            }
            const zoneInput = document.getElementById('edit_home_address');
            const zone = zoneInput ? zoneInput.value : '';
            const validZones = ['Zone 1', 'Zone 2', 'Zone 3', 'Zone 4', 'Zone 5', 'Zone 6', 'Zone 7'];
            if (!zone || !validZones.includes(zone)) {
              e.preventDefault();
              alert('Please select a valid Barangay Zone from the dropdown (Zone 1 to Zone 7).');
              if (zoneInput) zoneInput.focus();
              return;
            }
          });
        }
      });
    </script>