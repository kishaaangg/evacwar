              </div>
              <div>
                <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Phone Number <span
                    class="text-red-500">*</span></label>
                <input type="tel" id="add_resident_contact" name="contact_number" required pattern="09[0-9]{9}"
