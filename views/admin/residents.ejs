                            <% if (res.household_names) { %>
                              <div class="text-[11px] text-slate-400 mt-1 truncate">
                                <strong class="text-slate-500">Family:</strong>
                                <%= res.household_names %>
                              </div>
                              <% } %>
                          </div>
                        </div>
                        <span
                          class="font-mono text-xs font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-lg border border-slate-200 shrink-0">#
                          <%= res.id %>
                        </span>
                      </div>

                      <div class="flex items-center justify-between mt-3 pt-2 border-t border-slate-100">
                        <span
                          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold border border-slate-200">
                          <i class="ph ph-map-pin text-rose-500"></i>
                          <%= res.purok %>
                        </span>
                        <div class="flex items-center gap-1.5">
                          <% if (isPendingMob) { %>
                            <button
                              class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 transition-colors shadow-xs"
                              title="Approve Resident" data-id="<%= res.id %>" data-name="<%= res.name || '' %>"
                              onclick="handleApproveResident(this.getAttribute('data-id'), this.getAttribute('data-name'))">
                              <i class="ph ph-check text-base font-bold"></i>
                            </button>
                            <button
                              class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-white bg-rose-600 hover:bg-rose-700 active:bg-rose-800 transition-colors shadow-xs"
                              title="Reject Registration" data-id="<%= res.id %>" data-name="<%= res.name || '' %>"
                              onclick="handleRejectResident(this.getAttribute('data-id'), this.getAttribute('data-name'))">
                              <i class="ph ph-x text-base font-bold"></i>
                            </button>
                            <% } %>
                              <button
                                class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-emerald-600 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors shadow-2xs"
                                title="View Details & Household History" data-id="<%= res.id %>"
                                onmouseenter="prefetchResidentDetails(this.getAttribute('data-id'))"
                                onpointerdown="prefetchResidentDetails(this.getAttribute('data-id'))"
                                onclick="openResidentDetailsModal(this.getAttribute('data-id'))">
                                <i class="ph ph-eye text-sm"></i>
                              </button>
                              <button
                                class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-colors shadow-2xs"
                                title="Edit Resident" data-id="<%= res.id %>"
                                data-first-name="<%= res.first_name || '' %>"
                                data-middle-name="<%= res.middle_name || '' %>"
                                data-last-name="<%= res.last_name || '' %>" data-sex="<%= res.sex || 'Male' %>"
                                data-birthdate="<%= res.birthdate ? new Date(res.birthdate).toISOString().split('T')[0] : '' %>"
                                data-age="<%= res.age || '' %>" data-contact="<%= res.contact || '' %>"
                                data-address="<%= res.purok || '' %>"
                                data-barangay="<%= res.barangay || 'San Rafael' %>"
                                data-emergency-name="<%= res.emergency_contact_name || '' %>"
                                data-emergency-phone="<%= res.emergency_contact_phone || '' %>"
                                data-vulnerability="<%= res.vulnerability || 'None' %>"
                                data-is-4ps="<%= res.is_4ps ? 'true' : 'false' %>"
                                data-is-pregnant="<%= res.is_pregnant ? 'true' : 'false' %>"
                                data-is-lactating="<%= res.is_lactating ? 'true' : 'false' %>"
                                data-is-pwd="<%= res.is_pwd ? 'true' : 'false' %>"
                                data-is-single-head="<%= res.is_single_head ? 'true' : 'false' %>"
                                data-has-serious-illness="<%= res.has_serious_illness ? 'true' : 'false' %>"
                                data-serious-illness-details="<%= res.serious_illness_details || '' %>"
                                data-photo="<%= photoUrl || '' %>"
                                data-id-photo="<%= idPhotoUrl || '' %>" onclick="openEditModalFromBtn(this)">
                                <i class="ph ph-pencil-simple text-sm"></i>
                              </button>
                              <% if (isWalkin) { %>
                                <button type="button"
                                  class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-amber-600 bg-amber-50 hover:bg-amber-100 border border-amber-200 transition-colors shadow-2xs"
                                  title="Remove Walk-In" data-id="<%= res.id %>" data-name="<%= res.name || '' %>"
                                  data-is-walkin="true" onclick="confirmDeleteResident(this)">
                                  <i class="ph ph-user-minus text-sm"></i>
                                </button>
                                <% } else { %>
                                  <button type="button"
                                    class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 transition-colors shadow-2xs"
                                    title="Delete Resident" data-id="<%= res.id %>" data-name="<%= res.name || '' %>"
                                    data-is-walkin="false" onclick="confirmDeleteResident(this)">
                                    <i class="ph ph-trash text-sm"></i>
                                  </button>
                                  <% } %>
                        </div>
                      </div>
                    </div>
                    <% }) %>
                      <% } else { %>
                        <div class="text-center py-14 text-slate-400">
                          <i class="ph ph-users text-4xl mb-2 text-slate-300"></i>
                          <p class="font-semibold text-sm">No resident records found.</p>
                        </div>
                        <% } %>
            </div>

            <!-- Pagination Controls (ITE-PT-DOM001: 25 items/page for 60fps scrolling & instant search) -->
            <div id="residentPaginationBar" class="p-4 border-t border-slate-200/80 bg-slate-50/70 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-semibold text-slate-600">
              <div id="residentPaginationInfo">
                Showing <span id="pagStart">1</span>-<span id="pagEnd">25</span> of <span id="pagTotal">0</span> residents
              </div>
              <div class="flex items-center gap-1.5" id="residentPaginationBtns">
                <button type="button" id="prevPageBtn" onclick="changeResidentPage(-1)" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1 transition-all">
                  <i class="ph ph-caret-left font-bold"></i> Previous
                </button>
                <div id="paginationPageNumbers" class="flex items-center gap-1"></div>
                <button type="button" id="nextPageBtn" onclick="changeResidentPage(1)" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1 transition-all">
                  Next <i class="ph ph-caret-right font-bold"></i>
                </button>
              </div>
            </div>

          </div>

        </div>
        <%- include('../partials/footer-visible') %>
      </main>

      <!-- 1. ADD RESIDENT MODAL (CLEAN HEADER) -->
      <div id="residentModal"
