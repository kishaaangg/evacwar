              <button type="submit"
                class="flex-1 py-3 rounded-2xl bg-blue-600 text-white font-bold hover:bg-blue-700 shadow-md shadow-blue-500/20 text-xs uppercase tracking-wider transition-all">Save
                Resident</button>
            </div>
          </form>
        </div>
