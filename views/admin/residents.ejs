                    class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none text-sm font-semibold cursor-pointer appearance-none">
                    <option value="" disabled selected>Select Zone</option>
                    <option value="Zone 1">Zone 1</option>
                    <option value="Zone 2">Zone 2</option>
                    <option value="Zone 3">Zone 3</option>
                    <option value="Zone 4">Zone 4</option>
                    <option value="Zone 5">Zone 5</option>
                    <option value="Zone 6">Zone 6</option>
                    <option value="Zone 7">Zone 7</option>
                  </select>
                  <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400">
                    <i class="ph ph-caret-down text-sm"></i>
                  </div>
                </div>
              </div>
            </div>

            <input type="hidden" id="edit_barangay" name="barangay" value="San Rafael">

            <!-- Emergency Contact -->
            <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/80 space-y-3">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">Emergency Contact Person</h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Contact Name</label>
                  <input type="text" id="edit_emergency_contact_name" name="emergency_contact_name"
                    class="w-full px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none text-sm font-semibold">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Contact Phone</label>
                  <input type="tel" id="edit_emergency_contact_phone" name="emergency_contact_phone"
                    pattern="09[0-9]{9}" maxlength="11"
                    title="Must be an 11-digit Philippine mobile number starting with 09 (e.g. 09123456789)"
                    class="w-full px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none text-sm font-semibold">
                </div>
              </div>
            </div>

            <!-- Vulnerability & Tags -->
            <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/80 space-y-3">
              <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">Vulnerabilities & Classifications
              </h4>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                  <input type="checkbox" id="edit_is_4ps" name="is_4ps"
                    class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500"> 4Ps Member
                </label>
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                  <input type="checkbox" id="edit_is_pwd" name="is_pwd"
                    class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500"> PWD
                </label>
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                  <input type="checkbox" id="edit_is_pregnant" name="is_pregnant"
                    class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500"> Pregnant
                </label>
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                  <input type="checkbox" id="edit_is_lactating" name="is_lactating"
                    class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500"> Lactating
                </label>
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                  <input type="checkbox" id="edit_is_single_head" name="is_single_head"
                    class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500"> Single Parent
                </label>
                <label class="flex items-center gap-2 text-xs font-bold text-slate-700 cursor-pointer">
                  <input type="checkbox" id="edit_has_serious_illness" name="has_serious_illness"
                    onchange="toggleIllnessDetails()" class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500"> Serious
                  Illness
                </label>
              </div>

              <div id="edit_illness_details_container" class="hidden pt-2">
                <label class="block text-xs font-bold text-slate-700 mb-1">Illness / Condition Details</label>
                <input type="text" id="edit_serious_illness_details" name="serious_illness_details"
                  placeholder="e.g. Hypertension, Dialysis"
                  class="w-full px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none text-sm font-semibold">
              </div>
            </div>

            <div class="pt-3 flex gap-3">
              <button type="button" onclick="document.getElementById('editResidentModal').classList.add('hidden')"
                class="flex-1 py-3 rounded-2xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 text-xs uppercase tracking-wider">Cancel</button>
              <button type="submit"
                class="flex-1 py-3 rounded-2xl bg-blue-600 text-white font-bold hover:bg-blue-700 shadow-md shadow-blue-500/20 text-xs uppercase tracking-wider transition-all">Save
                Changes</button>
            </div>
          </form>
        </div>
      </div>

      <!-- 3. VIEW RESIDENT & HOUSEHOLD DETAILS MODAL (CLEAN HEADER) -->
      <div id="viewResidentDetailsModal"
        class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm px-4">
        <div
          class="bg-white rounded-3xl w-full max-w-3xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col border border-slate-200/80 animate-in fade-in zoom-in-95 duration-150">
          <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-white shrink-0">
            <h3 class="text-base sm:text-lg font-black text-slate-900 flex items-center gap-2.5">
              <i class="ph ph-identification-card text-xl text-blue-600"></i> Resident & Household Details
            </h3>
            <button onclick="document.getElementById('viewResidentDetailsModal').classList.add('hidden')"
              class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-700 flex items-center justify-center transition-colors">
              <i class="ph ph-x text-base font-bold"></i>
            </button>
          </div>
          <div id="residentDetailsContent" class="p-6 overflow-y-auto flex-1 custom-scrollbar">
            <!-- Dynamic Content Injected via openResidentDetailsModal() -->
          </div>
          <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end shrink-0">
            <button type="button" onclick="document.getElementById('viewResidentDetailsModal').classList.add('hidden')"
              class="px-6 py-2.5 rounded-xl font-bold text-slate-700 bg-white border border-slate-200 hover:bg-slate-100 transition-colors text-xs sm:text-sm">
              Close Profile
            </button>
          </div>
        </div>
      </div>

      <!-- 4. DELETE / REMOVE WALK-IN RESIDENT CONFIRMATION MODAL -->
      <div id="deleteResidentModal"
        class="hidden fixed inset-0 z-[110] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm px-4">
        <div
          class="bg-white rounded-3xl w-full max-w-md shadow-2xl p-6 space-y-4 border border-slate-100 text-center animate-in fade-in zoom-in-95 duration-150">
          <div id="deleteResidentModalIconContainer"
            class="w-14 h-14 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto text-2xl shadow-inner">
            <i id="deleteResidentModalIcon" class="ph ph-warning-circle font-bold"></i>
          </div>
          <div>
            <h3 id="deleteResidentModalTitle" class="text-lg font-extrabold text-slate-900">Confirm Resident Deletion
            </h3>
            <p class="text-xs text-slate-500 mt-1" id="deleteResidentModalText">Are you sure you want to delete this
              resident record and user account? Historical evacuation records will remain archived.</p>
          </div>
          <form id="deleteResidentForm" action="" method="POST" class="flex gap-3 pt-2">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="button" onclick="closeDeleteResidentModal()"
              class="flex-1 px-4 py-2.5 rounded-xl font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all text-xs uppercase tracking-wider">Cancel</button>
            <button type="submit" id="deleteResidentSubmitBtn"
              class="flex-1 px-4 py-2.5 rounded-xl font-bold text-white bg-red-600 hover:bg-red-700 shadow-md shadow-red-600/20 transition-all text-xs uppercase tracking-wider">Yes,
              Delete</button>
          </form>
        </div>
      </div>

      <!-- FULLSCREEN VALID ID PREVIEW MODAL / LIGHTBOX -->
      <div id="residentIdPreviewModal" class="fixed inset-0 z-[70] hidden bg-slate-950/85 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6 transition-all duration-200">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-4xl w-full max-h-[92vh] flex flex-col overflow-hidden shadow-2xl animate-in fade-in zoom-in duration-150">
          <!-- Modal Header -->
          <div class="px-5 py-4 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between gap-3 shrink-0">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-9 h-9 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center shrink-0 text-lg">
                <i class="ph ph-identification-card"></i>
              </div>
              <div class="min-w-0">
                <h3 id="residentIdPreviewTitle" class="text-sm sm:text-base font-extrabold text-white truncate">Resident Valid ID</h3>
                <p class="text-[11px] text-slate-400 font-medium">Barangay / Government Identification Document</p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <a id="residentIdPreviewDownloadBtn" href="#" target="_blank" rel="noopener noreferrer" download
                class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs flex items-center gap-1.5 shadow-sm transition-all"
                title="Open original file in new tab">
                <i class="ph ph-arrow-square-out text-sm"></i>
                <span class="hidden sm:inline">Open Full Size</span>
              </a>
              <button type="button" onclick="closeResidentIdModal()"
                class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-colors cursor-pointer text-lg"
                title="Close Lightbox">
                <i class="ph ph-x font-bold"></i>
              </button>
            </div>
          </div>

          <!-- Image / Document Viewer Body -->
          <div class="flex-1 overflow-auto p-4 sm:p-6 flex items-center justify-center bg-slate-950/80 min-h-[300px]">
            <img id="residentIdPreviewImg" src="" alt="Valid ID Document"
              class="max-w-full max-h-[70vh] object-contain rounded-xl shadow-2xl border border-slate-800/80 transition-transform" />
            <div id="residentIdPreviewFallback" class="hidden text-center text-slate-400 p-8">
              <i class="ph ph-file-pdf text-5xl text-rose-500 mb-3 block"></i>
              <p class="text-sm font-bold text-white mb-1">Document Preview</p>
              <p class="text-xs text-slate-400 mb-4">This document cannot be previewed directly as an image.</p>
              <a id="residentIdPreviewFallbackLink" href="#" target="_blank" rel="noopener noreferrer"
                class="px-4 py-2 rounded-xl bg-indigo-600 text-white font-bold text-xs inline-flex items-center gap-1.5">
                <i class="ph ph-download-simple"></i> Download / View Document
              </a>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="px-5 py-3 bg-slate-900 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
            <span class="text-[11px]">Press ESC or click close to exit lightbox</span>
            <button type="button" onclick="closeResidentIdModal()"
              class="px-4 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer">
              Close
            </button>
