                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center gap-1 text-emerald-700 font-extrabold">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <%= addUnstaffedCount %> No Staff Yet
                  </span>
                  <span class="text-slate-300">•</span>
                  <span class="inline-flex items-center gap-1 text-slate-600 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                    <%= addStaffedCount %> Staffed
                  </span>
                </div>
              </div>

              <p id="edit_center_warning"
                class="hidden text-xs text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-xl font-semibold flex items-center gap-1.5">
                <i class="ph ph-warning-circle text-sm"></i> Only 1 evacuation site allowed per staff member.
              </p>

              <div
                class="max-h-48 overflow-y-auto p-2 bg-slate-50 border border-slate-200 rounded-xl space-y-1.5 custom-scrollbar">
                <% if (locals.centers && locals.centers.length> 0) { %>
                  <% locals.centers.forEach(c=> { %>
                    <label id="edit_center_label_<%= c.id %>"
                      class="edit-center-row flex items-center justify-between gap-2.5 p-2 rounded-xl transition-all cursor-pointer text-xs <%= c.has_staff ? 'bg-white border border-slate-200/80 hover:border-slate-300' : 'bg-emerald-50/50 border border-emerald-200/80 hover:bg-emerald-50 hover:border-emerald-300' %>"
                      data-center-id="<%= c.id %>"
                      data-has-staff="<%= c.has_staff ? '1' : '0' %>"
                      data-staff-names="<%= c.staff_names || '' %>"
                      data-staff-ids="<%= JSON.stringify((c.assigned_staff || []).map(s => s.id)) %>">
                      <div class="flex items-center gap-2.5 min-w-0">
                        <input type="checkbox" name="assigned_center_ids[]" value="<%= c.id %>"
                          class="edit-center-checkbox w-4 h-4 rounded text-blue-600 focus:ring-blue-500 border-slate-300 cursor-pointer shrink-0"
                          onchange="handleCenterCheckboxChange('edit', this)">
                        <div class="min-w-0">
                          <span class="font-bold text-slate-900 block truncate">
                            <%= c.name %>
                          </span>
                          <span class="text-[10px] text-slate-400 font-medium block truncate">
                            <%= c.address || 'San Rafael' %>
                          </span>
                        </div>
                      </div>

                      <div class="shrink-0 flex items-center ml-2" id="edit_center_badge_<%= c.id %>">
                        <% if (!c.has_staff) { %>
                          <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300/80 flex items-center gap-1 shrink-0">
                            <i class="ph ph-check-circle text-emerald-600"></i> No Staff Yet
                          </span>
                        <% } else { %>
                          <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200 flex items-center gap-1 shrink-0 max-w-[140px] truncate" title="Assigned Staff: <%= c.staff_names %>">
                            <i class="ph ph-user text-slate-400"></i> <span class="truncate"><%= c.staff_names %></span>
                          </span>
                        <% } %>
                      </div>
                    </label>
                  <% }) %>
                <% } else { %>
                  <div class="text-xs text-slate-400 italic p-2">No evacuation centers registered yet.</div>
                <% } %>
              </div>
            </div>

            <div class="pt-3 flex gap-3">
              <button type="button" onclick="document.getElementById('editStaffModal').classList.add('hidden')"
                class="flex-1 py-3 rounded-2xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 text-xs uppercase tracking-wider">Cancel</button>
              <button type="submit"
                class="flex-1 py-3 rounded-2xl bg-blue-600 text-white font-bold hover:bg-blue-700 shadow-md shadow-blue-500/20 text-xs uppercase tracking-wider transition-all">Save
                Changes</button>
            </div>
          </form>
        </div>
      </div>

      <!-- 3. DELETE STAFF CONFIRMATION MODAL -->
      <div id="deleteStaffModal"
        class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm px-4">
        <div
          class="bg-white rounded-3xl w-full max-w-md shadow-2xl p-6 space-y-4 border border-slate-100 text-center animate-in fade-in zoom-in-95 duration-150">
          <div
            class="w-14 h-14 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto text-2xl shadow-inner">
            <i class="ph ph-warning-circle font-bold"></i>
          </div>
          <div>
            <h3 class="text-lg font-extrabold text-slate-900">Confirm Staff Deletion</h3>
            <p class="text-xs text-slate-500 mt-1" id="deleteStaffModalText">Are you sure you want to delete this staff
              member and account? This action cannot be undone.</p>
          </div>
          <form id="deleteStaffForm" action="" method="POST" class="flex gap-3 pt-2">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="button" onclick="closeDeleteStaffModal()"
              class="flex-1 px-4 py-2.5 rounded-xl font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all text-xs uppercase tracking-wider">No,
              Cancel</button>
            <button type="submit"
              class="flex-1 px-4 py-2.5 rounded-xl font-bold text-white bg-red-600 hover:bg-red-700 shadow-md shadow-red-600/20 transition-all text-xs uppercase tracking-wider">Yes,
              Delete</button>
          </form>
        </div>
      </div>

  </div>

  <%- include('../partials/footer') %>

    <script>
      // Avatar instant previews
      function previewAddAvatar(input) {
        if (input.files && input.files[0]) {
          const reader = new FileReader();
          reader.onload = function (e) {
            const img = document.getElementById('add_avatar_preview');
            const icon = document.getElementById('add_avatar_icon');
            if (img && icon) {
              img.src = e.target.result;
              img.classList.remove('hidden');
              icon.classList.add('hidden');
            }
          };
          reader.readAsDataURL(input.files[0]);
        }
      }

      function previewEditAvatar(input) {
        if (input.files && input.files[0]) {
          const reader = new FileReader();
          reader.onload = function (e) {
            const img = document.getElementById('edit_avatar_preview');
            const icon = document.getElementById('edit_avatar_icon');
            if (img && icon) {
              img.src = e.target.result;
              img.classList.remove('hidden');
              icon.classList.add('hidden');
            }
          };
          reader.readAsDataURL(input.files[0]);
        }
      }

      // Toggle Password Visibility
      function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
          input.type = 'text';
          if (icon) {
            icon.classList.remove('ph-eye');
            icon.classList.add('ph-eye-slash');
          }
        } else {
          input.type = 'password';
          if (icon) {
            icon.classList.remove('ph-eye-slash');
            icon.classList.add('ph-eye');
          }
        }
      }

      // Limit assigned center checkboxes to maximum 1 (auto-switches to newly checked site)
      function handleCenterCheckboxChange(prefix, changedBox) {
        const checkboxes = document.querySelectorAll(`.${prefix}-center-checkbox`);
        const checkedBoxes = Array.from(checkboxes).filter(cb => cb.checked);
        const countBadge = document.getElementById(`${prefix}_center_count_badge`);
        const warningEl = document.getElementById(`${prefix}_center_warning`);

        if (checkedBoxes.length > 1) {
          // Auto-switch: uncheck other checkboxes so only the newly clicked one remains selected
          if (changedBox && changedBox.checked) {
            checkboxes.forEach(cb => {
              if (cb !== changedBox) cb.checked = false;
            });
          } else {
            checkedBoxes.slice(1).forEach(cb => { cb.checked = false; });
          }
        }
        if (warningEl) warningEl.classList.add('hidden');

        const activeCount = Array.from(checkboxes).filter(cb => cb.checked).length;
        if (countBadge) {
          countBadge.textContent = `${activeCount} / 1 Selected`;
          if (activeCount === 1) {
            countBadge.className = 'text-[11px] font-bold text-emerald-800 bg-emerald-100 border border-emerald-300 px-2.5 py-0.5 rounded-full';
          } else {
            countBadge.className = 'text-[11px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-full';
          }
        }
      }

      // Toggle Evacuation Sites assignment section based on Staff Type / Role
      function syncStaffTypeUi(prefix) {
        const typeSelect = document.getElementById(prefix === 'add' ? 'add_staff_type' : 'edit_staff_type');
        const sitesSection = document.getElementById(prefix === 'add' ? 'add_sites_section' : 'edit_sites_section');
        const rescuerNotice = document.getElementById(prefix === 'add' ? 'add_rescuer_notice' : 'edit_rescuer_notice');
        const isRescuer = typeSelect && typeSelect.value === 'RESCUER';

        if (sitesSection && rescuerNotice) {
          if (isRescuer) {
            sitesSection.classList.add('hidden');
            rescuerNotice.classList.remove('hidden');
            // Uncheck and clear any selected centers for Rescuers
            document.querySelectorAll(`.${prefix}-center-checkbox`).forEach(cb => { cb.checked = false; });
            handleCenterCheckboxChange(prefix);
          } else {
            sitesSection.classList.remove('hidden');
            rescuerNotice.classList.add('hidden');
          }
        }
      }

      function openAddStaffModal() {
        document.getElementById('staffModal').classList.remove('hidden');
        syncStaffTypeUi('add');
      }

      // Open Edit Modal with populated data
      function openEditModalFromBtn(btn) {
        const id = btn.getAttribute('data-id');
        const firstName = btn.getAttribute('data-first-name');
        const middleName = btn.getAttribute('data-middle-name');
        const lastName = btn.getAttribute('data-last-name');
        const occupation = btn.getAttribute('data-occupation');
        const email = btn.getAttribute('data-email');
        const contact = btn.getAttribute('data-contact');
        const staffType = btn.getAttribute('data-staff-type') || 'BOTH';
        const centerId = btn.getAttribute('data-center-id') || '';
        const photo = btn.getAttribute('data-photo');

        document.getElementById('editStaffForm').action = '/admin/staff/edit/' + id;
        document.getElementById('edit_first_name').value = firstName || '';
        document.getElementById('edit_middle_name').value = middleName || '';
        document.getElementById('edit_last_name').value = lastName || '';
        document.getElementById('edit_occupation').value = occupation || 'Emergency Staff';
        document.getElementById('edit_email').value = email || '';
        document.getElementById('edit_contact_number').value = contact || '';
        document.getElementById('edit_staff_type').value = (staffType === 'RESCUER' ? 'RESCUER' : 'EVACUATION');
        syncStaffTypeUi('edit');

        // Populate single site checkbox (1 site max)
        const rawCenterIds = btn.getAttribute('data-center-ids');
        let centerIds = [];
        try {
          centerIds = JSON.parse(rawCenterIds || '[]');
        } catch (e) {
          if (centerId) centerIds = [parseInt(centerId, 10)];
        }
        if (!Array.isArray(centerIds) && centerId) {
          centerIds = [parseInt(centerId, 10)];
        }
        if (centerIds.length > 1) {
          centerIds = [centerIds[0]];
        }

        document.querySelectorAll('.edit-center-checkbox').forEach(cb => {
          cb.checked = centerIds.includes(parseInt(cb.value, 10));
        });
        handleCenterCheckboxChange('edit');

        // Dynamic badges for Edit Modal: distinguish Current Site vs No Staff Yet vs Other Staff
        const editingStaffId = parseInt(id, 10);
        document.querySelectorAll('.edit-center-row').forEach(row => {
          const cId = parseInt(row.getAttribute('data-center-id'), 10);
          const rawStaffIds = row.getAttribute('data-staff-ids') || '[]';
          const staffNames = row.getAttribute('data-staff-names') || '';
          let staffIds = [];
          try { staffIds = JSON.parse(rawStaffIds); } catch(e) {}
          const badgeEl = document.getElementById(`edit_center_badge_${cId}`);
          if (badgeEl) {
            if (staffIds.includes(editingStaffId)) {
              badgeEl.innerHTML = `<span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-blue-100 text-blue-800 border border-blue-300 flex items-center gap-1 shrink-0"><i class="ph ph-check text-blue-600"></i> Current Site</span>`;
              row.className = 'edit-center-row flex items-center justify-between gap-2.5 p-2 rounded-xl transition-all cursor-pointer text-xs bg-blue-50/60 border border-blue-200 hover:border-blue-300';
            } else if (staffIds.length === 0) {
              badgeEl.innerHTML = `<span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300/80 flex items-center gap-1 shrink-0"><i class="ph ph-check-circle text-emerald-600"></i> No Staff Yet</span>`;
              row.className = 'edit-center-row flex items-center justify-between gap-2.5 p-2 rounded-xl transition-all cursor-pointer text-xs bg-emerald-50/50 border border-emerald-200/80 hover:bg-emerald-50 hover:border-emerald-300';
            } else {
              badgeEl.innerHTML = `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200 flex items-center gap-1 shrink-0 max-w-[140px] truncate" title="Assigned Staff: ${staffNames}"><i class="ph ph-user text-slate-400"></i> <span class="truncate">${staffNames}</span></span>`;
              row.className = 'edit-center-row flex items-center justify-between gap-2.5 p-2 rounded-xl transition-all cursor-pointer text-xs bg-white border border-slate-200/80 hover:border-slate-300';
            }
          }
        });

        // Preview avatar if exists
        const img = document.getElementById('edit_avatar_preview');
        const icon = document.getElementById('edit_avatar_icon');
        if (photo && photo.trim() !== '') {
          img.src = photo;
          img.classList.remove('hidden');
          icon.classList.add('hidden');
        } else {
          img.src = '';
          img.classList.add('hidden');
          icon.classList.remove('hidden');
        }

        document.getElementById('editStaffModal').classList.remove('hidden');
      }

      // Client-Side Pagination & Filtering (Matching Residents page ITE-PT-DOM001)
      let staffCurrentPage = 1;
      const staffPageSize = 25;
      let matchedStaffRows = [];
      let matchedStaffCards = [];

      let staffSearchDebounceTimer = null;
      function debouncedFilterStaff() {
        clearTimeout(staffSearchDebounceTimer);
        staffSearchDebounceTimer = setTimeout(filterStaff, 200);
      }

      function filterStaff() {
        const query = (document.getElementById('staffSearchInput')?.value || '').toLowerCase().trim();
        const typeFilter = (document.getElementById('staffTypeFilter')?.value || 'all').toUpperCase().trim();
        const centerFilter = (document.getElementById('staffCenterFilter')?.value || 'all').toLowerCase().trim();

        const rows = Array.from(document.querySelectorAll('#staffTableBody tr[data-name]'));
        const cards = Array.from(document.querySelectorAll('#staffMobileContainer > div.staff-card-item'));

        matchedStaffRows = [];
        matchedStaffCards = [];

        rows.forEach(row => {
          const name = row.getAttribute('data-name') || '';
          const email = row.getAttribute('data-email') || '';
          const occupation = row.getAttribute('data-occupation') || '';
          const type = row.getAttribute('data-type') || '';
          const center = row.getAttribute('data-center') || '';

          const fullText = (name + ' ' + email + ' ' + occupation + ' ' + center).toLowerCase();

          const matchesQuery = !query || fullText.includes(query);
          const matchesType = (typeFilter === 'ALL' || type === typeFilter);
          const matchesCenter = (centerFilter === 'all' || center.includes(centerFilter));

          if (matchesQuery && matchesType && matchesCenter) {
            matchedStaffRows.push(row);
          } else {
            row.style.display = 'none';
          }
        });

        cards.forEach(card => {
          const name = card.getAttribute('data-name') || '';
          const email = card.getAttribute('data-email') || '';
          const occupation = card.getAttribute('data-occupation') || '';
          const type = card.getAttribute('data-type') || '';
          const center = card.getAttribute('data-center') || '';

          const fullText = (name + ' ' + email + ' ' + occupation + ' ' + center).toLowerCase();

          const matchesQuery = !query || fullText.includes(query);
          const matchesType = (typeFilter === 'ALL' || type === typeFilter);
          const matchesCenter = (centerFilter === 'all' || center.includes(centerFilter));

          if (matchesQuery && matchesType && matchesCenter) {
            matchedStaffCards.push(card);
          } else {
            card.style.display = 'none';
          }
        });

        staffCurrentPage = 1;
        renderPaginatedStaffView();
      }

      function renderPaginatedStaffView() {
        const total = Math.max(matchedStaffRows.length, matchedStaffCards.length);
        const totalPages = Math.ceil(total / staffPageSize) || 1;
        if (staffCurrentPage > totalPages) staffCurrentPage = totalPages;
        if (staffCurrentPage < 1) staffCurrentPage = 1;

        const startIdx = (staffCurrentPage - 1) * staffPageSize;
        const endIdx = startIdx + staffPageSize;

        matchedStaffRows.forEach((row, idx) => {
          row.style.display = (idx >= startIdx && idx < endIdx) ? '' : 'none';
        });

        matchedStaffCards.forEach((card, idx) => {
          card.style.display = (idx >= startIdx && idx < endIdx) ? '' : 'none';
        });

        // Toggle Empty States
        const noStaffDesk = document.getElementById('noStaffDesktopRow');
        const noStaffMob = document.getElementById('noStaffMobileRow');
        if (noStaffDesk) noStaffDesk.style.display = total === 0 ? '' : 'none';
        if (noStaffMob) noStaffMob.style.display = total === 0 ? '' : 'none';

        const pagStart = document.getElementById('pagStart');
        const pagEnd = document.getElementById('pagEnd');
        const pagTotal = document.getElementById('pagTotal');
        const prevBtn = document.getElementById('prevPageBtn');
        const nextBtn = document.getElementById('nextPageBtn');
        const numContainer = document.getElementById('paginationPageNumbers');

        if (pagStart) pagStart.textContent = total > 0 ? (startIdx + 1) : 0;
        if (pagEnd) pagEnd.textContent = Math.min(endIdx, total);
        if (pagTotal) pagTotal.textContent = total;

        if (prevBtn) prevBtn.disabled = (staffCurrentPage <= 1);
        if (nextBtn) nextBtn.disabled = (staffCurrentPage >= totalPages);

        if (numContainer) {
          numContainer.innerHTML = '';
          const maxVisiblePages = 5;
          let pStart = Math.max(1, staffCurrentPage - 2);
          let pEnd = Math.min(totalPages, pStart + maxVisiblePages - 1);
          if (pEnd - pStart < maxVisiblePages - 1) {
            pStart = Math.max(1, pEnd - maxVisiblePages + 1);
          }

          for (let p = pStart; p <= pEnd; p++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `w-7 h-7 rounded-lg text-xs font-bold transition-all ${p === staffCurrentPage ? 'bg-blue-600 text-white shadow-xs' : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'}`;
            btn.textContent = p;
            btn.onclick = () => { staffCurrentPage = p; renderPaginatedStaffView(); };
            numContainer.appendChild(btn);
          }
        }
      }

      function changeStaffPage(direction) {
        staffCurrentPage += direction;
        renderPaginatedStaffView();
      }

      // Delete confirmation helper
      window.confirmDeleteStaff = function (btn) {
        let id = '';
        let name = '';
        if (typeof btn === 'object') {
          id = btn.getAttribute('data-id');
          name = btn.getAttribute('data-name');
        } else {
          id = btn;
        }
        const form = document.getElementById('deleteStaffForm');
        const text = document.getElementById('deleteStaffModalText');
        if (form) form.action = '/admin/staff/delete/' + id;
        if (text) text.textContent = `Are you sure you want to delete "${name || 'this staff member'}" and their staff account? This action cannot be undone.`;
        const modal = document.getElementById('deleteStaffModal');
        if (modal) modal.classList.remove('hidden');
      };

      window.closeDeleteStaffModal = function () {
        const modal = document.getElementById('deleteStaffModal');
        if (modal) modal.classList.add('hidden');
      };

      // Live Real-Time Online / Offline Status Synchronizer & Initialization
      document.addEventListener('DOMContentLoaded', () => {
        filterStaff();

        if (typeof io !== 'undefined') {
          const socket = window.__appSocket || io();
          window.__appSocket = socket;

          socket.on('user:status_change', (data) => {
            if (!data || !data.userId) return;
            const dots = document.querySelectorAll('.staff-status-dot-' + data.userId);
            dots.forEach((dot) => {
              if (data.isOnline) {
                dot.className = 'staff-status-dot staff-status-dot-' + data.userId + ' absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-500 ring-2 ring-white animate-pulse';
                dot.title = 'Online';
              } else {
                dot.className = 'staff-status-dot staff-status-dot-' + data.userId + ' absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-slate-300 ring-2 ring-white';
                dot.title = 'Offline';
              }
            });
          });
        }

        // Frontend Validation for Add Staff Form
        const addStaffForm = document.getElementById('addStaffForm');
        if (addStaffForm) {
          addStaffForm.addEventListener('submit', function (e) {
            const phone = (document.getElementById('add_staff_contact')?.value || '').trim();
            const password = (document.getElementById('add_staff_password')?.value || '').trim();

            // Validate phone: strictly 11 digits starting with 09
            if (!/^09\d{9}$/.test(phone)) {
              e.preventDefault();
              alert('Please enter a valid 11-digit Philippine mobile number starting with 09 (e.g., 09123456789).');
              document.getElementById('add_staff_contact')?.focus();
              return false;
            }

            // Validate password if provided (since default is staff123 if blank)
            if (password && (password.length < 8 || !/[a-zA-Z]/.test(password) || !/[0-9]/.test(password))) {
              e.preventDefault();
              alert('Password must be at least 8 characters long and contain both letters and numbers.');
              document.getElementById('add_staff_password')?.focus();
              return false;
            }
          });
        }

        // Frontend Validation for Edit Staff Form
        const editStaffForm = document.getElementById('editStaffForm');
        if (editStaffForm) {
          editStaffForm.addEventListener('submit', function (e) {
            const phone = (document.getElementById('edit_contact_number')?.value || '').trim();
            if (!/^09\d{9}$/.test(phone)) {
              e.preventDefault();
              alert('Please enter a valid 11-digit Philippine mobile number starting with 09 (e.g., 09123456789).');
              document.getElementById('edit_contact_number')?.focus();
              return false;
            }
          });
        }
      });

      function openAddAdminModal() {
        const modal = document.getElementById('addAdminModal');
        if (modal) modal.classList.remove('hidden');
      }
      function closeAddAdminModal() {
        const modal = document.getElementById('addAdminModal');
        if (modal) modal.classList.add('hidden');
      }
      window.openAddAdminModal = openAddAdminModal;
      window.closeAddAdminModal = closeAddAdminModal;
    </script>

    <!-- ADD NEW ADMINISTRATOR MODAL -->
    <div id="addAdminModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-5">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-2xl bg-slate-900 text-emerald-400 flex items-center justify-center shrink-0">
              <i class="ph ph-shield-plus text-xl"></i>
            </div>
            <div>
              <h3 class="text-base font-black text-slate-900 leading-tight">Add New Administrator</h3>
              <p class="text-xs text-slate-500 font-medium">Grant full Command Center admin privileges</p>
            </div>
          </div>
          <button type="button" onclick="closeAddAdminModal()" class="p-1.5 rounded-xl text-slate-400 hover:bg-slate-100 hover:text-slate-700 cursor-pointer">
            <i class="ph ph-x text-lg"></i>
          </button>
        </div>

        <form id="addAdminForm" action="/admin/admins/create" method="POST" class="space-y-3.5">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">First Name *</label>
              <input type="text" name="first_name" required placeholder="e.g. Juan"
                class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 outline-none font-semibold text-slate-800" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Last Name *</label>
              <input type="text" name="last_name" required placeholder="e.g. Dela Cruz"
                class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 outline-none font-semibold text-slate-800" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Email Address (Login Username) *</label>
            <input type="email" name="email" required placeholder="admin.name@evakwar.gov.ph"
              class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 outline-none font-semibold text-slate-800" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Mobile Number (Optional)</label>
            <input type="text" name="contact_number" placeholder="09XXXXXXXXX"
              class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 outline-none font-mono font-semibold text-slate-800" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Password *</label>
            <input type="password" name="password" required minlength="8" placeholder="At least 8 chars (letters & numbers)"
              class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-blue-500 outline-none font-semibold text-slate-800" />
            <p class="text-[11px] text-slate-400 mt-1">Must be at least 8 characters and include both letters and numbers.</p>
          </div>

          <div class="pt-2 flex items-center justify-end gap-2.5 border-t border-slate-100">
            <button type="button" onclick="closeAddAdminModal()"
              class="px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-bold cursor-pointer">
              Cancel
            </button>
            <button type="submit"
              class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-black shadow-md flex items-center gap-1.5 cursor-pointer">
              <i class="ph ph-shield-check text-emerald-400 text-sm"></i> Create Admin Account
            </button>
          </div>
        </form>
      </div>
    </div>