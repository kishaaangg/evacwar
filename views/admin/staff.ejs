                    <label
                      class="flex items-center justify-between gap-2.5 p-2 rounded-xl transition-all cursor-pointer text-xs <%= c.has_staff ? 'bg-white border border-slate-200/80 hover:border-slate-300' : 'bg-emerald-50/50 border border-emerald-200/80 hover:bg-emerald-50 hover:border-emerald-300' %>">
                      <div class="flex items-center gap-2.5 min-w-0">
                        <input type="checkbox" name="assigned_center_ids[]" value="<%= c.id %>"
                          class="add-center-checkbox w-4 h-4 rounded text-blue-600 focus:ring-blue-500 border-slate-300 cursor-pointer shrink-0"
                          onchange="handleCenterCheckboxChange('add', this)">
                        <div class="min-w-0">
                          <span class="font-bold text-slate-900 block truncate">
                            <%= c.name %>
                          </span>
                          <span class="text-[10px] text-slate-400 font-medium block truncate">
                            <%= c.address || 'San Rafael' %>
                          </span>
                        </div>
                      </div>

                      <div class="shrink-0 flex items-center ml-2">
                        <% if (!c.has_staff) { %>
                          <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300/80 flex items-center gap-1 shrink-0">
                            <i class="ph ph-check-circle text-emerald-600"></i> No Staff Yet
                          </span>
                        <% } else { %>
                          <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200 flex items-center gap-1 shrink-0 max-w-[140px] truncate" title="Assigned Staff: <%= c.staff_names %>">
                            <i class="ph ph-user text-slate-400"></i> <span class="truncate"><%= c.staff_names %></span>
                          </span>
                        <% } %>
                      </div>
                    </label>
                  <% }) %>
                <% } else { %>
                  <div class="text-xs text-slate-400 italic p-2">No evacuation centers registered yet.</div>
                <% } %>
              </div>
            </div>

            <div class="pt-3 flex gap-3">
              <button type="button" onclick="document.getElementById('staffModal').classList.add('hidden')"
                class="flex-1 py-3 rounded-2xl border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 text-xs uppercase tracking-wider">Cancel</button>
              <button type="submit"
                class="flex-1 py-3 rounded-2xl bg-blue-600 text-white font-bold hover:bg-blue-700 shadow-md shadow-blue-500/20 text-xs uppercase tracking-wider transition-all">Save
                Staff</button>
            </div>
          </form>
        </div>
      </div>

