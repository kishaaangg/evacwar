                const addStaffedCount = addTotalCenters - addUnstaffedCount;
              %>
              <div class="flex items-center justify-between text-[11px] font-semibold bg-slate-100/80 px-2.5 py-1.5 rounded-lg border border-slate-200/70">
                <span class="text-slate-500">Facility Status:</span>
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center gap-1 text-emerald-700 font-extrabold">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <%= addUnstaffedCount %> No Staff Yet
                  </span>
                  <span class="text-slate-300">•</span>
                  <span class="inline-flex items-center gap-1 text-slate-600 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                    <%= addStaffedCount %> Staffed
                  </span>
                </div>
              </div>

