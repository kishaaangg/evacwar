<%- include('../partials/header') %>

  <div class="app-main-layout">
    <%- include('../partials/sidebar') %>

      <main class="app-content flex flex-col min-h-screen bg-slate-50 relative pb-28 lg:pb-12 overflow-x-hidden">
        <div class="max-w-7xl mx-auto space-y-5 flex-1 w-full p-4 sm:p-6 lg:p-7">

          <!-- Page Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h1 class="text-2xl sm:text-3xl font-black text-blue-950 tracking-tight">Manage Staff &amp; Admins</h1>
              <p class="text-sm text-slate-500 font-medium mt-0.5">Configure emergency staff roster, operational roles,
                center assignments, and administrator accounts.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
              <button type="button"
                class="px-4 py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white shadow-md shadow-slate-900/15 text-sm font-bold flex items-center gap-2 transition-all active:scale-98 cursor-pointer"
                onclick="openAddAdminModal()">
                <i class="ph ph-shield-plus text-xl text-emerald-400"></i> Add New Admin
              </button>
              <button type="button"
                class="btn btn-primary px-5 py-3 rounded-2xl shadow-md shadow-blue-500/20 text-sm font-bold flex items-center gap-2 hover:bg-blue-700 transition-all active:scale-98 cursor-pointer"
                onclick="openAddStaffModal()">
                <i class="ph ph-user-plus text-xl"></i> Add New Staff
              </button>
            </div>
          </div>

          <!-- Status Alerts -->
          <% if (locals.successMsg) { %>
            <div class="p-3.5 bg-emerald-50 border-l-4 border-emerald-500 rounded-2xl flex items-center justify-between shadow-xs">
              <div class="flex items-center gap-2.5 text-emerald-950 text-xs sm:text-sm font-bold">
                <i class="ph ph-check-circle text-xl text-emerald-600 shrink-0"></i>
                <span><%= successMsg %></span>
              </div>
              <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-800 p-1 cursor-pointer">
                <i class="ph ph-x"></i>
              </button>
            </div>
          <% } %>
          <% if (locals.errorMsg) { %>
            <div class="p-3.5 bg-rose-50 border-l-4 border-rose-500 rounded-2xl flex items-center justify-between shadow-xs">
              <div class="flex items-center gap-2.5 text-rose-950 text-xs sm:text-sm font-bold">
                <i class="ph ph-warning-circle text-xl text-rose-600 shrink-0"></i>
                <span><%= errorMsg %></span>
              </div>
              <button type="button" onclick="this.parentElement.remove()" class="text-rose-600 hover:text-rose-800 p-1 cursor-pointer">
                <i class="ph ph-x"></i>
              </button>
            </div>
          <% } %>

          <!-- Administrator Accounts Card -->
          <div class="card p-4 sm:p-5 shadow-sm bg-white border border-slate-200/90 rounded-3xl space-y-3.5">
            <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-3">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-slate-900 text-emerald-400 flex items-center justify-center shrink-0 shadow-xs">
                  <i class="ph ph-shield-check text-xl"></i>
                </div>
                <div>
                  <h2 class="text-sm sm:text-base font-black text-slate-900 leading-tight">Administrator Accounts</h2>
                  <p class="text-xs text-slate-500 font-medium">System administrators with full Command Center access.</p>
                </div>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-black bg-slate-100 text-slate-700 border border-slate-200">
                <%= (locals.adminAccounts && locals.adminAccounts.length) ? locals.adminAccounts.length : 0 %> Admin(s)
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              <% if (locals.adminAccounts && locals.adminAccounts.length > 0) { %>
                <% locals.adminAccounts.forEach(adm => { %>
                  <div class="p-3.5 rounded-2xl border border-slate-200 bg-slate-50/70 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                      <div class="relative w-10 h-10 rounded-xl bg-slate-900 text-white font-black text-sm flex items-center justify-center shrink-0 shadow-xs">
                        <%= (adm.name || 'A').charAt(0).toUpperCase() %>
                        <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full border-2 border-white <%= adm.is_online ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
                      </div>
                      <div class="min-w-0">
                        <div class="text-xs sm:text-sm font-black text-slate-900 truncate flex items-center gap-1.5">
                          <span class="truncate"><%= adm.name %></span>
                          <% if (adm.is_current_user) { %>
                            <span class="px-1.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[9.5px] font-black uppercase shrink-0">You</span>
                          <% } %>
                        </div>
                        <div class="text-[11px] font-semibold text-slate-500 truncate"><%= adm.email %></div>
                        <% if (adm.contact_number && adm.contact_number !== '09000000000') { %>
                          <div class="text-[10.5px] font-mono text-slate-400 truncate"><%= adm.contact_number %></div>
                        <% } %>
                      </div>
                    </div>
                    <% if (!adm.is_current_user && locals.adminAccounts.length > 1) { %>
                      <form action="/admin/admins/delete/<%= adm.id %>" method="POST"
                        onsubmit="return confirm('Remove administrator account <%= adm.name %> (<%= adm.email %>)?');"
                        class="shrink-0">
                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                        <button type="submit" title="Remove Admin"
                          class="p-2 rounded-xl text-rose-600 hover:bg-rose-100 transition-colors cursor-pointer">
                          <i class="ph ph-trash text-base"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>

          <!-- Main Staff Card Container -->
          <div class="card p-0 overflow-hidden shadow-sm bg-white border border-slate-200/90 rounded-3xl">

            <!-- Search & Multi-Filter Toolbar -->
            <div
              class="p-4 sm:p-5 border-b border-slate-200/80 bg-slate-50/70 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 sm:gap-4">

              <!-- Search Input -->
              <div class="relative w-full lg:max-w-sm shrink-0">
                <i class="ph ph-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></i>
                <input type="text" id="staffSearchInput" oninput="debouncedFilterStaff()"
                  placeholder="Search name, email, occupation, center..."
                  class="w-full pl-11 pr-4 py-2.5 text-sm bg-white border border-slate-200 rounded-2xl focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all shadow-2xs font-medium text-slate-800 placeholder:text-slate-400" />
              </div>

              <!-- Filter Dropdowns Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full lg:w-auto">

                <!-- Filter: Staff Type -->
                <div class="min-w-[170px]">
                  <select id="staffTypeFilter" onchange="filterStaff()"
                    class="w-full text-xs sm:text-sm py-2.5 px-3.5 bg-white font-semibold border border-slate-200 rounded-2xl outline-none focus:border-blue-500 shadow-2xs text-slate-700 cursor-pointer">
                    <option value="all" selected>All Roles</option>
                    <option value="EVACUATION">Site Staff</option>
                    <option value="RESCUER">Rescuer</option>
                  </select>
                </div>

                <!-- Filter: Evacuation Center -->
                <div class="min-w-[200px]">
                  <select id="staffCenterFilter" onchange="filterStaff()"
                    class="w-full text-xs sm:text-sm py-2.5 px-3.5 bg-white font-semibold border border-slate-200 rounded-2xl outline-none focus:border-blue-500 shadow-2xs text-slate-700 truncate cursor-pointer">
                    <option value="all" selected>All Assigned Centers</option>
                    <% if (locals.centers && locals.centers.length> 0) { %>
                      <% locals.centers.forEach(c=> { %>
                        <option value="<%= c.name.toLowerCase() %>">
                          <%= c.name %>
                        </option>
                        <% }) %>
                          <% } %>
                  </select>
                </div>

              </div>
            </div>

            <!-- Desktop View: Table -->
            <div class="hidden md:block border-0 rounded-none overflow-x-auto">
              <table class="w-full text-left border-collapse table-fixed">
                <colgroup>
                  <col style="width: 60px;">
                  <col style="width: 28%;">
                  <col style="width: 18%;">
                  <col style="width: 18%;">
                  <col style="width: 20%;">
                  <col style="width: 16%;">
                  <col style="width: 90px;">
                </colgroup>
                <thead
                  class="bg-slate-100 dark:bg-slate-800 sticky top-0 z-20 border-b border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-100 select-none shadow-xs font-extrabold">
                  <tr>
                    <th
                      class="py-3.5 px-3 text-[11px] font-extrabold uppercase tracking-wider text-center bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      ID</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Staff Member</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Occupation</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Staff Type</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Assigned Center</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Contact</th>
                    <th
                      class="py-3.5 px-4 text-[11px] font-extrabold uppercase tracking-wider text-right bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100">
                      Actions</th>
                  </tr>
                </thead>
                <tbody id="staffTableBody" class="divide-y divide-slate-100 bg-white">
                  <% if (locals.staffMembers && locals.staffMembers.length> 0) { %>
                    <% locals.staffMembers.forEach(staff=> {
                      const staffType = (staff.staff_type || 'BOTH').toUpperCase();
                      const isOnline = Boolean(staff.is_online);
                      const photoUrl = staff.profile_photo ? ((staff.profile_photo.startsWith('http') ||
                      staff.profile_photo.startsWith('/')) ? staff.profile_photo :
                      `/uploads/profiles/${staff.profile_photo}`) : null;
                      %>
                      <tr class="hover:bg-blue-50/40 transition-colors group"
                        data-name="<%= (staff.name || '').toLowerCase() %>"
                        data-email="<%= (staff.email || '').toLowerCase() %>"
                        data-occupation="<%= (staff.occupation || '').toLowerCase() %>" data-type="<%= staffType %>"
                        data-center="<%= (staff.assigned_center_name || '').toLowerCase() %>">

                        <!-- ID -->
                        <td class="py-4 px-3 text-center font-mono text-xs font-bold text-slate-400">#<%= staff.id %>
                        </td>

                        <!-- Staff Name & Email (with Online Indicator Circle on top layer) -->
                        <td class="py-4 px-4">
                          <div class="flex items-center gap-3 min-w-0">
                            <div
                              class="relative shrink-0 w-10 h-10 min-w-[40px] max-w-[40px] min-h-[40px] max-h-[40px]">
                              <div
                                class="w-full h-full aspect-square rounded-2xl bg-blue-100 border border-blue-200 flex items-center justify-center text-blue-700 font-bold text-sm shadow-2xs overflow-hidden">
                                <% if (photoUrl) { %>
                                  <img src="<%= photoUrl %>" alt="<%= staff.name %>"
                                    loading="lazy" decoding="async"
                                    class="w-full h-full object-cover rounded-2xl"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                  <span style="display:none;"
                                    class="w-full h-full flex items-center justify-center font-bold text-xs">
                                    <%= (staff.first_name || staff.name || 'S' ).charAt(0).toUpperCase() %>
                                  </span>
                                  <% } else { %>
                                    <span class="font-bold text-xs">
                                      <%= (staff.first_name || staff.name || 'S' ).charAt(0).toUpperCase() %>
                                    </span>
                                    <% } %>
                              </div>

                              <!-- Status Circle on top layer OUTSIDE overflow-hidden -->
                              <span
                                class="staff-status-dot staff-status-dot-<%= staff.user_id %> absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full z-10 <%= isOnline ? 'bg-emerald-500 ring-2 ring-white animate-pulse' : 'bg-slate-300 ring-2 ring-white' %>"
                                title="<%= isOnline ? 'Online' : 'Offline' %>"></span>
                            </div>

                            <div class="min-w-0 flex-1">
                              <div
                                class="font-bold text-slate-900 text-sm truncate group-hover:text-blue-900 transition-colors"
                                title="<%= staff.name %>">
                                <%= staff.name %>
                              </div>
                              <div class="text-xs text-slate-400 font-medium truncate" title="<%= staff.email || '' %>">
                                <%= staff.email || 'N/A' %>
                              </div>
                            </div>
                          </div>
                        </td>

                        <!-- Occupation -->
                        <td class="py-4 px-4">
                          <span class="font-medium text-slate-700 text-sm block truncate"
                            title="<%= staff.occupation || 'Emergency Staff' %>">
                            <%= staff.occupation || 'Emergency Staff' %>
                          </span>
                        </td>

                        <!-- Staff Type Badge -->
                        <td class="py-4 px-4">
                          <% if (staffType==='RESCUER' ) { %>
                            <span
                              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200/80 shadow-2xs">
                              <i class="ph ph-lifebuoy text-sm"></i> Rescuer
                            </span>
                            <% } else if (staffType==='EVACUATION' ) { %>
                              <span
                                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200/80 shadow-2xs">
                                <i class="ph ph-buildings text-sm"></i> Site Staff
                              </span>
                              <% } else { %>
                                <span
                                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/80 shadow-2xs">
                                  <i class="ph ph-shield-check text-sm"></i> Both
                                </span>
                                <% } %>
                        </td>

                        <!-- Assigned Centers (Up to 3) -->
                        <td class="py-4 px-4">
                          <div class="flex flex-wrap gap-1 max-w-[240px]">
                            <% if (staffType==='RESCUER' ) { %>
                              <span
                                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200/90 shadow-2xs"
                                title="Emergency SOS Field Response (No Site Assignment)">
                                <i class="ph ph-lifebuoy text-xs text-amber-600"></i>
                                <span>No Site (Rescuer)</span>
                              </span>
                              <% } else if (staff.assigned_centers && staff.assigned_centers.length> 0) { %>
                                <% staff.assigned_centers.slice(0, 1).forEach(c=> { %>
                                  <span
                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 truncate"
                                    title="<%= c.name %>">
                                    <i class="ph ph-buildings text-[11px] text-blue-600"></i>
                                    <span class="truncate max-w-[130px]">
                                      <%= c.name %>
                                    </span>
                                  </span>
                                  <% }) %>
                                    <% } else { %>
                                      <span class="text-xs text-slate-400 italic">Unassigned</span>
                                      <% } %>
                          </div>
                        </td>

                        <!-- Contact -->
                        <td class="py-4 px-4">
                          <div class="text-slate-600 text-xs font-medium flex items-center gap-1.5 truncate"
                            title="<%= staff.contact || 'No phone' %>">
                            <i class="ph ph-phone text-slate-400 text-sm shrink-0"></i>
                            <span class="truncate">
                              <%= staff.contact || 'None' %>
                            </span>
                          </div>
                        </td>

                        <!-- Actions -->
                        <td class="py-4 px-4 text-right">
                          <div class="flex items-center justify-end gap-1.5">
                            <button
                              class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 transition-all shadow-2xs hover:scale-105 active:scale-95 shrink-0"
                              title="Edit Staff" data-id="<%= staff.id %>"
                              data-first-name="<%= staff.first_name || '' %>"
                              data-middle-name="<%= staff.middle_name || '' %>"
                              data-last-name="<%= staff.last_name || '' %>"
                              data-occupation="<%= staff.occupation || '' %>" data-email="<%= staff.email || '' %>"
                              data-contact="<%= staff.contact || '' %>" data-staff-type="<%= staffType %>"
                              data-center-id="<%= staff.assigned_center_id || '' %>"
                              data-center-ids="<%= JSON.stringify(staff.assigned_center_ids || (staff.assigned_center_id ? [staff.assigned_center_id] : [])) %>"
                              data-photo="<%= photoUrl || '' %>" onclick="openEditModalFromBtn(this)">
                              <i class="ph ph-pencil-simple text-sm"></i>
                            </button>
                            <button type="button"
                              class="w-8 h-8 min-w-[32px] max-w-[32px] min-h-[32px] max-h-[32px] aspect-square rounded-xl flex items-center justify-center text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 transition-all shadow-2xs hover:scale-105 active:scale-95 shrink-0"
                              title="Delete Staff" data-id="<%= staff.id %>" data-name="<%= staff.name || '' %>"
                              onclick="confirmDeleteStaff(this)">
                              <i class="ph ph-trash text-sm"></i>
                            </button>
                          </div>
                        </td>

                      </tr>
                      <% }) %>
                        <% } %>
                        <tr id="noStaffDesktopRow" <%= (locals.staffMembers && locals.staffMembers.length > 0) ? 'style="display: none;"' : '' %>>
                          <td colspan="7" class="text-center py-14 text-slate-400">
                            <i class="ph ph-users text-4xl mb-2 text-slate-300"></i>
                            <p class="font-semibold text-sm">No staff records found.</p>
                          </td>
                        </tr>
                </tbody>
              </table>
            </div>

            <!-- Mobile View: Card List -->
            <div id="staffMobileContainer"
              class="block md:hidden border-t border-slate-100 divide-y divide-slate-100">
              <% if (locals.staffMembers && locals.staffMembers.length> 0) { %>
                <% locals.staffMembers.forEach(staff=> {
                  const staffType = (staff.staff_type || 'BOTH').toUpperCase();
                  const isOnline = Boolean(staff.is_online);
                  const photoUrl = staff.profile_photo ? ((staff.profile_photo.startsWith('http') ||
                  staff.profile_photo.startsWith('/')) ? staff.profile_photo :
                  `/uploads/profiles/${staff.profile_photo}`) : null;
                  %>
                  <div class="staff-card-item p-4 bg-white hover:bg-slate-50 transition-colors"
                    data-name="<%= (staff.name || '').toLowerCase() %>"
                    data-email="<%= (staff.email || '').toLowerCase() %>"
                    data-occupation="<%= (staff.occupation || '').toLowerCase() %>" data-type="<%= staffType %>"
                    data-center="<%= (staff.assigned_center_name || '').toLowerCase() %>">

                    <!-- Top header -->
                    <div class="flex items-start justify-between mb-3">
                      <div class="flex items-center gap-3 min-w-0">
                        <div class="relative shrink-0 w-11 h-11 min-w-[44px] max-w-[44px] min-h-[44px] max-h-[44px]">
                          <div
                            class="w-full h-full aspect-square rounded-2xl bg-blue-100 border border-blue-200 flex items-center justify-center text-blue-700 font-bold shadow-2xs overflow-hidden">
                            <% if (photoUrl) { %>
                              <img src="<%= photoUrl %>" alt="<%= staff.name %>"
                                loading="lazy" decoding="async"
                                class="w-full h-full object-cover rounded-2xl"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                              <span style="display:none;"
                                class="w-full h-full flex items-center justify-center font-bold text-sm">
                                <%= (staff.first_name || staff.name || 'S' ).charAt(0).toUpperCase() %>
                              </span>
                              <% } else { %>
                                <span class="font-bold text-sm">
                                  <%= (staff.first_name || staff.name || 'S' ).charAt(0).toUpperCase() %>
                                </span>
                                <% } %>
                          </div>

                          <!-- Circle indicator on photo (Real-time Live Online/Offline on top layer) -->
                          <span
                            class="staff-status-dot staff-status-dot-<%= staff.user_id %> absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full z-10 <%= isOnline ? 'bg-emerald-500 ring-2 ring-white animate-pulse' : 'bg-slate-300 ring-2 ring-white' %>"
                            title="<%= isOnline ? 'Online' : 'Offline' %>"></span>
                        </div>
                        <div class="min-w-0">
                          <div class="font-bold text-slate-900 text-sm truncate">
                            <%= staff.name %>
                          </div>
                          <div class="text-xs text-slate-600 font-medium truncate">
                            <%= staff.occupation || 'Emergency Staff' %>
                          </div>
                          <div class="text-[11px] text-slate-400 font-medium truncate">
                            <%= staff.email || 'N/A' %>
                          </div>
                        </div>
                      </div>

                      <span
                        class="font-mono text-xs font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-lg border border-slate-200 shrink-0">#
                        <%= staff.id %></span>
                    </div>

                    <!-- Centers & Contact -->
                    <div class="mb-3 space-y-1.5 bg-slate-50/90 p-3 rounded-2xl border border-slate-100 text-xs">
                      <div class="flex flex-wrap items-center gap-1">
                        <% if (staffType==='RESCUER' ) { %>
                          <span
                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                            <i class="ph ph-lifebuoy text-[11px] text-amber-600"></i>
                            <span>No Site (Rescuer)</span>
                          </span>
                          <% } else if (staff.assigned_centers && staff.assigned_centers.length> 0) { %>
                            <% staff.assigned_centers.slice(0, 1).forEach(c=> { %>
                              <span
                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                <i class="ph ph-buildings text-[11px] text-blue-600"></i>
                                <span>
                                  <%= c.name %>
                                </span>
                              </span>
                              <% }) %>
                                <% } else { %>
                                  <span class="text-xs text-slate-400 italic">No Center Assigned</span>
                                  <% } %>
                      </div>
                      <div
                        class="text-slate-600 flex items-center gap-1.5 pt-1 border-t border-slate-200/60 font-medium">
                        <i class="ph ph-phone text-slate-400 text-sm"></i>
                        <span>
                          <%= staff.contact || 'No phone' %>
                        </span>
                      </div>
                    </div>

                    <!-- Badges & Action Buttons -->
                    <div class="flex items-center justify-between pt-1">
                      <div>
