                          title="Edit Staff" data-id="<%= staff.id %>" data-first-name="<%= staff.first_name || '' %>"
                          data-middle-name="<%= staff.middle_name || '' %>"
                          data-last-name="<%= staff.last_name || '' %>" data-occupation="<%= staff.occupation || '' %>"
                          data-email="<%= staff.email || '' %>" data-contact="<%= staff.contact || '' %>"
                          data-staff-type="<%= staffType %>" data-center-id="<%= staff.assigned_center_id || '' %>"
