<%- include('../partials/header') %>

  <div class="app-main-layout">
    <%- include('../partials/sidebar') %>

      <main class="app-content flex flex-col min-h-screen bg-slate-100/70 relative pb-24 lg:pb-12 overflow-x-hidden">
        
        <!-- Ambient subtle background aura -->
        <div class="absolute top-0 left-0 w-full h-64 bg-gradient-to-b from-blue-900/10 via-slate-900/5 to-transparent pointer-events-none -z-10"></div>

        <div class="w-full px-4 sm:px-6 lg:px-8 py-5 sm:py-6 space-y-5 relative z-10 flex-1">

          <!-- PAGE TOP BAR -->
          <div class="flex items-center justify-between px-1">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-100 text-blue-900 border border-blue-200">
                  System Settings
                </span>
                <span class="text-xs text-slate-400">•</span>
                <span class="text-xs font-semibold text-slate-500 flex items-center gap-1">
                  <i class="ph ph-map-pin text-blue-600"></i> MDRRMO San Rafael HQ
                </span>
              </div>
              <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Admin Settings</h1>
              <p class="text-xs sm:text-sm text-slate-500 font-medium">Manage administrator accounts, credentials, and system configurations.</p>
            </div>

            <!-- Header Action: Add Administrator -->
            <button type="button" onclick="openModal('modalAddAdmin')"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-blue-900 hover:bg-blue-950 text-white text-xs sm:text-sm font-bold shadow-sm transition-all hover:scale-[1.02] active:scale-95 cursor-pointer shrink-0">
              <i class="ph ph-user-plus text-base"></i>
              <span>Add Administrator</span>
            </button>
          </div>

          <!-- FEEDBACK NOTIFICATIONS -->
          <% if (locals.statusMsg) { %>
            <div class="p-3.5 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-2xl shadow-xs flex items-center justify-between gap-3 animate-in fade-in duration-150">
              <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold">
                <i class="ph ph-check-circle text-xl text-emerald-600 shrink-0"></i>
                <span><%= locals.statusMsg %></span>
              </div>
              <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-950 text-base cursor-pointer">
                <i class="ph ph-x"></i>
              </button>
            </div>
          <% } %>

          <% if (locals.errorMsg) { %>
            <div class="p-3.5 bg-red-50 border border-red-200 text-red-900 rounded-2xl shadow-xs flex items-center justify-between gap-3 animate-in fade-in duration-150">
              <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold">
                <i class="ph ph-warning-circle text-xl text-red-600 shrink-0"></i>
                <span><%= locals.errorMsg %></span>
              </div>
              <button onclick="this.parentElement.remove()" class="text-red-700 hover:text-red-950 text-base cursor-pointer">
                <i class="ph ph-x"></i>
              </button>
            </div>
          <% } %>

          <!-- 1. PROFILE HERO HEADER (LIST-STYLE) -->
          <div class="bg-white rounded-3xl p-4 sm:p-5 shadow-xs border border-slate-200/90 relative overflow-hidden">
            
            <!-- Hidden Avatar Upload Form (Submits immediately on change) -->
            <form id="avatarUploadForm" action="/admin/settings" method="POST" enctype="multipart/form-data" class="hidden">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <input type="file" id="photo-upload-input" name="profile_photo" accept="image/*" onchange="previewAndSubmitAvatar(this)" />
            </form>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4 min-w-0">
                
                <!-- Avatar Circle with Camera Overlay -->
                <div class="relative shrink-0 w-16 h-16 sm:w-20 sm:h-20">
                  <div class="w-full h-full rounded-full overflow-hidden bg-slate-100 border-2 border-white shadow-md ring-2 ring-blue-100 flex items-center justify-center relative">
                    <% 
                      let rawProfilePhoto = (user && user.profile_photo) ? user.profile_photo : (locals.profilePhoto ? locals.profilePhoto : null);
                      let profilePhotoSrc = null;
                      if (rawProfilePhoto) {
                        profilePhotoSrc = (rawProfilePhoto.startsWith('http') || rawProfilePhoto.startsWith('/')) ? rawProfilePhoto : `/uploads/profiles/${rawProfilePhoto}`;
                      }
                    %>
                    <% if (profilePhotoSrc) { %>
                      <img loading="lazy" id="profile-avatar-display" src="<%= profilePhotoSrc %>" decoding="async" alt="<%= user.name %>" class="w-full h-full object-cover rounded-full aspect-square block bg-white" onerror="this.style.display='none'; document.getElementById('profile-avatar-fallback').classList.remove('hidden');" />
                      <div id="profile-avatar-fallback" class="w-full h-full rounded-full bg-blue-900 text-white flex items-center justify-center font-black text-xl hidden">
                        <%= (user.name || 'A').charAt(0).toUpperCase() %>
                      </div>
                    <% } else { %>
                      <div class="w-full h-full rounded-full bg-blue-900 text-white flex items-center justify-center font-black text-xl">
                        <%= (user.name || 'A').charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                  </div>
                  
                  <label for="photo-upload-input" title="Upload new photo" class="absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center cursor-pointer shadow-md transition-transform hover:scale-110 border-2 border-white">
                    <i class="ph ph-camera text-xs"></i>
                  </label>
                </div>

                <!-- Admin Details -->
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                    <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight truncate">
                      <%= (user && user.name) ? user.name : 'Administrator' %>
                    </h2>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-purple-50 text-purple-700 border border-purple-200">
                      System Administrator
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Active Session
                    </span>
                  </div>
                  
                  <p class="text-xs text-slate-500 font-medium truncate mb-1">
                    <%= user ? (user.email || 'admin@evakwar.gov.ph') : 'admin@evakwar.gov.ph' %>
                  </p>

                  <div class="flex items-center gap-2 flex-wrap text-[11px] text-slate-500">
                    <span class="inline-flex items-center gap-1 font-semibold text-slate-700">
                      <i class="ph ph-phone text-blue-600"></i>
                      <%= (resident && resident.contact_number && resident.contact_number !== '09000000000') ? resident.contact_number : '0900-000-0000' %>
                    </span>
                    <span>•</span>
                    <span class="inline-flex items-center gap-1 text-slate-500">
                      <i class="ph ph-shield-check text-indigo-600"></i>
                      MDRRMO Municipal Command
                    </span>
                  </div>
                </div>

              </div>

              <!-- Edit Profile CTA -->
              <div class="shrink-0 flex items-center gap-2 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100 justify-end">
                <button type="button" onclick="openModal('modalEditProfile')"
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold transition-all active:scale-95 border border-blue-200 cursor-pointer">
                  <i class="ph ph-pencil-simple text-sm"></i>
                  <span>Edit Profile</span>
                </button>
              </div>

            </div>
          </div>

          <!-- ========================================================================= -->
          <!-- 2. SECTION: ADMINISTRATOR ACCOUNTS (LIST DESIGN)                          -->
          <!-- ========================================================================= -->
          <% const adminList = locals.adminAccounts || []; %>
          <div class="space-y-1.5">
            <div class="flex items-center justify-between px-3">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">
                Administrator Accounts (<%= adminList.length %>)
              </h3>
              <button type="button" onclick="openModal('modalAddAdmin')"
                class="inline-flex items-center gap-1 text-xs font-bold text-blue-900 hover:text-blue-950 transition-colors cursor-pointer">
                <i class="ph ph-plus-circle text-sm"></i> Add New Admin
              </button>
            </div>
            
            <div class="bg-white rounded-3xl shadow-xs border border-slate-200/90 overflow-hidden divide-y divide-slate-100">
              <% if (adminList.length === 0) { %>
                <div class="p-6 text-center text-xs text-slate-400">
                  No administrator accounts found.
                </div>
              <% } else { %>
                <% adminList.forEach(function(adm) {
                  const admPhoto = adm.profile_photo
                    ? ((adm.profile_photo.startsWith('http') || adm.profile_photo.startsWith('/')) ? adm.profile_photo : '/uploads/profiles/' + adm.profile_photo)
                    : null;
                  const admInitial = (adm.name || adm.email || 'A').charAt(0).toUpperCase();
                %>
                  <div class="px-4 sm:px-5 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50/70 transition-colors">
                    
                    <!-- Admin Avatar & Meta Info -->
                    <div class="flex items-center gap-3.5 min-w-0">
                      <div class="relative shrink-0">
                        <% if (admPhoto) { %>
                          <img src="<%= admPhoto %>" alt="<%= adm.name %>"
                            class="w-10 h-10 rounded-2xl object-cover border border-slate-200 bg-slate-100" />
                        <% } else { %>
                          <div class="w-10 h-10 rounded-2xl bg-blue-900 text-white font-bold text-sm flex items-center justify-center border border-blue-950">
                            <%= admInitial %>
                          </div>
                        <% } %>
                        <span title="<%= adm.is_online ? 'Active Online' : 'Offline' %>"
                          class="w-2.5 h-2.5 rounded-full border-2 border-white absolute -bottom-0.5 -right-0.5 <%= adm.is_online ? 'bg-emerald-500' : 'bg-slate-300' %>"></span>
                      </div>

                      <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="text-sm font-bold text-slate-900 truncate"><%= adm.name %></span>
                          <% if (adm.is_current_user) { %>
                            <span class="inline-flex items-center gap-1 px-2 py-0.2 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200">
                              <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span> You
                            </span>
                          <% } %>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-slate-400 font-medium truncate mt-0.5">
                          <span class="truncate"><%= adm.email %></span>
                          <% if (adm.contact_number && adm.contact_number !== '09000000000') { %>
                            <span>•</span>
                            <span><%= adm.contact_number %></span>
                          <% } %>
                        </div>
                      </div>
                    </div>

                    <!-- Role Badge & Action -->
                    <div class="flex items-center justify-between sm:justify-end gap-3 pl-13 sm:pl-0 shrink-0">
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg text-[11px] font-bold bg-purple-50 text-purple-700 border border-purple-200">
                        <i class="ph ph-shield-star text-xs"></i> Admin
                      </span>

                      <% if (!adm.is_current_user && adminList.length > 1) { %>
                        <form action="/admin/admins/delete/<%= adm.id %>" method="POST" class="inline"
                          onsubmit="return confirm('Remove administrator access for <%= adm.name.replace(/'/g, '') %>?');">
                          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
                          <button type="submit"
                            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 transition-colors cursor-pointer"
                            title="Remove Administrator">
                            <i class="ph ph-trash text-sm"></i> Remove
                          </button>
                        </form>
                      <% } else if (adm.is_current_user) { %>
                        <span class="text-xs font-semibold text-slate-400 px-2 select-none">Current Session</span>
                      <% } else { %>
                        <span class="text-xs font-semibold text-slate-400 px-2 select-none">Primary Admin</span>
                      <% } %>
                    </div>

                  </div>
                <% }); %>
              <% } %>
            </div>
          </div>

          <!-- ========================================================================= -->
          <!-- 3. SECTION: ACCOUNT & PROFILE SETTINGS                                   -->
          <!-- ========================================================================= -->
          <div class="space-y-1.5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 px-3">Account & Profile</h3>
            
            <div class="bg-white rounded-3xl shadow-xs border border-slate-200/90 overflow-hidden divide-y divide-slate-100">
              
              <!-- Manage Profile / Legal Name -->
              <button type="button" onclick="openModal('modalEditProfile')" class="w-full px-4 sm:px-5 py-3.5 flex items-center justify-between text-left hover:bg-slate-50 transition-colors group cursor-pointer">
                <div class="flex items-center gap-3.5 min-w-0">
                  <div class="w-9 h-9 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
                    <i class="ph ph-user-circle"></i>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-bold text-slate-800">Manage Profile Details</div>
                    <div class="text-xs text-slate-400 truncate">
                      <%= (resident && resident.first_name) ? (resident.first_name + ' ' + (resident.last_name || '')) : (user.name || 'Not set') %>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-1.5 text-xs font-bold text-blue-600">
                  <span>Edit</span>
                  <i class="ph ph-caret-right text-slate-400 group-hover:text-slate-700 text-base transition-transform group-hover:translate-x-0.5"></i>
                </div>
              </button>

              <!-- Mobile Contact Number -->
              <button type="button" onclick="openModal('modalEditProfile')" class="w-full px-4 sm:px-5 py-3.5 flex items-center justify-between text-left hover:bg-slate-50 transition-colors group cursor-pointer">
                <div class="flex items-center gap-3.5 min-w-0">
                  <div class="w-9 h-9 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
                    <i class="ph ph-phone"></i>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-bold text-slate-800">Mobile Contact Number</div>
                    <div class="text-xs text-slate-400 truncate">
                      <%= (resident && resident.contact_number && resident.contact_number !== '09000000000') ? resident.contact_number : '09000000000' %>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-1.5 text-xs font-bold text-blue-600">
                  <span>Edit</span>
                  <i class="ph ph-caret-right text-slate-400 group-hover:text-slate-700 text-base transition-transform group-hover:translate-x-0.5"></i>
                </div>
              </button>

              <!-- Email Address -->
              <button type="button" onclick="openModal('modalEditProfile')" class="w-full px-4 sm:px-5 py-3.5 flex items-center justify-between text-left hover:bg-slate-50 transition-colors group cursor-pointer">
                <div class="flex items-center gap-3.5 min-w-0">
                  <div class="w-9 h-9 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
                    <i class="ph ph-envelope-simple"></i>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-bold text-slate-800">Email Address</div>
                    <div class="text-xs text-slate-400 truncate">
                      <%= user ? (user.email || 'admin@evakwar.gov.ph') : 'admin@evakwar.gov.ph' %>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-1.5 text-xs font-bold text-blue-600">
                  <span>Edit</span>
                  <i class="ph ph-caret-right text-slate-400 group-hover:text-slate-700 text-base transition-transform group-hover:translate-x-0.5"></i>
                </div>
              </button>

              <!-- System Role & Jurisdiction -->
              <div class="w-full px-4 sm:px-5 py-3.5 flex items-center justify-between text-left">
                <div class="flex items-center gap-3.5 min-w-0">
                  <div class="w-9 h-9 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg shrink-0">
                    <i class="ph ph-identification-badge"></i>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-bold text-slate-800">System Role & Jurisdiction</div>
                    <div class="text-xs text-slate-400 truncate">Full MDRRMO Command Center Access • Barangay San Rafael</div>
                  </div>
                </div>
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200 shrink-0">
                  Administrator
                </span>
              </div>

            </div>
          </div>

          <!-- ========================================================================= -->
          <!-- 4. SECTION: SECURITY & CREDENTIALS                                       -->
          <!-- ========================================================================= -->
          <div class="space-y-1.5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 px-3">Security & Credentials</h3>
            
            <div class="bg-white rounded-3xl shadow-xs border border-slate-200/90 overflow-hidden divide-y divide-slate-100">
              
              <!-- Change Password -->
              <button type="button" onclick="openModal('modalChangePassword')" class="w-full px-4 sm:px-5 py-3.5 flex items-center justify-between text-left hover:bg-slate-50 transition-colors group cursor-pointer">
                <div class="flex items-center gap-3.5 min-w-0">
                  <div class="w-9 h-9 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
                    <i class="ph ph-lock-key"></i>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-bold text-slate-800">Change Password</div>
                    <div class="text-xs text-slate-400 truncate">Update your administrative login password regularly</div>
                  </div>
                </div>
                <div class="flex items-center gap-1.5 text-xs font-bold text-orange-600">
                  <span>Update</span>
                  <i class="ph ph-caret-right text-slate-400 group-hover:text-slate-700 text-base transition-transform group-hover:translate-x-0.5"></i>
                </div>
              </button>

              <!-- Session Protection -->
              <div class="w-full px-4 sm:px-5 py-3.5 flex items-center justify-between text-left">
                <div class="flex items-center gap-3.5 min-w-0">
                  <div class="w-9 h-9 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg shrink-0">
                    <i class="ph ph-shield-check"></i>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-bold text-slate-800">Session Security</div>
                    <div class="text-xs text-slate-400 truncate">CSRF token protection & secure HTTP session enabled</div>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active & Secure
                </span>
              </div>

              <!-- Sign Out -->
              <a href="/logout" class="w-full px-4 sm:px-5 py-3.5 flex items-center justify-between text-left hover:bg-red-50/50 transition-colors group">
                <div class="flex items-center gap-3.5 min-w-0">
                  <div class="w-9 h-9 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
                    <i class="ph ph-sign-out"></i>
                  </div>
                  <div class="min-w-0">
                    <div class="text-sm font-bold text-red-600">Sign Out</div>
                    <div class="text-xs text-red-400 truncate">End administrative session on this computer</div>
                  </div>
                </div>
                <i class="ph ph-arrow-right text-red-400 group-hover:text-red-600 text-lg transition-transform group-hover:translate-x-0.5"></i>
              </a>

            </div>
          </div>

        </div>
        <%- include('../partials/footer-visible') %>
      </main>
  </div>

  <!-- ========================================================================= -->
  <!-- TOP-ALIGNED CLEAN MODALS (RESIDENT SETTINGS PATTERN)                      -->
  <!-- ========================================================================= -->

  <!-- 1. ADD NEW ADMINISTRATOR MODAL -->
  <div id="modalAddAdmin" class="fixed inset-0 z-[120] hidden bg-slate-900/60 backdrop-blur-xs flex flex-col items-center justify-start overflow-y-auto p-3 sm:p-6 pt-4 sm:pt-8 pb-32 sm:pb-12"
    onclick="if (event.target === this) closeModal('modalAddAdmin');">
    <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl border border-slate-200 overflow-hidden my-auto animate-in fade-in zoom-in-95 duration-150">
      
      <!-- Modal Header -->
      <div class="px-5 py-4 bg-white border-b border-slate-100 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-base">
            <i class="ph ph-user-plus"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-sm sm:text-base leading-tight text-slate-900">Add New Administrator</h3>
            <p class="text-[10px] text-slate-400">Create an authorized account with full Command Center access</p>
          </div>
        </div>
        <button type="button" onclick="closeModal('modalAddAdmin')"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors cursor-pointer">
          <i class="ph ph-x text-base"></i>
        </button>
      </div>

      <!-- Modal Body Form -->
      <form id="formAddAdmin" action="/admin/admins/create" method="POST" class="p-5 space-y-4 text-xs font-bold text-slate-700">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block uppercase text-[10px] text-slate-400 mb-1">First Name *</label>
            <input type="text" id="add_first_name" name="first_name" required maxlength="60"
              class="form-control w-full text-xs font-semibold" placeholder="e.g. Juan" />
          </div>
          <div>
            <label class="block uppercase text-[10px] text-slate-400 mb-1">Last Name *</label>
            <input type="text" name="last_name" required maxlength="60"
              class="form-control w-full text-xs font-semibold" placeholder="e.g. Dela Cruz" />
          </div>
        </div>

        <div>
          <label class="block uppercase text-[10px] text-slate-400 mb-1">Email Address *</label>
          <input type="email" name="email" required maxlength="120"
            class="form-control w-full text-xs font-semibold" placeholder="admin@evakwar.ph" />
        </div>

        <div>
          <label class="block uppercase text-[10px] text-slate-400 mb-1">Mobile Number (Optional)</label>
          <input type="tel" id="add_admin_phone" name="contact_number" maxlength="11" inputmode="numeric"
            class="form-control w-full text-xs font-semibold" placeholder="09XXXXXXXXX" />
        </div>

        <div>
          <label class="block uppercase text-[10px] text-slate-400 mb-1">Temporary Password *</label>
          <div class="relative">
            <input type="password" id="add_admin_password" name="password" required minlength="8"
              class="form-control w-full text-xs font-semibold pr-10" placeholder="Min. 8 chars (letters & numbers)" />
            <button type="button" onclick="togglePassVisibility('add_admin_password', 'add_pass_icon')"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 cursor-pointer">
              <i id="add_pass_icon" class="ph ph-eye text-base"></i>
            </button>
          </div>
          <p class="text-[10px] text-slate-400 mt-1 font-normal">Must be at least 8 characters and include both letters and numbers.</p>
        </div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
          <button type="button" onclick="closeModal('modalAddAdmin')"
            class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="px-5 py-2 rounded-xl bg-blue-900 hover:bg-blue-950 text-white font-bold text-xs shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-check-circle"></i> Create Administrator
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 2. EDIT PROFILE MODAL -->
  <div id="modalEditProfile" class="fixed inset-0 z-[120] hidden bg-slate-900/60 backdrop-blur-xs flex flex-col items-center justify-start overflow-y-auto p-3 sm:p-6 pt-4 sm:pt-8 pb-32 sm:pb-12"
    onclick="if (event.target === this) closeModal('modalEditProfile');">
    <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl border border-slate-200 overflow-hidden my-auto animate-in fade-in zoom-in-95 duration-150">
      
      <!-- Modal Header -->
      <div class="px-5 py-4 bg-white border-b border-slate-100 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-base">
            <i class="ph ph-user-circle"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-sm sm:text-base leading-tight text-slate-900">Manage Administrator Profile</h3>
            <p class="text-[10px] text-slate-400">Update your operational name, email, and mobile contact</p>
          </div>
        </div>
        <button type="button" onclick="closeModal('modalEditProfile')"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors cursor-pointer">
          <i class="ph ph-x text-base"></i>
        </button>
      </div>

      <!-- Modal Body Form -->
      <form id="formEditProfile" action="/admin/settings" method="POST" class="p-5 space-y-4 text-xs font-bold text-slate-700">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block uppercase text-[10px] text-slate-400 mb-1">First Name *</label>
            <input type="text" name="first_name" required maxlength="60"
              class="form-control w-full text-xs font-semibold"
              value="<%= (resident && resident.first_name && resident.first_name !== 'Super' && resident.first_name !== 'Administrator') ? resident.first_name : '' %>"
              placeholder="e.g. Juan" />
          </div>
          <div>
            <label class="block uppercase text-[10px] text-slate-400 mb-1">Last Name *</label>
            <input type="text" name="last_name" required maxlength="60"
              class="form-control w-full text-xs font-semibold"
              value="<%= (resident && resident.last_name && resident.last_name !== 'Admin' && resident.last_name !== 'Administrator') ? resident.last_name : '' %>"
              placeholder="e.g. Dela Cruz" />
          </div>
        </div>

        <div>
          <label class="block uppercase text-[10px] text-slate-400 mb-1">Mobile Contact Number</label>
          <input type="tel" id="edit_admin_contact" name="contact_number" maxlength="11" pattern="09[0-9]{9}" inputmode="numeric"
            class="form-control w-full text-xs font-semibold"
            value="<%= (resident && resident.contact_number && resident.contact_number !== '09000000000') ? resident.contact_number : '' %>"
            placeholder="09XXXXXXXXX" title="11-digit Philippine mobile number starting with 09" />
        </div>

        <div>
          <label class="block uppercase text-[10px] text-slate-400 mb-1">Email Address *</label>
          <input type="email" name="email" required maxlength="120"
            class="form-control w-full text-xs font-semibold"
            value="<%= user ? (user.email || 'admin@evakwar.gov.ph') : 'admin@evakwar.gov.ph' %>" />
        </div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
          <button type="button" onclick="closeModal('modalEditProfile')"
            class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="px-5 py-2 rounded-xl bg-blue-900 hover:bg-blue-950 text-white font-bold text-xs shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-floppy-disk"></i> Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 3. CHANGE PASSWORD MODAL -->
  <div id="modalChangePassword" class="fixed inset-0 z-[120] hidden bg-slate-900/60 backdrop-blur-xs flex flex-col items-center justify-start overflow-y-auto p-3 sm:p-6 pt-4 sm:pt-8 pb-32 sm:pb-12"
    onclick="if (event.target === this) closeModal('modalChangePassword');">
    <div class="bg-white w-full max-w-md rounded-3xl shadow-2xl border border-slate-200 overflow-hidden my-auto animate-in fade-in zoom-in-95 duration-150">
      
      <!-- Modal Header -->
      <div class="px-5 py-4 bg-white border-b border-slate-100 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-base">
            <i class="ph ph-lock-key"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-sm sm:text-base leading-tight text-slate-900">Change Password</h3>
            <p class="text-[10px] text-slate-400">Update your administrative credentials securely</p>
          </div>
        </div>
        <button type="button" onclick="closeModal('modalChangePassword')"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors cursor-pointer">
          <i class="ph ph-x text-base"></i>
        </button>
      </div>

      <!-- Modal Body Form -->
      <form id="formChangePassword" action="/admin/settings" method="POST" class="p-5 space-y-4 text-xs font-bold text-slate-700">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />

        <div>
          <label class="block uppercase text-[10px] text-slate-400 mb-1">Current Password *</label>
          <div class="relative">
            <input type="password" id="current_pass_input" name="current_password" required
              class="form-control w-full text-xs font-semibold pr-10" placeholder="••••••••" />
            <button type="button" onclick="togglePassVisibility('current_pass_input', 'current_pass_icon')"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 cursor-pointer">
              <i id="current_pass_icon" class="ph ph-eye text-base"></i>
            </button>
          </div>
        </div>

        <div>
          <label class="block uppercase text-[10px] text-slate-400 mb-1">New Password *</label>
          <div class="relative">
            <input type="password" id="new_pass_input" name="new_password" required minlength="8"
              class="form-control w-full text-xs font-semibold pr-10" placeholder="Min. 8 chars (letters & numbers)" />
            <button type="button" onclick="togglePassVisibility('new_pass_input', 'new_pass_icon')"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 cursor-pointer">
              <i id="new_pass_icon" class="ph ph-eye text-base"></i>
            </button>
          </div>
        </div>

        <div>
          <label class="block uppercase text-[10px] text-slate-400 mb-1">Confirm New Password *</label>
          <div class="relative">
            <input type="password" id="confirm_pass_input" name="confirm_password" required minlength="8"
              class="form-control w-full text-xs font-semibold pr-10" placeholder="Repeat new password" />
            <button type="button" onclick="togglePassVisibility('confirm_pass_input', 'confirm_pass_icon')"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 cursor-pointer">
              <i id="confirm_pass_icon" class="ph ph-eye text-base"></i>
            </button>
          </div>
        </div>

        <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200/80 text-[11px] text-slate-500 font-normal space-y-0.5">
          <p class="font-bold text-slate-700">Password Requirements:</p>
          <p>• At least 8 characters long</p>
          <p>• Contains both letters and numbers</p>
        </div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
          <button type="button" onclick="closeModal('modalChangePassword')"
            class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="px-5 py-2 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-xs shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-key"></i> Update Password
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- SCRIPT LOGIC (MODALS, AVATAR, & VALIDATION) -->
  <script>
    // Central Modal Opener & Closer (Resident Settings Pattern)
    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        if (id === 'modalAddAdmin') {
          setTimeout(() => document.getElementById('add_first_name')?.focus(), 60);
        }
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
      }
    }

    // Toggle Password Visibility
    function togglePassVisibility(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (!input || !icon) return;
      const isPass = input.type === 'password';
      input.type = isPass ? 'text' : 'password';
      icon.className = isPass ? 'ph ph-eye-slash text-base' : 'ph ph-eye text-base';
    }

    // Instant Avatar Upload & Submit (Resident Settings Pattern)
    function previewAndSubmitAvatar(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        if (!file.type.startsWith('image/')) {
          alert('Please select a valid image file.');
          input.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          alert('Image file size must be less than 10MB.');
          input.value = '';
          return;
        }
        const form = document.getElementById('avatarUploadForm');
        if (form) form.submit();
      }
    }

    // Keyboard Shortcuts (Escape closes modals)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        ['modalAddAdmin', 'modalEditProfile', 'modalChangePassword'].forEach(id => closeModal(id));
      }
    });

    // Form Validations
    document.addEventListener('DOMContentLoaded', () => {
      // Add Admin Form
      const formAdd = document.getElementById('formAddAdmin');
      if (formAdd) {
        formAdd.addEventListener('submit', function (e) {
          const phone = (document.getElementById('add_admin_phone')?.value || '').trim();
          if (phone && !/^09\d{9}$/.test(phone)) {
            e.preventDefault();
            alert('Please enter a valid 11-digit Philippine mobile number starting with 09 (e.g., 09123456789).');
            document.getElementById('add_admin_phone')?.focus();
            return false;
          }

          const pass = (document.getElementById('add_admin_password')?.value || '').trim();
          if (pass.length < 8 || !/[a-zA-Z]/.test(pass) || !/[0-9]/.test(pass)) {
            e.preventDefault();
            alert('Password must be at least 8 characters long and contain both letters and numbers.');
            document.getElementById('add_admin_password')?.focus();
            return false;
          }

          const submitBtn = formAdd.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="ph ph-spinner animate-spin"></i> Creating...';
          }
        });
      }

      // Edit Profile Form
      const formEdit = document.getElementById('formEditProfile');
      if (formEdit) {
        formEdit.addEventListener('submit', function (e) {
          const contact = (document.getElementById('edit_admin_contact')?.value || '').trim();
          if (contact && !/^09\d{9}$/.test(contact)) {
            e.preventDefault();
            alert('Please enter a valid 11-digit Philippine mobile number starting with 09 (e.g., 09123456789).');
            document.getElementById('edit_admin_contact')?.focus();
            return false;
          }
          const submitBtn = formEdit.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="ph ph-spinner animate-spin"></i> Saving...';
          }
        });
      }

      // Change Password Form
      const formPass = document.getElementById('formChangePassword');
      if (formPass) {
        formPass.addEventListener('submit', function (e) {
          const newPass = (document.getElementById('new_pass_input')?.value || '').trim();
          const confPass = (document.getElementById('confirm_pass_input')?.value || '').trim();

          if (newPass.length < 8 || !/[a-zA-Z]/.test(newPass) || !/[0-9]/.test(newPass)) {
            e.preventDefault();
            alert('Password must be at least 8 characters long and contain both letters and numbers.');
            document.getElementById('new_pass_input')?.focus();
            return false;
          }

          if (newPass !== confPass) {
            e.preventDefault();
            alert('New password and confirmation password do not match.');
            document.getElementById('confirm_pass_input')?.focus();
            return false;
          }

          const submitBtn = formPass.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="ph ph-spinner animate-spin"></i> Updating...';
          }
        });
      }
    });
  </script>

  <%- include('../partials/footer') %>
