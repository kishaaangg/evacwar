<%- include('../partials/header') %>
  <% const nonEvacuatedReports=locals.nonEvacuatedReports || { totalNotEvacuatedHouseholds: 0,
    totalNotEvacuatedIndividuals: 0, totalVulnerableCount: 0, topZone: 'None' , topZoneCount: 0,
    activeEventName: 'Active Evacuation Advisory' , availableEvents: [], list: [] }; %>

    <style>
      @media print {
        @page {
          size: A4 portrait;
          margin: 8mm 10mm;
        }

        * {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
          box-sizing: border-box !important;
        }

        header,
        nav,
        .app-sidebar,
        .no-print,
        button,
        footer,
        .report-toolbar {
          display: none !important;
        }

        html,
        body {
          height: auto !important;
          min-height: auto !important;
          overflow: visible !important;
          background: #ffffff !important;
          color: #0f172a !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
        }

        .app-main-layout,
        .app-content,
        main {
          display: block !important;
          position: static !important;
          min-height: auto !important;
          height: auto !important;
          overflow: visible !important;
          background: #ffffff !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }

        .max-w-7xl {
          max-width: 100% !important;
          padding: 0 !important;
          margin: 0 auto !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }

        /* Isolate visible tab and hide inactive tabs */
        .report-tab-content.hidden {
          display: none !important;
        }

        body.printing-ec-board .report-tab-content:not(#tab-evacuation) {
          display: none !important;
        }

        #tab-evacuation {
          padding: 0 !important;
          margin: 0 !important;
          width: 100% !important;
        }

        /* Specific printable sections with SAFE INNER PADDING so sides & top are NEVER cut off */
        #printable-ec-board-report,
        body.printing-ec-board #printable-ec-board-report,
        #tab-evacuation:not(.hidden) #printable-ec-board-report {
          display: block !important;
          width: 100% !important;
          max-width: 100% !important;
          box-sizing: border-box !important;
          margin: 0 auto !important;
          padding: 10mm 14mm 10mm 14mm !important;
          /* 14mm side padding, 10mm top/bottom padding */
          background: #ffffff !important;
          color: #000000 !important;
          box-shadow: none !important;
          border: none !important;
          page-break-inside: auto;
        }

        .print-header {
          display: block !important;
          padding-top: 2mm !important;
          margin-top: 0 !important;
          margin-bottom: 8px !important;
          border-bottom: 2px solid #0f172a !important;
          padding-bottom: 5px !important;
          page-break-after: avoid;
          break-after: avoid;
        }

        .print-header h2 {
          margin: 0 !important;
          padding: 0 !important;
          line-height: 1.25 !important;
          font-size: 14pt !important;
          font-weight: 900 !important;
          color: #0f172a !important;
        }

        .print-header p {
          margin: 2px 0 0 0 !important;
          padding: 0 !important;
          font-size: 8pt !important;
          color: #475569 !important;
        }

        .print-table {
          width: 100% !important;
          max-width: 100% !important;
          border-collapse: collapse !important;
          margin-top: 5px !important;
          margin-bottom: 5px !important;
          table-layout: auto !important;
          box-sizing: border-box !important;
        }

        .print-table th,
        .print-table td {
          border: 1px solid #475569 !important;
          padding: 3px 6px !important;
          font-size: 8pt !important;
          line-height: 1.2 !important;
          color: #000000 !important;
        }

        .print-table th {
          background-color: #f1f5f9 !important;
          font-weight: 700 !important;
        }

        .print-table tr {
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }

        .grid {
          box-sizing: border-box !important;
          width: 100% !important;
        }

        .rounded-xl,
        .rounded-2xl,
        .rounded {
          border-radius: 4px !important;
        }

        .print-footer {
          border-top: 1px solid #94a3b8 !important;
          margin-top: 10px !important;
          padding-top: 6px !important;
          font-size: 7.5pt !important;
          text-align: center !important;
          color: #475569 !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }
      }

      /* Clean layout formatting for direct PDF download generator (Single Page Portrait) */
      .pdf-export-clone {
        font-family: 'Open Sans', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
        background: #ffffff !important;
        color: #0f172a !important;
        line-height: 1.25 !important;
        font-size: 11px !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        outline: none !important;
      }

      .pdf-export-clone#printable-ec-board-report,
      .pdf-export-clone#printable-non-evac-report,
      .pdf-export-clone.rounded-2xl,
      .pdf-export-clone.border,
      .pdf-export-clone.shadow-2xs {
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        outline: none !important;
      }

      .pdf-export-clone .no-print,
      .pdf-export-clone button,
      .pdf-export-clone input,
      .pdf-export-clone select,
      .pdf-export-clone .report-toolbar {
        display: none !important;
      }

      .pdf-export-clone .print-header {
        display: block !important;
        margin-bottom: 10px !important;
        padding-bottom: 6px !important;
        border-bottom: 2.5px solid #0f172a !important;
      }

      .pdf-export-clone .print-header h2 {
        font-size: 22px !important;
        font-weight: 900 !important;
        color: #0f172a !important;
        line-height: 1.2 !important;
        margin: 0 0 3px 0 !important;
        text-transform: uppercase !important;
      }

      .pdf-export-clone .print-header p {
        font-size: 11px !important;
        font-weight: 700 !important;
        color: #475569 !important;
        margin: 0 !important;
      }

      /* EC Board Summary Cards (Square & Bigger) */
      .pdf-export-clone .ec-summary-grid {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 10px !important;
        margin-bottom: 12px !important;
      }

      .pdf-export-clone .ec-summary-card {
        padding: 16px 8px !important;
        min-height: 112px !important;
        height: 112px !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        box-sizing: border-box !important;
        border-radius: 8px !important;
        border-width: 1.5px !important;
      }

      .pdf-export-clone .ec-summary-card div:first-child {
        font-size: 10px !important;
        font-weight: 800 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.3px !important;
        margin-bottom: 6px !important;
      }

      .pdf-export-clone .ec-summary-card div:last-child {
        font-size: 28px !important;
        font-weight: 900 !important;
        line-height: 1 !important;
      }

      .pdf-export-clone .ec-summary-card.ratio-card div:last-child {
        font-size: 17px !important;
        line-height: 1.1 !important;
      }

      .pdf-export-clone .member-drawer-content,
      .pdf-export-clone .hh-member-drawer {
        display: none !important;
      }

      .pdf-export-clone table {
        width: 100% !important;
        border-collapse: collapse !important;
        margin-top: 3px !important;
        margin-bottom: 4px !important;
      }

      .pdf-export-clone th,
      .pdf-export-clone td {
        padding: 3px 6px !important;
        font-size: 9.5px !important;
        line-height: 1.2 !important;
      }

      .pdf-export-clone h1 {
        font-size: 16px !important;
        margin: 0 !important;
      }

      .pdf-export-clone h3 {
        font-size: 11px !important;
        margin-top: 5px !important;
        margin-bottom: 3px !important;
      }

      .pdf-export-clone .p-5,
      .pdf-export-clone .p-4,
      .pdf-export-clone [class*="p-3.5"],
      .pdf-export-clone .p-3:not(.ec-summary-card) {
        padding: 6px 8px !important;
      }

      .pdf-export-clone .space-y-5>*+*,
      .pdf-export-clone .space-y-4>*+* {
        margin-top: 6px !important;
      }

      .pdf-export-clone .gap-3:not(.ec-summary-grid),
      .pdf-export-clone .gap-2 {
        gap: 6px !important;
      }

      .pdf-export-clone .rounded-2xl:not(#printable-ec-board-report):not(#printable-non-evac-report),
      .pdf-export-clone .rounded-xl:not(#printable-ec-board-report):not(#printable-non-evac-report) {
        border-radius: 6px !important;
      }
    </style>

    <div class="app-main-layout">
      <%- include('../partials/sidebar') %>

        <main class="app-content flex flex-col min-h-screen bg-slate-50 relative pb-24 lg:pb-8 overflow-x-hidden">
          <div class="max-w-7xl mx-auto space-y-4 flex-1 w-full p-3 sm:p-4 lg:p-5">

            <!-- 1. CLEAN PAGE HEADER -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 no-print pt-1 pb-1">
              <div>
                <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight leading-tight">
                  Command Reports & Operations System
                </h1>
                <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">
                  Real-time disaster management telemetry, evacuation center logistics, and resident emergency rosters.
                </p>
              </div>

            </div>

            <!-- 2. NAVIGATION TABS (5 BALANCED & CENTERED SECTIONS) -->
            <div class="bg-white p-1.5 sm:p-2 rounded-2xl border border-slate-200/90 shadow-2xs no-print">
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 w-full">
                <% const activeTab=(filters.tab==='non-evacuated' ? 'evacuation' : (filters.tab || 'overview' )); %>

                  <!-- 1. Overview -->
                  <button type="button" onclick="switchTab('overview')" data-tab="overview"
                    class="report-tab-btn w-full px-2 sm:px-3 py-2.5 rounded-xl text-xs sm:text-[13px] font-bold transition-all flex items-center justify-center gap-1.5 sm:gap-2 text-center <%= activeTab === 'overview' ? 'bg-blue-600 text-white shadow-sm ring-2 ring-blue-600/20' : 'text-slate-700 hover:text-slate-950 bg-slate-50 hover:bg-slate-100 border border-slate-200/80' %>">
                    <i class="ph ph-gauge text-base shrink-0"></i>
                    <span class="truncate">Overview</span>
                  </button>

                  <!-- 2. Evacuation & EC Board -->
                  <button type="button" onclick="switchTab('evacuation')" data-tab="evacuation"
                    class="report-tab-btn w-full px-2 sm:px-3 py-2.5 rounded-xl text-xs sm:text-[13px] font-bold transition-all flex items-center justify-center gap-1.5 sm:gap-2 text-center <%= activeTab === 'evacuation' ? 'bg-blue-600 text-white shadow-sm ring-2 ring-blue-600/20' : 'text-slate-700 hover:text-slate-950 bg-slate-50 hover:bg-slate-100 border border-slate-200/80' %>">
                    <i class="ph ph-buildings text-base shrink-0"></i>
                    <span class="truncate">Evacuation & EC</span>
                  </button>

                  <!-- 3. Household Reports -->
                  <button type="button" onclick="switchTab('households')" data-tab="households"
                    class="report-tab-btn w-full px-2 sm:px-3 py-2.5 rounded-xl text-xs sm:text-[13px] font-bold transition-all flex items-center justify-center gap-1.5 sm:gap-2 text-center <%= (activeTab === 'households' || activeTab === 'residents') ? 'bg-blue-600 text-white shadow-sm ring-2 ring-blue-600/20' : 'text-slate-700 hover:text-slate-950 bg-slate-50 hover:bg-slate-100 border border-slate-200/80' %>">
                    <i class="ph ph-house text-base shrink-0"></i>
                    <span class="truncate">Household Reports</span>
                  </button>

                  <!-- 4. SOS / Rescue -->
                  <button type="button" onclick="switchTab('sos')" data-tab="sos"
                    class="report-tab-btn w-full px-2 sm:px-3 py-2.5 rounded-xl text-xs sm:text-[13px] font-bold transition-all flex items-center justify-center gap-1.5 sm:gap-2 text-center <%= activeTab === 'sos' ? 'bg-blue-600 text-white shadow-sm ring-2 ring-blue-600/20' : 'text-slate-700 hover:text-slate-950 bg-slate-50 hover:bg-slate-100 border border-slate-200/80' %>">
                    <i class="ph ph-siren text-base text-red-600 shrink-0"></i>
                    <span class="truncate">SOS / Rescue</span>
                    <% if (overview.activeSos> 0) { %>
                      <span id="tabBadgeSos"
                        class="px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] sm:text-[11px] font-black transition-colors <%= activeTab === 'sos' ? 'bg-white text-rose-700 shadow-xs' : 'bg-red-100 text-red-800 border border-red-300' %> shrink-0">
                        <%= overview.activeSos %>
                      </span>
                      <% } %>
                  </button>

                  <!-- 5. SMS / Alerts -->
                  <button type="button" onclick="switchTab('sms')" data-tab="sms"
                    class="report-tab-btn w-full px-2 sm:px-3 py-2.5 rounded-xl text-xs sm:text-[13px] font-bold transition-all flex items-center justify-center gap-1.5 sm:gap-2 text-center <%= activeTab === 'sms' ? 'bg-blue-600 text-white shadow-sm ring-2 ring-blue-600/20' : 'text-slate-700 hover:text-slate-950 bg-slate-50 hover:bg-slate-100 border border-slate-200/80' %>">
                    <i class="ph ph-chats-circle text-base text-blue-600 shrink-0"></i>
                    <span class="truncate">SMS / Alerts</span>
                  </button>
              </div>
            </div>

            <!-- SECTION 1: OVERVIEW TAB -->
            <div id="tab-overview" class="report-tab-content <%= activeTab === 'overview' ? '' : 'hidden' %> space-y-4">

              <!-- OVERVIEW STATS (6 CRITICAL METRICS) -->
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 no-print">
                <!-- 1. Total Population / Households -->
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                  <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total Population</div>
                  <div class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                    <%= overview.totalResidents || 0 %>
                  </div>
                  <div class="text-[11px] font-semibold text-blue-600">
                    <%= overview.totalHouseholds || 0 %> Households
                  </div>
                </div>

                <!-- 2. Evacuated -->
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                  <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Evacuated</div>
                  <div class="text-xl sm:text-2xl font-black text-emerald-600 tracking-tight">
                    <%= overview.currentEvacuees || 0 %>
                  </div>
                  <div class="text-[11px] font-semibold text-slate-500">In Shelters</div>
                </div>

                <!-- 3. Not Yet Evacuated -->
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-rose-200/90 shadow-2xs space-y-1">
                  <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Not Yet Evacuated</div>
                  <div class="text-xl sm:text-2xl font-black text-rose-600 tracking-tight">
                    <%= (nonEvacuatedReports && nonEvacuatedReports.totalNotEvacuatedHouseholds) || 0 %>
                  </div>
                  <div class="text-[11px] font-semibold text-rose-700">
                    <%= (nonEvacuatedReports && nonEvacuatedReports.totalNotEvacuatedIndividuals) || 0 %> Persons
                      Pending
                  </div>
                </div>

                <!-- 4. Active SOS -->
                <div
                  class="bg-white p-3.5 sm:p-4 rounded-2xl border <%= overview.activeSos > 0 ? 'border-red-300 bg-red-50/20' : 'border-slate-200/90' %> shadow-2xs space-y-1">
                  <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Active SOS</div>
                  <div
                    class="text-xl sm:text-2xl font-black <%= overview.activeSos > 0 ? 'text-red-600' : 'text-slate-800' %> tracking-tight flex items-center gap-1.5">
                    <%= overview.activeSos || 0 %>
                      <% if (overview.activeSos> 0) { %>
                        <span class="w-2 h-2 rounded-full bg-red-500 animate-ping inline-block"></span>
                        <% } %>
                  </div>
                  <div
                    class="text-[11px] font-semibold <%= overview.activeSos > 0 ? 'text-red-700' : 'text-slate-500' %>">
                    <%= overview.activeSos> 0 ? 'Distress Active' : 'No Distress' %>
                  </div>
                </div>

                <!-- 5. Open Evacuation Centers -->
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                  <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Evac Centers</div>
                  <div class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                    <%= overview.totalCenters || 0 %>
                  </div>
                  <div class="text-[11px] font-semibold text-emerald-600">Operational</div>
                </div>

                <!-- 6. Available Capacity -->
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                  <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Available Capacity</div>
                  <div class="text-xl sm:text-2xl font-black text-emerald-600 tracking-tight">
                    <%= overview.availableSlots || 0 %>
                  </div>
                  <div class="text-[11px] font-semibold text-slate-500">
                    of <%= overview.totalCapacity || 0 %> Slots
                  </div>
                </div>
              </div>

              <!-- NON-EVACUATED ACTION BANNER IN OVERVIEW -->
              <div
                class="bg-white rounded-2xl border border-rose-200 p-4 sm:p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 no-print">
                <div class="flex items-center gap-3">
                  <div
                    class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 border border-rose-200 flex items-center justify-center shrink-0">
                    <i class="ph ph-warning-octagon text-xl"></i>
                  </div>
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="text-xs sm:text-sm font-black text-slate-900 uppercase tracking-wide">
                        Evacuation Priority: <%= (nonEvacuatedReports &&
                          nonEvacuatedReports.totalNotEvacuatedHouseholds) || 0 %> Registered Families Not In Shelter
                      </h4>
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">
                        <%= (nonEvacuatedReports && nonEvacuatedReports.totalNotEvacuatedIndividuals) || 0 %>
                          Individuals
                          at Risk
                      </span>
                    </div>
                    <p class="text-xs text-slate-500 mt-0.5">
                      Reference Event: <span class="font-bold text-slate-700">
                        <%= (nonEvacuatedReports && nonEvacuatedReports.activeEventName) || 'Active Evacuation Advisory'
                          %>
                      </span> &bull; Highest Pending Area: <span class="font-bold text-rose-600">
                        <%= (nonEvacuatedReports && nonEvacuatedReports.topZone) || 'All Zones' %>
                      </span> (<%= (nonEvacuatedReports && nonEvacuatedReports.topZoneCount) || 0 %> households)
                    </p>
                  </div>
                </div>
                <button type="button" onclick="switchTab('evacuation')"
                  class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shrink-0 flex items-center gap-1.5 shadow-2xs transition-colors cursor-pointer">
                  <span>View Evacuation Status</span>
                  <i class="ph ph-arrow-right font-bold"></i>
                </button>
              </div>

              <!-- EVACUATION CENTERS MASTER OVERVIEW TABLE -->
              <div class="bg-white rounded-2xl border border-slate-200/90 shadow-2xs overflow-hidden">
                <div class="p-3.5 sm:p-4 bg-slate-50/70 border-b border-slate-200/80 flex items-center justify-between">
                  <div>
                    <h3 class="font-bold text-slate-900 text-xs sm:text-sm flex items-center gap-2">
                      <i class="ph ph-buildings text-blue-600"></i>
                      <span>Evacuation Centers Capacity & Occupancy Status</span>
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Live occupancy monitoring across all designated
                      municipal
                      evacuation centers.</p>
                  </div>
                  <button type="button" onclick="switchTab('evacuation')"
                    class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1">
                    <span>Open EC Board</span>
                    <i class="ph ph-arrow-right"></i>
                  </button>
                </div>
                <div class="overflow-x-auto">
                  <table class="w-full text-xs text-left">
                    <thead class="bg-slate-100/80 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                      <tr>
                        <th class="p-3">Evacuation Center</th>
                        <th class="p-3 text-center">Max Capacity</th>
                        <th class="p-3 text-center">Occupied</th>
                        <th class="p-3 text-center">Available</th>
                        <th class="p-3 text-center">Families</th>
                        <th class="p-3">Occupancy Rate</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                      <% const centerRows=(allEcBoardStats && allEcBoardStats.center_summaries &&
                        allEcBoardStats.center_summaries.length> 0)
                        ? allEcBoardStats.center_summaries
                        : ((filterOptions && filterOptions.centers && filterOptions.centers.length > 0)
                        ? filterOptions.centers.map(c => ({
                        id: c.id,
                        name: c.name,
                        address: c.address,
                        capacity: c.max_capacity || 0,
                        occupied: c.current_occupancy || 0,
                        available: Math.max(0, (c.max_capacity || 0) - (c.current_occupancy || 0)),
                        families: 0
                        }))
                        : []);
                        %>
                        <% if (centerRows.length> 0) { %>
                          <% centerRows.forEach(c=> { %>
                            <% const pct=c.capacity> 0 ? Math.min(100, Math.round((c.occupied / c.capacity) * 100)) : 0;
                              const barWidthStyle = 'style="width: ' + pct + '%;"';
                              %>
                              <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="p-3 font-bold text-slate-900">
                                  <div>
                                    <%= c.name %>
                                  </div>
                                  <div class="text-[11px] font-normal text-slate-500">
                                    <%= c.address %>
                                  </div>
                                </td>
                                <td class="p-3 text-center font-semibold text-slate-700">
                                  <%= c.capacity %>
                                </td>
                                <td class="p-3 text-center font-bold text-emerald-600">
                                  <%= c.occupied %>
                                </td>
                                <td class="p-3 text-center font-bold text-blue-600">
                                  <%= c.available %>
                                </td>
                                <td class="p-3 text-center font-semibold text-slate-700">
                                  <%= c.families %>
                                </td>
                                <td class="p-3">
                                  <div class="flex items-center gap-2">
                                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden max-w-[120px]">
                                      <div class="bg-blue-600 h-2 rounded-full" <%- barWidthStyle %>></div>
                                    </div>
                                    <span class="font-bold text-xs text-slate-700">
                                      <%= pct %>%
                                    </span>
                                  </div>
                                </td>
                              </tr>
