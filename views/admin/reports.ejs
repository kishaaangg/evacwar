                            <%= activeHouseholdItems.length %> Families In Shelter
                          </span>
                        </div>
                        <p class="text-[11px] text-slate-500 font-medium mt-1 truncate">
                          Shelter roster for: <strong class="text-slate-800">
                            <%= isSingleCenter ? currentStats.center.name : 'All Evacuation Centers Combined' %>
                          </strong>
                        </p>
                      </div>

                      <div class="shrink-0">
                        <% if (isSingleCenter) { %>
                          <a href="/admin/reports?tab=evacuation&centerId=all"
                            class="px-2.5 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-bold flex items-center gap-1 transition-colors shadow-2xs"
                            title="Show All Centers Combined">
                            <i class="ph ph-arrows-out"></i>
                            <span class="hidden sm:inline">Show All</span>
                          </a>
                          <% } %>
                      </div>
                    </div>

                    <!-- Controls / Search Filter (Site selector removed as EC Board has it) -->
                    <div class="p-3 bg-slate-50/70 border-b border-slate-200/80 text-xs">
                      <div class="relative">
                        <i
                          class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="tileEvacSearch" oninput="filterTileEvacuated()"
                          placeholder="Search checked-in families by name, zone, or purok..."
                          class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:ring-1 focus:ring-emerald-200 outline-none transition-all shadow-2xs" />
                      </div>
                    </div>

                    <!-- Scrollable Roster (PER HOUSEHOLD) -->
                    <div
                      class="p-3.5 space-y-2.5 max-h-[620px] overflow-y-auto custom-scrollbar flex-1 divide-y divide-slate-100"
                      id="tileEvacList">
                      <% if (activeHouseholdItems.length> 0) { %>
                        <% activeHouseholdItems.forEach((hh)=> { %>
                          <% const headDisplayName=hh.head_name || hh.name || 'Household Head' ; const
                            memNames=(hh.members || []).map(m=> m.name || `${m.first_name || ''} ${m.last_name ||
                            ''}`.trim() || 'Member');
                            %>
                            <div class="tile-evac-row pt-2.5 first:pt-0"
                              data-name="<%= headDisplayName.toLowerCase() %> <%= memNames.join(' ').toLowerCase() %>"
                              data-center="<%= (hh.center_name || '').toLowerCase() %>"
                              data-zone="<%= (hh.zone || '').toLowerCase() %>"
                              data-address="<%= (hh.home_address || '').toLowerCase() %>">
                              <div
                                class="p-3 rounded-xl bg-white border border-slate-200/80 hover:border-emerald-300 hover:shadow-xs transition-all">
                                <div class="flex items-stretch justify-between gap-3">
                                  <!-- Left Info: Head, Zone, Address, Phone, Vulns, Family Members -->
                                  <div class="min-w-0 flex-1 flex flex-col justify-between space-y-1">
                                    <div>
                                      <div class="flex items-center gap-1.5 flex-wrap">
                                        <span
                                          class="font-black text-slate-900 text-xs sm:text-sm tracking-tight truncate">
                                          <%= headDisplayName %>
                                        </span>
                                        <span
                                          class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                                          <%= hh.zone || 'Zone 1' %>
                                        </span>
                                      </div>
                                      <% if (hh.home_address && hh.zone && hh.home_address.trim().toLowerCase()
                                        !==hh.zone.trim().toLowerCase()) { %>
                                        <div
                                          class="text-[11px] text-slate-500 font-medium flex items-center gap-1 mt-0.5">
                                          <i class="ph ph-map-pin text-emerald-600 shrink-0"></i>
                                          <span class="truncate">
                                            <%= hh.home_address %>
                                          </span>
                                        </div>
                                        <% } %>
                                          <% if (hh.contact_number) { %>
                                            <div
                                              class="text-[11px] text-slate-500 font-medium flex items-center gap-1 mt-0.5">
                                              <i class="ph ph-phone text-slate-400"></i>
                                              <span>
                                                <%= hh.contact_number %>
                                              </span>
                                            </div>
                                            <% } %>

                                              <% const vulnList=(hh.vuln_types && hh.vuln_types.length> 0) ?
                                                hh.vuln_types : (hh.vulnerability_types || []); %>
                                                <% if (vulnList && vulnList.length> 0) { %>
                                                  <div class="flex items-center gap-1 flex-wrap pt-0.5">
                                                    <% vulnList.forEach(v=> { %>
                                                      <span
                                                        class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-50 text-amber-800 border border-amber-200">
                                                        <%= v %>
                                                      </span>
                                                      <% }) %>
                                                  </div>
                                                  <% } %>
                                    </div>

                                    <% if (hh.members && hh.members.length> 0) { %>
                                      <div class="text-[11px] text-slate-600 pt-1 leading-snug">
                                        <span class="font-bold text-slate-700">Family Members:</span>
                                        <span>
                                          <%= hh.members.map(m=> m.name || `${m.first_name || ''} ${m.last_name ||
                                            ''}`.trim() || 'Family Member').join(', ') %>
                                        </span>
                                      </div>
                                      <% } %>
                                  </div>

                                  <!-- Right Info: In Shelter status, Site Name, and Date/Time aligned on bottom with family members -->
                                  <div class="shrink-0 flex flex-col items-end justify-between text-right">
                                    <div class="flex flex-col items-end gap-1">
                                      <span
                                        class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        In Shelter
                                      </span>
                                      <span
                                        class="inline-flex items-center gap-1 font-bold text-teal-700 bg-teal-50 px-2 py-0.5 rounded border border-teal-200/70 text-[10px] max-w-[170px] truncate"
                                        title="<%= hh.center_name %>">
                                        <i class="ph ph-buildings shrink-0"></i>
                                        <span class="truncate">
                                          <%= hh.center_name %>
                                        </span>
                                      </span>
                                    </div>
                                    <div class="pt-1.5 flex items-center justify-end">
                                      <span class="text-[10px] text-slate-500 font-medium flex items-center gap-1">
                                        <i class="ph ph-clock text-slate-400"></i>
                                        <span>
                                          <%= hh.check_in_time ? new Date(hh.check_in_time).toLocaleDateString([],
                                            {month:'short', day:'numeric'}) + ' ' + new
                                            Date(hh.check_in_time).toLocaleTimeString([], {hour:'2-digit',
                                            minute:'2-digit'}) : 'Active' %>
                                        </span>
                                      </span>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                            <% }) %>
                              <% } else { %>
                                <div class="p-8 text-center text-slate-400 font-semibold">
                                  <i class="ph ph-users-three text-slate-300 text-3xl mb-1"></i>
                                  <p class="text-xs text-slate-700 font-bold">No active evacuees checked in.</p>
                                  <p class="text-[11px] text-slate-400">No checked-in families found for the selected
                                    facility.</p>
                                </div>
                                <% } %>
                                  <div id="tileEvacNoResults"
                                    class="hidden p-8 text-center text-slate-400 text-xs font-semibold">
                                    No matching checked-in families found.
                                  </div>
                    </div>
                  </div>

                  <!-- BOTTOM SECTION: NOT EVACUATED RESIDENTS -->
                  <div class="bg-white rounded-2xl border border-rose-200/90 shadow-2xs overflow-hidden flex flex-col">
                    <!-- Header -->
                    <div
                      class="p-4 bg-gradient-to-r from-rose-50/90 via-orange-50/40 to-white border-b border-rose-200/80 flex items-center justify-between gap-3">
                      <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                          <div
                            class="w-8 h-8 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
                            <i class="ph ph-warning-octagon text-lg"></i>
                          </div>
                          <h3 class="font-black text-slate-900 text-sm tracking-tight">
                            Residents Not Evacuated
                          </h3>
                          <span id="notEvacCountBadge"
                            class="px-2 py-0.5 rounded-full text-[11px] font-black bg-rose-600 text-white shrink-0">
                            <%= nonEvacItems.length %> Families
                          </span>
                        </div>
                        <p class="text-[11px] text-slate-500 font-medium mt-1">
                          Registered households not currently checked in to any evacuation center
                        </p>
                      </div>


                    </div>

                    <!-- Controls / Filters -->
                    <div
                      class="p-3 bg-slate-50/70 border-b border-slate-200/80 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                      <div class="relative">
                        <i
                          class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="tileNotEvacSearch" oninput="filterTileNotEvacuated()"
                          placeholder="Search un-evacuated names..."
                          class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-slate-200 rounded-xl focus:border-rose-500 focus:ring-1 focus:ring-rose-200 outline-none transition-all shadow-2xs" />
                      </div>
                      <div>
                        <select id="tileNotEvacZoneFilter" onchange="filterTileNotEvacuated()"
                          class="w-full py-1.5 px-2.5 text-xs bg-white border border-slate-200 rounded-xl focus:border-rose-500 outline-none font-medium text-slate-700 shadow-2xs">
                          <option value="all">All Zones / Locations</option>
                          <% allZonesList.forEach(z=> { %>
                            <option value="<%= z.toLowerCase() %>">
                              <%= z %>
                            </option>
                            <% }) %>
                        </select>
                      </div>
                    </div>

                    <!-- Scrollable Roster -->
                    <div
                      class="p-3.5 space-y-2.5 max-h-[620px] overflow-y-auto custom-scrollbar flex-1 divide-y divide-slate-100"
                      id="tileNotEvacList">
                      <% if (nonEvacItems.length> 0) { %>
                        <% nonEvacItems.forEach((h)=> { %>
                          <% const headDisplayName=h.head_name || h.name || `${h.first_name || '' } ${h.last_name || ''
                            }`.trim() || 'Household Head' ; %>
                            <div class="tile-not-evac-row pt-2.5 first:pt-0"
                              data-name="<%= headDisplayName.toLowerCase() %> <%= ((h.members || []).map(m => (m.first_name + ' ' + m.last_name).toLowerCase())).join(' ') %>"
                              data-zone="<%= (h.zone || '').toLowerCase() %>"
                              data-address="<%= (h.home_address || '').toLowerCase() %>">
                              <div
                                class="p-3 rounded-xl bg-white border border-slate-200/80 hover:border-rose-300 hover:shadow-xs transition-all space-y-2">
                                <div class="flex items-start justify-between gap-2">
                                  <div class="min-w-0">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                      <span
                                        class="font-black text-slate-900 text-xs sm:text-sm tracking-tight truncate">
                                        <%= headDisplayName %>
                                      </span>
                                      <span
                                        class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-slate-100 text-slate-700 border border-slate-200 shrink-0">
                                        <%= h.zone || 'Zone 1' %>
                                      </span>
                                    </div>
                                    <% if (h.home_address && h.zone && h.home_address.trim().toLowerCase()
                                      !==h.zone.trim().toLowerCase()) { %>
                                      <div
                                        class="text-[11px] text-slate-500 font-medium flex items-center gap-1 mt-0.5">
                                        <i class="ph ph-map-pin text-rose-500 shrink-0"></i>
                                        <span class="truncate">
                                          <%= h.home_address %>
                                        </span>
                                      </div>
                                      <% } %>
                                        <% if (h.contact_number) { %>
                                          <div
                                            class="text-[11px] text-slate-500 font-medium flex items-center gap-1 mt-0.5">
                                            <i class="ph ph-phone text-slate-400"></i>
                                            <span>
                                              <%= h.contact_number %>
                                            </span>
                                          </div>
                                          <% } %>
                                  </div>

                                  <span
                                    class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-rose-50 text-rose-700 border border-rose-200 shrink-0">
                                    Not In Shelter
                                  </span>
                                </div>

                                <% const vulnList=(h.vuln_types && h.vuln_types.length> 0) ? h.vuln_types :
                                  (h.vulnerability_types || []); %>
                                  <% if (vulnList && vulnList.length> 0) { %>
                                    <div class="flex items-center gap-1 flex-wrap pt-0.5">
                                      <% vulnList.forEach(v=> { %>
                                        <span
                                          class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-50 text-amber-800 border border-amber-200">
                                          <%= v %>
                                        </span>
                                        <% }) %>
                                    </div>
                                    <% } %>

                                      <% if (h.members && h.members.length> 0) { %>
                                        <div
                                          class="text-[10px] text-slate-500 bg-slate-50 p-2 rounded-lg border border-slate-200/60 leading-relaxed">
                                          <span class="font-bold text-slate-700">Family Members:</span>
                                          <span>
                                            <%= h.members.map(m=> (m.name || `${m.first_name || ''} ${m.last_name ||
                                              ''}`.trim() || 'Family Member')).join(', ') %>
                                          </span>
                                        </div>
                                        <% } %>
                              </div>
                            </div>
                            <% }) %>
                              <% } else { %>
                                <div class="p-8 text-center text-slate-400 font-semibold">
                                  <i class="ph ph-check-circle text-emerald-500 text-3xl mb-1"></i>
                                  <p class="text-xs text-slate-700 font-bold">All registered residents have evacuated!
                                  </p>
                                  <p class="text-[11px] text-slate-400">Zero households currently pending evacuation.
                                  </p>
                                </div>
                                <% } %>
                                  <div id="tileNotEvacNoResults"
                                    class="hidden p-8 text-center text-slate-400 text-xs font-semibold">
                                    No matching un-evacuated households found.
                                  </div>
                    </div>
                  </div>

                </div>
            </div>

            <!-- SECTION 3: HOUSEHOLD REPORTS TAB -->
            <% const hhData=(typeof householdReports !=='undefined' && householdReports) ? householdReports : ((typeof
              residentReports !=='undefined' && residentReports) ? residentReports : { list: [], totalHouseholds: 0,
              totalIndividuals: 0, vulnerableHouseholds: 0, fourPsHouseholds: 0, barangayCounts: {}, demographics: {}
              }); %>
              <div id="tab-households"
                class="report-tab-content <%= (activeTab === 'households' || activeTab === 'residents') ? '' : 'hidden' %> space-y-4">

                <!-- PRINT HEADER (Visible only during print) -->
                <div class="hidden print-header text-left border-b-2 border-slate-900 pb-2.5 mb-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <h1 class="text-lg font-black text-slate-900 uppercase tracking-tight">MUNICIPALITY OF BAAO
                        &mdash; MDRRMO DISASTER RESPONSE</h1>
                      <h2 class="text-xs font-bold text-slate-700">Evacwar Emergency Operations Center &bull; Official
                        Household Masterlist &amp; Family Demographics Roster</h2>
                      <p class="text-[10px] text-slate-500 mt-0.5">Barangay San Rafael &bull; Generated: <%=
                          locals.formatManilaDateTime ? locals.formatManilaDateTime(new Date()) : new
                          Date().toLocaleString('en-US', { timeZone: 'Asia/Manila' }) %>
                      </p>
                    </div>
                    <div class="text-right">
                      <span
                        class="inline-block px-2.5 py-1 rounded bg-blue-100 text-blue-800 text-[10px] font-black border border-blue-300 uppercase">
                        OFFICIAL HOUSEHOLD ROSTER
                      </span>
                    </div>
                  </div>
                </div>

                <!-- HOUSEHOLD KPI METRICS -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 no-print">
                  <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Registered Households
                    </div>
                    <div class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                      <%= hhData.totalHouseholds || (hhData.list ? hhData.list.length : 0) %>
                    </div>
                    <div class="text-[11px] font-semibold text-blue-600">Family Units Profiled</div>
                  </div>
                  <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total Population</div>
                    <div class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                      <%= hhData.totalIndividuals || (overview && overview.totalResidents) || 0 %>
                    </div>
                    <div class="text-[11px] font-semibold text-emerald-600">Heads &amp; Family Members</div>
                  </div>
                  <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Vulnerable Households
                    </div>
                    <div class="text-xl sm:text-2xl font-black text-purple-600 tracking-tight">
                      <%= hhData.vulnerableHouseholds || 0 %>
                    </div>
                    <div class="text-[11px] font-semibold text-purple-700">Special Needs Priority</div>
                  </div>
                  <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">4Ps Beneficiaries</div>
                    <div class="text-xl sm:text-2xl font-black text-blue-700 tracking-tight">
                      <%= hhData.fourPsHouseholds || 0 %>
                    </div>
                    <div class="text-[11px] font-semibold text-slate-500">DSWD Pantawid Pamilya</div>
                  </div>
                </div>

                <!-- DEMOGRAPHIC PROFILE QUICK PILLS BAR (NO-PRINT) -->
                <% const demo=hhData.demographics || {}; %>
                  <div
                    class="bg-slate-50 border border-slate-200/90 rounded-2xl p-3 no-print flex flex-wrap items-center gap-2">
                    <span
                      class="text-[11px] font-extrabold text-slate-600 uppercase tracking-wider mr-1 flex items-center gap-1.5">
                      <i class="ph ph-chart-pie-slice text-blue-600 text-sm"></i> Sector Demographics:
                    </span>
                    <span
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-xs font-bold">
                      <i class="ph ph-person"></i> Seniors: <strong class="font-black text-amber-900">
                        <%= demo.seniors || 0 %>
                      </strong>
                    </span>
                    <span
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-cyan-50 border border-cyan-200 text-cyan-800 text-xs font-bold">
                      <i class="ph ph-baby"></i> Children (0-17): <strong class="font-black text-cyan-900">
                        <%= demo.children || 0 %>
                      </strong>
                    </span>
                    <span
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-800 text-xs font-bold">
                      <i class="ph ph-wheelchair"></i> PWD: <strong class="font-black text-indigo-900">
                        <%= demo.is_pwd || 0 %>
                      </strong>
                    </span>
                    <span
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-pink-50 border border-pink-200 text-pink-800 text-xs font-bold">
                      <i class="ph ph-gender-female"></i> Pregnant: <strong class="font-black text-pink-900">
                        <%= demo.is_pregnant || 0 %>
                      </strong>
                    </span>
                    <span
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold">
                      <i class="ph ph-drop"></i> Lactating: <strong class="font-black text-emerald-900">
                        <%= demo.is_lactating || 0 %>
                      </strong>
                    </span>
                    <span
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-purple-50 border border-purple-200 text-purple-800 text-xs font-bold">
                      <i class="ph ph-user"></i> Solo Parents: <strong class="font-black text-purple-900">
                        <%= demo.is_single_head || 0 %>
                      </strong>
                    </span>
                    <span
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold">
                      <i class="ph ph-first-aid"></i> Medical Needs: <strong class="font-black text-rose-900">
                        <%= demo.has_serious_illness || 0 %>
                      </strong>
                    </span>
                  </div>

                  <!-- HOUSEHOLDS TABLE & MEMBER BREAKDOWN -->
                  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-2xs overflow-hidden">
                    <div
                      class="p-3.5 sm:p-4 bg-slate-50/70 border-b border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                      <div>
                        <h3 class="font-bold text-slate-900 text-xs sm:text-sm flex items-center gap-2">
                          <i class="ph ph-house text-blue-600 text-base"></i>
                          <span>Household Masterlist &amp; Family Member Roster</span>
                        </h3>
                        <p class="text-[11px] text-slate-500 mt-0.5">
                          <%= (hhData.list || []).length %> registered households covering <%= hhData.totalIndividuals
                              || 0 %> total individuals.
                        </p>
                      </div>
                      <div class="flex items-center gap-2 no-print">
                        <button type="button" onclick="toggleAllHouseholdDrawers(true)"
                          class="px-2.5 py-1 text-[11px] font-bold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-lg border border-blue-200 transition-colors flex items-center gap-1">
                          <i class="ph ph-caret-double-down"></i> Expand All Members
                        </button>
                        <button type="button" onclick="toggleAllHouseholdDrawers(false)"
                          class="px-2.5 py-1 text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-200 transition-colors flex items-center gap-1">
                          <i class="ph ph-caret-double-up"></i> Collapse
                        </button>
                      </div>
                    </div>

                    <div class="overflow-x-auto">
                      <table class="w-full text-xs text-left">
                        <thead class="bg-slate-100/80 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                          <tr>
                            <th class="p-3 w-16 text-center">HH #</th>
                            <th class="p-3">Head of Household</th>
                            <th class="p-3">Barangay / Purok</th>
                            <th class="p-3 text-center">Family Size</th>
                            <th class="p-3">Vulnerability Profile</th>
                            <th class="p-3 text-center">LoRa Node</th>
                            <th class="p-3 text-center no-print">Member Details</th>
                            <th class="p-3 text-center">Status</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                          <% if (hhData.list && hhData.list.length> 0) { %>
                            <% hhData.list.forEach(hh=> { %>
                              <!-- MAIN HOUSEHOLD ROW -->
                              <tr class="hover:bg-blue-50/30 transition-colors border-t border-slate-100">
                                <td class="p-3 text-center font-black text-slate-500">
                                  #<%= hh.household_id || hh.id %>
                                </td>
                                <td class="p-3">
                                  <div class="font-extrabold text-slate-900 text-xs sm:text-[13px]">
                                    <%= hh.head_name || `${hh.first_name || '' } ${hh.last_name || '' }` %>
                                  </div>
                                  <div class="text-[11px] text-slate-500 flex items-center gap-2 mt-0.5">
                                    <span>Age <%= hh.age || '—' %> / <%= hh.sex || '—' %></span>
                                    <% if (hh.contact_number) { %>
                                      &bull; <a href="tel:<%= hh.contact_number %>"
                                        class="text-blue-600 hover:underline">
                                        <%= hh.contact_number %>
                                      </a>
                                      <% } %>
                                  </div>
                                </td>
                                <td class="p-3 text-slate-700">
                                  <div class="font-bold">
                                    <%= hh.barangay || 'San Rafael' %>
                                  </div>
                                  <% if (hh.home_address) { %>
                                    <div class="text-[11px] text-slate-500 truncate max-w-xs">
                                      <%= hh.home_address %>
                                    </div>
                                    <% } %>
                                </td>
                                <td class="p-3 text-center">
                                  <span
                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-xs font-black bg-blue-50 text-blue-700 border border-blue-200">
                                    <i class="ph ph-users text-sm"></i>
                                    <%= hh.total_members || hh.family_size || 1 %>
                                      <%= (hh.total_members || hh.family_size || 1)===1 ? 'Person' : 'Members' %>
                                  </span>
                                  <div class="text-[10px] text-slate-400 font-medium mt-0.5">
                                    1 Head, <%= (hh.members || []).length %>
                                      <%= (hh.members || []).length===1 ? 'member' : 'members' %>
                                  </div>
                                </td>
                                <td class="p-3">
                                  <div class="flex flex-wrap gap-1">
                                    <% if (hh.vuln_badges && hh.vuln_badges.length> 0) { %>
                                      <% hh.vuln_badges.forEach(vb=> { %>
                                        <% let badgeClass='bg-slate-100 text-slate-700 border-slate-200' ; if
                                          (vb.color==='blue' ) badgeClass='bg-blue-50 text-blue-700 border-blue-200' ;
                                          else if (vb.color==='amber' )
                                          badgeClass='bg-amber-50 text-amber-800 border-amber-200' ; else if
                                          (vb.color==='indigo' )
                                          badgeClass='bg-indigo-50 text-indigo-700 border-indigo-200' ; else if
                                          (vb.color==='cyan' ) badgeClass='bg-cyan-50 text-cyan-800 border-cyan-200' ;
                                          else if (vb.color==='rose' )
                                          badgeClass='bg-rose-50 text-rose-700 border-rose-200' ; else if
                                          (vb.color==='pink' ) badgeClass='bg-pink-50 text-pink-700 border-pink-200' ;
                                          else if (vb.color==='purple' )
                                          badgeClass='bg-purple-50 text-purple-700 border-purple-200' ; %>
                                          <span
                                            class="px-2 py-0.5 rounded-md text-[10px] font-bold border <%= badgeClass %>">
                                            <%= vb.label %>
                                          </span>
                                          <% }) %>
                                            <% } else { %>
                                              <span class="text-slate-400 text-[11px] font-normal">&mdash; Standard
                                                Household</span>
                                              <% } %>
                                  </div>
                                </td>
                                <td class="p-3 text-center">
                                  <% if (hh.has_lora) { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-black bg-emerald-50 text-emerald-700 border border-emerald-300 shadow-2xs">
                                      <i class="ph ph-broadcast text-emerald-600 font-bold"></i>
                                      <span>LoRa Node (<%= hh.lora_node_id || '!f4e213d4' %>)</span>
                                    </span>
                                  <% } else { %>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-[11px] font-medium bg-slate-100 text-slate-500 border border-slate-200">
                                      <i class="ph ph-x-circle text-slate-400"></i>
                                      <span>No LoRa Node</span>
                                    </span>
                                  <% } %>
                                </td>
                                <td class="p-3 text-center no-print">
                                  <button type="button"
                                    onclick="toggleHouseholdDrawer('<%= hh.household_id || hh.id %>')"
                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-bold text-slate-700 bg-slate-100 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-200 border border-slate-200 transition-all">
                                    <span>
                                      <%= (hh.members || []).length %> Members
                                    </span>
                                    <i id="hh-icon-<%= hh.household_id || hh.id %>"
                                      class="ph ph-caret-down hh-caret-icon text-xs"></i>
                                  </button>
                                </td>
                                <td class="p-3 text-center">
                                  <span
                                    class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                    Registered
                                  </span>
                                </td>
                              </tr>

                              <!-- EXPANDABLE HOUSEHOLD MEMBERS DRAWER ROW -->
                              <tr id="hh-drawer-<%= hh.household_id || hh.id %>"
                                class="hh-member-drawer member-drawer-content hidden bg-slate-50/70 border-b border-slate-200">
                                <td colspan="8" class="p-3 sm:p-4">
                                  <div
                                    class="bg-white rounded-xl border border-slate-200/90 shadow-2xs overflow-hidden">
                                    <div
                                      class="px-3.5 py-2.5 bg-slate-100/80 border-b border-slate-200 flex items-center justify-between">
                                      <div class="text-[11px] font-bold text-slate-800 flex items-center gap-1.5">
                                        <i class="ph ph-users-three text-blue-600"></i>
                                        <span>Family Roster &bull; <%= hh.head_name || 'Household' %> (Total: <%=
                                              hh.total_members || 1 %>)</span>
                                      </div>
                                      <span class="text-[10px] text-slate-500 font-semibold">
                                        1 Head of Family + <%= (hh.members || []).length %> Dependents
                                      </span>
                                    </div>

                                    <div class="overflow-x-auto">
                                      <table class="w-full text-xs text-left">
                                        <thead
                                          class="bg-slate-50 text-slate-500 font-bold uppercase text-[10px] border-b border-slate-200/80">
                                          <tr>
                                            <th class="p-2.5 pl-3.5">Name</th>
                                            <th class="p-2.5">Relation</th>
                                            <th class="p-2.5 text-center">Age / Sex</th>
                                            <th class="p-2.5">Special Needs / Vulnerability</th>
                                            <th class="p-2.5 text-center">Role</th>
                                          </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 text-slate-700">
                                          <!-- 1. Head of Household Row -->
                                          <tr class="bg-blue-50/40">
                                            <td
                                              class="p-2.5 pl-3.5 font-extrabold text-blue-950 flex items-center gap-1.5">
                                              <i class="ph ph-crown-simple text-amber-500 text-sm"></i>
                                              <span>
                                                <%= hh.head_name || `${hh.first_name || '' } ${hh.last_name || '' }` %>
                                              </span>
                                            </td>
                                            <td class="p-2.5 font-bold text-blue-800">Head of Household</td>
                                            <td class="p-2.5 text-center text-slate-700">
                                              <%= hh.age || '—' %> / <%= hh.sex || '—' %>
                                            </td>
                                            <td class="p-2.5">
                                              <div class="flex flex-wrap gap-1">
                                                <% if (hh.is_4ps) { %><span
                                                    class="bg-blue-50 text-blue-700 border border-blue-200 px-1.5 py-0.2 rounded text-[9px] font-bold">4Ps
                                                    Head</span>
                                                  <% } %>
                                                    <% if (Number(hh.age)>= 60) { %><span
                                                        class="bg-amber-50 text-amber-700 border border-amber-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Senior
                                                        Head</span>
                                                      <% } %>
                                                        <% if (hh.is_pwd) { %><span
                                                            class="bg-indigo-50 text-indigo-700 border border-indigo-200 px-1.5 py-0.2 rounded text-[9px] font-bold">PWD</span>
                                                          <% } %>
                                                            <% if (hh.is_pregnant) { %><span
                                                                class="bg-rose-50 text-rose-700 border border-rose-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Pregnant</span>
                                                              <% } %>
                                                                <% if (hh.is_lactating) { %><span
                                                                    class="bg-pink-50 text-pink-700 border border-pink-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Lactating</span>
                                                                  <% } %>
                                                                    <% if (hh.is_single_head) { %><span
                                                                        class="bg-purple-50 text-purple-700 border border-purple-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Solo
                                                                        Parent</span>
                                                                      <% } %>
                                                                        <% if (hh.has_serious_illness) { %><span
                                                                            class="bg-rose-50 text-rose-700 border border-rose-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Medical
                                                                            Need</span>
                                                                          <% } %>
                                                                            <% if (!hh.is_4ps && !(Number(hh.age)>= 60)
                                                                              && !hh.is_pwd && !hh.is_pregnant &&
                                                                              !hh.is_lactating && !hh.is_single_head &&
                                                                              !hh.has_serious_illness) { %>
                                                                              <span
                                                                                class="text-slate-400 text-[10px]">None</span>
                                                                              <% } %>
                                              </div>
                                            </td>
                                            <td class="p-2.5 text-center">
                                              <span
                                                class="px-2 py-0.5 rounded-full text-[9px] font-black bg-blue-100 text-blue-800">
                                                PRIMARY
                                              </span>
                                            </td>
                                          </tr>

                                          <!-- 2. Household Members Rows -->
                                          <% if (hh.members && hh.members.length> 0) { %>
                                            <% hh.members.forEach(m=> { %>
                                              <tr class="hover:bg-slate-50 transition-colors">
                                                <td class="p-2.5 pl-3.5 font-bold text-slate-800">
                                                  <%= m.first_name %>
                                                    <%= m.middle_name ? m.middle_name + ' ' : '' %>
                                                      <%= m.last_name %>
                                                </td>
                                                <td class="p-2.5 text-slate-600 font-semibold">
                                                  <%= m.relation || 'Dependent' %>
                                                </td>
                                                <td class="p-2.5 text-center text-slate-600">
                                                  <%= m.age || '—' %> / <%= m.sex || '—' %>
                                                </td>
                                                <td class="p-2.5">
                                                  <div class="flex flex-wrap gap-1">
                                                    <% const mStatus=(m.status || '' ).toLowerCase(); %>
                                                      <% if (m.is_pwd || mStatus.includes('pwd')) { %>
                                                        <span
                                                          class="bg-indigo-50 text-indigo-700 border border-indigo-200 px-1.5 py-0.2 rounded text-[9px] font-bold">PWD</span>
                                                        <% } %>
                                                          <% if (m.is_pregnant || mStatus.includes('pregnant')) { %>
                                                            <span
                                                              class="bg-rose-50 text-rose-700 border border-rose-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Pregnant</span>
                                                            <% } %>
                                                              <% if (m.is_lactating || mStatus.includes('lactating')) {
                                                                %>
                                                                <span
                                                                  class="bg-pink-50 text-pink-700 border border-pink-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Lactating</span>
                                                                <% } %>
                                                                  <% if (Number(m.age)>= 60 ||
                                                                    mStatus.includes('elderly') ||
                                                                    mStatus.includes('senior')) { %>
                                                                    <span
                                                                      class="bg-amber-50 text-amber-700 border border-amber-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Senior</span>
                                                                    <% } %>
                                                                      <% if ((Number(m.age)> 0 && Number(m.age) < 18) ||
                                                                          mStatus.includes('infant') ||
                                                                          mStatus.includes('toddler') ||
                                                                          mStatus.includes('student')) { %>
                                                                          <span
                                                                            class="bg-cyan-50 text-cyan-700 border border-cyan-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Minor
                                                                            / Child</span>
                                                                          <% } %>
                                                                            <% if (m.has_serious_illness ||
                                                                              mStatus.includes('illness') ||
                                                                              mStatus.includes('bedridden')) { %>
                                                                              <span
                                                                                class="bg-rose-50 text-rose-700 border border-rose-200 px-1.5 py-0.2 rounded text-[9px] font-bold">Medical
                                                                                Need</span>
                                                                              <% } %>
                                                                                <% if (!m.is_pwd && !m.is_pregnant &&
                                                                                  !m.is_lactating && !(Number(m.age)>=
                                                                                  60) && !(Number(m.age) < 18) &&
                                                                                    !m.has_serious_illness &&
                                                                                    !mStatus.includes('pwd') &&
                                                                                    !mStatus.includes('pregnant') &&
                                                                                    !mStatus.includes('lactating') &&
                                                                                    !mStatus.includes('elderly') &&
                                                                                    !mStatus.includes('infant') &&
                                                                                    !mStatus.includes('illness') &&
                                                                                    !mStatus.includes('bedridden')) { %>
                                                                                    <span
                                                                                      class="text-slate-400 text-[10px]">None</span>
                                                                                    <% } %>
                                                  </div>
                                                </td>
                                                <td class="p-2.5 text-center">
                                                  <span
                                                    class="px-2 py-0.5 rounded-full text-[9px] font-semibold bg-slate-100 text-slate-600">
                                                    MEMBER
                                                  </span>
                                                </td>
                                              </tr>
                                              <% }) %>
                                                <% } else { %>
                                                  <tr>
                                                    <td colspan="5"
                                                      class="p-2.5 pl-3.5 text-slate-400 italic text-[11px]">
                                                      No dependent household members registered under this family.
                                                    </td>
                                                  </tr>
                                                  <% } %>
                                        </tbody>
                                      </table>
                                    </div>
                                  </div>
                                </td>
                              </tr>
                              <% }) %>
                                <% } else { %>
                                  <tr>
                                    <td colspan="7" class="p-8 text-center text-slate-400 font-semibold">
                                      No household records found matching filter criteria.
                                    </td>
                                  </tr>
                                  <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
              </div>

              <!-- SOS / RESCUE REPORTS TAB -->
              <div id="tab-sos" class="report-tab-content <%= activeTab === 'sos' ? '' : 'hidden' %> space-y-4">

                <!-- 1. SOS EXECUTIVE METRICS (4 SUMMARY CARDS) -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 no-print">
                  <!-- Active Signals -->
                  <div
                    class="bg-white p-3.5 sm:p-4 rounded-2xl border <%= overview.activeSos > 0 ? 'border-red-300 bg-red-50/10' : 'border-slate-200/90' %> shadow-2xs space-y-1">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Active Distress Signals
                    </div>
                    <div class="text-xl sm:text-2xl font-black text-red-600 tracking-tight flex items-center gap-2">
                      <span>
                        <%= overview.activeSos || 0 %>
                      </span>
                      <% if (overview.activeSos> 0) { %>
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
                        <% } %>
                    </div>
                    <div
                      class="text-[11px] font-semibold <%= overview.activeSos > 0 ? 'text-red-700' : 'text-slate-500' %>">
                      <%= overview.activeSos> 0 ? 'Immediate field deployment' : 'Zero pending distress' %>
                    </div>
                  </div>

                  <!-- Rescued & Safe -->
                  <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-emerald-200/90 shadow-2xs space-y-1">
                    <div class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider">Secured & Rescued</div>
                    <div class="text-xl sm:text-2xl font-black text-emerald-600 tracking-tight">
                      <%= (sosReports.list || []).filter(s=> ['RESCUED', 'RESOLVED'].includes((s.status ||
                        '').toUpperCase())).length %>
                    </div>
                    <div class="text-[11px] font-semibold text-emerald-700">Evacuees extracted safe</div>
                  </div>

                  <!-- In Progress / En Route -->
                  <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-indigo-200/90 shadow-2xs space-y-1">
                    <div class="text-[10px] font-bold text-indigo-800 uppercase tracking-wider">Dispatched / En Route
                    </div>
                    <div class="text-xl sm:text-2xl font-black text-indigo-600 tracking-tight">
                      <%= (sosReports.list || []).filter(s=> ['ACKNOWLEDGED', 'RESPONDING'].includes((s.status ||
                        '').toUpperCase())).length %>
                    </div>
                    <div class="text-[11px] font-semibold text-indigo-700">Responders actively deploying</div>
                  </div>

                  <!-- Total SOS Logged -->
                  <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90 shadow-2xs space-y-1">
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total Distress Logged
                    </div>
                    <div class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                      <%= (sosReports.list || []).length %>
                    </div>
                    <div class="text-[11px] font-semibold text-slate-500">Cumulative field signals</div>
                  </div>
                </div>

                <!-- 2. SOS AUDIT LOGS TABLE & CONTROLS -->
                <% const rescuerList=(locals.sosReports && locals.sosReports.rescuers &&
                  locals.sosReports.rescuers.length> 0) ? locals.sosReports.rescuers : []; %>
                  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-2xs overflow-hidden">
                    <!-- Header & Export Button -->
                    <div
                      class="p-3.5 sm:p-4 bg-slate-50/70 border-b border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <div>
                        <h3 class="font-bold text-slate-900 text-xs sm:text-sm flex items-center gap-2">
                          <i class="ph ph-siren text-red-600 text-base"></i>
                          <span>Search & Rescue Operations & Distress Telemetry Log</span>
                        </h3>
                        <p class="text-[11px] text-slate-500 mt-0.5">
                          Comprehensive incident records with GPS coordinates, timeline, responder identity, and
                          resolution duration.
                        </p>
                      </div>
                    </div>

                    <!-- Toolbar & Quick Filters -->
                    <div
                      class="p-3.5 border-b border-slate-200 bg-white flex flex-col md:flex-row md:items-center justify-between gap-3 no-print">
                      <!-- Search Input -->
                      <div class="relative flex-1 max-w-md">
                        <i
                          class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input type="text" id="adminSosSearch" oninput="filterAdminSosTable()"
                          placeholder="Search by resident name, rescuer, purok, or notes..."
                          class="w-full pl-9 pr-3 py-1.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-600 transition-all">
                      </div>

                      <!-- Rescuer Dropdown & Status Filter -->
                      <div class="flex flex-wrap items-center gap-2">
                        <select id="adminSosRescuerSelect" onchange="filterAdminSosTable()"
                          class="px-2.5 py-1.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-rose-500/20">
                          <option value="all">All Rescuers</option>
                          <% rescuerList.forEach(rec=> { %>
                            <option value="<%= rec.name.toLowerCase() %>">
                              <%= rec.name %> (Rescuer)
                            </option>
                            <% }); %>
                        </select>

                        <div class="flex items-center gap-1 overflow-x-auto no-scrollbar py-0.5">
                          <button type="button" onclick="setAdminSosStatus('ALL', this)"
                            class="admin-sos-status-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-rose-600 text-white shadow-2xs">All</button>
                          <button type="button" onclick="setAdminSosStatus('ACTIVE', this)"
                            class="admin-sos-status-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">Active</button>
                          <button type="button" onclick="setAdminSosStatus('RESPONDING', this)"
                            class="admin-sos-status-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">En
                            Route</button>
                          <button type="button" onclick="setAdminSosStatus('RESCUED', this)"
                            class="admin-sos-status-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">Rescued</button>
                          <button type="button" onclick="setAdminSosStatus('RESOLVED', this)"
                            class="admin-sos-status-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200">Resolved</button>
                        </div>

                        <button type="button" onclick="resetAdminSosFilters()"
                          class="text-xs font-bold text-slate-500 hover:text-slate-800 px-2 py-1 rounded hover:bg-slate-100 transition-colors">
                          Reset
                        </button>
                      </div>
                    </div>

                    <!-- Telemetry Table -->
                    <div class="overflow-x-auto">
                      <table class="w-full text-xs text-left border-collapse">
                        <thead class="bg-slate-100/80 text-slate-600 font-bold uppercase tracking-wider text-[10px]">
                          <tr>
                            <th class="p-3">Alert ID</th>
                            <th class="p-3">Distressed Resident</th>
                            <th class="p-3">Location & Coordinates</th>
                            <th class="p-3">Triggered Date / Time</th>
                            <th class="p-3">Acknowledged / Rescuer</th>
                            <th class="p-3">Resolution & Duration</th>
                            <th class="p-3 text-center">Status</th>
                            <th class="p-3 text-right">Radar Link</th>
                          </tr>
                        </thead>
                        <tbody id="adminSosTableBody" class="divide-y divide-slate-100 text-slate-700 font-medium">
                          <% if (sosReports.list && sosReports.list.length> 0) { %>
                            <% sosReports.list.forEach(sos=> {
                              const resName = sos.resident_name || (sos.first_name ? `${sos.first_name} ${sos.last_name
                              || ''}`.trim() : (sos.name || 'Resident in Distress'));
                              const resInitial = resName.charAt(0).toUpperCase();
                              const st = (sos.status || 'ACTIVE').toUpperCase();
                              const lat = sos.latitude || 13.5102;
                              const lng = sos.longitude || 123.3470;
                              const isSenior = (sos.age >= 60);
                              const isPwd = !!sos.is_pwd;
                              const isPreg = !!sos.is_pregnant;
                              const isMed = !!sos.has_serious_illness;
                              const trigTime = locals.formatManilaDateTime ? locals.formatManilaDateTime(sos.created_at)
                              : (sos.created_at ? new Date(sos.created_at).toLocaleString('en-US', { month: 'short',
                              day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Manila'
                              }) : 'N/A');
                              const resolvedTime = sos.updated_at && st !== 'ACTIVE' ? (locals.formatManilaDateTime ?
                              locals.formatManilaDateTime(sos.updated_at) : new
                              Date(sos.updated_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour:
                              'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Manila' })) : null;
                              %>
                              <tr class="admin-sos-row hover:bg-slate-50/80 transition-colors"
                                data-resident="<%= resName.toLowerCase() %>"
                                data-contact="<%= (sos.contact_number || '').toLowerCase() %>"
                                data-location="<%= (sos.barangay || sos.home_address || '').toLowerCase() %>"
                                data-handler="<%= (sos.handler_name || sos.handler_email || '').toLowerCase() %>"
                                data-status="<%= st %>" data-notes="<%= (sos.responder_notes || '').toLowerCase() %>">

                                <!-- Alert ID -->
                                <td class="p-3 font-mono font-bold text-slate-900 whitespace-nowrap">
                                  SOS-#<%= sos.id %>
                                </td>

                                <!-- Resident -->
                                <td class="p-3">
                                  <div class="flex items-center gap-2">
                                    <div
                                      class="w-7 h-7 rounded-lg bg-slate-800 text-white flex items-center justify-center font-bold text-xs shrink-0">
                                      <%= resInitial %>
                                    </div>
                                    <div class="min-w-0">
                                      <div class="font-extrabold text-slate-900 truncate">
                                        <%= resName %>
                                      </div>
                                      <div class="flex flex-wrap items-center gap-1 mt-0.5">
                                        <% if (sos.contact_number) { %>
                                          <a href="tel:<%= sos.contact_number %>"
                                            class="text-[10px] text-blue-600 hover:underline font-semibold flex items-center gap-0.5">
                                            <i class="ph ph-phone"></i>
                                            <span>
                                              <%= sos.contact_number %>
                                            </span>
                                          </a>
                                          <% } %>
                                            <% if (isSenior) { %>
                                              <span
                                                class="px-1 py-0.2 rounded bg-purple-50 text-purple-700 font-black text-[9px] border border-purple-200">Senior</span>
                                              <% } %>
                                                <% if (isPwd) { %>
                                                  <span
                                                    class="px-1 py-0.2 rounded bg-blue-50 text-blue-700 font-black text-[9px] border border-blue-200">PWD</span>
                                                  <% } %>
                                                    <% if (isPreg) { %>
                                                      <span
                                                        class="px-1 py-0.2 rounded bg-rose-50 text-rose-700 font-black text-[9px] border border-rose-200">Pregnant</span>
                                                      <% } %>
                                                        <% if (isMed) { %>
                                                          <span
                                                            class="px-1 py-0.2 rounded bg-amber-50 text-amber-800 font-black text-[9px] border border-amber-200">Medical</span>
                                                          <% } %>
                                      </div>
                                    </div>
                                  </div>
                                </td>

                                <!-- Location & Coordinates -->
                                <td class="p-3 text-slate-700">
                                  <div class="font-bold truncate max-w-[150px]">
                                    <%= sos.barangay || sos.home_address || 'San Rafael' %>
                                  </div>
                                  <a href="https://maps.google.com/?q=<%= lat %>,<%= lng %>" target="_blank"
                                    class="text-[10px] font-mono text-blue-600 hover:underline inline-flex items-center gap-0.5 mt-0.5">
                                    <i class="ph ph-map-pin"></i>
                                    <span>
                                      <%= Number(lat).toFixed(4) %>, <%= Number(lng).toFixed(4) %>
                                    </span>
                                    <% if (sos.accuracy) { %>
                                      <span class="text-slate-400 font-sans">(±<%= Math.round(sos.accuracy) %>m)</span>
                                      <% } %>
                                  </a>
                                </td>

                                <!-- Triggered Date / Time -->
                                <td class="p-3 text-slate-600 whitespace-nowrap text-[11px]">
                                  <div class="flex items-center gap-1 font-semibold">
                                    <i class="ph ph-clock text-slate-400"></i>
                                    <span>
                                      <%= trigTime %>
                                    </span>
                                  </div>
                                </td>

                                <!-- Acknowledged / Rescuer -->
                                <td class="p-3">
                                  <% if ((sos.handler_name || sos.handler_email) && sos.handler_staff_type==='RESCUER' )
                                    { %>
                                    <div
                                      class="font-bold text-slate-900 truncate max-w-[140px] flex items-center gap-1">
                                      <i class="ph ph-user-check text-rose-600"></i>
                                      <span>
                                        <%= sos.handler_name || sos.handler_email %>
                                      </span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-medium">
                                      <%= sos.handler_contact || 'Tactical Rescuer Unit' %>
                                    </div>
                                    <% } else { %>
                                      <span
                                        class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-500">Unassigned</span>
                                      <% } %>
                                </td>

                                <!-- Resolution & Duration -->
                                <td class="p-3 whitespace-nowrap text-[11px]">
                                  <% if (resolvedTime) { %>
                                    <div class="font-bold text-emerald-700 flex items-center gap-1">
                                      <i class="ph ph-check-circle text-emerald-500"></i>
                                      <span>
                                        <%= resolvedTime %>
                                      </span>
                                    </div>
                                    <% if (sos.responseMinutes !==null && sos.responseMinutes !==undefined) { %>
                                      <span
                                        class="inline-block mt-0.5 px-1.5 py-0.2 rounded text-[10px] font-black bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        ⚡ Responded in <%= sos.responseMinutes %> min
                                      </span>
                                      <% } %>
                                        <% } else { %>
                                          <span class="text-slate-400 font-semibold italic text-[10px]">Awaiting rescue
                                            resolution</span>
                                          <% } %>
                                </td>

                                <!-- Status Badge -->
                                <td class="p-3 text-center whitespace-nowrap">
                                  <span
                                    class="px-2.5 py-0.5 rounded-full text-[10px] font-black <%= st === 'ACTIVE' ? 'bg-red-50 text-red-700 border border-red-200' : (st === 'RESCUED' || st === 'RESOLVED' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-700 border border-amber-200') %>">
                                    <%= st %>
                                  </span>
                                </td>

                                <!-- Action / Radar Link -->
