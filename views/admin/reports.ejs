                      <i class="ph ph-file-pdf text-sm"></i> Export to PDF
                    </button>
                  </div>
                </div>

                <% const currentStats=(filters.centerId && filters.centerId !=='all' && singleEcBoardStats) ?
                  singleEcBoardStats : allEcBoardStats; const isSingleCenter=(filters.centerId && filters.centerId
                  !=='all' && singleEcBoardStats); %>
                  <% if (currentStats) { %>
                    <!-- 2. EVACUATION CENTER INFORMATION SECTION -->
                    <div class="text-xs space-y-1 font-semibold text-slate-900 py-1 text-left">
                      <div
                        class="font-bold text-slate-900 uppercase tracking-wider text-[11px] border-b border-slate-900 pb-1 mb-2">
                        EVACUATION CENTER INFORMATION
                      </div>
                      <div class="space-y-1 text-left">
                        <div><span class="font-bold text-slate-900">Name of Evacuation Center:</span>
                          <%= isSingleCenter ? currentStats.center.name : 'ALL EVACUATION CENTERS COMBINED' %>
                        </div>
                        <div><span class="font-bold text-slate-900">Location:</span>
                          <%= isSingleCenter ? currentStats.center.address : 'San Rafael, Baao, Camarines Sur' %>
                        </div>
                        <% if (isSingleCenter) { %>
                          <div><span class="font-bold text-slate-900">Contact Number:</span>
                            <%= currentStats.center.contact_number || '0912-345-6789' %>
                          </div>
                          <% } %>
                            <div><span class="font-bold text-slate-900">Report Date:</span>
                              <%= new Date().toLocaleDateString() %>
                            </div>
                      </div>
                    </div>


                    <!-- 3. SUMMARY CARDS (Square & Bigger) -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 ec-summary-grid">
                      <div
                        class="ec-summary-card p-4 sm:p-5 bg-blue-50 border border-blue-200 rounded-xl text-center flex flex-col items-center justify-center min-h-[115px]">
                        <div class="text-[11px] font-extrabold text-blue-700 uppercase tracking-wider mb-2">Total
                          Families</div>
                        <div class="text-3xl sm:text-4xl font-black text-blue-950">
                          <%= currentStats.metrics.total_families %>
                        </div>
                      </div>
                      <div
                        class="ec-summary-card p-4 sm:p-5 bg-emerald-50 border border-emerald-200 rounded-xl text-center flex flex-col items-center justify-center min-h-[115px]">
                        <div class="text-[11px] font-extrabold text-emerald-700 uppercase tracking-wider mb-2">Total
                          Evacuees</div>
                        <div class="text-3xl sm:text-4xl font-black text-emerald-950">
                          <%= currentStats.metrics.total_evacuees %>
                        </div>
                      </div>
                      <div
                        class="ec-summary-card p-4 sm:p-5 bg-amber-50 border border-amber-200 rounded-xl text-center flex flex-col items-center justify-center min-h-[115px]">
                        <div class="text-[11px] font-extrabold text-amber-700 uppercase tracking-wider mb-2">4Ps
                          Beneficiaries</div>
                        <div class="text-3xl sm:text-4xl font-black text-amber-950">
                          <%= currentStats.metrics.total_4ps_beneficiaries %>
                        </div>
                      </div>
                      <div
                        class="ec-summary-card ratio-card p-4 sm:p-5 bg-indigo-50 border border-indigo-200 rounded-xl text-center flex flex-col items-center justify-center min-h-[115px]">
                        <div class="text-[11px] font-extrabold text-indigo-700 uppercase tracking-wider mb-2">Male /
                          Female Ratio</div>
                        <div class="text-xl sm:text-2xl font-black text-indigo-950">
                          <%= currentStats.metrics.total_male %> M / <%= currentStats.metrics.total_female %> F
                        </div>
                      </div>
                    </div>

                    <!-- AGE & SEX MATRIX TABLE (7 BRACKETS) -->
                    <div class="space-y-2">
                      <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Age Group & Sex Matrix
                        (Checked-In Evacuees)</h3>
                      <table class="print-table w-full text-xs text-left border border-slate-900">
                        <thead class="bg-slate-100 text-slate-900 font-bold uppercase border-b border-slate-900">
                          <tr>
                            <th class="p-2 border border-slate-900">Age Bracket</th>
                            <th class="p-2 border border-slate-900 text-center">Male</th>
                            <th class="p-2 border border-slate-900 text-center">Female</th>
                            <th class="p-2 border border-slate-900 text-center">Total</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-300 font-semibold text-slate-800">
                          <% const brackets=[ { key: '0_11m' , label: '0–11 months' }, { key: '1_3y' ,
                            label: '1–3 years' }, { key: '4_5y' , label: '4–5 years' }, { key: '6_12y' ,
                            label: '6–12 years' }, { key: '13_18y' ,label: '13–18 years' }, { key: '19_59y'
                            ,label: '19–59 years' }, { key: '60plus' ,label: '60+ years' } ]; %>
                            <% brackets.forEach(b=> { %>
                              <% const item=currentStats.age_groups[b.key] || { male: 0, female: 0, total: 0 }; %>
                                <tr class="hover:bg-slate-50">
                                  <td class="p-2 border border-slate-900 font-bold">
                                    <%= b.label %>
                                  </td>
                                  <td class="p-2 border border-slate-900 text-center font-bold text-blue-700">
                                    <%= item.male %>
                                  </td>
                                  <td class="p-2 border border-slate-900 text-center font-bold text-rose-700">
                                    <%= item.female %>
                                  </td>
                                  <td class="p-2 border border-slate-900 text-center font-black text-slate-950">
                                    <%= item.total %>
                                  </td>
                                </tr>
                                <% }) %>
                                  <tr class="bg-slate-200 font-black text-slate-950 border-t-2 border-slate-900">
                                    <td class="p-2.5 border border-slate-900">TOTAL EVACUEES</td>
                                    <td class="p-2.5 border border-slate-900 text-center text-blue-900">
                                      <%= currentStats.metrics.total_male %>
                                    </td>
                                    <td class="p-2.5 border border-slate-900 text-center text-rose-900">
                                      <%= currentStats.metrics.total_female %>
                                    </td>
                                    <td class="p-2.5 border border-slate-900 text-center text-black font-black">
                                      <%= currentStats.metrics.total_evacuees %>
                                    </td>
                                  </tr>
                        </tbody>
                      </table>
                    </div>

                    <!-- SPECIAL CATEGORIES SECTOR BREAKDOWN -->
                    <div class="space-y-2">
                      <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Special Sector &
                        Vulnerability
                        Breakdown</h3>
                      <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-xs">
                        <div class="p-2.5 border border-slate-900 rounded bg-slate-50">
                          <div class="text-[10px] font-bold text-slate-600 uppercase">Pregnant Women</div>
                          <div class="text-base font-black text-slate-950 mt-0.5">
                            <%= currentStats.special_categories.pregnant %>
                          </div>
                        </div>
                        <div class="p-2.5 border border-slate-900 rounded bg-slate-50">
                          <div class="text-[10px] font-bold text-slate-600 uppercase">Breastfeeding Mothers</div>
                          <div class="text-base font-black text-slate-950 mt-0.5">
                            <%= currentStats.special_categories.lactating %>
                          </div>
                        </div>
                        <div class="p-2.5 border border-slate-900 rounded bg-slate-50">
                          <div class="text-[10px] font-bold text-slate-600 uppercase">Persons w/ Disability (PWD)</div>
                          <div class="text-base font-black text-slate-950 mt-0.5">
                            <%= currentStats.special_categories.pwd %>
                          </div>
                        </div>
                        <div class="p-2.5 border border-slate-900 rounded bg-slate-50">
                          <div class="text-[10px] font-bold text-slate-600 uppercase">Single-Headed Household</div>
                          <div class="text-base font-black text-slate-950 mt-0.5">
                            <%= currentStats.special_categories.single_headed %>
                          </div>
                        </div>
                        <div class="p-2.5 border border-slate-900 rounded bg-slate-50">
                          <div class="text-[10px] font-bold text-slate-600 uppercase">Serious Illness</div>
                          <div class="text-base font-black text-slate-950 mt-0.5">
                            <%= currentStats.special_categories.serious_illness %>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- ALL EVACUATION CENTERS SUMMARY TABLE (SHOWN IN ALL CENTERS MODE) -->
                    <% if (!isSingleCenter && currentStats.center_summaries) { %>
                      <div class="space-y-2 pt-2">
                        <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Evacuation Center
                          Occupancy
                          Summary</h3>
                        <table class="print-table w-full text-xs text-left border border-slate-900">
                          <thead class="bg-slate-100 text-slate-900 font-bold uppercase border-b border-slate-900">
                            <tr>
                              <th class="p-2 border border-slate-900">Evacuation Center</th>
                              <th class="p-2 border border-slate-900 text-center">Capacity</th>
                              <th class="p-2 border border-slate-900 text-center">Occupied</th>
                              <th class="p-2 border border-slate-900 text-center">Available</th>
                              <th class="p-2 border border-slate-900 text-center">Families</th>
                            </tr>
                          </thead>
                          <tbody class="divide-y divide-slate-300 font-semibold text-slate-800">
                            <% currentStats.center_summaries.forEach(c=> { %>
                              <tr class="hover:bg-slate-50">
                                <td class="p-2 border border-slate-900 font-bold">
                                  <%= c.name %>
                                </td>
                                <td class="p-2 border border-slate-900 text-center">
                                  <%= c.capacity %>
                                </td>
                                <td class="p-2 border border-slate-900 text-center text-orange-700 font-bold">
                                  <%= c.occupied %>
                                </td>
                                <td class="p-2 border border-slate-900 text-center text-emerald-700 font-bold">
                                  <%= c.available %>
                                </td>
                                <td class="p-2 border border-slate-900 text-center">
                                  <%= c.families %>
                                </td>
                              </tr>
                              <% }) %>
                                <tr class="bg-slate-200 font-black text-slate-950 border-t-2 border-slate-900">
                                  <td class="p-2.5 border border-slate-900">TOTAL ALL CENTERS</td>
                                  <td class="p-2.5 border border-slate-900 text-center">
                                    <%= currentStats.summary.capacity %>
                                  </td>
                                  <td class="p-2.5 border border-slate-900 text-center text-orange-950">
                                    <%= currentStats.summary.total_occupied %>
                                  </td>
                                  <td class="p-2.5 border border-slate-900 text-center text-emerald-950">
                                    <%= currentStats.summary.available_slots %>
                                  </td>
                                  <td class="p-2.5 border border-slate-900 text-center">
                                    <%= currentStats.summary.total_families %>
                                  </td>
                                </tr>
                          </tbody>
                        </table>
                      </div>
                      <% } %>

                        <!-- PRINT FOOTER NOTE -->
                        <div
                          class="print-footer pt-3 border-t border-slate-300 text-center text-[11px] text-slate-600 font-semibold">
                          Generated from Evacwar evacuation records &bull; Barangay San Rafael Emergency Operations
                          Command
                        </div>
                        <% } else { %>
                          <div class="p-6 text-center text-slate-400 font-semibold">No evacuation data available for the
                            selected center.</div>
                          <% } %>
              </div>

              <!-- ========================================================================= -->
              <!-- DUAL TILES BELOW EC EVACUATION BOARD                                      -->
              <!-- LEFT: RESIDENTS NOT EVACUATED | RIGHT: CHECKED-IN EVACUEES LIST           -->
              <!-- ========================================================================= -->
              <% const officialZones=['Zone 1', 'Zone 2' , 'Zone 3' , 'Zone 4' , 'Zone 5' , 'Zone 6' , 'Zone 7' ]; const
                uniqueZonesSet=new Set(); ((nonEvacuatedReports && nonEvacuatedReports.list) || []).forEach(h=> {
                if (h.zone && officialZones.includes(h.zone)) {
                uniqueZonesSet.add(h.zone);
                }
                });
                const allZonesList = uniqueZonesSet.size > 0 ? Array.from(uniqueZonesSet).sort() : officialZones;
                const activeEvacueeItems = (evacuationReports && evacuationReports.activeEvacuees &&
                evacuationReports.activeEvacuees.length > 0)
                ? evacuationReports.activeEvacuees
                : ((evacuationReports && evacuationReports.logs) || []).filter(c => c.status === 'ACTIVE' || c.status
                === 'CHECKED_IN');
                const activeHouseholdItems = (evacuationReports && evacuationReports.activeHouseholds &&
                evacuationReports.activeHouseholds.length > 0)
                ? evacuationReports.activeHouseholds
                : (() => {
                const map = {};
                activeEvacueeItems.forEach(c => {
                const resId = c.resident_id || c.id;
                if (!map[resId]) {
                map[resId] = {
                resident_id: resId,
                head_name: c.resident_name || c.evacuee_name || 'Household Head',
                name: c.resident_name || c.evacuee_name || 'Household Head',
                contact_number: c.resident_contact || '',
                home_address: c.resident_purok || 'Barangay San Rafael',
                zone: c.resident_purok || c.resident_barangay || 'Zone 1',
                household_size: 1,
                total_members: 1,
                members: [],
                center_name: c.center_name || 'Evacuation Center',
                check_in_time: c.check_in_time,
                vuln_types: []
                };
                }
                if (c.household_member_id) {
                map[resId].members.push({
                name: c.member_name || c.evacuee_name || 'Family Member',
                first_name: c.member_name || '',
                last_name: '',
                relation: c.member_relation || ''
                });
                map[resId].household_size++;
                map[resId].total_members++;
                }
                if (c.check_in_time && (!map[resId].check_in_time || new Date(c.check_in_time) > new
                Date(map[resId].check_in_time))) {
                map[resId].check_in_time = c.check_in_time;
                }
                });
                return Object.values(map);
                })();
                const nonEvacItems = ((nonEvacuatedReports && nonEvacuatedReports.list) || []).filter(h =>
                !h.is_evacuated && (!h.approval_status || h.approval_status === 'APPROVED'));
                %>
                <div class="space-y-6 no-print" id="evacuationDualTiles">

                  <!-- TOP SECTION: CHECKED-IN EVACUEES (PER HOUSEHOLD) -->
