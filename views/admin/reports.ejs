    <script src="/js/html2pdf.bundle.min.js"></script>
    <script>
      function toggleHouseholdDrawer(hhId) {
        const drawer = document.getElementById('hh-drawer-' + hhId);
        const icon = document.getElementById('hh-icon-' + hhId);
        if (!drawer) return;
        drawer.classList.toggle('hidden');
        if (icon) {
          icon.classList.toggle('ph-caret-down');
          icon.classList.toggle('ph-caret-up');
        }
      }

      function toggleAllHouseholdDrawers(show) {
        const drawers = document.querySelectorAll('.hh-member-drawer');
        const icons = document.querySelectorAll('.hh-caret-icon');
        drawers.forEach(d => {
          if (show === undefined) {
            d.classList.toggle('hidden');
          } else if (show) {
            d.classList.remove('hidden');
          } else {
            d.classList.add('hidden');
          }
        });
        icons.forEach(ic => {
          if (show) {
            ic.classList.remove('ph-caret-down');
            ic.classList.add('ph-caret-up');
          } else if (show === false) {
            ic.classList.add('ph-caret-down');
            ic.classList.remove('ph-caret-up');
          }
        });
      }

      function switchTab(tabName) {
        if (tabName === 'residents') tabName = 'households';
        if (tabName === 'non-evacuated') tabName = 'evacuation';
        document.querySelectorAll('.report-tab-content').forEach(el => el.classList.add('hidden'));
        const activeEl = document.getElementById('tab-' + tabName) || (tabName === 'households' ? document.getElementById('tab-residents') : null);
        if (activeEl) activeEl.classList.remove('hidden');

        document.querySelectorAll('.report-tab-btn').forEach(btn => {
          const btnTab = btn.getAttribute('data-tab');
          const isTarget = btnTab === tabName || (tabName === 'households' && btnTab === 'residents');
          if (isTarget) {
            btn.className = 'report-tab-btn w-full px-2 sm:px-3 py-2.5 rounded-xl text-xs sm:text-[13px] font-bold transition-all flex items-center justify-center gap-1.5 sm:gap-2 text-center bg-blue-600 text-white shadow-sm ring-2 ring-blue-600/20';
          } else {
            btn.className = 'report-tab-btn w-full px-2 sm:px-3 py-2.5 rounded-xl text-xs sm:text-[13px] font-bold transition-all flex items-center justify-center gap-1.5 sm:gap-2 text-center text-slate-700 hover:text-slate-950 bg-slate-50 hover:bg-slate-100 border border-slate-200/80';
          }
        });

        if (tabName === 'sos' && typeof filterAdminSosTable === 'function') {
          filterAdminSosTable();
        }

        const url = new URL(window.location.href);
        url.searchParams.set('tab', tabName);
        window.history.pushState({}, '', url);
      }

      // =========================================================================
      // ADMIN SOS REPORTS INTERACTIVE CONTROLS
      // =========================================================================
      let adminSosCurrentStatus = 'ALL';

      function setAdminSosStatus(status, btn) {
        adminSosCurrentStatus = status;
        document.querySelectorAll('.admin-sos-status-btn').forEach(b => {
          b.className = 'admin-sos-status-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200';
        });
        if (btn) {
          btn.className = 'admin-sos-status-btn px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-rose-600 text-white shadow-2xs';
        }
        filterAdminSosTable();
      }

      function filterByRescuerName(rescuerName) {
        switchTab('sos');
        const sel = document.getElementById('adminSosRescuerSelect');
        if (sel) {
          sel.value = rescuerName.toLowerCase();
        }
        filterAdminSosTable();
      }

      function filterAdminSosTable() {
        const query = (document.getElementById('adminSosSearch')?.value || '').toLowerCase().trim();
        const rescuerVal = (document.getElementById('adminSosRescuerSelect')?.value || 'all').toLowerCase().trim();
        const rows = document.querySelectorAll('.admin-sos-row');
        let visibleCount = 0;

        rows.forEach(r => {
          const resident = (r.getAttribute('data-resident') || '').toLowerCase();
          const contact = (r.getAttribute('data-contact') || '').toLowerCase();
          const location = (r.getAttribute('data-location') || '').toLowerCase();
          const handler = (r.getAttribute('data-handler') || '').toLowerCase();
          const status = (r.getAttribute('data-status') || '').toUpperCase();
          const notes = (r.getAttribute('data-notes') || '').toLowerCase();

          // Rescuer filter
          if (rescuerVal !== 'all' && !handler.includes(rescuerVal)) {
            r.style.display = 'none';
            return;
          }

          // Status filter
          let matchesStatus = true;
          if (adminSosCurrentStatus === 'ACTIVE') matchesStatus = (status === 'ACTIVE');
          else if (adminSosCurrentStatus === 'RESPONDING') matchesStatus = (status === 'RESPONDING' || status === 'ACKNOWLEDGED');
          else if (adminSosCurrentStatus === 'RESCUED') matchesStatus = (status === 'RESCUED');
          else if (adminSosCurrentStatus === 'RESOLVED') matchesStatus = (status === 'RESOLVED');

          // Query filter
          const matchesQuery = !query || resident.includes(query) || contact.includes(query) || location.includes(query) || handler.includes(query) || notes.includes(query);

          if (matchesStatus && matchesQuery) {
            r.style.display = '';
            visibleCount++;
          } else {
            r.style.display = 'none';
          }
        });

        const emptyNotice = document.getElementById('adminSosEmptyNotice');
        if (emptyNotice) {
          if (visibleCount === 0 && rows.length > 0) {
            emptyNotice.classList.remove('hidden');
          } else {
            emptyNotice.classList.add('hidden');
          }
        }
      }

      function resetAdminSosFilters() {
        const search = document.getElementById('adminSosSearch');
        if (search) search.value = '';
        const sel = document.getElementById('adminSosRescuerSelect');
        if (sel) sel.value = 'all';
        adminSosCurrentStatus = 'ALL';
        const firstBtn = document.querySelector('.admin-sos-status-btn');
        if (firstBtn) setAdminSosStatus('ALL', firstBtn);
        else filterAdminSosTable();
      }

      function printSingleEcReport() {
        switchTab('evacuation');
        document.body.classList.add('printing-ec-board');
        setTimeout(() => {
          window.print();
          document.body.classList.remove('printing-ec-board');
        }, 150);
      }

      function printActiveReport() {
        const activeBtn = document.querySelector('.report-tab-btn.bg-blue-600, .report-tab-btn.bg-rose-600');
        const activeTab = activeBtn ? activeBtn.getAttribute('data-tab') : 'overview';
        if (activeTab === 'evacuation') {
          printSingleEcReport();
          return;
        }
        if (activeTab === 'non-evacuated') {
          printNonEvacuatedReport();
          return;
        }
        const activeContainer = document.getElementById('tab-' + activeTab);
        if (activeContainer) {
          activeContainer.querySelectorAll('.member-drawer-content').forEach(el => el.classList.remove('hidden'));
        }
        setTimeout(() => window.print(), 150);
      }

      // =========================================================================
      // DIRECT CLIENT-SIDE PDF FILE DOWNLOAD ENGINE
      // =========================================================================
      function showPdfToast(message, isSuccess = null) {
        let toast = document.getElementById('pdf-export-toast');
        if (!toast) {
          toast = document.createElement('div');
          toast.id = 'pdf-export-toast';
          document.body.appendChild(toast);
        }
        if (isSuccess === true) {
          toast.className = 'fixed bottom-5 right-5 z-[9999] px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 text-xs font-bold transition-all duration-300 transform translate-y-0 opacity-100 bg-emerald-950 text-emerald-200 border border-emerald-700/80';
          toast.innerHTML = '<i class="ph ph-check-circle text-lg text-emerald-400"></i> <span>' + message + '</span>';
        } else if (isSuccess === false) {
          toast.className = 'fixed bottom-5 right-5 z-[9999] px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 text-xs font-bold transition-all duration-300 transform translate-y-0 opacity-100 bg-rose-950 text-rose-200 border border-rose-700/80';
          toast.innerHTML = '<i class="ph ph-warning-circle text-lg text-rose-400"></i> <span>' + message + '</span>';
        } else {
          toast.className = 'fixed bottom-5 right-5 z-[9999] px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 text-xs font-bold transition-all duration-300 transform translate-y-0 opacity-100 bg-slate-900 text-white border border-slate-700';
          toast.innerHTML = '<i class="ph ph-spinner animate-spin text-lg text-blue-400"></i> <span>' + message + '</span>';
        }

        if (isSuccess !== null) {
          setTimeout(() => {
            if (toast) {
              toast.className = 'fixed bottom-5 right-5 z-[9999] px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2.5 text-xs font-bold transition-all duration-300 transform translate-y-10 opacity-0 pointer-events-none bg-slate-900 text-white border border-slate-700';
            }
          }, 4000);
        }
      }

      async function downloadPdfViaPuppeteer(tab, centerId = 'all', defaultFilename = 'Evacwar_Report.pdf') {
        const pdfButtons = document.querySelectorAll('button[onclick*="PDF"]');
        const originalStates = [];
        pdfButtons.forEach(btn => {
          originalStates.push({ btn, html: btn.innerHTML, disabled: btn.disabled });
          btn.disabled = true;
          btn.innerHTML = '<i class="ph ph-spinner animate-spin text-sm"></i> <span>Exporting PDF...</span>';
        });

        showPdfToast('Generating PDF file, please wait...');

        try {
          const queryParams = new URLSearchParams({ tab, centerId });

          // 1. Try server-side Puppeteer export first
          let serverSuccess = false;
          try {
            const res = await fetch(`/admin/reports/export-pdf?${queryParams.toString()}`);
            if (res.ok) {
              const blob = await res.blob();
              if (blob && blob.size > 1000) {
                let downloadName = defaultFilename;
                const disposition = res.headers.get('Content-Disposition');
                if (disposition && disposition.includes('filename=')) {
                  const match = disposition.match(/filename="?([^"]+)"?/);
                  if (match && match[1]) downloadName = match[1];
                }

                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = downloadName;
                document.body.appendChild(a);
                a.click();

                setTimeout(() => {
                  window.URL.revokeObjectURL(url);
                  if (a.parentNode) a.parentNode.removeChild(a);
                }, 1500);

                showPdfToast('PDF exported successfully: ' + downloadName, true);
                serverSuccess = true;
                return;
              }
            }
          } catch (serverErr) {
            console.warn('[PDF Export] Server export unavailable, switching to browser PDF engine...', serverErr);
          }

          // 2. Client-side PDF engine (captures directly from active DOM, 100% filled, zero blank pages)
          showPdfToast('Exporting PDF file, please wait...');

          // Ensure html2pdf bundle is loaded
          if (typeof html2pdf === 'undefined') {
            await new Promise((resolve, reject) => {
              const s1 = document.createElement('script');
              s1.src = '/js/html2pdf.bundle.min.js';
              s1.onload = resolve;
              s1.onerror = () => {
                const s2 = document.createElement('script');
                s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
                s2.onload = resolve;
                s2.onerror = reject;
                document.head.appendChild(s2);
              };
              document.head.appendChild(s1);
            });
          }

          // Locate the element corresponding to the requested tab
          let targetEl = null;
          if (tab === 'evacuation') {
            targetEl = document.getElementById('printable-ec-board-report') || document.getElementById('tab-evacuation');
          } else if (tab === 'non-evacuated') {
            targetEl = document.getElementById('printable-non-evac-report') || document.getElementById('tab-non-evacuated');
          } else if (tab === 'households' || tab === 'residents') {
            targetEl = document.getElementById('tab-households') || document.getElementById('tab-residents');
          } else if (tab === 'sos') {
            targetEl = document.getElementById('tab-sos');
          } else if (tab === 'sms') {
            targetEl = document.getElementById('tab-sms');
          } else {
            targetEl = document.getElementById('tab-overview');
          }

          if (!targetEl) {
            throw new Error('Report section could not be found.');
          }

          // Temporarily unhide if hidden
          const wasHidden = targetEl.classList.contains('hidden');
          if (wasHidden) targetEl.classList.remove('hidden');

          // Clean export formatting (zero outer borders or outlines on report)
          targetEl.classList.add('pdf-export-clone');
          const originalBorder = targetEl.style.border;
          const originalRadius = targetEl.style.borderRadius;
          const originalShadow = targetEl.style.boxShadow;
          targetEl.style.border = 'none';
          targetEl.style.borderRadius = '0';
          targetEl.style.boxShadow = 'none';

          // Prepend temporary official header if none exists in this section
          let tempHeader = null;
          if (!targetEl.querySelector('.print-header')) {
            tempHeader = document.createElement('div');
            tempHeader.className = 'print-header';
            tempHeader.style.cssText = 'border-bottom: 2px solid #0f172a; padding-bottom: 8px; margin-bottom: 14px;';
            tempHeader.innerHTML = `
              <h1 style="font-size: 15px; font-weight: 900; color: #0f172a; margin: 0; text-transform: uppercase;">
                BARANGAY SAN RAFAEL &mdash; EVACWAR EMERGENCY OPERATIONS
              </h1>
              <h2 style="font-size: 11px; font-weight: 700; color: #334155; margin: 3px 0 0 0;">
                Command Operations & Emergency Masterlist
              </h2>
              <p style="font-size: 9px; color: #64748b; margin: 2px 0 0 0;">
                Official Public Document &bull; Generated: ${new Date().toLocaleDateString()}
              </p>
            `;
            targetEl.insertBefore(tempHeader, targetEl.firstChild);
          }

          const opt = {
            margin: [6, 6, 6, 6],
            filename: defaultFilename,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: {
              scale: 2,
              useCORS: true,
              logging: false,
              backgroundColor: '#ffffff'
            },
            jsPDF: {
              unit: 'mm',
              format: 'a4',
              orientation: 'portrait'
            }
          };

          try {
            await html2pdf().set(opt).from(targetEl).save();
            showPdfToast('PDF exported successfully: ' + defaultFilename, true);
          } finally {
            if (tempHeader && tempHeader.parentNode) {
              tempHeader.parentNode.removeChild(tempHeader);
            }
            targetEl.classList.remove('pdf-export-clone');
            targetEl.style.border = originalBorder;
            targetEl.style.borderRadius = originalRadius;
            targetEl.style.boxShadow = originalShadow;
            if (wasHidden) targetEl.classList.add('hidden');
          }
        } catch (err) {
          console.error('[PDF Export] Failed:', err);
          showPdfToast('PDF export failed: ' + (err.message || 'Unknown error'), false);
        } finally {
          originalStates.forEach(s => {
            s.btn.innerHTML = s.html;
            s.btn.disabled = s.disabled;
          });
        }
      }

      function exportReportPDF() {
        const activeBtn = document.querySelector('.report-tab-btn.bg-blue-600, .report-tab-btn.bg-rose-600');
        const activeTab = activeBtn ? activeBtn.getAttribute('data-tab') : 'overview';
        const dateStr = new Date().toISOString().slice(0, 10);

        if (activeTab === 'evacuation') {
          exportEcBoardPDF();
          return;
        }
        if (activeTab === 'non-evacuated') {
          exportNonEvacuatedPDF();
          return;
        }
        if (activeTab === 'households' || activeTab === 'residents') {
          downloadPdfViaPuppeteer('households', 'all', `Evacwar_Household_Masterlist_${dateStr}.pdf`);
          return;
        }
        if (activeTab === 'sos') {
          downloadPdfViaPuppeteer('sos', 'all', `Evacwar_SOS_Rescue_Log_${dateStr}.pdf`);
          return;
        }
        if (activeTab === 'sms') {
          downloadPdfViaPuppeteer('sms', 'all', `Evacwar_SMS_Broadcast_Log_${dateStr}.pdf`);
          return;
        }

        // Default: overview tab
        downloadPdfViaPuppeteer('overview', 'all', `Evacwar_Command_Overview_${dateStr}.pdf`);
      }

      function exportEcBoardPDF() {
        const select = document.getElementById('ecBoardViewSelect');
        const centerId = (select && select.value) ? select.value : 'all';
        const centerName = (select && select.value !== 'all') ? (select.options[select.selectedIndex]?.text?.trim()?.replace(/[^a-zA-Z0-9_-]/g, '_') || 'Center') : 'All_Centers';
        const dateStr = new Date().toISOString().slice(0, 10);
        const filename = `Evacwar_EC_Board_${centerName}_${dateStr}.pdf`;
        downloadPdfViaPuppeteer('evacuation', centerId, filename);
      }

      function exportNonEvacuatedPDF() {
        const dateStr = new Date().toISOString().slice(0, 10);
        const filename = `Evacwar_Residents_Not_Yet_Evacuated_${dateStr}.pdf`;
        downloadPdfViaPuppeteer('non-evacuated', 'all', filename);
      }

      // Backwards compatibility alias
      function generateAndDownloadPDF(targetEl, filename, options = {}) {
        exportReportPDF();
      }

      // =========================================================================
      // DUAL TILES INTERACTIVE CONTROLS (NOT EVACUATED & EVACUATED LISTS)
      // =========================================================================
      function filterTileNotEvacuated() {
        const query = (document.getElementById('tileNotEvacSearch')?.value || '').trim().toLowerCase();
        const zoneVal = (document.getElementById('tileNotEvacZoneFilter')?.value || 'all').toLowerCase();
        let visibleCount = 0;

        document.querySelectorAll('.tile-not-evac-row').forEach(row => {
          const nameData = row.getAttribute('data-name') || '';
          const zoneData = row.getAttribute('data-zone') || '';
          const addrData = row.getAttribute('data-address') || '';

          const matchQuery = !query || nameData.includes(query) || addrData.includes(query);
          const matchZone = zoneVal === 'all' || zoneData === zoneVal;

          if (matchQuery && matchZone) {
            row.classList.remove('hidden');
            visibleCount++;
          } else {
            row.classList.add('hidden');
          }
        });

        const badge = document.getElementById('notEvacCountBadge');
        if (badge) badge.innerText = `${visibleCount} Families`;

        const noResults = document.getElementById('tileNotEvacNoResults');
        if (noResults) {
          if (visibleCount === 0) noResults.classList.remove('hidden');
          else noResults.classList.add('hidden');
        }
      }

      function filterTileEvacuated() {
        const query = (document.getElementById('tileEvacSearch')?.value || '').trim().toLowerCase();
        let visibleCount = 0;

        document.querySelectorAll('.tile-evac-row').forEach(row => {
          const nameData = row.getAttribute('data-name') || '';
          const centerData = row.getAttribute('data-center') || '';
          const purokData = row.getAttribute('data-purok') || '';

          const matchQuery = !query || nameData.includes(query) || centerData.includes(query) || purokData.includes(query);

          if (matchQuery) {
            row.classList.remove('hidden');
            visibleCount++;
          } else {
            row.classList.add('hidden');
          }
        });

        const badge = document.getElementById('evacCountBadge');
        if (badge) badge.innerText = `${visibleCount} In Shelter`;

        const noResults = document.getElementById('tileEvacNoResults');
        if (noResults) {
          if (visibleCount === 0) noResults.classList.remove('hidden');
          else noResults.classList.add('hidden');
        }
      }

      function printNonEvacuatedReport() {
        switchTab('evacuation');
        const tilesEl = document.getElementById('evacuationDualTiles');
        if (tilesEl) tilesEl.scrollIntoView({ behavior: 'smooth' });
      }

      window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const tabParam = urlParams.get('tab');
        if (tabParam) {
          switchTab(tabParam);
        }
        if (urlParams.get('print') === '1') {
          const targetTab = tabParam || 'overview';
          if (targetTab === 'evacuation' || targetTab === 'non-evacuated') {
            document.body.classList.add('printing-ec-board');
          }
          setTimeout(() => {
            window.print();
            document.body.classList.remove('printing-ec-board');
          }, 350);
        }
      });
    </script>

