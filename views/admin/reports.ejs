                    class="bg-white rounded-2xl border border-emerald-200/90 shadow-2xs overflow-hidden flex flex-col">
                    <!-- Header -->
                    <div
                      class="p-4 bg-gradient-to-r from-emerald-50/90 via-teal-50/40 to-white border-b border-emerald-200/80 flex items-center justify-between gap-3">
