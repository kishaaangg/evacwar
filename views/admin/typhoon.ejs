    function updateTyphoonUI(w) {
      if (!w) return;
      const tempNum = w.temperature != null ? Number(w.temperature) : 26.6;
      const rounded = Math.round(tempNum);
      const apparent = w.apparent_temperature != null ? Number(w.apparent_temperature) : Number((tempNum + 3.8).toFixed(1));
      const dew = w.dew_point != null ? Number(w.dew_point) : Number((tempNum - 2.0).toFixed(1));

      const dayEl = document.getElementById('typhoonDay');
      if (dayEl) dayEl.textContent = (new Date()).toLocaleDateString('en-US', { weekday: 'long' });

      const locLabel = document.getElementById('typhoonLocationLabel');
      if (locLabel && w.location_name) locLabel.textContent = w.location_name;

      const iconContainer = document.getElementById('typhoonStatusIconContainer');
      if (iconContainer) {
        iconContainer.innerHTML = clientWindySvg('windy-sun-rain', 'w-11 h-11');
      }

      const tempMainEl = document.getElementById('typhoonTempMain');
      const tempEl = document.getElementById('typhoonTemp');
      const heatIndexEl = document.getElementById('typhoonHeatIndex');
      const windChillEl = document.getElementById('typhoonWindChill');
      const dewpointEl = document.getElementById('typhoonDewpoint');
      const windEl = document.getElementById('typhoonWind');
      const gustsEl = document.getElementById('typhoonGusts');
      const pressureEl = document.getElementById('typhoonPressure');
      const humidityEl = document.getElementById('typhoonHumidity');
      const rainEl = document.getElementById('typhoonRain');
      const rainRateEl = document.getElementById('typhoonRainRate');
      const rainTotalEl = document.getElementById('typhoonRainTotal');
      const peakTag = document.getElementById('chartCalloutPeak');
      const lowTag = document.getElementById('chartCalloutLow');
      const windGustTag = document.getElementById('chartWindGustTag');
      const windSpeedTag = document.getElementById('chartWindSpeedTag');

      if (tempMainEl) tempMainEl.textContent = rounded + '°C';
      if (tempEl) tempEl.textContent = tempNum;
      if (heatIndexEl) heatIndexEl.textContent = apparent;
      if (windChillEl) windChillEl.textContent = (tempNum - 1.2).toFixed(1);
      if (dewpointEl) dewpointEl.textContent = dew;
      if (windEl) windEl.textContent = w.wind_speed != null ? w.wind_speed : 18.3;
      if (gustsEl) gustsEl.textContent = w.wind_gusts != null ? w.wind_gusts : 39.6;
      if (pressureEl) pressureEl.textContent = w.pressure != null ? w.pressure : 998.4;
      if (humidityEl) humidityEl.textContent = w.humidity != null ? w.humidity : 89;
      if (rainEl) rainEl.textContent = w.rainfall != null ? w.rainfall : 0.2;
      if (rainRateEl) rainRateEl.textContent = w.rainfall != null ? w.rainfall : 0.2;
      if (rainTotalEl) rainTotalEl.textContent = w.rainfall != null ? w.rainfall : 0.2;
      if (windGustTag && w.wind_gusts) windGustTag.textContent = Math.round(w.wind_gusts);
      if (windSpeedTag && w.wind_speed) windSpeedTag.textContent = Math.round(w.wind_speed);

      // Update 5-day forecast row if returned
      if (w.daily && Array.isArray(w.daily) && w.daily.length >= 5) {
        const rangeEl = document.getElementById('typhoonTempRange');
        if (rangeEl) rangeEl.textContent = `${w.daily[0].temp_max}° / ${w.daily[0].temp_min}°`;
        const grid = document.getElementById('forecastGrid');
        if (grid) {
          grid.innerHTML = w.daily.slice(0, 5).map((df, i) => {
            const iconKey = (i === 0) ? 'windy-sun-rain' : df.icon;
            return `
              <div class="flex flex-col items-center gap-1.5 p-1 rounded-xl ${i === 0 ? 'bg-blue-50/70 border border-blue-100' : ''}">
                <span class="text-xs font-semibold text-slate-700">${df.day_name}</span>
                ${clientWindySvg(iconKey, 'w-7 h-7')}
                <div class="text-xs font-mono font-bold text-slate-900 mt-0.5">${df.temp_max}°</div>
                <div class="text-[10px] font-mono text-slate-400">${df.temp_min}°</div>
              </div>
            `;
          }).join('');
        }
      }
    }

    // Use device GPS location
    async function useMyLocationTyphoon(btn) {
      const icon = document.getElementById('typhoonLocIcon');
      if (icon) icon.classList.add('animate-spin');
      if (btn) btn.disabled = true;

      try {
        if (!window.EvakwarWeatherLocation) {
          throw new Error('Location manager is still loading. Please try again in a moment.');
        }
        const coords = await window.EvakwarWeatherLocation.getCurrentPosition();
        const weather = await window.EvakwarWeatherLocation.fetchWeather(coords);
        updateTyphoonUI(weather);
        window.EvakwarWeatherLocation.showToast('Updated weather for your device location!');
      } catch (err) {
        console.warn('GPS location retrieval error:', err.message);
        if (window.EvakwarWeatherLocation) {
          window.EvakwarWeatherLocation.showToast(err.message, true);
        } else {
          alert(err.message);
        }
      } finally {
        if (icon) icon.classList.remove('animate-spin');
        if (btn) btn.disabled = false;
      }
    }

    // Live synchronization with Open-Meteo (respects saved location if present)
    async function refreshTyphoonData(btn) {
      const icon = document.getElementById('refreshIcon');
      if (icon) icon.classList.add('animate-spin');
      if (btn) btn.disabled = true;
      try {
        const saved = (window.EvakwarWeatherLocation) ? window.EvakwarWeatherLocation.getSavedLocation() : null;
        const res = await fetch('/api/weather/refresh', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(saved || {})
        });
        const data = await res.json();
        if (data.success && data.weather) {
          updateTyphoonUI(data.weather);
        }
      } catch (err) {
        console.error('Open-Meteo refresh error:', err);
      } finally {
        if (icon) icon.classList.remove('animate-spin');
        if (btn) btn.disabled = false;
      }
    }

    // Automatic Live / Latest PAGASA Video Auto-Updater
    let currentPagasaVideoId = '<%= (pagasaData.youtube && pagasaData.youtube.videoId) ? pagasaData.youtube.videoId : "AgcXtAFRGkw" %>';
    let currentPagasaIsLive = ('<%= (pagasaData.youtube && pagasaData.youtube.isLive) ? "true" : "false" %>' === 'true');

    async function checkPagasaVideoUpdate() {
      try {
        const res = await fetch('/api/weather/pagasa', { cache: 'no-store' });
        const data = await res.json();
        if (!data || !data.success || !data.pagasa || !data.pagasa.youtube) return;

        const yt = data.pagasa.youtube;
        const badgeContainer = document.getElementById('pagasaLiveStatusBadge');
        const titleEl = document.getElementById('pagasaVideoTitle');
        const publishedEl = document.getElementById('pagasaVideoPublished');
        const iframe = document.getElementById('pagasaVideoIframe');

        if (titleEl && yt.title) {
          titleEl.textContent = yt.title;
          titleEl.setAttribute('title', yt.title);
        }

        if (publishedEl && yt.formattedPublished) {
          publishedEl.textContent = 'Issued: ' + yt.formattedPublished;
        }

        // Dynamically show 🔴 LIVE badge ONLY if PAGASA has an active live broadcast
        if (badgeContainer) {
          if (yt.isLive) {
            badgeContainer.innerHTML = `
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-red-600 text-white text-[10px] font-black uppercase tracking-wider shadow-xs animate-pulse">
                <span class="w-1.5 h-1.5 rounded-full bg-white"></span> 🔴 LIVE
              </span>
              <span class="text-xs font-black uppercase tracking-wider text-slate-800">
                DOST-PAGASA WEATHER UPDATE
              </span>
            `;
          } else {
            badgeContainer.innerHTML = `
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 text-[10px] font-black tracking-tight border border-blue-200/60 uppercase">
                📺 Latest DOST-PAGASA Weather Forecast
              </span>
            `;
          }
        }

        // Seamlessly update video player when PAGASA starts a live broadcast or posts a new forecast
        if (yt.videoId && yt.embedUrl && (yt.videoId !== currentPagasaVideoId || yt.isLive !== currentPagasaIsLive)) {
          currentPagasaVideoId = yt.videoId;
          currentPagasaIsLive = Boolean(yt.isLive);
          if (iframe) {
            iframe.src = yt.embedUrl;
          }
        }
      } catch (err) {
        // Silent check - keep current stable video without interruption
      }
    }

    // Trigger update immediately on page load, then periodically every 3 minutes (180,000ms)
    checkPagasaVideoUpdate();
    setInterval(checkPagasaVideoUpdate, 180000);

    // Load official YouTube IFrame API asynchronously
    (function () {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      tag.async = true;
      const firstScriptTag = document.getElementsByTagName('script')[0];
      if (firstScriptTag && firstScriptTag.parentNode) {
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
      }
    })();

    // Recenter Windy map to San Rafael (Ikpan), Baao, Camarines Sur
    function resetWindyView() {
      const iframe = document.getElementById('windyIframe');
      if (iframe) {
        iframe.src = "https://embed.windy.com/embed.html?type=map&location=coordinates&metricRain=mm&metricTemp=°C&metricWind=km/h&zoom=11&overlay=wind&product=ecmwf&level=surface&lat=13.5104&lon=123.3481&detailLat=13.5104&detailLon=123.3481&detail=true&pressure=true";
      }
    }
  </script>
