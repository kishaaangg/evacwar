          </g>
          <path d="M11 25 C7.7 25 5 22.3 5 19 C5 16 7.2 13.5 10.2 13.1 C11.1 9.8 14.1 7.5 17.7 7.5 C21.8 7.5 25.1 10.5 25.8 14.5 C26.2 14.4 26.6 14.3 27 14.3 C30.3 14.3 33 17 33 20.3 C33 23.6 30.3 25 27 25 Z" fill="#607D8B" />
          <path d="M17 23 L13.5 28 H17 L15 32.5 L20.5 27 H17 Z" fill="#FFD600" stroke="#FFA000" stroke-width="0.5" />
          <line x1="23" y1="27" x2="21.5" y2="31.5" stroke="#0288D1" stroke-width="2.2" stroke-linecap="round" />
        </svg>`;
      }
      if (name.includes('sun') && (name.includes('cloud') || name.includes('partly'))) {
        return `<svg viewBox="0 0 36 36" class="${size} select-none shrink-0" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="23" cy="13" r="6.5" fill="#FFA000" />
          <g stroke="#FF8F00" stroke-width="1.8" stroke-linecap="round">
            <line x1="23" y1="3" x2="23" y2="5" /><line x1="23" y1="21" x2="23" y2="23" />
