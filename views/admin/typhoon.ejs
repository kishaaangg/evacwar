            <line x1="13" y1="13" x2="15" y2="13" /><line x1="31" y1="13" x2="33" y2="13" />
            <line x1="16" y1="6" x2="17.4" y2="7.4" /><line x1="28.6" y1="18.6" x2="30" y2="20" />
