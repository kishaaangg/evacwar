    // Use device GPS location for Admin Dashboard Weather
    async function useMyLocationDashboard(btn) {
      const icon = document.getElementById('dashLocIcon');
      if (icon) icon.classList.add('animate-spin');
      if (btn) btn.disabled = true;

      try {
        if (!window.EvakwarWeatherLocation) {
          throw new Error('Location manager is still loading. Please try again in a moment.');
        }
        const coords = await window.EvakwarWeatherLocation.getCurrentPosition();
        const weather = await window.EvakwarWeatherLocation.fetchWeather(coords);
        updateDashboardWeatherUI(weather);
        window.EvakwarWeatherLocation.showToast('Updated weather for your device location!');
      } catch (err) {
        console.warn('GPS location retrieval error:', err.message);
        if (window.EvakwarWeatherLocation) {
          window.EvakwarWeatherLocation.showToast(err.message, true);
        } else {
          alert(err.message);
        }
      } finally {
        if (icon) icon.classList.remove('animate-spin');
        if (btn) btn.disabled = false;
      }
    }

    async function refreshWeatherData(btn) {
      const icon = document.getElementById('weatherRefreshIcon');
      if (icon) icon.classList.add('animate-spin');
      if (btn) btn.disabled = true;

      try {
        const saved = (window.EvakwarWeatherLocation) ? window.EvakwarWeatherLocation.getSavedLocation() : null;
        const res = await fetch('/api/weather/refresh', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(saved || {})
        });
        const data = await res.json();
        if (data.success && data.weather) {
          updateDashboardWeatherUI(data.weather);
        }
      } catch (err) {
        console.error('Failed to refresh weather telemetry:', err);
      } finally {
        if (icon) icon.classList.remove('animate-spin');
        if (btn) btn.disabled = false;
      }
    }

    // Live ticking clock for Regional Weather Telemetry Card
    function tickWeatherClock() {
      const timeEl = document.getElementById('weatherTime');
      const dayEl = document.getElementById('weatherDay');
      const now = new Date();
      if (timeEl) {
        timeEl.textContent = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }).toLowerCase();
      }
      if (dayEl) {
        dayEl.textContent = now.toLocaleDateString('en-US', { weekday: 'long' });
      }
    }
    setInterval(tickWeatherClock, 1000);
    tickWeatherClock();

    // Audio Chime generator using Web Audio API (matches Staff interface)
    let adminAudioCtx = null;
    function getAdminAudioContext() {
      try {
        if (!adminAudioCtx) {
          const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
          if (AudioCtxClass) adminAudioCtx = new AudioCtxClass();
        }
        if (adminAudioCtx && adminAudioCtx.state === 'suspended') {
          adminAudioCtx.resume().catch(() => {});
        }
      } catch (e) {
        console.warn('AudioContext init skipped:', e);
      }
      return adminAudioCtx;
    }

    ['click', 'touchstart', 'keydown'].forEach(evt => {
      document.addEventListener(evt, () => {
        getAdminAudioContext();
      }, { once: true, passive: true });
    });

    function playEmergencyChime() {
      try {
        const ctx = getAdminAudioContext();
        if (!ctx) return;
        if (ctx.state === 'suspended') {
          ctx.resume().catch(() => {});
        }
        const now = ctx.currentTime;

        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = 'sawtooth';
        osc1.frequency.setValueAtTime(880, now);
        osc1.frequency.exponentialRampToValueAtTime(440, now + 0.35);
        gain1.gain.setValueAtTime(0.35, now);
        gain1.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.start(now);
        osc1.stop(now + 0.35);

        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(1200, now + 0.2);
        osc2.frequency.exponentialRampToValueAtTime(600, now + 0.55);
        gain2.gain.setValueAtTime(0.35, now + 0.2);
        gain2.gain.exponentialRampToValueAtTime(0.01, now + 0.55);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now + 0.2);
        osc2.stop(now + 0.55);
      } catch (e) {
        console.warn('Emergency audio chime skipped:', e);
      }
    }

    // Top-Right Floating SOS Pop-Up Management
    const activeAdminToasts = new Map();

    function showAdminSosToast(alert, playSound = true) {
      if (!alert) return;
      if (typeof window.showGlobalDistressNotification === 'function') {
        window.showGlobalDistressNotification(alert);
        return;
      }
      const sosId = alert.id || 'temp_' + Date.now();

      let container = document.getElementById('adminSosToastContainer');
      if (!container) {
        container = document.createElement('div');
        container.id = 'adminSosToastContainer';
        container.className = 'fixed top-16 sm:top-20 right-4 z-50 flex flex-col gap-3 pointer-events-none max-w-sm sm:max-w-md w-full px-2';
        document.body.appendChild(container);
      }

      const resName = alert.name || (alert.first_name ? `${alert.first_name} ${alert.last_name || ''}`.trim() : 'Resident');
      const barangay = alert.barangay || 'San Rafael';
      const status = (alert.status || 'ACTIVE').toUpperCase();
      const statusBadgeBg = status === 'ACKNOWLEDGED' ? 'bg-amber-400 text-slate-950' : 
                           (status === 'RESPONDING' ? 'bg-indigo-200 text-indigo-950' : 
                           (status === 'RESCUED' ? 'bg-emerald-200 text-emerald-950' : 'bg-red-900/80 text-white animate-pulse'));

      let handlerHtml = '';
      if (alert.handler_name) {
        handlerHtml = `<i class="ph ph-user-check text-emerald-300 text-sm"></i><span>Acknowledged by: <strong class="text-white">${alert.handler_name}</strong></span>`;
      } else {
        handlerHtml = `<i class="ph ph-clock text-amber-300 text-sm"></i><span>Situation: <strong class="text-white">Awaiting Staff Acknowledgment</strong></span>`;
      }

      const existingToast = document.getElementById(`adminSosToast_${sosId}`);
      if (existingToast) {
        const badge = existingToast.querySelector('.sos-status-badge');
        if (badge) {
          badge.className = `sos-status-badge text-[10px] font-black uppercase px-2 py-0.5 rounded-full ${statusBadgeBg}`;
          badge.innerText = status;
        }
        const handler = existingToast.querySelector('.sos-handler-info');
        if (handler) handler.innerHTML = handlerHtml;
        return;
      }

      const toast = document.createElement('div');
      toast.id = `adminSosToast_${sosId}`;
      toast.className = 'pointer-events-auto bg-gradient-to-r from-red-600 via-rose-600 to-red-700 text-white p-4 rounded-2xl shadow-2xl shadow-red-900/40 border border-red-400/80 transform transition-all duration-300 ease-out translate-y-3 opacity-0 flex flex-col gap-2.5 backdrop-blur-md';
      toast.innerHTML = `
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-10 h-10 rounded-xl bg-white/20 backdrop-blur-md flex items-center justify-center font-black text-xl shrink-0 shadow-inner animate-pulse">
              <i class="ph ph-siren text-white"></i>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="bg-white/20 text-white text-[10px] font-black uppercase px-2 py-0.5 rounded-full tracking-wider border border-white/30">
                  Urgent Distress Signal
                </span>
                <span class="sos-status-badge text-[10px] font-black uppercase px-2 py-0.5 rounded-full ${statusBadgeBg}">
                  ${status}
                </span>
              </div>
              <h4 class="font-black text-sm sm:text-base text-white leading-tight mt-1 truncate">
                ${resName}
                <span class="text-red-200 text-xs font-bold font-mono">• ${barangay}</span>
              </h4>
            </div>
          </div>
          <button type="button" onclick="dismissAdminSosToast('${sosId}')" class="text-white/80 hover:text-white p-1 rounded-lg hover:bg-white/10 transition-colors shrink-0" title="Dismiss">
            <i class="ph ph-x text-lg"></i>
          </button>
        </div>
        
        <div class="sos-handler-info text-xs text-red-100 font-medium flex items-center gap-1.5 pl-0.5">
          ${handlerHtml}
        </div>

        <div class="flex items-center justify-between gap-2 pt-2 border-t border-white/20 mt-0.5">
          <span class="text-[11px] text-red-100/90 font-medium flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Live Signal
          </span>
          <a href="/admin/evacuation?sos_id=${sosId}" class="px-3.5 py-1.5 bg-white text-red-700 hover:bg-red-50 font-black rounded-xl text-xs uppercase tracking-wider transition-all shadow-md flex items-center gap-1.5 active:scale-95 shrink-0">
            <i class="ph ph-navigation-arrow"></i> Dispatch & Radar Map
          </a>
        </div>
      `;

      container.prepend(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-3', 'opacity-0');
      });

      if (playSound) {
        playEmergencyChime();
      }

      // Auto dismiss after 25 seconds
      const timer = setTimeout(() => {
        dismissAdminSosToast(sosId);
      }, 25000);

      activeAdminToasts.set(sosId, timer);
    }

    function dismissAdminSosToast(sosId) {
      if (typeof window.dismissGlobalDistressBanner === 'function') {
        window.dismissGlobalDistressBanner(sosId);
      }
      const toast = document.getElementById(`adminSosToast_${sosId}`);
      if (toast) {
        toast.classList.add('opacity-0', 'translate-y-3');
        setTimeout(() => {
          if (toast && toast.parentElement) toast.remove();
        }, 300);
      }
      if (activeAdminToasts.has(sosId)) {
        clearTimeout(activeAdminToasts.get(sosId));
        activeAdminToasts.delete(sosId);
      }
    }

    function updateEmergencyCasesCard(count) {
      const cardContainer = document.getElementById('cardEmergencyCasesContainer');
      const cardCount = document.getElementById('cardEmergencyCasesCount');
      const cardBadge = document.getElementById('cardEmergencyCasesBadge');
      const cardSubtext = document.getElementById('cardEmergencyCasesSubtext');
      const cardDistressStatus = document.getElementById('cardEmergencyCasesDistressStatus');
      const cardPendingCount = document.getElementById('cardEmergencyCasesPendingCount');
      const cardIcon = document.getElementById('cardEmergencyCasesIcon');

      const isSos = count > 0;
      if (cardCount) cardCount.innerText = Number(count).toLocaleString();
      if (cardPendingCount) cardPendingCount.innerText = `${Number(count).toLocaleString()} pending`;

      if (cardContainer) {
        cardContainer.className = `col-span-1 sm:col-span-2 lg:col-span-1 bg-white rounded-2xl border ${isSos ? 'border-red-300 ring-2 ring-red-500/20' : 'border-slate-200/90'} shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition-all`;
      }
      if (cardIcon) {
        cardIcon.className = `w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white flex items-center justify-center shrink-0 shadow-xs ${isSos ? 'text-red-600 animate-pulse' : 'text-rose-600'}`;
      }
      if (cardBadge) {
        cardBadge.innerText = isSos ? 'URGENT' : 'ALL CLEAR';
        cardBadge.className = `inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] font-bold ${isSos ? 'bg-red-200 text-red-900 animate-pulse border border-red-300' : 'bg-rose-100 text-rose-800'} shadow-2xs`;
      }
      if (cardSubtext) {
        cardSubtext.innerText = isSos ? 'Active SOS' : 'Standby';
        cardSubtext.className = `text-[9px] sm:text-[10px] font-medium ${isSos ? 'text-red-600 font-bold' : 'text-slate-500'} mt-0.5 whitespace-nowrap`;
      }
      if (cardDistressStatus) {
        cardDistressStatus.innerText = isSos ? 'Active Distress' : 'No Incidents';
        cardDistressStatus.className = `font-bold ${isSos ? 'text-red-600' : 'text-emerald-700'} shrink-0`;
      }
    }

    function refreshAdminSosState(triggerChime = false) {
      fetch('/api/sos/active')
        .then(r => r.json())
        .then(data => {
          if (data && data.success && Array.isArray(data.alerts)) {
            updateEmergencyCasesCard(data.alerts.length);
            if (data.alerts.length > 0) {
              data.alerts.forEach((alert, idx) => {
                showAdminSosToast(alert, triggerChime && idx === 0);
              });
            }
          } else {
            updateEmergencyCasesCard(0);
          }
        })
        .catch(e => console.warn('Admin SOS state check error:', e));
    }

    // Real-time Socket listeners for Admin
    if (typeof io !== 'undefined') {
      const dashSocket = window.__appSocket || (window.__appSocket = io());

      dashSocket.on('sos:new', function(data) {
        if (data) {
          showAdminSosToast(data, true);
          refreshAdminSosState(false);
        }
      });

      dashSocket.on('sos_alert', function(data) {
        if (data) {
          showAdminSosToast(data, true);
          refreshAdminSosState(false);
        }
      });

      dashSocket.on('sos:update', function(data) {
        if (data && data.id) {
          showAdminSosToast(data, false);
        }
        refreshAdminSosState(false);
      });

      dashSocket.on('sos:update_status', function(data) {
        if (data && data.id) {
          if (data.status === 'RESOLVED' || data.status === 'CANCELLED') {
            dismissAdminSosToast(data.id);
          } else {
            showAdminSosToast(data, false);
          }
        }
        refreshAdminSosState(false);
      });

      dashSocket.on('sos:resolve', function(data) {
        if (data && data.id) dismissAdminSosToast(data.id);
        refreshAdminSosState(false);
      });

      dashSocket.on('sos:cancel', function(data) {
        if (data && data.id) dismissAdminSosToast(data.id);
        refreshAdminSosState(false);
      });
    }

    // On initial page load: pop up notification with chime if active alerts exist
    try {
      const initDataEl = document.getElementById('initialAdminActiveSos');
      if (initDataEl) {
        const initialAlerts = JSON.parse(initDataEl.textContent || '[]');
        if (Array.isArray(initialAlerts) && initialAlerts.length > 0) {
          initialAlerts.forEach((alert, idx) => {
            showAdminSosToast(alert, idx === 0);
          });
        }
      }
    } catch (e) {
      console.warn('Initial SOS toast parse error:', e);
    }
  </script>

  <!-- Chart.js Engine & EvakWar Dashboard Analytics Visualizations -->
  <script type="application/json" id="evakWarChartData">
    <%- JSON.stringify((locals.analytics && locals.analytics.chartData) ? locals.analytics.chartData : {}) %>
  </script>
  <script src="/js/chart.umd.min.js"></script>
  <script>
    (function initEvakWarDashboardCharts() {
      // Safely parse dynamic Chart Data from JSON data island
      const dataIsland = document.getElementById('evakWarChartData');
      const chartRawData = dataIsland ? JSON.parse(dataIsland.textContent || '{}') : {};

      function setupCharts() {
        if (typeof Chart === 'undefined') {
          // Fallback to CDN if needed
          const cdnScript = document.createElement('script');
          cdnScript.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';
          cdnScript.onload = renderAllCharts;
          document.head.appendChild(cdnScript);
          return;
        }
        renderAllCharts();
      }

      window.__evakWarCharts = window.__evakWarCharts || {};

      function renderAllCharts() {
        Chart.defaults.font.family = 'Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
        Chart.defaults.color = '#64748b';
        Chart.defaults.plugins.tooltip.backgroundColor = '#0f172a';
        Chart.defaults.plugins.tooltip.titleFont = { weight: 'bold', size: 12 };
        Chart.defaults.plugins.tooltip.bodyFont = { size: 11 };
        Chart.defaults.plugins.tooltip.padding = 10;
        Chart.defaults.plugins.tooltip.cornerRadius = 8;

        // 1. Evacuation Trends (Line Chart)
        const ctxEvac = document.getElementById('chartEvacuationTrends');
        if (ctxEvac) {
          if (window.__evakWarCharts.evac) window.__evakWarCharts.evac.destroy();
          const evacData = chartRawData.evacuationTrends || { labels: [], data: [] };
          window.__evakWarCharts.evac = new Chart(ctxEvac, {
            type: 'line',
            data: {
              labels: evacData.labels,
              datasets: [{
                label: 'Check-Ins Logged',
                data: evacData.data,
                borderColor: '#2563eb',
                backgroundColor: 'rgba(37, 99, 235, 0.12)',
                borderWidth: 2.5,
                fill: true,
                tension: 0.35,
                pointBackgroundColor: '#2563eb',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: { precision: 0 },
                  grid: { color: 'rgba(226, 232, 240, 0.8)' }
                },
                x: {
                  grid: { display: false }
                }
              }
            }
          });
        }

        // 2. SOS Emergency Reports (Line Chart)
        const ctxSos = document.getElementById('chartSosReports');
        if (ctxSos) {
          if (window.__evakWarCharts.sos) window.__evakWarCharts.sos.destroy();
          const sosData = chartRawData.sosTimeline || { labels: [], data: [] };
          window.__evakWarCharts.sos = new Chart(ctxSos, {
            type: 'line',
            data: {
              labels: sosData.labels,
              datasets: [{
                label: 'Distress Reports',
                data: sosData.data,
                borderColor: '#e11d48',
                backgroundColor: 'rgba(225, 29, 72, 0.12)',
                borderWidth: 2.5,
                fill: true,
                tension: 0.35,
                pointBackgroundColor: '#e11d48',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: { precision: 0 },
                  grid: { color: 'rgba(226, 232, 240, 0.8)' }
                },
                x: {
                  grid: { display: false }
                }
              }
            }
          });
        }


        // 4. Resident Vulnerability (Horizontal Bar Chart)
        const ctxVuln = document.getElementById('chartVulnerability');
        if (ctxVuln) {
          if (window.__evakWarCharts.vulnerability) window.__evakWarCharts.vulnerability.destroy();
          const vulnData = chartRawData.vulnerabilities || { labels: [], data: [] };
          window.__evakWarCharts.vulnerability = new Chart(ctxVuln, {
            type: 'bar',
            data: {
              labels: vulnData.labels,
              datasets: [{
                label: 'Individuals',
                data: vulnData.data,
                backgroundColor: [
                  '#f59e0b', // Senior Citizens
                  '#3b82f6', // PWDs
                  '#ec4899', // Pregnant
                  '#06b6d4', // Children
                  '#10b981'  // Lactating
                ],
                borderRadius: 6,
                barThickness: 18
              }]
            },
            options: {
              indexAxis: 'y',
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false }
              },
              scales: {
                x: {
                  beginAtZero: true,
                  ticks: { precision: 0 },
                  grid: { color: 'rgba(226, 232, 240, 0.8)' }
                },
                y: {
                  grid: { display: false },
                  ticks: { font: { weight: 'bold', size: 10 } }
                }
              }
            }
          });
        }

        // 5. Resident Registration Status (Donut Chart)
        const ctxReg = document.getElementById('chartRegistrationStatus');
        if (ctxReg) {
          if (window.__evakWarCharts.regStatus) window.__evakWarCharts.regStatus.destroy();
          const regData = chartRawData.registrationStatus || { labels: [], data: [] };
          window.__evakWarCharts.regStatus = new Chart(ctxReg, {
            type: 'doughnut',
            data: {
              labels: regData.labels,
              datasets: [{
                data: regData.data,
                backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                hoverBackgroundColor: ['#059669', '#d97706', '#dc2626'],
                borderWidth: 3,
                borderColor: '#ffffff'
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '68%',
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    boxWidth: 12,
                    boxHeight: 12,
                    usePointStyle: true,
                    font: { size: 11, weight: 'bold' },
                    padding: 14
                  }
                }
              }
            }
          });
        }

        // 6. Gender Distribution (Donut Chart)
        const ctxGen = document.getElementById('chartGenderDistribution');
        if (ctxGen) {
          if (window.__evakWarCharts.gender) window.__evakWarCharts.gender.destroy();
          const genData = chartRawData.genderDistribution || { labels: [], data: [] };
          window.__evakWarCharts.gender = new Chart(ctxGen, {
            type: 'doughnut',
            data: {
              labels: genData.labels,
              datasets: [{
                data: genData.data,
                backgroundColor: ['#3b82f6', '#ec4899'],
                hoverBackgroundColor: ['#2563eb', '#db2777'],
                borderWidth: 3,
                borderColor: '#ffffff'
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '68%',
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    boxWidth: 12,
                    boxHeight: 12,
                    usePointStyle: true,
                    font: { size: 11, weight: 'bold' },
                    padding: 14
                  }
                }
              }
            }
          });
        }
      }

      window.refreshEvakWarCharts = function () {
        location.reload();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupCharts);
      } else {
        setupCharts();
      }
    })();
  </script>

