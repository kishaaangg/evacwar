<%- include('../partials/header') %>

  <div class="app-main-layout">
    <%- include('../partials/sidebar') %>

      <main class="app-content flex flex-col min-h-screen bg-slate-50 relative pb-24 lg:pb-8 overflow-x-hidden">
        <div class="max-w-7xl mx-auto space-y-4 sm:space-y-5 flex-1 w-full p-3 sm:p-4 lg:p-6">

          <!-- 1. ADMIN DASHBOARD HEADER -->
          <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1 pb-3 sm:pb-4 border-b border-slate-200/80">
            <div>
              <h1 class="text-xl sm:text-2xl font-bold text-blue-950 tracking-tight">System Overview</h1>
              <p class="text-xs sm:text-sm text-slate-500 font-medium mt-0.5">
                Real-time typhoon monitoring and early warning for Barangay San Rafael Baao, Camarines Sur.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2 text-xs">
              <!-- System Status Badge -->
              <% const hasSos=(locals.summary && locals.summary.activeSosCount> 0); %>
                <% if (hasSos) { %>
                  <a href="/admin/evacuation"
                    class="bg-red-50 hover:bg-red-100 text-red-700 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full border border-red-200 font-bold flex items-center gap-1.5 shadow-2xs text-[10px] sm:text-xs transition-colors animate-pulse"
                    title="View Active SOS on Evacuation Map">
                    <span class="relative flex h-2 w-2">
                      <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-red-600"></span>
                    </span>
                    <%= locals.summary.activeSosCount %> Active SOS Alert<% if (locals.summary.activeSosCount> 1) { %>s
                        <% } %>
                  </a>
                  <% } else { %>

                    <% } %>

                      <!-- Real-Time PST Live Digital Clock -->
                      <div
                        class="text-[10px] sm:text-xs font-mono font-bold text-blue-900 bg-blue-50 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full border border-blue-200/80 flex items-center shadow-2xs">
                        <i class="ph ph-clock mr-1.5 text-blue-600"></i>
                        <span id="dashboardLiveClock">--:--:--</span>
                        <span class="ml-1 text-[9px] text-blue-600/80 font-sans font-bold">PST</span>
                      </div>

                      <!-- Date Badge -->
                      <div
                        class="text-[10px] sm:text-xs font-semibold text-slate-600 bg-slate-100 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-full border border-slate-200 flex items-center shadow-2xs">
                        <i class="ph ph-calendar-blank mr-1.5 text-slate-400"></i>
                        <span id="dashboardDateText">Today</span>
                      </div>
            </div>
          </div>

          <!-- Floating container for Upper-Right SOS Emergency Pop-ups (with Sound) -->
          <div id="adminSosToastContainer" class="fixed top-16 sm:top-20 right-4 z-50 flex flex-col gap-3 pointer-events-none max-w-sm sm:max-w-md w-full px-2"></div>
          <script type="application/json" id="initialAdminActiveSos">
            <%- JSON.stringify(locals.activeSosAlerts || []) %>
          </script>

                  <!-- 3. KEY COMMAND STATISTICS CARDS (MATCHING REFERENCE UI) -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 sm:gap-4">

                    <!-- Card 1: Residents (Sky Blue Theme) -->
                    <div
                      class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition-all">
                      <!-- Top Pastel Section -->
                      <div class="bg-[#d8ecfd] p-3.5 sm:p-4 rounded-t-2xl">
                        <div class="flex items-center gap-2.5 sm:gap-3">
                          <div
                            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white flex items-center justify-center shrink-0 shadow-xs text-sky-600">
                            <i class="ph ph-users-three text-xl sm:text-2xl"></i>
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="text-xs sm:text-[13px] font-semibold text-slate-700 leading-tight">
                              Total Residents
                            </div>
                            <div class="flex items-baseline justify-between gap-1 mt-1.5">
                              <span class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight leading-none">
                                <%= locals.summary ? Number(locals.summary.totalResidents).toLocaleString() : 0 %>
                              </span>
                              <div class="text-right shrink-0">
                                <span
                                  class="inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 shadow-2xs">
                                  Official
                                </span>
                                <div
                                  class="text-[9px] sm:text-[10px] font-medium text-slate-500 mt-0.5 whitespace-nowrap">
                                  San Rafael</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <!-- Bottom White Section -->
                      <div class="bg-white p-3.5 sm:p-4 rounded-b-2xl space-y-2 text-xs">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-slate-600 font-normal">Registered:</span>
                          <span class="font-bold text-slate-900 shrink-0">
                            <%= locals.summary ? Number(locals.summary.totalResidents).toLocaleString() : 0 %>
                          </span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-slate-600 font-normal">Households:</span>
                          <span class="font-bold text-slate-900 shrink-0">
                            <%= locals.summary ? Number(locals.summary.totalFamilies).toLocaleString() : 0 %>
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- Card 2: Families (Mint Green Theme) -->
                    <div
                      class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition-all">
                      <!-- Top Pastel Section -->
                      <div class="bg-[#dcfce7] p-3.5 sm:p-4 rounded-t-2xl">
                        <div class="flex items-center gap-2.5 sm:gap-3">
                          <div
                            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white flex items-center justify-center shrink-0 shadow-xs text-emerald-600">
                            <i class="ph ph-house-line text-xl sm:text-2xl"></i>
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="text-xs sm:text-[13px] font-semibold text-slate-700 leading-tight">
                              Total Families
                            </div>
                            <div class="flex items-baseline justify-between gap-1 mt-1.5">
                              <span class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight leading-none">
                                <%= locals.summary ? Number(locals.summary.totalFamilies).toLocaleString() : 0 %>
                              </span>
                              <div class="text-right shrink-0">
                                <span
                                  class="inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-200/80 text-emerald-900 shadow-2xs">
                                  Verified
                                </span>
                                <div
                                  class="text-[9px] sm:text-[10px] font-medium text-slate-500 mt-0.5 whitespace-nowrap">
                                  Households</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <!-- Bottom White Section -->
                      <div class="bg-white p-3.5 sm:p-4 rounded-b-2xl space-y-2 text-xs">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-slate-600 font-normal">Household Units:</span>
                          <span class="font-bold text-slate-900 shrink-0">
                            <%= locals.summary ? Number(locals.summary.totalFamilies).toLocaleString() : 0 %>
                          </span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-slate-600 font-normal">Avg Family Size:</span>
                          <span class="font-bold text-slate-900 shrink-0">
                            <%= (locals.summary && locals.summary.totalFamilies> 0) ? (locals.summary.totalResidents /
                              locals.summary.totalFamilies).toFixed(1) : '1.0' %> / fam
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- Card 3: Evacuation Centers (Lavender Theme) -->
                    <div
                      class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition-all">
                      <!-- Top Pastel Section -->
                      <div class="bg-[#f3e8ff] p-3.5 sm:p-4 rounded-t-2xl">
                        <div class="flex items-center gap-2.5 sm:gap-3">
                          <div
                            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white flex items-center justify-center shrink-0 shadow-xs text-purple-600">
                            <i class="ph ph-buildings text-xl sm:text-2xl"></i>
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="text-xs sm:text-[13px] font-semibold text-slate-700 leading-tight">
                              Evacuation Centers
                            </div>
                            <div class="flex items-baseline justify-between gap-1 mt-1.5">
                              <span class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight leading-none">
                                <%= locals.summary ? Number(locals.summary.totalCenters).toLocaleString() : 0 %>
                              </span>
                              <div class="text-right shrink-0">
                                <span
                                  class="inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 shadow-2xs">
                                  Shelters
                                </span>
                                <div
                                  class="text-[9px] sm:text-[10px] font-medium text-slate-500 mt-0.5 whitespace-nowrap">
                                  Operational</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <!-- Bottom White Section -->
                      <div class="bg-white p-3.5 sm:p-4 rounded-b-2xl space-y-2 text-xs">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-slate-600 font-normal">Total Sheltered:</span>
                          <span class="font-bold text-purple-700 shrink-0">
                            <%= locals.summary ? Number(locals.summary.totalEvacuees).toLocaleString() : 0 %>
                          </span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-slate-600 font-normal">Total Capacity:</span>
                          <span class="font-bold text-slate-900 shrink-0">
                            <%= locals.summary ? Number(locals.summary.totalCapacity).toLocaleString() : 0 %> slots
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- Card 4: Alerts Sent (Amber Theme) -->
                    <div
                      class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition-all">
                      <!-- Top Pastel Section -->
                      <div class="bg-[#fef3c7] p-3.5 sm:p-4 rounded-t-2xl">
                        <div class="flex items-center gap-2.5 sm:gap-3">
                          <div
                            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white flex items-center justify-center shrink-0 shadow-xs text-amber-600">
                            <i class="ph ph-megaphone text-xl sm:text-2xl"></i>
                          </div>
                          <div class="flex-1 min-w-0">
                            <div class="text-xs sm:text-[13px] font-semibold text-slate-700 leading-tight">
                              Alerts Sent
                            </div>
                            <div class="flex items-baseline justify-between gap-1 mt-1.5">
                              <span class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight leading-none">
                                <%= locals.summary ? Number(locals.summary.totalAlerts || 0).toLocaleString() : 0 %>
                              </span>
                              <div class="text-right shrink-0">
                                <span
                                  class="inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 shadow-2xs">
                                  Broadcasts
                                </span>
                                <div
                                  class="text-[9px] sm:text-[10px] font-medium text-slate-500 mt-0.5 whitespace-nowrap">
                                  SMS Outbox</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <!-- Bottom White Section -->
                      <div class="bg-white p-3.5 sm:p-4 rounded-b-2xl space-y-2 text-xs">
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-slate-600 font-normal">SMS Dispatched:</span>
                          <span class="font-bold text-slate-900 shrink-0">
                            <%= locals.summary ? Number(locals.summary.totalAlerts || 0).toLocaleString() : 0 %> logs
                          </span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-slate-600 font-normal">Gateway Status:</span>
                          <span class="font-bold text-emerald-700 shrink-0">Active</span>
                        </div>
                      </div>
                    </div>

                    <!-- Card 5: Emergency Cases / Active SOS (Rose Theme) -->
                    <% const isSosActive=(locals.summary && locals.summary.activeSosCount> 0); %>
                      <div
                        id="cardEmergencyCasesContainer"
                        class="col-span-1 sm:col-span-2 lg:col-span-1 bg-white rounded-2xl border <%= isSosActive ? 'border-red-300 ring-2 ring-red-500/20' : 'border-slate-200/90' %> shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition-all">
                        <!-- Top Pastel Section -->
                        <div class="<%= isSosActive ? 'bg-red-100/90' : 'bg-[#ffe4e6]' %> p-3.5 sm:p-4 rounded-t-2xl">
                          <div class="flex items-center gap-2.5 sm:gap-3">
                            <div
                              id="cardEmergencyCasesIcon"
                              class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white flex items-center justify-center shrink-0 shadow-xs <%= isSosActive ? 'text-red-600 animate-pulse' : 'text-rose-600' %>">
                              <i class="ph ph-siren text-xl sm:text-2xl"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                              <div
                                class="text-xs sm:text-[13px] font-semibold <%= isSosActive ? 'text-red-900' : 'text-slate-700' %> leading-tight">
                                Emergency Cases
                              </div>
                              <div class="flex items-baseline justify-between gap-1 mt-1.5">
                                <span
                                  id="cardEmergencyCasesCount"
                                  class="text-xl sm:text-2xl font-bold <%= isSosActive ? 'text-red-600' : 'text-slate-900' %> tracking-tight leading-none">
                                  <%= locals.summary ? Number(locals.summary.activeSosCount).toLocaleString() : 0 %>
                                </span>
                                <div class="text-right shrink-0">
                                  <span
                                    id="cardEmergencyCasesBadge"
                                    class="inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded-full text-[10px] font-bold <%= isSosActive ? 'bg-red-200 text-red-900 animate-pulse border border-red-300' : 'bg-rose-100 text-rose-800' %> shadow-2xs">
                                    <%= isSosActive ? 'URGENT' : 'ALL CLEAR' %>
                                  </span>
                                  <div
                                    id="cardEmergencyCasesSubtext"
                                    class="text-[9px] sm:text-[10px] font-medium <%= isSosActive ? 'text-red-600 font-bold' : 'text-slate-500' %> mt-0.5 whitespace-nowrap">
                                    <%= isSosActive ? 'Active SOS' : 'Standby' %>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <!-- Bottom White Section -->
                        <div class="bg-white p-3.5 sm:p-4 rounded-b-2xl space-y-2 text-xs">
                          <div class="flex items-center justify-between gap-2">
                            <span class="text-slate-600 font-normal">Distress Status:</span>
                            <span id="cardEmergencyCasesDistressStatus" class="font-bold <%= isSosActive ? 'text-red-600' : 'text-emerald-700' %> shrink-0">
                              <%= isSosActive ? 'Active Distress' : 'No Incidents' %>
                            </span>
                          </div>
                          <div class="flex items-center justify-between gap-2">
                            <span class="text-slate-600 font-normal">Active Signals:</span>
                            <span id="cardEmergencyCasesPendingCount" class="font-bold text-slate-900 shrink-0">
                              <%= locals.summary ? Number(locals.summary.activeSosCount).toLocaleString() : 0 %>
                                pending
                            </span>
                          </div>
                        </div>
                      </div>

                  </div>


                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6">
                    <div class="lg:col-span-8 space-y-4 sm:space-y-5">
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">

                        <!-- Donut 1: Account Verification -->
                        <div
                          class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-4 sm:p-5 flex flex-col justify-between">
                          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 mb-2">
                            <h4 class="font-extrabold text-slate-900 text-xs sm:text-sm uppercase tracking-wider">
                              Account Verification</h4>
                          </div>
                          <div class="relative h-56 sm:h-60 w-full flex items-center justify-center">
                            <canvas id="chartRegistrationStatus"></canvas>
                          </div>
                        </div>

                        <!-- Donut 2: Gender Demographics (Clean) -->
                        <div
                          class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-4 sm:p-5 flex flex-col justify-between">
                          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 mb-2">
                            <h4 class="font-extrabold text-slate-900 text-xs sm:text-sm uppercase tracking-wider">
                              Gender</h4>
                          </div>
                          <div class="relative h-56 sm:h-60 w-full flex items-center justify-center">
                            <canvas id="chartGenderDistribution"></canvas>
                          </div>
                        </div>

                      </div>

                      <!-- ROW 2: CHECK-INS (SOLO FULL-WIDTH) -->
                      <div
                        class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-4 sm:p-5 flex flex-col justify-between">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 mb-2">
                          <div class="flex items-center gap-2">

                            <div>
                              <h4 class="font-extrabold text-slate-900 text-xs sm:text-sm uppercase tracking-wider">
                                Evacuee Check-in Activity</h4>

                            </div>
                          </div>

                        </div>
                        <div class="relative h-60 sm:h-64 w-full">
                          <canvas id="chartEvacuationTrends"></canvas>
                        </div>
                      </div>

                      <!-- ROW 3: SOS EMERGENCY REPORTS (SOLO FULL-WIDTH) -->
                      <div
                        class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-4 sm:p-5 flex flex-col justify-between">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 mb-2">
                          <div class="flex items-center gap-2">

                            <div>
                              <h4 class="font-extrabold text-slate-900 text-xs sm:text-sm uppercase tracking-wider">SOS
                                Emergency Reports</h4>

                            </div>
                          </div>

                        </div>
                        <div class="relative h-60 sm:h-64 w-full">
                          <canvas id="chartSosReports"></canvas>
                        </div>
                      </div>

                    </div>

                    <!-- RIGHT / OPERATIONS COLUMN (4 COLS) -->
                    <div class="lg:col-span-4 space-y-4">

                      <!-- REGIONAL WEATHER TELEMETRY CARD (MODERN 3D WIDGET DESIGN) -->
                      <% const now=new Date(); const currentDayName=now.toLocaleDateString('en-US', { weekday: 'long' ,
                        timeZone: 'Asia/Manila' }); const currentTimeStr=now.toLocaleTimeString('en-US', {
                        hour: 'numeric' , minute: '2-digit' , hour12: true, timeZone: 'Asia/Manila' }).toLowerCase();
                        const currentTemp=(locals.weather && locals.weather.temperature !=null) ?
                        Math.round(locals.weather.temperature) : 27; const realFeelTemp=(locals.weather &&
                        locals.weather.apparent_temperature !=null) ? Math.round(locals.weather.apparent_temperature) :
                        Math.round(currentTemp - 2); const currentWind=(locals.weather && locals.weather.wind_speed
                        !=null) ? Math.round(locals.weather.wind_speed) : 18; const currentRainfall=(locals.weather &&
                        locals.weather.rainfall !=null) ? locals.weather.rainfall : 0.2; const
                        currentHumidity=(locals.weather && locals.weather.humidity !=null) ? locals.weather.humidity :
                        89; const weatherStatus=(locals.weather && locals.weather.weather_status) ?
                        locals.weather.weather_status : 'Scattered Rain Showers' ; const
                        isRainyWeather=weatherStatus.toLowerCase().includes('rain') ||
                        weatherStatus.toLowerCase().includes('drizzle') ||
                        weatherStatus.toLowerCase().includes('thunder') || weatherStatus.toLowerCase().includes('storm')
                        || weatherStatus.toLowerCase().includes('shower'); %>
                        <div
                          class="!bg-white rounded-[32px] border border-slate-200/80 shadow-[0_10px_25px_rgba(0,0,0,0.03)] p-5 sm:p-6 relative overflow-hidden font-heading transition-all"
                          style="background-color: #ffffff !important;">

                          <!-- TOP HEADER BAR: DAY & LOCATION (LEFT), TIME & ACTION BUTTONS (RIGHT) -->
                          <div class="flex items-center justify-between gap-2">
                            <div class="min-w-0">
                              <h3 class="font-bold text-slate-800 text-base sm:text-lg tracking-tight leading-tight"
                                id="weatherDay">
                                <%= currentDayName %>
                              </h3>
                              <div class="text-[11px] font-medium text-slate-400 mt-0.5 truncate max-w-[190px]"
                                id="dashWeatherLocLabel">
                                <%= (locals.weather && locals.weather.location_name) ? locals.weather.location_name
                                  : 'San Rafael, Baao' %>
                              </div>
                            </div>
                            <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                              <span class="font-semibold text-slate-600 text-xs sm:text-sm tracking-tight"
                                id="weatherTime">
                                <%= currentTimeStr %>
                              </span>
                              <button type="button" onclick="useMyLocationDashboard(this)" id="btnDashMyLocation"
                                class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-all active:scale-95 shadow-xs cursor-pointer shrink-0"
                                title="Use device GPS location">
                                <i class="ph ph-crosshair text-xs font-bold text-slate-700" id="dashLocIcon"></i>
                              </button>
                              <button type="button" onclick="refreshWeatherData(this)"
                                class="w-8 h-8 rounded-full bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center transition-all active:scale-95 shadow-xs cursor-pointer shrink-0"
                                title="Refresh Telemetry">
                                <i class="ph ph-arrow-up-right text-xs font-bold" id="weatherRefreshIcon"></i>
                              </button>
                            </div>
                          </div>

                          <!-- MIDDLE SECTION: TEMPERATURE & 3D VOLUMETRIC ARTWORK -->
                          <div class="flex items-center justify-between gap-2 mt-4 sm:mt-5">
                            <div class="min-w-0">
                              <div class="text-5xl sm:text-[54px] font-black text-slate-900 tracking-tight leading-none"
                                id="weatherTemp">
                                <%= currentTemp %>°C
                              </div>
                              <div
                                class="text-xs sm:text-sm font-semibold text-slate-500 mt-2.5 flex items-center gap-1.5"
                                id="weatherRealFeelContainer">
                                <span>Real feel <span id="weatherRealFeel">
                                    <%= realFeelTemp %>°C
                                  </span></span>
                              </div>
                            </div>

                            <!-- 3D WEATHER ARTWORK CONTAINER -->
                            <div id="weatherVisualContainer"
                              class="shrink-0 flex items-center justify-center select-none">
                              <% if (isRainyWeather) { %>
                                <!-- 3D Daytime Sun + Puffy Cloud + Raindrops (Windy Daytime Style) -->
                                <svg viewBox="0 0 140 120"
                                  class="w-24 h-20 sm:w-28 sm:h-24 drop-shadow-md select-none pointer-events-none"
                                  fill="none" xmlns="http://www.w3.org/2000/svg">
                                  <defs>
                                    <radialGradient id="dashSunGrad" cx="35%" cy="30%" r="65%">
                                      <stop offset="0%" stop-color="#FFF5A0" />
