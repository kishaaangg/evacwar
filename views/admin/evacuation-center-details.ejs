<%- include('../partials/header') %>

<div class="app-main-layout">
  <%- include('../partials/sidebar') %>

  <main class="app-content p-4 sm:p-6 lg:p-8 bg-slate-50 min-h-screen pb-24 lg:pb-10">
    <%
      const occ = parseInt(center.current_occupancy, 10) || 0;
      const max = Math.max(1, parseInt(center.max_capacity, 10) || 25);
      const pct = Math.min(100, Math.round((occ / max) * 100));
      const availableSlots = Math.max(0, max - occ);
      let badgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
      let barClass = 'bg-emerald-500';
      let statusLabel = 'Available';
      if (pct >= 100) {
        badgeClass = 'bg-red-50 text-red-700 border-red-200';
        barClass = 'bg-red-500';
        statusLabel = 'Full Capacity';
      } else if (pct >= 80) {
        badgeClass = 'bg-amber-50 text-amber-700 border-amber-200';
        barClass = 'bg-amber-500';
        statusLabel = 'Near Full';
      }
    %>

    <div class="max-w-6xl mx-auto space-y-5">
      <!-- Top Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <a href="/admin/evacuation"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 text-xs sm:text-sm font-bold shadow-2xs transition-colors">
          <i class="ph ph-arrow-left text-base"></i>
          <span>Back to Evacuation Map</span>
        </a>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold border <%= badgeClass %>">
          <span class="w-2 h-2 rounded-full <%= barClass %>"></span>
          <%= statusLabel %> (<%= pct %>%)
        </span>
      </div>

      <!-- Center Header Card -->
      <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6 space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
          <div class="flex items-start gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center shrink-0">
              <i class="ph ph-buildings text-2xl"></i>
            </div>
            <div>
              <h1 class="text-lg sm:text-2xl font-black text-slate-900 leading-tight"><%= center.name %></h1>
              <p class="text-xs sm:text-sm text-slate-500 font-semibold mt-1 flex items-center gap-1.5">
                <i class="ph ph-map-pin text-blue-500"></i>
                <span><%= center.address || 'Barangay San Rafael, Baao' %></span>
              </p>
              <% if (center.latitude && center.longitude) { %>
                <p class="text-[11px] font-mono text-slate-400 mt-1">
                  GPS: <%= Number(center.latitude).toFixed(5) %>° N, <%= Number(center.longitude).toFixed(5) %>° E
                </p>
              <% } %>
            </div>
          </div>
          <a href="/admin/reports?tab=evacuation&center_id=<%= center.id %>"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-xs transition-colors self-start">
            <i class="ph ph-chart-bar text-sm"></i>
            <span>View Full Reports</span>
          </a>
        </div>

        <!-- Occupancy Bar & Metrics -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Current Occupancy</div>
            <div class="text-2xl font-black text-slate-900 mt-1"><%= occ %></div>
          </div>
          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Max Capacity</div>
            <div class="text-2xl font-black text-slate-900 mt-1"><%= max %></div>
          </div>
          <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Available Slots</div>
            <div class="text-2xl font-black text-emerald-700 mt-1"><%= availableSlots %></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-bold text-slate-600 mb-1.5">
            <span>Facility Capacity Utilization</span>
            <span><%= occ %> / <%= max %> (<%= pct %>%)</span>
          </div>
          <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden border border-slate-200">
            <div class="<%= barClass %> h-full rounded-full transition-all duration-500" style="width: <%= pct %>%;"></div>
          </div>
        </div>
      </div>

      <!-- Assigned Site Staff -->
      <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6">
        <h2 class="text-sm sm:text-base font-black text-slate-900 mb-3 flex items-center gap-2">
          <i class="ph ph-user-gear text-blue-600 text-lg"></i>
          <span>Assigned Site Staff (<%= assignedStaff.length %>)</span>
        </h2>
        <% if (assignedStaff.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <% assignedStaff.forEach(s => {
              const sName = `${s.first_name || ''} ${s.middle_name ? s.middle_name + ' ' : ''}${s.last_name || ''}`.trim();
            %>
              <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-700 font-black flex items-center justify-center shrink-0">
                  <%= (s.first_name || 'S').charAt(0).toUpperCase() %>
                </div>
                <div class="min-w-0">
                  <div class="font-extrabold text-xs sm:text-sm text-slate-900 truncate"><%= sName %></div>
                  <div class="text-[11px] text-slate-500 truncate"><%= s.occupation || 'Evacuation Site Staff' %></div>
                  <% if (s.contact_number) { %>
                    <div class="text-[10px] font-mono text-blue-600 font-bold mt-0.5"><%= s.contact_number %></div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-500 italic">No staff currently assigned to this evacuation center.</p>
        <% } %>
      </div>

      <!-- Currently Checked-In Evacuees -->
      <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm p-5 sm:p-6">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h2 class="text-sm sm:text-base font-black text-slate-900 flex items-center gap-2">
            <i class="ph ph-users-three text-emerald-600 text-lg"></i>
            <span>Currently Checked-In Evacuees (<%= activeCheckIns.length %>)</span>
          </h2>
        </div>

        <% if (activeCheckIns.length > 0) { %>
          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-left border-collapse text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-50 text-slate-600 border-b border-slate-200 text-[11px] uppercase tracking-wider">
                  <th class="py-3 px-4 font-extrabold">Evacuee / Household Head</th>
                  <th class="py-3 px-4 font-extrabold">Address / Zone</th>
                  <th class="py-3 px-4 font-extrabold">Members</th>
                  <th class="py-3 px-4 font-extrabold">Check-in Time</th>
                  <th class="py-3 px-4 font-extrabold">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% activeCheckIns.forEach(c => {
                  const fullName = c.evacuee_name || `${c.first_name || ''} ${c.middle_name ? c.middle_name + ' ' : ''}${c.last_name || ''}`.trim() || 'Registered Resident';
                  const addr = c.home_address || c.barangay || 'San Rafael';
                  const checkInDate = c.check_in_time ? new Date(c.check_in_time).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—';
                %>
                  <tr class="hover:bg-slate-50/80">
                    <td class="py-3 px-4 font-bold text-slate-900"><%= fullName %></td>
                    <td class="py-3 px-4 text-slate-600"><%= addr %></td>
                    <td class="py-3 px-4 font-semibold text-slate-700"><%= c.member_count || c.family_size || 1 %></td>
                    <td class="py-3 px-4 text-slate-500 text-xs"><%= checkInDate %></td>
                    <td class="py-3 px-4">
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">CHECKED IN</span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-8 text-slate-400 text-xs font-semibold">
            <i class="ph ph-users text-3xl mb-1 block text-slate-300"></i>
            No evacuees are currently checked in at this facility.
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
