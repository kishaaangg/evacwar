<%- include('../partials/header') %>

  <div class="app-main-layout">
    <%- include('../partials/sidebar') %>

      <main
        class="app-content h-[calc(100dvh-4rem)] max-h-[calc(100dvh-4rem)] overflow-hidden relative !p-0 !m-0 flex-1">

        <!-- Full Width Fixed Edge-to-Edge Map -->
        <div class="absolute inset-0 w-full h-full z-0">
          <div id="evacuationMap" class="w-full h-full"></div>

          <!-- Floating Overlay Top Toolbar (Unified Responsive Bar matching Staff Map) -->
          <div
            class="absolute top-2 sm:top-4 inset-x-2 sm:inset-x-4 z-10 flex items-center gap-1.5 sm:gap-2 pointer-events-none min-w-0 max-w-full">

            <!-- Left: Compact Map Badge -->
            <div
              class="bg-white/95 backdrop-blur-md shadow-md px-2.5 sm:px-3 py-1.5 rounded-full border border-white/60 flex items-center gap-1.5 shrink-0 pointer-events-auto">
              <span class="relative flex h-2 w-2">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
              </span>
              <span class="font-extrabold text-slate-800 text-[11px] sm:text-xs tracking-wide">Map</span>
            </div>

            <!-- Right: Map Controls Group (Hybrid/Sat/Road Toggle + 3D + Rotate + My Location) -->
            <div
              class="flex-1 min-w-0 flex items-center overflow-x-auto no-scrollbar py-0.5 pointer-events-auto overscroll-contain">
              <div class="flex items-center gap-1 sm:gap-1.5 ml-auto shrink-0">
                <!-- Basemap Mode Switcher (Selectable Hybrid, No Labels & Roads) -->
                <div
                  class="bg-white/95 backdrop-blur-md shadow-md rounded-full p-1 border border-slate-200/80 flex items-center gap-0.5 shrink-0">
                  <button id="btnMapHybrid" type="button" onclick="setMapStyleMode('hybrid')"
                    class="px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-all bg-blue-600 text-white shadow-xs flex items-center gap-1 cursor-pointer"
                    title="Hybrid Satellite & Labels">
                    <i class="ph ph-planet text-sm"></i> <span class="hidden sm:inline">Hybrid</span>
                  </button>
                  <button id="btnMapSatellite" type="button" onclick="setMapStyleMode('satellite')"
                    class="px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-all bg-slate-100 text-slate-700 hover:bg-slate-200 flex items-center gap-1 cursor-pointer"
                    title="Pure Satellite Imagery (No Labels)">
                    <i class="ph ph-globe text-sm"></i> <span class="hidden sm:inline">No Labels</span>
                  </button>
                  <button id="btnMapRoad" type="button" onclick="setMapStyleMode('roads')"
                    class="px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-all bg-slate-100 text-slate-700 hover:bg-slate-200 flex items-center gap-1 cursor-pointer"
                    title="Roads Basemap">
                    <i class="ph ph-map-trifold text-sm"></i> <span class="hidden sm:inline">Roads</span>
                  </button>
                </div>

                <!-- 3D View Toggle -->
                <button id="btnResident3D" type="button" onclick="toggleResident3DPitch()"
                  class="bg-white/95 backdrop-blur-md shadow-md hover:bg-emerald-50 text-slate-700 border border-slate-200/80 rounded-full px-2.5 sm:px-3 py-1.5 text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 transition-transform active:scale-95 shrink-0 cursor-pointer"
                  title="Toggle Map Tilt">
                  <i class="ph ph-cube text-sm text-emerald-600"></i>
                  <span>Tilt</span>
                </button>

                <!-- Rotate 45° -->
                <button id="btnResidentRotate" type="button" onclick="rotateResidentMap(45)"
                  class="bg-white/95 backdrop-blur-md shadow-md hover:bg-amber-50 text-amber-700 border border-slate-200/80 rounded-full p-1.5 sm:px-2.5 text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 transition-transform active:scale-95 shrink-0 cursor-pointer"
                  title="Rotate Map 45°">
                  <i class="ph ph-arrows-clockwise text-sm text-amber-600"></i>
                </button>

                <!-- GPS My Location Button -->
                <button id="btnMyLocation" type="button" onclick="locateResidentUser(mapInstance, true)"
                  class="bg-white/95 backdrop-blur-md shadow-md hover:bg-blue-50 text-blue-900 border border-slate-200/80 rounded-full px-2.5 sm:px-3 py-1.5 text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1 transition-transform active:scale-95 shrink-0 cursor-pointer"
                  title="My Location">
                  <i class="ph ph-navigation-arrow text-sm text-blue-600"></i>
                  <span class="hidden xl:inline">My Location</span>
                </button>

                <!-- Nearest Evacuation Site Auto-Router Button (Icon-only so all toolbar buttons fit cleanly) -->
                <button id="btnNearestEvacRoute" type="button" onclick="window.findAndRouteNearestEvacCenter && window.findAndRouteNearestEvacCenter(true)"
                  class="bg-emerald-600 hover:bg-emerald-500 text-white shadow-md rounded-full w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center transition-transform active:scale-95 shrink-0 cursor-pointer"
                  title="Find &amp; Route to Nearest Evacuation Site" aria-label="Nearest Evacuation Site">
                  <i class="ph ph-compass text-base"></i>
                </button>
              </div>
            </div>

          </div>

          <!-- Floating Map Legend (Right Side - Collapsible) -->
          <div id="mapLegendContainer"
            class="absolute top-16 sm:top-20 right-2 sm:right-4 z-20 pointer-events-none flex flex-col items-end">
            <!-- Toggle Button (Icon only) -->
            <button id="btnToggleLegend" type="button" onclick="toggleMapLegend()"
              class="bg-white/95 backdrop-blur-md shadow-md hover:bg-blue-50 text-blue-600 border border-slate-200/90 rounded-full w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center transition-all active:scale-95 cursor-pointer pointer-events-auto shrink-0 mb-1.5"
              title="Toggle Map Legend">
              <i class="ph ph-map-trifold text-base sm:text-lg font-bold"></i>
            </button>

            <!-- Legend Card Panel (Hidden initially on resident view) -->
            <div id="mapLegendCard"
              class="hidden pointer-events-auto bg-white/95 backdrop-blur-md shadow-xl border border-slate-200/90 rounded-2xl p-3 sm:p-3.5 w-60 sm:w-64 transition-all duration-200 origin-top-right">

              <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100">
                <div class="flex items-center gap-1.5">
                  <div class="w-5 h-5 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center text-xs">
                    <i class="ph ph-map-trifold font-bold"></i>
                  </div>
                  <span class="text-xs font-black text-slate-900 tracking-wide uppercase">Map Legend</span>
                </div>
                <button type="button" onclick="toggleMapLegend(false)"
                  class="text-slate-400 hover:text-slate-600 p-0.5 rounded-md hover:bg-slate-100 transition-colors cursor-pointer"
                  title="Close Legend">
                  <i class="ph ph-x font-bold text-xs"></i>
                </button>
              </div>

              <div class="space-y-2 text-[11px] sm:text-xs">
                <!-- 1. Evacuation Route (Orange line) -->
                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-1.5 rounded-full bg-orange-500 shadow-xs shrink-0"></div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Evacuation Route</span>
                    <span class="text-[10px] text-slate-500">Orange designated safety path</span>
                  </div>
                </div>

                <!-- 2. Barangay Boundary (--- dashed line) -->
                <div class="flex items-center gap-2.5">
                  <div class="w-6 border-t-2 border-dashed border-red-400 shrink-0"></div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Boundary (<span
                        class="font-mono text-red-500 font-extrabold">- - -</span>)</span>
                    <span class="text-[10px] text-slate-500">San Rafael (Ikpan) perimeter</span>
                  </div>
                </div>

                <!-- 3. Flood / Hazard Area Polygon -->
                <div class="flex items-center gap-2.5">
                  <div
                    class="w-6 h-5 rounded border border-red-500 bg-red-500/25 flex items-center justify-center shrink-0">
                    <i class="ph ph-warning text-xs text-red-600"></i>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Hazard Danger Zone</span>
                    <span class="text-[10px] text-slate-500">Flood / hazard risk area</span>
                  </div>
                </div>

                <div class="pt-1 border-t border-slate-100/80"></div>

                <!-- 4. Evacuation Sites (Green = Available, Red = Full) -->
                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-6 flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 36 46" class="w-4 h-5 drop-shadow-xs">
                      <path d="M18 1 C8.6 1 1 8.6 1 18 C1 29 18 45 18 45 C18 45 35 29 35 18 C35 8.6 27.4 1 18 1 Z"
                        fill="#10b981" stroke="#FFFFFF" stroke-width="2.5" />
                      <path d="M11 19 L18 12 L25 19 L23 19 L23 24 L13 24 L13 19 Z" fill="#FFFFFF" />
                    </svg>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Available Evac Site</span>
                    <span class="text-[10px] text-emerald-600 font-semibold">Green marker (Space available)</span>
                  </div>
                </div>

                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-6 flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 36 46" class="w-4 h-5 drop-shadow-xs">
                      <path d="M18 1 C8.6 1 1 8.6 1 18 C1 29 18 45 18 45 C18 45 35 29 35 18 C35 8.6 27.4 1 18 1 Z"
                        fill="#ef4444" stroke="#FFFFFF" stroke-width="2.5" />
                      <path d="M11 19 L18 12 L25 19 L23 19 L23 24 L13 24 L13 19 Z" fill="#FFFFFF" />
                    </svg>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">Full Evac Site</span>
                    <span class="text-[10px] text-red-600 font-semibold">Red marker (100% full)</span>
                  </div>
                </div>
                <!-- 5. Ikpan Elementary School special pin -->
                <div class="flex items-center gap-2.5">
                  <div class="w-6 h-6 flex items-center justify-center shrink-0 relative">
                    <svg viewBox="0 0 38 48" class="w-5 h-6 drop-shadow-xs">
                      <path d="M19 1 C9.1 1 1 9.1 1 19 C1 31 19 47 19 47 C19 47 37 31 37 19 C37 9.1 28.9 1 19 1 Z"
                        fill="#10b981" stroke="#FFFFFF" stroke-width="2.5" />
                      <circle cx="19" cy="18" r="9" fill="#FFFFFF" />
                      <polygon points="19,11 12,15.5 19,19 26,15.5" fill="#10b981" />
                      <path d="M15,17 L15,20.5 C15,20.5 17,22 19,22 C21,22 23,20.5 23,20.5 L23,17" fill="none"
                        stroke="#10b981" stroke-width="1.3" />
                    </svg>

                    <span
                      class="absolute -top-1 -right-1 bg-amber-500 text-white text-[7.5px] font-black rounded-full px-1 border border-white leading-tight">
                      ES
                    </span>
                  </div>

                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">
                      Ikpan Elementary School
                    </span>
                    <span class="text-[10px] text-slate-500 font-semibold">
                      Special School Icon
                    </span>
                  </div>
                </div>

                <!-- 6. SOS Distress Alert -->
                <div class="flex items-center gap-2.5 pt-0.5">
                  <div class="w-6 h-6 flex items-center justify-center shrink-0 relative">
                    <span
                      class="animate-ping absolute inline-flex h-3.5 w-3.5 rounded-full bg-red-400 opacity-75"></span>
                    <span
                      class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-600 border border-white shadow-xs"></span>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-bold text-slate-800 leading-tight">SOS Distress Alert</span>
                    <span class="text-[10px] text-slate-500">Live emergency distress signal</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Half-Screen Solid White Sliding Bottom Sheet (Slides only to the middle, never over the top) -->
        <div id="residentEvacBottomSheet"
          class="fixed inset-x-0 bottom-16 lg:bottom-0 z-40 max-w-3xl mx-auto bg-white rounded-t-3xl shadow-[0_-10px_32px_rgba(15,23,42,0.22)] border-t border-slate-200 flex flex-col max-h-[50dvh] will-change-transform transition-transform duration-300 ease-out"
          style="transform: translateY(calc(100% - 56px)); background-color: #ffffff;">

          <!-- Drag / Tap Handle Area -->
          <div id="residentEvacSheetHandle"
            class="w-full pt-2.5 pb-2 px-4 flex flex-col items-center justify-center cursor-pointer select-none touch-none rounded-t-3xl bg-white shrink-0 hover:bg-slate-50 active:bg-slate-100 transition-colors border-b border-slate-100"
            title="Drag or tap to expand/collapse">
            <div class="w-11 h-1 bg-slate-300 rounded-full mb-1.5"></div>
            <div class="w-full flex items-center justify-between">
              <h3 class="font-extrabold text-slate-900 text-xs sm:text-sm flex items-center gap-1.5">
                <span class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                  <i class="ph ph-buildings text-sm"></i>
                </span>
                <span>Nearest Evacuation Centers</span>
              </h3>
              <span id="residentCentersCountBadge"
                class="text-[10px] font-extrabold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-200/80">
                <%= centers ? centers.length : 0 %> Sites
              </span>
            </div>
          </div>

          <!-- Scrollable Solid White Compact Sheet Content -->
          <div id="residentEvacScrollArea" class="flex-1 min-h-0 overflow-y-auto px-3 sm:px-4 pb-5 pt-2.5 bg-white overscroll-contain">
            <div id="residentCentersListContainer" class="flex flex-col gap-2">
              <% if (centers && centers.length> 0) { %>
                <% centers.forEach((center, index)=> {
                  const occ = parseInt(center.current_occupancy, 10) || 0;
                  const max = parseInt(center.max_capacity, 10) || 25;
                  const percent = Math.round((occ / max) * 100);
                  let barColor = "bg-emerald-500";
                  let statusColor = "text-emerald-700 bg-emerald-50 border-emerald-200";
                  let availability = "Available";

                  if (percent >= 100) {
                    barColor = "bg-red-500";
                    statusColor = "text-red-700 bg-red-50 border-red-200";
                    availability = "Full";
                  } else if (percent >= 80) {
                    barColor = "bg-orange-500";
                    statusColor = "text-orange-700 bg-orange-50 border-orange-200";
                    availability = "Near Full";
                  }
                  const progressWidth = Math.min(percent, 100) + '%';
                  const safeNameAttr = String(center.name || 'Evacuation Center').replace(/'/g, "\\'");
                  %>
                  <div
                    id="resident-center-card-<%= center.id %>"
                    class="rounded-2xl p-2.5 sm:p-3 border border-slate-200 bg-white shadow-2xs transition-all relative overflow-hidden cursor-pointer active:scale-[0.99]"
                    onclick="flyToCenter('<%= center.longitude %>', '<%= center.latitude %>', '<%= center.id %>')">
                    <div class="flex items-start justify-between gap-2">
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5 flex-wrap">
                          <span class="px-1.5 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider bg-slate-100 text-slate-600">
                            #<%= index + 1 %>
                          </span>
                          <h4 class="font-extrabold text-slate-900 text-xs sm:text-sm leading-tight truncate">
                            <%= center.name %>
                          </h4>
                        </div>
                        <div class="flex items-center gap-2 mt-1 text-[10px] text-slate-500 font-semibold flex-wrap">
                          <span class="inline-flex items-center gap-0.5 truncate max-w-[170px]">
                            <i class="ph ph-map-pin text-blue-500"></i> <%= center.address %>
                          </span>
                          <span id="distance-<%= center.id %>" class="inline-flex items-center gap-0.5 font-mono font-extrabold text-slate-400">Locating...</span>
                        </div>
                      </div>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-extrabold border shrink-0 <%= statusColor %>">
                        <%= availability %>
                      </span>
                    </div>

                    <div class="mt-2 flex items-center gap-2.5">
                      <div class="flex-1 min-w-0">
                        <div class="flex justify-between text-[10px] font-semibold text-slate-500 mb-0.5">
                          <span>Occupancy (<%= percent %>%)</span>
                          <span class="font-bold text-slate-700"><%= occ %> / <%= max %></span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
                          <div class="<%= barColor %> h-full rounded-full transition-all duration-500" style="width: <%= progressWidth %>;"></div>
                        </div>
                      </div>
                      <button type="button"
                        onclick="event.stopPropagation(); startResidentNavigationToCenter('<%= center.latitude %>', '<%= center.longitude %>', '<%= safeNameAttr %>', '<%= center.id %>')"
                        class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-extrabold shadow-xs flex items-center gap-1 shrink-0 transition-transform active:scale-95 cursor-pointer">
                        <i class="ph ph-navigation-arrow text-xs"></i>
                        <span>Navigate</span>
                      </button>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-slate-500 italic text-xs py-3 text-center">No evacuation centers registered yet.</div>
              <% } %>
            </div>
          </div>
        </div>
      </main>
  </div>

  <script id="map-features-data" type="application/json">
    <%- mapFeatures || '{"type":"FeatureCollection","features":[]}' %>
  </script>
  <script id="centers-data" type="application/json">
    <%- locals.centers ? JSON.stringify(locals.centers) : '[]' %>
  </script>
  <script>
    let mapInstance = null;
    let userGpsMarker = null;
    let userGpsCircle = null;
    let userGpsWatchId = null;
    let lastKnownUserCoords = null;
    let centerMarkersMap = {};
    let residentDrawnShapes = [];
    let residentInfoWindow = null;

    function getResidentInfoWindow() {
      if (!residentInfoWindow && typeof google !== 'undefined' && google.maps) {
        residentInfoWindow = new google.maps.InfoWindow();
      }
      return residentInfoWindow;
    }

    function flyToCenter(lng, lat, centerId) {
      if (typeof window.stopEmergencyAlertSound === 'function') window.stopEmergencyAlertSound();
      if (window.AndroidBleBridge && typeof window.AndroidBleBridge.stopNativeEmergencyAlarm === 'function') {
        try { window.AndroidBleBridge.stopNativeEmergencyAlarm(); } catch (_) {}
      }
      const parsedLng = parseFloat(lng);
      const parsedLat = parseFloat(lat);
      if (isNaN(parsedLng) || isNaN(parsedLat)) return;

      if (mapInstance) {
        let item = null;
        if (centerId && centerMarkersMap[String(centerId)]) {
          item = centerMarkersMap[String(centerId)];
        } else if (centerId && centerMarkersMap[centerId]) {
          item = centerMarkersMap[centerId];
        } else {
          item = Object.values(centerMarkersMap).find(m => Math.abs((m.lat || 0) - parsedLat) < 0.0001 && Math.abs((m.lng || 0) - parsedLng) < 0.0001);
        }

        if (typeof mapInstance.flyTo === 'function') {
          if (typeof window.focusMaplibreSiteCentered === 'function') {
            window.focusMaplibreSiteCentered(mapInstance, parsedLng, parsedLat, item ? item.popup : null, centerMarkersMap, 16.8);
          }
          if (residentEvacSheet && residentEvacSheet.isExpanded) {
            residentEvacSheet.setCollapsed();
          }
          return;
        }

        if (typeof google !== 'undefined' && google.maps) {
          const pos = new google.maps.LatLng(parsedLat, parsedLng);
          mapInstance.panTo(pos);
          mapInstance.setZoom(17);
          if (item && item.triggerClick) {
            item.triggerClick();
          }
          if (typeof mapInstance.panBy === 'function') {
            mapInstance.panBy(0, -130);
          }
          if (residentEvacSheet && residentEvacSheet.isExpanded) {
            residentEvacSheet.setCollapsed();
          }
          return;
        }
      }

      if (window._activeOfflineResidentLeafletMap) {
        window._activeOfflineResidentLeafletMap.setView([parsedLat, parsedLng], 17);
        if (centerMarkersMap[centerId] && centerMarkersMap[centerId].triggerClick) {
          centerMarkersMap[centerId].triggerClick();
        }
        if (residentEvacSheet && residentEvacSheet.isExpanded) {
          residentEvacSheet.setCollapsed();
        }
      }
    }
    window.flyToCenter = flyToCenter;

    window.setMapStyleMode = function (mode) {
      const activeMap = mapInstance || window._activeOfflineResidentLeafletMap;
      if (!activeMap) return;
      const btnHybrid = document.getElementById('btnMapHybrid');
      const btnSatellite = document.getElementById('btnMapSatellite');
      const btnRoad = document.getElementById('btnMapRoad');
      const buttons = {
        hybrid: btnHybrid,
        satellite: btnSatellite,
        roads: btnRoad,
        roadmap: btnRoad
      };

      if (typeof activeMap.getLayer === 'function' && window.setEvakWarMaplibreStyle) {
        window.setEvakWarMaplibreStyle(activeMap, mode, buttons);
        return;
      }
      if (window.setEvakWarMapType) {
        window.setEvakWarMapType(activeMap, mode, buttons);
      }
    };

    window.toggleResident3DPitch = function () {
      const activeMap = mapInstance || window._activeOfflineResidentLeafletMap;
      if (!activeMap) return;
      if (typeof activeMap.getLayer === 'function' && window.toggleEvakWarMaplibre3D) {
        window.toggleEvakWarMaplibre3D(activeMap, document.getElementById('btnResident3D'));
        return;
      }
      if (window.toggleEvacwar3D) {
        window.toggleEvacwar3D(activeMap, document.getElementById('btnResident3D'));
      }
    };

    window.rotateResidentMap = function (degrees = 45) {
      const activeMap = mapInstance || window._activeOfflineResidentLeafletMap;
      if (!activeMap) return;
      if (typeof activeMap.getLayer === 'function' && window.rotateEvakWarMaplibreCamera) {
        window.rotateEvakWarMaplibreCamera(activeMap, degrees);
        return;
      }
      if (window.rotateEvacwarCamera) {
        window.rotateEvacwarCamera(activeMap, degrees);
      }
    };

    function updateLiveDistancesToCenters(userLat, userLng) {
      if (typeof userLat !== 'number' || typeof userLng !== 'number') return;
      let nearestCenter = null;
      let minDistance = Infinity;
      let centersList = [];
      const centersDataEl = document.getElementById('centers-data');
      if (centersDataEl && centersDataEl.textContent) {
        try { centersList = JSON.parse(centersDataEl.textContent); } catch (e) { }
      }
      if (!Array.isArray(centersList) || centersList.length === 0) {
        if (typeof centerMarkersMap === 'object' && centerMarkersMap) {
          centersList = Object.keys(centerMarkersMap).map(k => ({
            id: k,
            latitude: centerMarkersMap[k].lat,
            longitude: centerMarkersMap[k].lng
          })).filter(c => c.latitude && c.longitude);
        }
      }
      if (!Array.isArray(centersList)) return;

      centersList.forEach(center => {
        if (!center || !center.id) return;
        const cLat = parseFloat(center.latitude);
        const cLng = parseFloat(center.longitude);
        if (isNaN(cLat) || isNaN(cLng)) return;

        const R = 6371; // km
        const dLat = (cLat - userLat) * Math.PI / 180;
        const dLon = (cLng - userLng) * Math.PI / 180;
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
          Math.cos(userLat * Math.PI / 180) * Math.cos(cLat * Math.PI / 180) *
          Math.sin(dLon / 2) * Math.sin(dLon / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        const d = R * c;

        const distEl = document.getElementById(`distance-${center.id}`);
        if (distEl) distEl.innerText = d.toFixed(1) + ' km';

        if (d < minDistance) {
          minDistance = d;
          nearestCenter = { ...center, distanceKm: d };
        }
      });

      // 1. Instant Haversine baseline (works 100% offline immediately)
      const withDistances = centersList.map(center => {
        if (!center || !center.id) return center;
        const cLat = parseFloat(center.latitude);
        const cLng = parseFloat(center.longitude);
        if (isNaN(cLat) || isNaN(cLng)) return { ...center, distanceKm: Infinity, isRoadDistance: false };
        const R = 6371;
        const dLat = (cLat - userLat) * Math.PI / 180;
        const dLon = (cLng - userLng) * Math.PI / 180;
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
          Math.cos(userLat * Math.PI / 180) * Math.cos(cLat * Math.PI / 180) *
          Math.sin(dLon / 2) * Math.sin(dLon / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return { ...center, distanceKm: R * c, isRoadDistance: false };
      }).sort((a, b) => (a.distanceKm ?? Infinity) - (b.distanceKm ?? Infinity));

      const oldBanner = document.getElementById('nearestEvacRouteBanner');
      if (oldBanner) oldBanner.remove();

      if (withDistances.length > 0 && typeof updateResidentCentersPanelList === 'function') {
        updateResidentCentersPanelList(withDistances);
      }

      // 2. When online, upgrade immediately to REAL ROAD-ROUTE distances via single-request OSRM Table API
      // so the #1 Nearest Center & km badges match the actual driving/walking road route!
      const applyRoadRouteRanking = async () => {
        if (typeof navigator === 'undefined' || !navigator.onLine || withDistances.length === 0) return;
        const validCenters = withDistances.filter(c => c && Number.isFinite(parseFloat(c.latitude)) && Number.isFinite(parseFloat(c.longitude)));
        if (validCenters.length === 0) return;

        // Throttle OSRM Table API calls: reuse if user moved < 40m within last 25s
        const nowMs = Date.now();
        const prev = window._lastOsrmTableCache;
        if (prev && (nowMs - prev.ts) < 25000) {
          const dLatM = Math.abs(userLat - prev.lat) * 111320;
          const dLngM = Math.abs(userLng - prev.lng) * 111320 * Math.cos(userLat * Math.PI / 180);
          if (Math.hypot(dLatM, dLngM) < 40 && Array.isArray(prev.sorted) && prev.sorted.length > 0) {
            updateResidentCentersPanelList(prev.sorted);
            window._nearestEvacCenter = prev.sorted[0];
            return;
          }
        }

        try {
          const coordStr = [
            `${userLng},${userLat}`,
            ...validCenters.map(c => `${parseFloat(c.longitude)},${parseFloat(c.latitude)}`)
          ].join(';');
          const ctrl = new AbortController();
          const timer = setTimeout(() => ctrl.abort(), 4500);
          const resp = await fetch(
            `https://router.project-osrm.org/table/v1/driving/${coordStr}?sources=0&annotations=distance,duration`,
            { signal: ctrl.signal }
          );
          clearTimeout(timer);
          if (!resp.ok) return;
          const data = await resp.json();
          const row = data && Array.isArray(data.distances) && Array.isArray(data.distances[0]) ? data.distances[0] : null;
          if (!row || row.length < validCenters.length + 1) return;

          const roadSorted = validCenters.map((c, idx) => {
            const roadMeters = row[idx + 1];
            const hasRoad = typeof roadMeters === 'number' && Number.isFinite(roadMeters) && roadMeters >= 0;
            return {
              ...c,
              distanceKm: hasRoad ? (roadMeters / 1000) : c.distanceKm,
              isRoadDistance: hasRoad
            };
          }).sort((a, b) => (a.distanceKm ?? Infinity) - (b.distanceKm ?? Infinity));

          window._lastOsrmTableCache = { lat: userLat, lng: userLng, ts: Date.now(), sorted: roadSorted };
          window._nearestEvacCenter = roadSorted[0] || nearestCenter;
          if (typeof updateResidentCentersPanelList === 'function') {
            updateResidentCentersPanelList(roadSorted);
          }
        } catch (_) {
          // Offline / OSRM timeout -> keep Haversine ranking seamlessly
        }
      };
      applyRoadRouteRanking();

      if (nearestCenter) {
        window._nearestEvacCenter = nearestCenter;
        // ONLY auto-start navigation if explicitly launched from an "Evacuate" deep-link (?auto_route=nearest)
        try {
          const urlParams = new URLSearchParams(window.location.search || '');
          const isEvacDeepLink = urlParams.get('auto_route') === 'nearest' || urlParams.get('autoRouteNearest') === '1' || (window.location.pathname || '').toLowerCase().indexOf('/evacuate') !== -1 || (window.location.pathname || '').toLowerCase().indexOf('/nearest-evac') !== -1;
          if (isEvacDeepLink && !window.__evwAutoRoutedNearest) {
            window.__evwAutoRoutedNearest = true;
            setTimeout(() => {
              window.startResidentNavigationToCenter(
                parseFloat(nearestCenter.latitude),
                parseFloat(nearestCenter.longitude),
                nearestCenter.name || 'Nearest Evacuation Center',
                nearestCenter.id
              );
            }, 400);
          }
        } catch (_) {}
      }
    }

    function renderResidentDrawnFeatures(geoJson, map) {
      if (!geoJson || !geoJson.features || !map) return;

      // MapLibre GeoJSON Layer (safely wait for style load if not ready yet)
      if (typeof map.getSource === 'function') {
        const applyGeoJson = () => {
          try {
            const src = map.getSource('resident-features');
            if (src && typeof src.setData === 'function') {
              src.setData(geoJson);
              return;
            }
            map.addSource('resident-features', { type: 'geojson', data: geoJson });
            if (!map.getLayer('resident-hazards-fill')) {
              map.addLayer({
                id: 'resident-hazards-fill',
                type: 'fill',
                source: 'resident-features',
                filter: ['all', ['==', '$type', 'Polygon'], ['!=', 'type', 'boundary'], ['!=', 'type', 'zone']],
                paint: {
                  'fill-color': ['coalesce', ['get', 'fillColor'], ['get', 'color'], '#ef4444'],
                  'fill-opacity': 0.35
                }
              });
            }
            if (!map.getLayer('resident-hazards-line')) {
              map.addLayer({
                id: 'resident-hazards-line',
                type: 'line',
                source: 'resident-features',
                filter: ['all', ['==', '$type', 'Polygon'], ['!=', 'type', 'boundary'], ['!=', 'type', 'zone']],
                paint: {
                  'line-color': ['coalesce', ['get', 'strokeColor'], ['get', 'color'], '#dc2626'],
                  'line-width': 2.5,
                  'line-opacity': 0.95
                }
              });
            }
            if (!map.getLayer('resident-boundary-dashed-line')) {
              map.addLayer({
                id: 'resident-boundary-dashed-line',
                type: 'line',
                source: 'resident-features',
                filter: ['all', ['==', '$type', 'Polygon'], ['==', 'type', 'boundary']],
                paint: { 'line-color': '#f87171', 'line-width': 1.5, 'line-dasharray': [3, 2], 'line-opacity': 0.85 }
              });
            }
            if (!map.getLayer('resident-zone-dashed-line')) {
              map.addLayer({
                id: 'resident-zone-dashed-line',
                type: 'line',
                source: 'resident-features',
                filter: ['all', ['==', '$type', 'Polygon'], ['==', 'type', 'zone']],
                paint: { 'line-color': ['coalesce', ['get', 'strokeColor'], '#ffffff'], 'line-width': 1.5, 'line-dasharray': [3, 2], 'line-opacity': 0.9 }
              });
            }
            if (!map.getLayer('resident-routes')) {
              map.addLayer({
                id: 'resident-routes',
                type: 'line',
                source: 'resident-features',
                filter: ['==', '$type', 'LineString'],
                paint: { 'line-color': '#f97316', 'line-width': 4.5, 'line-opacity': 0.95 }
              });
            }
          } catch (e) {
            console.warn('[ResidentMap] renderResidentDrawnFeatures notice:', e && e.message);
          }
        };

        if (typeof map.isStyleLoaded === 'function' && !map.isStyleLoaded()) {
          map.once('load', applyGeoJson);
        } else {
          applyGeoJson();
        }
        return;
      }

      // Google Maps Polyline/Polygon fallback
      if (typeof google !== 'undefined' && google.maps) {
        geoJson.features.forEach(feature => {
          if (!feature.geometry) return;
          if (feature.geometry.type === 'LineString') {
            const coords = feature.geometry.coordinates.map(pt => ({ lat: pt[1], lng: pt[0] }));
            const polyline = new google.maps.Polyline({
              path: coords,
              strokeColor: '#f97316',
              strokeWeight: 4,
              strokeOpacity: 0.9,
              map: map
            });
            residentDrawnShapes.push(polyline);
          } else if (feature.geometry.type === 'Polygon') {
            const isBoundary = feature.properties && feature.properties.type === 'boundary';
            const coords = feature.geometry.coordinates[0].map(pt => ({ lat: pt[1], lng: pt[0] }));
            const polygon = new google.maps.Polygon({
              paths: coords,
              fillColor: isBoundary ? 'transparent' : (feature.properties && feature.properties.fillColor ? feature.properties.fillColor : '#ef4444'),
              fillOpacity: isBoundary ? 0 : 0.35,
              strokeColor: isBoundary ? '#f87171' : (feature.properties && feature.properties.strokeColor ? feature.properties.strokeColor : '#dc2626'),
              strokeWeight: isBoundary ? 1.5 : 2.5,
              strokeOpacity: isBoundary ? 0.6 : 0.95,
              map: map
            });
            residentDrawnShapes.push(polygon);
          }
        });
      }
    }

    function renderResidentCenters(centersList, map) {
      if (!map) return;
      if (!Array.isArray(centersList)) centersList = [];

      // MapLibre Centers Rendering
      if (typeof map.getLayer === 'function') {
        const currentIds = new Set();
        centersList.forEach(center => {
          if (!center || !center.id) return;
          const cId = String(center.id);
          currentIds.add(cId);

          const lat = parseFloat(center.latitude) || 13.5102;
          const lng = parseFloat(center.longitude) || 123.3470;
          const percent = Math.round(((parseInt(center.current_occupancy, 10) || 0) / (parseInt(center.max_capacity, 10) || 25)) * 100);
          let markerColor = '#10b981';
          if (percent >= 100) markerColor = '#ef4444';
          else if (percent >= 80) markerColor = '#f97316';

          const popupContent = window.buildCenterPopupHtml(center, 'resident');

          // If popup for this center is currently open on map, update live DOM immediately
          const livePopupEl = document.getElementById(`popup-center-${center.id}`);
          if (livePopupEl) {
            livePopupEl.outerHTML = popupContent;
          }

          if (centerMarkersMap[cId] && centerMarkersMap[cId].marker) {
            const existing = centerMarkersMap[cId];
            if (typeof existing.marker.setLngLat === 'function') {
              existing.marker.setLngLat([lng, lat]);
            }
            if (existing.popup) existing.popup.setHTML(popupContent);
            existing.lat = lat;
            existing.lng = lng;
            existing.triggerClick = () => flyToCenter(lng, lat, center.id);
            const markerEl = (existing.marker.getElement && typeof existing.marker.getElement === 'function') ? existing.marker.getElement() : null;
            if (markerEl) {
              const path = markerEl.querySelector('path');
              if (path) path.setAttribute('fill', markerColor);
              const rect = markerEl.querySelector('rect');
              if (rect) rect.setAttribute('fill', markerColor);
            }
          } else if (typeof maplibregl !== 'undefined') {
            const el = window.createMaplibreCenterMarkerEl(markerColor, center);
            const popup = new maplibregl.Popup({
              anchor: 'bottom',
              offset: [0, -44],
              maxWidth: '360px',
              closeButton: true,
              closeOnClick: false
            }).setHTML(popupContent);

            if (typeof window.bringMaplibrePopupToFront === 'function') {
              popup.on('open', () => window.bringMaplibrePopupToFront(popup));
            }

            const marker = new maplibregl.Marker({ element: el, anchor: 'bottom' })
              .setLngLat([lng, lat])
              .addTo(map);

            // When resident clicks evacuation center marker, focus on that site and open popup card on top
            el.addEventListener('click', (e) => {
              e.stopPropagation();
              flyToCenter(lng, lat, center.id);
            });

            const triggerClick = () => {
              flyToCenter(lng, lat, center.id);
            };

            const sId = String(center.id);
            centerMarkersMap[sId] = {
              marker,
              popup,
              triggerClick,
              lat,
              lng
            };
            centerMarkersMap[center.id] = centerMarkersMap[sId];
          }
        });

        // Calculate accurate live user distance & sort Nearest -> Farthest using native Capacitor GPS first, then Web Geolocation
        const applyUserGps = (lat, lng) => {
          if (typeof lat !== 'number' || typeof lng !== 'number' || isNaN(lat) || isNaN(lng)) return;
          lastKnownUserCoords = { latitude: lat, longitude: lng };
          window._lastKnownUserGps = { lat, lng, isFallback: false };
          updateLiveDistancesToCenters(lat, lng);
        };

        if (lastKnownUserCoords && typeof lastKnownUserCoords.latitude === 'number') {
          updateLiveDistancesToCenters(lastKnownUserCoords.latitude, lastKnownUserCoords.longitude);
        } else {
          const capGeo = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Geolocation;
          if (capGeo && typeof capGeo.getCurrentPosition === 'function') {
            capGeo.getCurrentPosition({ enableHighAccuracy: true, timeout: 12000, maximumAge: 5000 })
              .then(pos => { if (pos && pos.coords) applyUserGps(pos.coords.latitude, pos.coords.longitude); })
              .catch(() => {});
          }
          if ("geolocation" in navigator) {
            navigator.geolocation.getCurrentPosition(
              (geoPos) => applyUserGps(geoPos.coords.latitude, geoPos.coords.longitude),
              () => { },
              { enableHighAccuracy: true, timeout: 12000, maximumAge: 5000 }
            );
            if (!window.__evwResidentDistWatchId && typeof navigator.geolocation.watchPosition === 'function') {
              window.__evwResidentDistWatchId = navigator.geolocation.watchPosition(
                (geoPos) => applyUserGps(geoPos.coords.latitude, geoPos.coords.longitude),
                () => { },
                { enableHighAccuracy: true, timeout: 15000, maximumAge: 5000 }
              );
            }
          }
        }
        try {
          const urlParams = new URLSearchParams(window.location.search || '');
          const shouldAutoRoute = (
            urlParams.get('auto_route') === 'nearest' ||
            urlParams.get('autoRouteNearest') === '1' ||
            (window.location.pathname || '').toLowerCase().indexOf('/evacuate') !== -1 ||
            (window.location.pathname || '').toLowerCase().indexOf('/nearest-evac') !== -1
          ) && !window.__evwAutoRoutedNearest;
          if (shouldAutoRoute) window.__evwAutoRoutedNearest = true;
          if (typeof window.findAndRouteNearestEvacCenter === 'function') {
            setTimeout(() => { window.findAndRouteNearestEvacCenter(shouldAutoRoute); }, 400);
          }
        } catch (_) {}
        return;
      }

      // Google Maps Centers Rendering (Intact)
      if (typeof google === 'undefined' || !google.maps) return;
      centersList.forEach(center => {
        const lat = parseFloat(center.latitude) || 13.5102;
        const lng = parseFloat(center.longitude) || 123.3470;
        const pos = new google.maps.LatLng(lat, lng);

        const percent = Math.round(((parseInt(center.current_occupancy, 10) || 0) / (parseInt(center.max_capacity, 10) || 25)) * 100);
        let markerColor = '#10b981';
        if (percent >= 100) markerColor = '#ef4444';
        else if (percent >= 80) markerColor = '#f97316';

        const popupContent = window.buildCenterPopupHtml(center, 'resident');

        const centerMarker = new google.maps.Marker({
          position: pos,
          map: map,
          icon: typeof getCenterMarkerIcon === 'function' ? getCenterMarkerIcon(markerColor, center) : undefined,
          title: center.name,
          zIndex: 60
        });

        const openPopup = () => {
          const infowindow = getResidentInfoWindow();
          if (infowindow) {
            infowindow.setContent(popupContent);
            infowindow.setPosition(pos);
            infowindow.open(map, centerMarker);

            if ("geolocation" in navigator) {
              if (lastKnownUserCoords) {
                updateLiveDistancesToCenters(lastKnownUserCoords.latitude, lastKnownUserCoords.longitude);
              } else {
                navigator.geolocation.getCurrentPosition((geoPos) => {
                  lastKnownUserCoords = geoPos.coords;
                  window._lastKnownUserGps = { lat: geoPos.coords.latitude, lng: geoPos.coords.longitude, isFallback: false };
                  updateLiveDistancesToCenters(geoPos.coords.latitude, geoPos.coords.longitude);
                }, () => {
                  const distEl = document.getElementById(`distance-${center.id}`);
                  if (distEl) distEl.innerText = 'Location access denied';
                });
              }
            }
          }
        };

        centerMarker.addListener('click', openPopup);
        centerMarkersMap[center.id] = { marker: centerMarker, triggerClick: openPopup };
      });
    }

    function initResidentEvacuationMap() {
      if (typeof google === 'undefined' || !google.maps) return;
      if (mapInstance) return;

      const defaultCenter = { lat: 13.5135, lng: 123.3485 };
      const map = window.createEvakWarMap(document.getElementById('evacuationMap'), {
        center: defaultCenter,
        zoom: 16
      });

      mapInstance = map;
      window._residentMapReady = true;

      // Admin Drawn Routes & Hazards from DB
      let initialFeatures = { type: 'FeatureCollection', features: [] };
      try {
        const raw = document.getElementById('map-features-data').textContent;
        initialFeatures = typeof raw === 'string' ? JSON.parse(raw) : raw;
      } catch (e) { }
      renderResidentDrawnFeatures(initialFeatures, map);

      // Render Evacuation Centers
      let centersData = [];
      try { centersData = JSON.parse(document.getElementById('centers-data').textContent || '[]'); } catch (e) { }

      // Cache domain map data in IndexedDB for resilient offline access
      if (window.EvakWarDB && typeof window.EvakWarDB.saveMapData === 'function') {
        window.EvakWarDB.saveMapData(centersData, initialFeatures);
      }

      if (Array.isArray(centersData) && centersData.length > 0) {
        renderResidentCenters(centersData, map);
      } else if (window.EvakWarDB && typeof window.EvakWarDB.getMapData === 'function') {
        window.EvakWarDB.getMapData().then(cached => {
          if (cached) {
            if (cached.centers && cached.centers.length > 0) renderResidentCenters(cached.centers, map);
            if (cached.mapFeatures && cached.mapFeatures.features) renderResidentDrawnFeatures(cached.mapFeatures, map);
          }
        }).catch(err => console.warn('[Evacwar Map] IndexedDB map data read error:', err));
      }


      // Socket.io for Real-time Map Updates
      if (typeof io !== 'undefined') {
        const socket = io();

        async function fetchAndRefreshResidentCenters() {
          try {
            const res = await fetch('/api/centers/active');
            const data = await res.json();
            if (data.success && Array.isArray(data.centers) && map) {
              renderResidentCenters(data.centers, map);
              updateResidentCentersPanelList(data.centers);
            }
          } catch (e) {
            console.warn('[ResidentMap] Failed to refresh centers live:', e);
          }
        }

        socket.on('center_updated', (data) => {
          if (data && Array.isArray(data.centers) && map) {
            renderResidentCenters(data.centers, map);
            updateResidentCentersPanelList(data.centers);
          } else {
            fetchAndRefreshResidentCenters();
          }
        });

        socket.on('checkin:new', () => {
          fetchAndRefreshResidentCenters();
        });

        socket.on('ec_board_updated', () => {
          fetchAndRefreshResidentCenters();
        });

        socket.on('map_features_updated', (data) => {
          residentDrawnShapes.forEach(s => s.setMap(null));
          residentDrawnShapes = [];
          renderResidentDrawnFeatures(data, map);
        });

        socket.on('map_centers_updated', (data) => {
          if (data && Array.isArray(data.centers)) {
            if (typeof centerMarkersMap !== 'undefined') {
              Object.values(centerMarkersMap).forEach(item => {
                if (item && item.marker && typeof item.marker.setMap === 'function') {
                  item.marker.setMap(null);
                }
              });
              centerMarkersMap = {};
            }
            if (map && typeof renderResidentCenters === 'function') {
              renderResidentCenters(data.centers, map);
            }
            const dataEl = document.getElementById('centers-data');
            if (dataEl) dataEl.textContent = JSON.stringify(data.centers);
            if (window.EvakWarDB && typeof window.EvakWarDB.saveMapData === 'function') {
              window.EvakWarDB.saveMapData(data.centers);
            }
          } else {
            fetchAndRefreshResidentCenters();
          }
        });
      }
    }

    window.startResidentNavigationToCenter = function (lat, lng, name, centerId) {
      if (typeof window.stopEmergencyAlertSound === 'function') window.stopEmergencyAlertSound();
      if (window.AndroidBleBridge && typeof window.AndroidBleBridge.stopNativeEmergencyAlarm === 'function') {
        try { window.AndroidBleBridge.stopNativeEmergencyAlarm(); } catch (_) {}
      }
      if (typeof residentEvacSheet !== 'undefined' && residentEvacSheet && typeof residentEvacSheet.setCollapsed === 'function') {
        residentEvacSheet.setCollapsed();
      }
      if (typeof window.showEvakWarDirections === 'function') {
        window.showEvakWarDirections(parseFloat(lat), parseFloat(lng), name || 'Evacuation Center');
      } else if (typeof flyToCenter === 'function') {
        flyToCenter(parseFloat(lng), parseFloat(lat), centerId);
      }
    };

    function updateResidentCentersPanelList(centersList) {
      if (!Array.isArray(centersList) || centersList.length === 0) return;
      const listContainer = document.getElementById('residentCentersListContainer');
      const badge = document.getElementById('residentCentersCountBadge');
      if (badge) badge.textContent = `${centersList.length} Sites`;
      if (!listContainer) return;

      listContainer.innerHTML = centersList.map((center, index) => {
        const occ = parseInt(center.current_occupancy, 10) || 0;
        const max = Math.max(1, parseInt(center.max_capacity, 10) || 25);
        const percent = Math.round((occ / max) * 100);
        let barColor = "bg-emerald-500";
        let statusColor = "text-emerald-700 bg-emerald-50 border-emerald-200";
        let availability = "Available";

        if (percent >= 100) {
          barColor = "bg-red-500";
          statusColor = "text-red-700 bg-red-50 border-red-200";
          availability = "Full";
        } else if (percent >= 80) {
          barColor = "bg-orange-500";
          statusColor = "text-orange-700 bg-orange-50 border-orange-200";
          availability = "Near Full";
        }
        const progressWidth = Math.min(percent, 100) + '%';
        const safeLng = String(center.longitude || '123.3470');
        const safeLat = String(center.latitude || '13.5102');
        const safeId = String(center.id || index);
        const safeName = String(center.name || 'Evacuation Center');
        const safeNameJs = safeName.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
        const safeAddress = String(center.address || 'San Rafael');
        const distHtml = (typeof center.distanceKm === 'number' && Number.isFinite(center.distanceKm))
          ? `<span id="distance-${safeId}" class="inline-flex items-center gap-0.5 font-mono font-extrabold text-emerald-700 bg-emerald-50 px-1.5 py-0.2 rounded-md border border-emerald-200/70">${center.distanceKm.toFixed(2)} km</span>`
          : `<span id="distance-${safeId}" class="inline-flex items-center gap-0.5 font-mono font-extrabold text-emerald-700"></span>`;

        const isFirst = index === 0;
        const rankLabel = isFirst ? '1st Nearest' : `#${index + 1}`;
        const rankClass = isFirst ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-600';
        const cardClass = isFirst
          ? 'bg-emerald-50/40 border-emerald-200 shadow-xs'
          : 'bg-white border-slate-200/80 hover:border-slate-300';

        return `
          <div
            id="resident-center-card-${safeId}"
            class="rounded-2xl p-2.5 sm:p-3 border transition-all relative overflow-hidden cursor-pointer active:scale-[0.99] ${cardClass}"
            onclick="flyToCenter('${safeLng}', '${safeLat}', '${safeId}')">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="px-1.5 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider ${rankClass}">${rankLabel}</span>
                  <h4 class="font-extrabold text-slate-900 text-xs sm:text-sm leading-tight truncate">${safeName}</h4>
                </div>
                <div class="flex items-center gap-2 mt-1 text-[10px] text-slate-500 font-semibold flex-wrap">
                  <span class="inline-flex items-center gap-0.5 truncate max-w-[170px]">
                    <i class="ph ph-map-pin text-blue-500"></i> ${safeAddress}
                  </span>
                  ${distHtml}
                </div>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-extrabold border shrink-0 ${statusColor}">
                ${availability}
              </span>
            </div>

            <div class="mt-2 flex items-center gap-2.5">
              <div class="flex-1 min-w-0">
                <div class="flex justify-between text-[10px] font-semibold text-slate-500 mb-0.5">
                  <span>Occupancy (${percent}%)</span>
                  <span class="font-bold text-slate-700">${occ} / ${max}</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
                  <div class="${barColor} h-full rounded-full transition-all duration-500" style="width: ${progressWidth};"></div>
                </div>
              </div>
              <button type="button"
                onclick="event.stopPropagation(); startResidentNavigationToCenter('${safeLat}', '${safeLng}', '${safeNameJs}', '${safeId}')"
                class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-extrabold shadow-xs flex items-center gap-1 shrink-0 transition-transform active:scale-95 cursor-pointer">
                <i class="ph ph-navigation-arrow text-xs"></i>
                <span>Navigate</span>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    async function initResidentMaplibreMap() {
      if (typeof maplibregl === 'undefined' || typeof window.createEvakWarMaplibreMap !== 'function') {
        setTimeout(initResidentMaplibreMap, 50);
        return;
      }
      if (mapInstance) return mapInstance;

      let centersData = [];
      try { centersData = JSON.parse(document.getElementById('centers-data').textContent || '[]'); } catch (e) { }

      let initialFeatures = { type: 'FeatureCollection', features: [] };
      try {
        const raw = document.getElementById('map-features-data').textContent;
        initialFeatures = typeof raw === 'string' ? JSON.parse(raw) : raw;
      } catch (e) { }

      // Local IndexedDB caching fallback for offline use (identical mechanism as Staff Map)
      if ((!centersData || centersData.length === 0) && window.EvakWarDB && typeof window.EvakWarDB.getMapData === 'function') {
        try {
          const cached = await window.EvakWarDB.getMapData();
          if (cached) {
            if (Array.isArray(cached.centers) && cached.centers.length > 0) {
              centersData = cached.centers;
            }
            if (cached.mapFeatures && Array.isArray(cached.mapFeatures.features) && cached.mapFeatures.features.length > 0) {
              initialFeatures = cached.mapFeatures;
            }
          }
        } catch (err) {
          console.warn('[Evacwar Resident Map] EvakWarDB getMapData notice:', err);
        }
      }

      // Populate resident list panel if loaded from cache or server
      if (Array.isArray(centersData) && centersData.length > 0) {
        updateResidentCentersPanelList(centersData);
      }

      // Cache fresh data in IndexedDB
      if (window.EvakWarDB && typeof window.EvakWarDB.saveMapData === 'function' && Array.isArray(centersData) && centersData.length > 0) {
        window.EvakWarDB.saveMapData(centersData, initialFeatures);
      }

      const defaultCenter = [123.3485, 13.5135];
      const initialSources = {
        'resident-features': {
          type: 'geojson',
          data: initialFeatures || { type: 'FeatureCollection', features: [] }
        }
      };
      const initialLayers = [
        {
          id: 'resident-hazards-fill',
          type: 'fill',
          source: 'resident-features',
          filter: ['all', ['==', '$type', 'Polygon'], ['!=', 'type', 'boundary'], ['!=', 'type', 'zone']],
          paint: {
            'fill-color': ['coalesce', ['get', 'fillColor'], ['get', 'color'], '#ef4444'],
            'fill-opacity': 0.35
          }
        },
        {
          id: 'resident-hazards-line',
          type: 'line',
          source: 'resident-features',
          filter: ['all', ['==', '$type', 'Polygon'], ['!=', 'type', 'boundary'], ['!=', 'type', 'zone']],
          paint: {
            'line-color': ['coalesce', ['get', 'strokeColor'], ['get', 'color'], '#dc2626'],
            'line-width': 2.5,
            'line-opacity': 0.95
          }
        },
        {
          id: 'resident-boundary-dashed-line',
          type: 'line',
          source: 'resident-features',
          filter: ['all', ['==', '$type', 'Polygon'], ['==', 'type', 'boundary']],
          paint: {
            'line-color': '#f87171',
            'line-width': 1.5,
            'line-dasharray': [3, 2],
            'line-opacity': 0.85
          }
        },
        {
          id: 'resident-zone-dashed-line',
          type: 'line',
          source: 'resident-features',
          filter: ['all', ['==', '$type', 'Polygon'], ['==', 'type', 'zone']],
          paint: {
            'line-color': ['coalesce', ['get', 'strokeColor'], '#ffffff'],
            'line-width': 1.5,
            'line-dasharray': [3, 2],
            'line-opacity': 0.9
          }
        },
        {
          id: 'resident-routes',
          type: 'line',
          source: 'resident-features',
          filter: ['==', '$type', 'LineString'],
          paint: { 'line-color': '#f97316', 'line-width': 4.5, 'line-opacity': 0.95 }
        }
      ];

      const map = window.createEvakWarMaplibreMap('evacuationMap', {
        center: defaultCenter,
        zoom: 15.5,
        initialSources: initialSources,
        initialLayers: initialLayers,
        initialBasemap: 'hybrid'
      });
      mapInstance = map;
      window._residentMapReady = true;



      // Render Centers immediately without waiting for tiles or load event
      if (Array.isArray(centersData) && centersData.length > 0) {
        renderResidentCenters(centersData, map);
      }

      const renderAllMapData = () => {
        renderResidentDrawnFeatures(initialFeatures, map);
        renderResidentCenters(centersData, map);
      };

      if (map.loaded()) {
        renderAllMapData();
      } else {
        map.once('load', renderAllMapData);
      }
      map.on('style.load', () => {
        renderResidentDrawnFeatures(initialFeatures, map);
      });

      const updateOfflineBadge = () => {
        let badge = document.getElementById('mapOfflineBadge');
        if (!navigator.onLine) {
          if (!badge) {
            badge = document.createElement('div');
            badge.id = 'mapOfflineBadge';
            badge.className = 'absolute top-3 left-3 z-30 bg-slate-900/90 backdrop-blur-md border border-slate-700 text-white px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-lg';
            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span><span>Offline Mode</span>';
            const mapContainer = document.getElementById('evacuationMap');
            if (mapContainer && mapContainer.parentElement) {
              mapContainer.parentElement.appendChild(badge);
            }
          }
        } else if (badge) {
          badge.remove();
        }
      };
      updateOfflineBadge();
      window.addEventListener('online', updateOfflineBadge);
      window.addEventListener('offline', updateOfflineBadge);

      // Socket.io for Real-time Map Updates
      if (typeof io !== 'undefined') {
        const socket = io();

        async function fetchAndRefreshResidentCenters() {
          try {
            const res = await fetch('/api/centers/active');
            const data = await res.json();
            if (data.success && Array.isArray(data.centers) && map) {
              renderResidentCenters(data.centers, map);
              updateResidentCentersPanelList(data.centers);
            }
          } catch (e) {
            console.warn('[ResidentMap] Failed to refresh centers live:', e);
          }
        }

        socket.on('center_updated', (data) => {
          if (data && Array.isArray(data.centers) && map) {
            renderResidentCenters(data.centers, map);
            updateResidentCentersPanelList(data.centers);
          } else {
            fetchAndRefreshResidentCenters();
          }
        });

        socket.on('checkin:new', () => {
          fetchAndRefreshResidentCenters();
        });

        socket.on('ec_board_updated', () => {
          fetchAndRefreshResidentCenters();
        });

        socket.on('map_features_updated', (data) => {
          renderResidentDrawnFeatures(data, map);
        });

        socket.on('map_centers_updated', (data) => {
          if (data && Array.isArray(data.centers)) {
            renderResidentCenters(data.centers, map);
            updateResidentCentersPanelList(data.centers);
            const dataEl = document.getElementById('centers-data');
            if (dataEl) dataEl.textContent = JSON.stringify(data.centers);
            if (window.EvakWarDB && typeof window.EvakWarDB.saveMapData === 'function') {
              window.EvakWarDB.saveMapData(data.centers);
            }
          } else {
            fetchAndRefreshResidentCenters();
          }
        });

        setInterval(fetchAndRefreshResidentCenters, 15000);
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) fetchAndRefreshResidentCenters();
        });

        // Plot Live Rescuer Profile Picture Markers on Resident Evacuation Map
        const residentRescuerMarkers = {};
        function plotResidentMapRescuer(rData) {
          if (!rData || !map || typeof maplibregl === 'undefined') return;
          const rLat = parseFloat(rData.latitude !== undefined ? rData.latitude : (rData.lat !== undefined ? rData.lat : rData.rescuer_lat));
          const rLng = parseFloat(rData.longitude !== undefined ? rData.longitude : (rData.lng !== undefined ? rData.lng : rData.rescuer_lng));
          if (!isFinite(rLat) || !isFinite(rLng)) return;
          const st = String(rData.status || 'RESPONDING').toUpperCase();
          const key = rData.rescuer_user_id ? `u_${rData.rescuer_user_id}` : String(rData.sos_id || rData.id || 'default');
          if (st === 'RESOLVED' || st === 'CANCELLED') {
            if (residentRescuerMarkers[key]) {
              try { residentRescuerMarkers[key].remove(); } catch (_) {}
              delete residentRescuerMarkers[key];
            }
            return;
          }
          const rName = rData.rescuer_name || rData.handler_name || rData.responder_name || 'Emergency Rescuer';
          const rPhoto = rData.rescuer_photo || rData.handler_photo || null;
          const el = (typeof window.createMaplibreRescuerMarkerEl === 'function')
            ? window.createMaplibreRescuerMarkerEl({ rescuer_name: rName, rescuer_photo: rPhoto })
            : document.createElement('div');
          const popupHtml = `
            <div style="font-family: system-ui; padding: 6px; text-align: center;">
              <div style="font-weight: 800; color: #0f172a; font-size: 13px;">${rName}</div>
              <div style="font-size: 11px; color: #059669; font-weight: 700; margin-top: 2px;">Barangay Emergency Rescuer</div>
            </div>
          `;
          if (residentRescuerMarkers[key]) {
            residentRescuerMarkers[key].setLngLat([rLng, rLat]);
            const mEl = residentRescuerMarkers[key].getElement && residentRescuerMarkers[key].getElement();
            if (mEl) mEl.innerHTML = el.innerHTML;
          } else {
            residentRescuerMarkers[key] = new maplibregl.Marker({ element: el, anchor: 'center' })
              .setLngLat([rLng, rLat])
              .setPopup(new maplibregl.Popup({ offset: 22 }).setHTML(popupHtml))
              .addTo(map);
          }
        }

        socket.on('rescuer:location_update', (data) => {
          plotResidentMapRescuer(data);
        });
        socket.on('sos:update_status', (data) => {
          if (data && (data.rescuer_lat || (data.alert && data.alert.rescuer_lat))) {
            plotResidentMapRescuer({
              sos_id: data.id || data.sos_id,
              rescuer_user_id: data.handled_by || (data.alert && data.alert.handled_by),
              rescuer_name: data.responder_name || data.handler_name || (data.alert && data.alert.handler_name),
              rescuer_photo: data.rescuer_photo || data.handler_photo || (data.alert && (data.alert.rescuer_photo || data.alert.handler_photo)),
              latitude: data.rescuer_lat || (data.alert && data.alert.rescuer_lat),
              longitude: data.rescuer_lng || (data.alert && data.alert.rescuer_lng),
              status: data.status
            });
          }
        });
        fetch('/api/sos/resident/active')
          .then(r => r.json())
          .then(d => {
            if (d && d.success && d.activeSos && (d.activeSos.handled_by || d.activeSos.handler_name)) {
              plotResidentMapRescuer({
                sos_id: d.activeSos.id,
                rescuer_user_id: d.activeSos.handled_by,
                rescuer_name: d.activeSos.handler_name || d.activeSos.responder_name,
                rescuer_photo: d.activeSos.rescuer_photo || d.activeSos.handler_photo,
                latitude: d.activeSos.rescuer_lat || 13.51037,
                longitude: d.activeSos.rescuer_lng || 123.34810,
                status: d.activeSos.status
              });
            }
          })
          .catch(() => {});
      }

      return map;
    }

    class MobileBottomSheet {
      constructor(sheetId, handleId, scrollAreaId, peekHeight = 48) {
        this.sheet = document.getElementById(sheetId);
        this.handle = document.getElementById(handleId);
        this.scrollArea = document.getElementById(scrollAreaId);
        this.peekHeight = peekHeight;
        this.isExpanded = false;
        this.startY = 0;
        this.isDragging = false;

        if (!this.sheet || !this.handle) return;
        this.init();
      }

      init() {
        this.setCollapsed();

        this.handle.addEventListener('click', (e) => {
          e.stopPropagation();
          this.toggle();
        });

        this.handle.addEventListener('touchstart', (e) => {
          this.startY = e.touches[0].clientY;
          this.isDragging = true;
          this.sheet.style.transition = 'none';
        }, { passive: true });

        window.addEventListener('touchmove', (e) => {
          if (!this.isDragging) return;
          const clientY = e.touches[0].clientY;
          const deltaY = clientY - this.startY;

          if (!this.isExpanded) {
            if (deltaY < 0) {
              const sheetHeight = this.sheet.offsetHeight;
              const targetTranslate = Math.max(0, (sheetHeight - this.peekHeight) + deltaY);
              this.sheet.style.transform = `translateY(${targetTranslate}px)`;
              if (e.cancelable) e.preventDefault();
            }
          } else {
            if (deltaY > 0 && (!this.scrollArea || this.scrollArea.scrollTop <= 0)) {
              this.sheet.style.transform = `translateY(${deltaY}px)`;
              if (e.cancelable) e.preventDefault();
            }
          }
        }, { passive: false });

        window.addEventListener('touchend', (e) => {
          if (!this.isDragging) return;
          this.isDragging = false;
          const deltaY = (e.changedTouches[0].clientY) - this.startY;

          if (!this.isExpanded) {
            if (deltaY < -30) {
              this.setExpanded();
            } else {
              this.setCollapsed();
            }
          } else {
            if (deltaY > 30) {
              this.setCollapsed();
            } else {
              this.setExpanded();
            }
          }
        }, { passive: true });
      }

      setCollapsed() {
        this.isExpanded = false;
        this.sheet.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
        this.sheet.style.transform = `translateY(calc(100% - ${this.peekHeight}px))`;
        if (this.scrollArea) {
          this.scrollArea.scrollTop = 0;
          this.scrollArea.style.overflowY = 'hidden';
        }
      }

      setExpanded() {
        this.isExpanded = true;
        this.sheet.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
        this.sheet.style.transform = 'translateY(0)';
        if (this.scrollArea) {
          this.scrollArea.style.overflowY = 'auto';
        }
      }

      toggle() {
        if (this.isExpanded) this.setCollapsed();
        else this.setExpanded();
      }
    }

    let residentEvacSheet = null;
    document.addEventListener('DOMContentLoaded', () => {
      residentEvacSheet = new MobileBottomSheet('residentEvacBottomSheet', 'residentEvacSheetHandle', 'residentEvacScrollArea', 56);
    });

    if (window.MAP_CONFIG && window.MAP_CONFIG.provider === 'maplibre') {
      if (document.getElementById('evacuationMap')) {
        initResidentMaplibreMap();
      } else if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initResidentMaplibreMap);
      } else {
        initResidentMaplibreMap();
      }
    } else {
      whenGoogleMapsReady(() => {
        window._residentMapReady = true;
        initResidentEvacuationMap();
      });
    }

    // Immediate Local DB Cache of Server-Rendered Map Data
    document.addEventListener('DOMContentLoaded', () => {
      try {
        const centersData = JSON.parse(document.getElementById('centers-data').textContent || '[]');
        const raw = document.getElementById('map-features-data').textContent;
        const initialFeatures = typeof raw === 'string' ? JSON.parse(raw) : raw;
        if (window.EvakWarDB && typeof window.EvakWarDB.saveMapData === 'function' && Array.isArray(centersData) && centersData.length > 0) {
          window.EvakWarDB.saveMapData(centersData, initialFeatures);
        }
      } catch (e) { }
    });
  </script>

