  <!-- SCRIPT LOGIC FOR MODALS, AVATAR, THEME & LOCALIZATION -->
  <script>
    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
    }

    function openEditProfileModal() { openModal('modalEditProfile'); }
    function openPersonalInfoModal() { openModal('modalPersonalInfo'); }
    function openEmergencyContactModal() { openModal('modalEmergencyContact'); }
    function openVulnerabilityModal() { openModal('modalVulnerability'); }
    function openChangePasswordModal() { openModal('modalChangePassword'); }
    function openNotificationsModal() { openModal('modalNotifications'); }
    function openLanguageModal() { openModal('modalLanguage'); }
    function openAboutModal() { openModal('modalAbout'); }
    function openPrivacyModal() { openModal('modalPrivacy'); }
    function openInstallAppModal() {
      if (window.EvakWarPWA && window.EvakWarPWA.openInstallModal) {
        window.EvakWarPWA.openInstallModal();
      } else {
        openModal('modalInstallApp');
      }
    }
    function closeInstallAppModal() {
      if (window.EvakWarPWA && window.EvakWarPWA.closeInstallModal) {
        window.EvakWarPWA.closeInstallModal();
      } else {
        closeModal('modalInstallApp');
      }
    }

    // Instant Avatar Upload & Submit
    function previewAndSubmitAvatar(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        if (!file.type.startsWith('image/')) {
          alert('Please select a valid image file.');
          input.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          alert('Image file size must be less than 10MB.');
          input.value = '';
          return;
        }
        
        // Submit avatar form immediately
        const form = document.getElementById('avatarUploadForm');
        if (form) form.submit();
      }
    }

    // App Theme Toggle (Light / Dark)
    function toggleAppTheme() {
      const current = localStorage.getItem('Evacwar_theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      localStorage.setItem('Evacwar_theme', next);
      applyTheme(next);
    }

    function applyTheme(theme) {
      const label = document.getElementById('current-theme-label');
      const icon = document.getElementById('theme-icon');
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
        if (label) label.innerText = 'Dark Mode Active';
        if (icon) icon.className = 'ph ph-moon';
      } else {
        document.documentElement.classList.remove('dark');
        if (label) label.innerText = 'Light Mode Active';
        if (icon) icon.className = 'ph ph-sun';
      }
    }

    // Centralized Shared Language Setter & Localizer
    function setAppLanguage(lang, label) {
      if (window.EvacwarI18n && window.EvacwarI18n.setLanguage) {
        window.EvacwarI18n.setLanguage(lang, label);
      }
      closeModal('modalLanguage');
    }

    // Initialize state
    document.addEventListener('DOMContentLoaded', () => {
      const savedTheme = localStorage.getItem('Evacwar_theme') || 'light';
      applyTheme(savedTheme);

      if (window.applyCurrentLanguage) {
        window.applyCurrentLanguage();
      }

      if (window.EvakWarPWA && window.EvakWarPWA.syncUI) {
        window.EvakWarPWA.syncUI();
      }

      // Validation for Edit Profile Form
      const formEditProfile = document.getElementById('formEditProfile');
      if (formEditProfile) {
        formEditProfile.addEventListener('submit', function (e) {
          const contact = (document.getElementById('res_edit_contact')?.value || '').trim();
          if (contact && !/^09\d{9}$/.test(contact)) {
            e.preventDefault();
            alert('Please enter a valid 11-digit Philippine mobile number starting with 09 (e.g., 09123456789).');
            document.getElementById('res_edit_contact')?.focus();
            return false;
          }
        });
      }

      // Validation for Emergency Contact Form
      const formEmerg = document.getElementById('formEmergencyContact');
      if (formEmerg) {
        formEmerg.addEventListener('submit', function (e) {
          const phone = (document.getElementById('res_emerg_phone')?.value || '').trim();
          if (phone && !/^09\d{9}$/.test(phone)) {
            e.preventDefault();
            alert('Please enter a valid 11-digit Philippine mobile number starting with 09 (e.g., 09123456789).');
            document.getElementById('res_emerg_phone')?.focus();
            return false;
          }
        });
      }

      // Validation for Change Password Form
      const formPass = document.getElementById('formChangePassword');
      if (formPass) {
        formPass.addEventListener('submit', function (e) {
          const newPass = (document.getElementById('res_new_password')?.value || '').trim();
          const confPass = (document.getElementById('res_confirm_password')?.value || '').trim();

          if (newPass.length < 8 || !/[a-zA-Z]/.test(newPass) || !/[0-9]/.test(newPass)) {
            e.preventDefault();
            alert('Password must be at least 8 characters long and contain both letters and numbers.');
            document.getElementById('res_new_password')?.focus();
            return false;
          }

          if (newPass !== confPass) {
            e.preventDefault();
            alert('New password and confirmation password do not match.');
            document.getElementById('res_confirm_password')?.focus();
            return false;
          }
        });
      }

      // Auto-open modal if URL specifies
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('openModal') === 'editProfile') {
        openEditProfileModal();
      } else if (urlParams.get('openModal') === 'personalInfo') {
        openPersonalInfoModal();
      }

      // Close modal on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          ['modalEditProfile', 'modalPersonalInfo', 'modalEmergencyContact', 'modalVulnerability', 'modalChangePassword', 'modalNotifications', 'modalLanguage', 'modalAbout', 'modalPrivacy', 'modalInstallApp'].forEach(id => {
            closeModal(id);
          });
        }
      });
    });
  </script>

  <%- include('../partials/footer') %>
<script>
    (function() {
      function syncSettingsTransportBadge() {
        const badge = document.getElementById('settingsActiveTransportBadge');
        if (!badge) return;
        const lora = window.evakwarLoraClient;
        const isOnline = navigator.onLine;
        if (lora && lora.connected) {
          if (lora.transport === 'BLE') {
            badge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-800 border border-indigo-300';
            badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span> BLE: ' + (lora.deviceName ? lora.deviceName.split(' ')[0] : 'RES1');
          } else if (lora.transport === 'USB_SERIAL') {
            badge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-cyan-100 text-cyan-800 border border-cyan-300';
            badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span> USB-OTG CABLE';
          }
        } else if (isOnline) {
          badge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
          badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> WI-FI ONLINE';
        } else {
          badge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300 animate-pulse';
          badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> OFFLINE (NO LORA)';
        }
      }

      window.addEventListener('online', syncSettingsTransportBadge);
      window.addEventListener('offline', syncSettingsTransportBadge);
      if (window.evakwarLoraClient && typeof window.evakwarLoraClient.on === 'function') {
        window.evakwarLoraClient.on('status', syncSettingsTransportBadge);
      }
      setTimeout(syncSettingsTransportBadge, 200);
      setTimeout(syncSettingsTransportBadge, 1000);
    })();
  </script>