<%- include('../partials/header') %>

  <div class="app-main-layout">
    <%- include('../partials/sidebar') %>

      <main class="app-content flex flex-col min-h-screen bg-slate-50 relative pb-40 lg:pb-12 overflow-x-hidden">
        <div class="max-w-7xl mx-auto space-y-6 flex-1 w-full px-4 sm:px-6 py-4">


          <!-- Minimalist LoRa Mesh & Network Status Strip -->
          <div id="loraMeshStatusStrip" onclick="window.openLoraHardwarePicker && window.openLoraHardwarePicker()"
            class="rounded-xl bg-slate-900/90 text-white px-3.5 py-2.5 border border-slate-800 shadow-xs flex items-center justify-between gap-3 text-xs cursor-pointer hover:bg-slate-900 transition-colors"
            title="Tap for LoRa Hardware connection options">
            <div class="flex items-center gap-2.5 min-w-0">
              <span id="loraStatusDot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
              <div class="flex items-center gap-2 truncate">
                <span id="loraStatusTitle" class="font-bold text-white text-xs">LoRa Mesh Standby</span>
                <span class="text-slate-500 text-[11px] hidden sm:inline">•</span>
                <span id="loraStatusSubtitle" class="text-slate-400 text-[11px] truncate">433.875 MHz Emergency Backup</span>
              </div>
            </div>
            <div id="loraStatusBadgeContainer" class="shrink-0 flex items-center gap-2">
              <span id="webLoraStatusBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                Online (Wi-Fi)
              </span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- SOS Trigger Card -->
            <div
              class="lg:col-span-5 card p-6 sm:p-8 flex flex-col items-center justify-center text-center border-t-8 border-red-500 shadow-elevated relative overflow-hidden bg-white rounded-3xl">

              <!-- SOS Button Circle -->
              <button id="sos-btn" type="button"
                class="w-44 h-44 sm:w-52 sm:h-52 rounded-full bg-gradient-to-br from-red-500 to-rose-600 text-white shadow-2xl hover:from-red-600 hover:to-rose-700 hover:scale-105 active:scale-95 transition-all flex flex-col items-center justify-center border-8 border-red-100 mb-4 relative group cursor-pointer">
                <div id="sosBtnPing"
                  class="absolute inset-0 bg-red-400 animate-ping opacity-40 group-hover:opacity-70 transition-opacity rounded-full">
                </div>
                <i id="sosBtnIcon" class="ph ph-warning-octagon text-6xl relative z-10 mb-2"></i>
                <span id="sosBtnText" class="text-3xl font-black relative z-10 tracking-widest">S O S</span>
              </button>

              <!-- STOP SOS Button Container (Visible ONLY when SOS is active) -->
              <div id="stopSosContainer" class="hidden w-full max-w-xs mb-4 animate-fade-in">
                <button id="stopSosBtn" type="button"
                  class="w-full py-3.5 px-6 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white border-2 border-red-500 shadow-lg font-black text-sm uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer active:scale-95 transition-all">
                  <i class="ph ph-stop-circle text-2xl text-red-500"></i>
                  <span>STOP SOS</span>
                </button>
              </div>

              <h3 id="sosCardHeading" class="font-bold text-slate-800 text-lg mb-1">Press for Emergency Rescue</h3>
              <p id="sosCardSubtext" class="text-xs text-slate-500 max-w-md">
                Tapping this button will send your current location coordinates directly to the assigned rescuers for
                emergency response.
              </p>
            </div>

            <!-- Resident Live Map Card (Expanded with White Rescuer En-Route Tracker Inside) -->
            <div
              class="lg:col-span-7 card p-4 sm:p-6 border border-slate-200/80 shadow-md bg-white space-y-3.5 flex flex-col justify-between rounded-3xl">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <h3 class="font-extrabold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                    <i class="ph ph-map-pin-fill text-blue-600 text-lg"></i> Live Location &amp; Rescue Tracking Map
                  </h3>
                  <button id="btnRecenterGps" type="button"
                    class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1 bg-blue-50 px-3 py-1.5 rounded-xl border border-blue-200/80 active:scale-95 transition-transform cursor-pointer"
                    title="Reset to auto GPS">
                    <i class="ph ph-navigation-arrow"></i> Recenter / Auto GPS
                  </button>
                </div>

                <!-- CLEAN WHITE LIVE RESCUER TRACKER, 4-STAGE PROGRESS STEPPER & ORANGE-ROAD ETA CARD -->
                <div id="rescuerEtaCard" class="hidden w-full text-left bg-white text-slate-900 rounded-2xl p-3.5 sm:p-4 border-2 border-emerald-300 shadow-md space-y-3">
                  <!-- Top ETA Banner & Live Status -->
                  <div class="flex items-start justify-between gap-2.5">
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5">
                        <span class="relative flex h-2.5 w-2.5 shrink-0">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-600"></span>
                        </span>
                        <span id="rescuerEtaStageTitle" class="text-xs font-black uppercase tracking-wider text-emerald-700">Rescuer En Route to Your Location</span>
                      </div>
                      <div id="rescuerEtaStatusSubtext" class="text-xs font-semibold text-slate-600 mt-0.5 leading-snug">
                        Following San Rafael main orange road path to your location...
                      </div>
                    </div>
                    <div class="bg-emerald-50 border border-emerald-300 rounded-xl px-3 py-1.5 text-right shrink-0 shadow-2xs">
                      <div id="rescuerEtaHeroMins" class="text-sm sm:text-base font-black font-mono text-emerald-800 leading-tight">~1 min</div>
                      <div class="text-[9.5px] font-extrabold uppercase text-emerald-700">Est. Arrival</div>
                    </div>
                  </div>

                  <!-- 4-Stage Live Dispatch Progress Bar & Stepper -->
                  <div class="space-y-1.5 pt-0.5">
                    <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden border border-slate-200">
                      <div id="rescuerEtaProgressBar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full transition-all duration-500" style="width: 55%;"></div>
                    </div>
                    <div class="grid grid-cols-4 gap-1 text-[10px] font-extrabold text-center">
                      <div id="stepSos1" class="text-emerald-700 font-black flex flex-col items-center gap-0.5">
                        <span>1. SOS Sent</span>
                      </div>
                      <div id="stepSos2" class="text-emerald-700 font-black flex flex-col items-center gap-0.5">
                        <span>2. Assigned</span>
                      </div>
                      <div id="stepSos3" class="text-slate-400 font-bold flex flex-col items-center gap-0.5">
                        <span>3. En Route</span>
                      </div>
                      <div id="stepSos4" class="text-slate-400 font-bold flex flex-col items-center gap-0.5">
                        <span>4. Arriving</span>
                      </div>
                    </div>
                  </div>

                  <!-- Assigned Rescuer Profile Strip -->
                  <div class="bg-slate-50 rounded-xl p-2.5 border border-slate-200 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div id="rescuerEtaAvatarSlot" class="w-10 h-10 rounded-full bg-blue-100 border-2 border-blue-600 text-blue-800 flex items-center justify-center font-black text-xs shrink-0 overflow-hidden shadow-xs">
                        <i class="ph ph-navigation-arrow text-base"></i>
                      </div>
                      <div class="min-w-0">
                        <div class="text-[10px] font-extrabold uppercase text-slate-500">Assigned Rescuer (Auto-Matched)</div>
                        <div id="rescuerEtaResponderName" class="text-xs sm:text-sm font-black text-slate-900 truncate">Barangay Rescue Team</div>
                      </div>
                    </div>
                    <span id="rescuerEtaStatusBadge" class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-emerald-100 text-emerald-800 border border-emerald-300 shrink-0">
                      ASSIGNED
                    </span>
                  </div>

                  <!-- Live Orange-Road Distance & ETA Metrics -->
                  <div class="grid grid-cols-3 gap-2">
                    <div class="bg-slate-50 rounded-xl p-2 border border-slate-200 text-center">
                      <div class="text-[9.5px] font-extrabold uppercase text-slate-500">Road Distance</div>
                      <div id="rescuerEtaDistanceVal" class="text-xs sm:text-sm font-black font-mono text-blue-700 mt-0.5">-- m</div>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-2 border border-slate-200 text-center">
                      <div class="text-[9.5px] font-extrabold uppercase text-slate-500">Vehicle ETA</div>
                      <div id="rescuerEtaVehicleVal" class="text-xs sm:text-sm font-black font-mono text-emerald-700 mt-0.5">~-- min</div>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-2 border border-slate-200 text-center">
                      <div class="text-[9.5px] font-extrabold uppercase text-slate-500">On-Foot ETA</div>
                      <div id="rescuerEtaWalkVal" class="text-xs sm:text-sm font-black font-mono text-amber-700 mt-0.5">~-- min</div>
                    </div>
                  </div>

                  <div class="pt-1.5 border-t border-slate-200 flex items-center justify-between text-[10.5px] font-mono text-slate-600 gap-2">
                    <span id="rescuerEtaCoordsText" class="truncate font-semibold">Rescuer GPS: 13.51037° N, 123.34810° E</span>
                    <span class="text-orange-600 font-sans font-extrabold shrink-0 flex items-center gap-1"><i class="ph ph-path"></i> Orange Road Path</span>
                  </div>
                </div>

                <!-- Bigger Live Location Map -->
                <div id="sosResidentMap"
                  class="w-full h-[420px] sm:h-[500px] lg:h-[560px] rounded-2xl overflow-hidden border border-slate-200 relative bg-slate-900 shadow-inner">
                </div>
              </div>

              <div class="space-y-2 pt-2">
                <p
                  class="text-[11px] text-blue-800 bg-blue-50/80 px-3 py-2 rounded-xl border border-blue-200/80 font-medium flex items-center gap-2 shadow-xs">
                  <i class="ph ph-hand-tap text-base text-blue-600 shrink-0"></i>
                  <span><strong>Pin slightly off when zoomed in?</strong> Phone GPS has a natural ±5–15m satellite
                    margin. Simply <strong>tap your house roof</strong> or drag the pin to set 100% exact
                    coordinates!</span>
                </p>

                <div
                  class="flex flex-wrap items-center justify-between text-[11px] text-slate-500 gap-2 pt-2 border-t border-slate-100">
                  <span class="flex items-center gap-1">
                    <i class="ph ph-shield-check text-emerald-500 font-bold"></i> Encrypted Location Stream
                  </span>
                  <span id="gpsAccuracyText" class="font-semibold text-slate-600">Accuracy: Searching...</span>
                </div>
              </div>
            </div>

          </div>

        </div>
        <%- include('../partials/footer-visible') %>

          <style>
            .user-gps-marker {
              width: 22px;
              height: 22px;
              background-color: #2563eb;
              border: 3px solid #ffffff;
              border-radius: 50%;
              box-shadow: 0 0 12px rgba(37, 99, 235, 0.7);
              position: relative;
            }

            .user-gps-marker::after {
              content: '';
              position: absolute;
              top: -8px;
              left: -8px;
              right: -8px;
              bottom: -8px;
              border-radius: 50%;
              background-color: rgba(37, 99, 235, 0.3);
              animation: pulseGpsDot 2s infinite ease-out;
            }

            @keyframes pulseGpsDot {
              0% {
                transform: scale(0.6);
                opacity: 1;
              }

              100% {
                transform: scale(2.2);
                opacity: 0;
              }
            }
          </style>

          <!-- SOS Confirmation Modal -->
          <div id="sosConfirmModal" class="hidden fixed inset-0 z-[220] bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="sosConfirmTitle">
            <div class="bg-white rounded-3xl shadow-2xl border-2 border-red-600 max-w-sm w-full p-6 text-center space-y-4">
              <div class="w-14 h-14 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center mx-auto text-3xl shadow-xs">
                <i class="ph-fill ph-warning-circle"></i>
              </div>
              <div>
                <h3 id="sosConfirmTitle" class="font-heading font-black text-lg text-slate-900">Send Emergency SOS?</h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed">
                  Are you sure you want to send a distress signal? This will immediately alert Barangay San Rafael Rescuers and share your live GPS location.
                </p>
              </div>
              <div class="grid grid-cols-2 gap-2.5 pt-1">
                <button type="button" id="btnCancelSosModal"
                  class="py-3 px-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-sm transition-all active:scale-95 cursor-pointer">
                  Cancel
                </button>
                <button type="button" id="btnConfirmSosSend"
                  class="py-3 px-4 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-black text-sm shadow-lg shadow-red-600/30 transition-all active:scale-95 cursor-pointer">
                  Yes, Send SOS
                </button>
              </div>
            </div>
          </div>

          <script src="/js/lora-mesh-client.js"></script>
          <script>
            (function() {
              if (window.LoRaMeshClient) {
                const client = window.evakwarLoraClient || new window.LoRaMeshClient();
                window.evakwarLoraClient = client;
                const updateSosLoraBanner = (st) => {
                  const isOnline = navigator.onLine;
                  const isLora = Boolean(st && st.connected && (st.transport === 'BLE' || st.transport === 'USB_SERIAL' || st.transport === 'ESP_WIFI'));
                  const dot = document.getElementById('loraStatusDot');
                  const title = document.getElementById('loraStatusTitle');
                  const sub = document.getElementById('loraStatusSubtitle');
                  const badge = document.getElementById('webLoraStatusBadge');

                  if (isLora) {
                    if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shrink-0';
                    if (title) title.textContent = `${st.transport}: ${st.deviceName || 'LoRa Active'}`;
                    if (sub) sub.textContent = '433.875 MHz RF Ready (Works Zero-Internet)';
                    if (badge) {
                      badge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/40';
                      badge.textContent = 'LoRa Radio Connected';
                    }
                  } else if (isOnline) {
                    if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0';
                    if (title) title.textContent = 'Online via Wi-Fi';
                    if (sub) sub.textContent = 'LoRa mesh standby (Tap to pair radio node)';
                    if (badge) {
                      badge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/15 text-blue-300 border border-blue-400/30';
                      badge.textContent = 'Wi-Fi Active';
                    }
                  } else {
                    if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping shrink-0';
                    if (title) title.textContent = 'Offline — No LoRa Connected';
                    if (sub) sub.textContent = 'Tap here to connect ESP32 LoRa node for offline SOS';
                    if (badge) {
                      badge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-400/40';
                      badge.textContent = 'LoRa Required Offline';
                    }
                  }
                };
                client.on('status', updateSosLoraBanner);
                window.addEventListener('online', () => updateSosLoraBanner(client));
                window.addEventListener('offline', () => updateSosLoraBanner(client));
                updateSosLoraBanner(client);
                window.connectWebLoraBle = async () => {
                  try {
                    const res = await client.connectBLE();
                    if (typeof window.EvacWarToast === 'function' && res) {
                      window.EvacWarToast(`LoRa BLE Connected: ${res.deviceName}`);
                    }
                  } catch (e) {
                    alert(e.message);
                  }
                };
                window.connectWebLoraUsb = async () => {
                  try {
                    const res = await client.connectUSBSerial();
                    if (typeof window.EvacWarToast === 'function' && res) {
                      window.EvacWarToast(`LoRa USB Connected: ${res.deviceName}`);
                    }
                  } catch (e) {
                    alert(e.message);
                  }
                };
              }
            })();
          </script>
          <script id="map-features-data" type="application/json">
    <%- typeof mapFeatures !== 'undefined' ? mapFeatures : '{"type":"FeatureCollection","features":[]}' %>
  </script>
          <script id="sosUserData" type="application/json">
    <%- JSON.stringify({ 
      id: (typeof resident !== 'undefined' && resident && resident.id) ? resident.id : ((typeof user !== 'undefined' && user && user.resident_id) ? user.resident_id : ((typeof user !== 'undefined' && user && user.id) ? user.id : null)), 
      resident_id: (typeof resident !== 'undefined' && resident && resident.id) ? resident.id : ((typeof user !== 'undefined' && user && user.resident_id) ? user.resident_id : null),
      user_id: (typeof user !== 'undefined' && user && user.id) ? user.id : null,
      name: (typeof user !== 'undefined' && user && user.name) ? user.name : "Resident",
      profile_photo: (typeof user !== 'undefined' && user && user.profile_photo) ? user.profile_photo : null
    }) %>
  </script>

          <script>
            document.addEventListener('DOMContentLoaded', () => {
              const sosUserElement = document.getElementById('sosUserData');
              const sosUserData = sosUserElement ? JSON.parse(sosUserElement.textContent || '{}') : {};
              let cachedResident = null;
              try {
                const rawCached = localStorage.getItem('evw_cached_resident');
                if (rawCached) cachedResident = JSON.parse(rawCached);
              } catch (_e) {}

              const resolvedResName = (cachedResident && (cachedResident.name || (cachedResident.first_name ? `${cachedResident.first_name} ${cachedResident.last_name || ''}`.trim() : null)))
                || ((sosUserData.name && sosUserData.name !== 'Resident') ? sosUserData.name : 'Resident');
              const residentId = (cachedResident && (cachedResident.resident_id || cachedResident.id))
                || (sosUserData.id || sosUserData.resident_id || null);
              const currentUserId = (cachedResident && (cachedResident.user_id || cachedResident.id)) || sosUserData.user_id || null;
              const residentName = resolvedResName;
              const residentPhoto = (cachedResident && cachedResident.profile_photo) || sosUserData.profile_photo || null;

              const sosBtn = document.getElementById('sos-btn');
              const sosBtnIcon = document.getElementById('sosBtnIcon');
              const sosBtnText = document.getElementById('sosBtnText');
              const sosBtnPing = document.getElementById('sosBtnPing');
              const stopSosContainer = document.getElementById('stopSosContainer');
              const stopSosBtn = document.getElementById('stopSosBtn');
              const cancelSosBtn = document.getElementById('cancelSosBtn');
              const sosActiveBanner = document.getElementById('sosActiveBanner');
              const sosCardHeading = document.getElementById('sosCardHeading');
              const sosCardSubtext = document.getElementById('sosCardSubtext');
              const gpsStatusText = document.getElementById('gpsStatusText');
              const gpsStatusBadge = document.getElementById('gpsStatusBadge');
              const gpsAccuracyText = document.getElementById('gpsAccuracyText');
              const btnRecenterGps = document.getElementById('btnRecenterGps');

              let currentLat = null;
              let currentLng = null;
              let currentAccuracy = 0;
              let isManuallyPinned = false;
              let isAcquiringGps = false;
              let activeSosAlert = null;
              let watchId = null;
              let socket = null;
              let map = null;
              let gpsMarker = null;

              if (typeof io !== 'undefined') {
                socket = io();
              }

              function isValidCoordinate(lat, lng) {
                const nLat = Number(lat);
                const nLng = Number(lng);
                return (
                  lat !== null &&
                  lat !== undefined &&
                  lng !== null &&
                  lng !== undefined &&
                  !isNaN(nLat) &&
                  !isNaN(nLng) &&
                  isFinite(nLat) &&
                  isFinite(nLng) &&
                  nLat >= -90 &&
                  nLat <= 90 &&
                  nLng >= -180 &&
                  nLng <= 180 &&
                  !(nLat === 0 && nLng === 0)
                );
              }

              function panMapTo(lat, lng, zoom) {
                if (!map || !isValidCoordinate(lat, lng)) return;
                const nLat = Number(lat);
                const nLng = Number(lng);

                // 1. MapLibre Provider (Strictly flat 2D top-down view)
                if (typeof maplibregl !== 'undefined' && typeof map.getLayer === 'function') {
                  const opts = {
                    center: [nLng, nLat],
                    pitch: 0,
                    bearing: 0,
                    essential: true
                  };
                  if (typeof zoom === 'number') opts.zoom = zoom;
                  if (typeof map.flyTo === 'function') {
                    map.flyTo(opts);
                  } else if (typeof map.panTo === 'function') {
                    map.panTo([nLng, nLat]);
                  }
                  return;
                }

                // 2. Google Maps Provider (Strictly flat 2D top-down view)
                if (typeof google !== 'undefined' && google.maps && typeof map.panTo === 'function') {
                  map.panTo(new google.maps.LatLng(nLat, nLng));
                  if (typeof map.setTilt === 'function') map.setTilt(0);
                  if (typeof map.setHeading === 'function') map.setHeading(0);
                  if (typeof zoom === 'number' && typeof map.setZoom === 'function') {
                    map.setZoom(zoom);
                  }
                }
              }

              // Pixel-perfect Pinpoint Needle (Ensures 0px drift at all zoom levels)
              function createPrecisePinElement() {
                const el = document.createElement('div');
                el.className = 'evakwar-precise-needle-marker';
                el.style.width = '36px';
                el.style.height = '48px';
                el.style.cursor = 'grab';
                el.style.display = 'block';
                el.style.filter = 'drop-shadow(0 4px 6px rgba(0,0,0,0.4))';
                el.innerHTML = `
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 48" width="36" height="48" style="display: block;">
                    <path d="M18 2 C8.6 2 1 9.6 1 19 C1 31 18 47 18 47 C18 47 35 31 35 19 C35 9.6 27.4 2 18 2 Z" fill="#ef4444" stroke="#ffffff" stroke-width="2.5"/>
                    <circle cx="18" cy="19" r="8" fill="#ffffff"/>
                    <path d="M18 13 L18 20 M18 23.5 L18 25.5" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round"/>
                  </svg>`;
                return el;
              }

              // Dynamic Accuracy Circle for MapLibre
              function createGeoJsonCircle(center, radiusInMeters, points = 36) {
                const [lng, lat] = center;
                const coords = [];
                const distanceX = radiusInMeters / (111320 * Math.cos(lat * Math.PI / 180));
                const distanceY = radiusInMeters / 110540;

                for (let i = 0; i < points; i++) {
                  const theta = (i / points) * (2 * Math.PI);
                  const x = distanceX * Math.cos(theta);
                  const y = distanceY * Math.sin(theta);
                  coords.push([lng + x, lat + y]);
                }
                coords.push(coords[0]);
                return {
                  type: 'Feature',
                  geometry: {
                    type: 'Polygon',
                    coordinates: [coords]
                  }
                };
              }

              function updateMapAccuracyCircle(lat, lng, accuracy) {
                // 1. MapLibre circle overlay
                if (map && typeof maplibregl !== 'undefined' && typeof map.getLayer === 'function') {
                  const src = map.getSource('user-gps-accuracy-src');
                  const shouldShow = !isManuallyPinned && accuracy > 0 && accuracy <= 350;
                  const data = shouldShow
                    ? { type: 'FeatureCollection', features: [createGeoJsonCircle([lng, lat], accuracy)] }
                    : { type: 'FeatureCollection', features: [] };

                  if (src) {
                    src.setData(data);
                  } else if (map.isStyleLoaded && map.isStyleLoaded()) {
                    try {
                      map.addSource('user-gps-accuracy-src', { type: 'geojson', data: data });
                      map.addLayer({
                        id: 'user-gps-accuracy-fill',
                        type: 'fill',
                        source: 'user-gps-accuracy-src',
                        paint: { 'fill-color': '#2563eb', 'fill-opacity': 0.15 }
                      });
                      map.addLayer({
                        id: 'user-gps-accuracy-stroke',
                        type: 'line',
                        source: 'user-gps-accuracy-src',
                        paint: { 'line-color': '#2563eb', 'line-width': 1.5, 'line-opacity': 0.45, 'line-dasharray': [2, 2] }
                      });
                    } catch (_) { }
                  }
                  return;
                }

                // 2. Google Maps circle overlay
                if (map && typeof google !== 'undefined' && google.maps) {
                  if (!window._googleSosAccuracyCircle) {
                    window._googleSosAccuracyCircle = new google.maps.Circle({
                      strokeColor: '#2563eb',
                      strokeOpacity: 0.5,
                      strokeWeight: 1.5,
                      fillColor: '#3b82f6',
                      fillOpacity: 0.15,
                      map: map,
                      center: { lat, lng },
                      radius: accuracy
                    });
                  } else {
                    window._googleSosAccuracyCircle.setCenter({ lat, lng });
                    window._googleSosAccuracyCircle.setRadius(accuracy);
                    window._googleSosAccuracyCircle.setVisible(!isManuallyPinned && accuracy > 0 && accuracy <= 350);
                  }
                }
              }

              function placeOrUpdateSosMarker(lat, lng) {
                if (!map || !isValidCoordinate(lat, lng)) return;

                const nLat = Number(lat);
                const nLng = Number(lng);

                // Update visual accuracy circle
                updateMapAccuracyCircle(nLat, nLng, currentAccuracy);
                if (activeSosAlert && typeof updateRescuerEtaDisplay === 'function') {
                  updateRescuerEtaDisplay(window._lastRescuerCoords ? {
                    status: window._lastRescuerCoords.status,
                    responderName: window._lastRescuerCoords.name,
                    rescuerPhoto: window._lastRescuerCoords.photo,
                    rescuerLat: window._lastRescuerCoords.lat,
                    rescuerLng: window._lastRescuerCoords.lng
                  } : {
                    status: activeSosAlert.status || 'ACTIVE',
                    responderName: activeSosAlert.handler_name || activeSosAlert.responder_name || null,
                    rescuerPhoto: activeSosAlert.rescuer_photo || activeSosAlert.handler_photo || null,
                    rescuerLat: activeSosAlert.rescuer_lat || null,
                    rescuerLng: activeSosAlert.rescuer_lng || null
                  });
                }

                // 1. MapLibre Provider
                if (typeof maplibregl !== 'undefined' && typeof map.getLayer === 'function') {
                  const pos = [nLng, nLat];
                  if (!gpsMarker) {
                    const el = createPrecisePinElement();

                    gpsMarker = new maplibregl.Marker({ element: el, draggable: true, anchor: 'bottom' })
                      .setLngLat(pos)
                      .addTo(map);

                    gpsMarker.on('dragend', () => {
                      const lngLat = gpsMarker.getLngLat();
                      setManualPinLocation(lngLat.lat, lngLat.lng);
                    });
                  } else {
                    if (typeof gpsMarker.setLngLat === 'function') {
                      gpsMarker.setLngLat(pos);
                    }
                  }
                  return;
                }

                // 2. Google Maps Provider
                if (typeof google !== 'undefined' && google.maps) {
                  const pos = new google.maps.LatLng(nLat, nLng);
                  if (!gpsMarker) {
                    gpsMarker = new google.maps.Marker({
                      position: pos,
                      map: map,
                      draggable: true,
                      icon: typeof getSosMarkerIcon === 'function' ? getSosMarkerIcon('ACTIVE') : undefined,
                      title: 'Drag or tap map to set exact house location'
                    });

                    gpsMarker.addListener('dragend', () => {
                      const markerPos = gpsMarker.getPosition();
                      setManualPinLocation(markerPos.lat(), markerPos.lng());
                    });
                  } else {
                    gpsMarker.setPosition(pos);
                    if (!gpsMarker.getMap()) {
                      gpsMarker.setMap(map);
                    }
                  }
                }
              }

              function setManualPinLocation(lat, lng) {
                if (!isValidCoordinate(lat, lng)) return;
                if (typeof window.isInsideBarangaySanRafael === 'function' && !window.isInsideBarangaySanRafael(lat, lng)) {
                  const brgyMsg = '🚫 Outside Barangay San Rafael Boundary! SOS & Rescue option is available ONLY within Barangay San Rafael.';
                  if (typeof window.EvacWarToast === 'function') {
                    window.EvacWarToast(brgyMsg);
                  } else {
                    alert(brgyMsg);
                  }
                  if (isValidCoordinate(currentLat, currentLng)) {
                    placeOrUpdateSosMarker(currentLat, currentLng);
                  }
                  return;
                }
                currentLat = Number(lat);
                currentLng = Number(lng);
                isManuallyPinned = true;

                // Hide accuracy circle since the resident chose exact location
                updateMapAccuracyCircle(currentLat, currentLng, 0);
                placeOrUpdateSosMarker(currentLat, currentLng);

                if (gpsStatusText) gpsStatusText.textContent = "Exact House Pinned";
                if (gpsStatusBadge) {
                  gpsStatusBadge.className = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-300 self-start sm:self-center";
                }
                if (gpsAccuracyText) gpsAccuracyText.textContent = `Exact House: ${currentLat.toFixed(5)}, ${currentLng.toFixed(5)}`;

                if (activeSosAlert && socket) {
                  socket.emit('sos:update', {
                    id: activeSosAlert.id,
                    resident_id: residentId,
                    latitude: currentLat,
                    longitude: currentLng,
                    accuracy: 0
                  });
                }
              }

              // Initialize MapLibre Map (Primary default provider)
              function initResidentMaplibreMap() {
                const container = document.getElementById('sosResidentMap');
                if (!container) return;
                if (typeof maplibregl === 'undefined' || typeof window.createEvakWarMaplibreMap !== 'function') {
                  setTimeout(initResidentMaplibreMap, 50);
                  return;
                }
                if (map) return;

                const defaultCenter = [123.3470, 13.5102]; // [lng, lat]
                map = window.createEvakWarMaplibreMap(container, {
                  center: defaultCenter,
                  zoom: 16,
                  maxZoom: 18,
                  bearing: 0,
                  pitch: 0,
                  maxPitch: 0
                });

                // Enforce strictly 2D flat map (Disable 3D tilt/pitch gestures)
                if (map) {
                  if (typeof map.setMaxPitch === 'function') map.setMaxPitch(0);
                  if (map.dragRotate && typeof map.dragRotate.disable === 'function') map.dragRotate.disable();
                  if (map.touchPitch && typeof map.touchPitch.disable === 'function') map.touchPitch.disable();

                  map.on('dragstart', () => {
                    userHasPannedMap = true;
                  });
                }

                map.on('click', (e) => {
                  setManualPinLocation(e.lngLat.lat, e.lngLat.lng);
                });

                map.on('load', () => {
                  map.resize();
                  // Render Admin-drawn San Rafael Orange Roads & Boundary on #sosResidentMap
                  try {
                    let featObj = { type: 'FeatureCollection', features: [] };
                    const fEl = document.getElementById('map-features-data');
                    if (fEl && fEl.textContent) {
                      const parsed = JSON.parse(fEl.textContent.trim());
                      if (parsed && Array.isArray(parsed.features) && parsed.features.length > 0) featObj = parsed;
                    }
                    if ((!featObj.features || featObj.features.length === 0) && window.OFFLINE_BOOTSTRAP && window.OFFLINE_BOOTSTRAP.mapFeatures) {
                      featObj = window.OFFLINE_BOOTSTRAP.mapFeatures;
                    }
                    if (featObj && Array.isArray(featObj.features) && featObj.features.length > 0 && !map.getSource('sos-map-features')) {
                      map.addSource('sos-map-features', { type: 'geojson', data: featObj });
                      map.addLayer({
                        id: 'sos-boundary-dashed',
                        type: 'line',
                        source: 'sos-map-features',
                        filter: ['all', ['==', '$type', 'Polygon'], ['==', 'type', 'boundary']],
                        paint: { 'line-color': '#f87171', 'line-width': 1.5, 'line-dasharray': [3, 2], 'line-opacity': 0.85 }
                      });
                      map.addLayer({
                        id: 'sos-orange-routes',
                        type: 'line',
                        source: 'sos-map-features',
                        filter: ['==', '$type', 'LineString'],
                        paint: { 'line-color': '#f97316', 'line-width': 4, 'line-opacity': 0.85 }
                      });
                    }
                  } catch (_) {}

                  if (isValidCoordinate(currentLat, currentLng)) {
                    placeOrUpdateSosMarker(currentLat, currentLng);
                    panMapTo(currentLat, currentLng, 17);
                  }
                  if (activeSosAlert && window._lastRescuerCoords) {
                    updateRescuerEtaDisplay({
                      status: window._lastRescuerCoords.status,
                      responderName: window._lastRescuerCoords.name,
                      rescuerPhoto: window._lastRescuerCoords.photo,
                      rescuerLat: window._lastRescuerCoords.lat,
                      rescuerLng: window._lastRescuerCoords.lng
                    });
                  }
                });

                setTimeout(() => {
                  if (map && typeof map.resize === 'function') map.resize();
                }, 350);
              }

              // Initialize Google Map (When provider is explicitly google)
              function initResidentGoogleMap() {
                const container = document.getElementById('sosResidentMap');
                if (!container || typeof google === 'undefined' || !google.maps) return;
                if (map) return;

                const defaultMapCenter = { lat: 13.5102, lng: 123.3470 };

                map = new google.maps.Map(container, {
                  center: defaultMapCenter,
                  zoom: 16,
                  maxZoom: 18,
                  heading: 0,
                  tilt: 0,
                  mapTypeId: google.maps.MapTypeId.HYBRID,
                  gestureHandling: 'greedy',
                  rotateControl: false,
                  disableDefaultUI: false,
                  zoomControl: true,
                  mapTypeControl: true,
                  streetViewControl: false,
                  fullscreenControl: false
                });

                map.addListener('dragstart', () => {
                  userHasPannedMap = true;
                });

                map.addListener('click', (e) => {
                  setManualPinLocation(e.latLng.lat(), e.latLng.lng());
                });

                if (isValidCoordinate(currentLat, currentLng)) {
                  placeOrUpdateSosMarker(currentLat, currentLng);
                  panMapTo(currentLat, currentLng, 17);
                }
              }

              // Automatic Map Provider Launcher
              if (window.MAP_CONFIG && window.MAP_CONFIG.provider === 'maplibre') {
                if (document.readyState === 'loading') {
                  document.addEventListener('DOMContentLoaded', initResidentMaplibreMap);
                } else {
                  initResidentMaplibreMap();
                }
              } else {
                whenGoogleMapsReady(initResidentGoogleMap);
              }

              let userHasPannedMap = false;

              if (btnRecenterGps) {
                btnRecenterGps.addEventListener('click', () => {
                  isManuallyPinned = false;
                  userHasPannedMap = false;
                  if ("geolocation" in navigator) {
                    if (gpsStatusText) gpsStatusText.textContent = "Acquiring live GPS...";
                    navigator.geolocation.getCurrentPosition(
                      (pos) => {
                        const lat = pos.coords.latitude;
                        const lng = pos.coords.longitude;
                        if (isValidCoordinate(lat, lng)) {
                          currentLat = lat;
                          currentLng = lng;
                          currentAccuracy = Math.round(pos.coords.accuracy || 0);

                          placeOrUpdateSosMarker(currentLat, currentLng);
                          panMapTo(currentLat, currentLng, 17);

                          if (gpsStatusText) gpsStatusText.textContent = "GPS Connected (Live)";
                          if (gpsStatusBadge) {
                            gpsStatusBadge.className = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 self-start sm:self-center";
                          }
                          const accDesc = currentAccuracy <= 25 ? 'High Precision' : (currentAccuracy <= 70 ? 'Fair' : 'Approximate');
                          if (gpsAccuracyText) gpsAccuracyText.textContent = `Accuracy: ±${currentAccuracy}m (${accDesc})`;
                        }
                      },
                      (err) => {
                        console.warn("Recenter GPS failed:", err);
                        if (gpsStatusText) gpsStatusText.textContent = "GPS Unavailable";
                      },
                      { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 }
                    );
                  }
                });
              }

              // Background Geolocation watchPosition
              function startGpsTracking() {
                if (!("geolocation" in navigator)) {
                  if (gpsStatusText) gpsStatusText.textContent = "GPS Not Supported";
                  return;
                }

                if (window.isSecureContext === false && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
                  if (gpsStatusText) gpsStatusText.textContent = "Requires HTTPS for GPS";
                }

                watchId = navigator.geolocation.watchPosition(
                  (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    if (!isValidCoordinate(lat, lng)) return;

                    if (!isManuallyPinned) {
                      const isFirstFix = (currentLat === null || currentLng === null);
                      currentLat = lat;
                      currentLng = lng;
                      currentAccuracy = Math.round(pos.coords.accuracy || 0);

                      if (gpsStatusText) gpsStatusText.textContent = "GPS Connected (Live)";
                      if (gpsStatusBadge) {
                        gpsStatusBadge.className = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 self-start sm:self-center";
                      }
                      const accDesc = currentAccuracy <= 25 ? 'High Precision' : (currentAccuracy <= 70 ? 'Fair' : 'Approximate');
                      if (gpsAccuracyText) gpsAccuracyText.textContent = `Accuracy: ±${currentAccuracy}m (${accDesc})`;

                      // Always place/update live GPS marker
                      placeOrUpdateSosMarker(currentLat, currentLng);

                      // Automatically recenter on initial fix or if user has not panned away
                      if (isFirstFix || !userHasPannedMap) {
                        panMapTo(currentLat, currentLng, 17);
                      }
                    }

                    // Emit live location update if SOS is active
                    if (activeSosAlert && socket) {
                      socket.emit('sos:update', {
                        id: activeSosAlert.id,
                        resident_id: residentId,
                        latitude: currentLat,
                        longitude: currentLng,
                        accuracy: isManuallyPinned ? 0 : currentAccuracy
                      });
                    }
                  },
                  (err) => {
                    console.warn("GPS position error:", err);
                    let msg = "GPS Location Unavailable";
                    if (err.code === 1) {
                      msg = "Location Permission Denied";
                    }
                    if (!isManuallyPinned && gpsStatusText) gpsStatusText.textContent = msg;
                    if (!isManuallyPinned && gpsStatusBadge) {
                      gpsStatusBadge.className = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300 self-start sm:self-center";
                    }
                  },
                  {
                    enableHighAccuracy: true,
                    maximumAge: 0,
                    timeout: 15000
                  }
                );
              }

              startGpsTracking();

              // Check if resident already has an active SOS alert on server (also syncs when rescuer ends/resolves rescue!)
              async function checkActiveResidentSos(isBackgroundPoll = false) {
                if (isBackgroundPoll && !navigator.onLine) return;
                try {
                  const res = await fetch('/api/sos/resident/active');
                  const data = await res.json();
                  if (data.success && data.activeSos) {
                    const srvSt = String(data.activeSos.status || 'ACTIVE').toUpperCase();
                    if (srvSt === 'RESOLVED' || srvSt === 'CANCELLED' || srvSt === 'RESCUED') {
                      if (activeSosAlert) {
                        if (typeof window.EvacWarToast === 'function') {
                          window.EvacWarToast('Your rescue has been completed and marked as resolved.');
                        }
                        setSosNormalState();
                      }
                      return;
                    }
                    // Never downgrade live RESPONDING status back to ACTIVE during background sync
                    if (isBackgroundPoll && activeSosAlert && window._lastRescuerCoords && window._lastRescuerCoords.status === 'RESPONDING' && srvSt === 'ACTIVE') {
                      data.activeSos.status = 'RESPONDING';
                    }
                    setSosActiveState(data.activeSos);
                    if (!isBackgroundPoll && isValidCoordinate(data.activeSos.latitude, data.activeSos.longitude)) {
                      currentLat = Number(data.activeSos.latitude);
                      currentLng = Number(data.activeSos.longitude);
                      placeOrUpdateSosMarker(currentLat, currentLng);
                      panMapTo(currentLat, currentLng, 17);
                    }
                  } else if (data.success && !data.activeSos && activeSosAlert && isBackgroundPoll) {
                    // Rescue was ended/resolved by rescuer or admin on the server!
                    if (typeof window.EvacWarToast === 'function') {
                      window.EvacWarToast('Your rescue has been completed and closed by the rescuer.');
                    }
                    setSosNormalState();
                  }
                } catch (err) {
                  if (!isBackgroundPoll) console.error("Error checking active SOS:", err);
                }
              }

              checkActiveResidentSos(false);
              setInterval(() => {
                if (activeSosAlert && navigator.onLine) {
                  checkActiveResidentSos(true);
                }
              }, 4000);

              function setSosActiveState(alertData) {
                activeSosAlert = alertData;
                isAcquiringGps = false;
                if (sosActiveBanner) sosActiveBanner.classList.remove('hidden');
                if (stopSosContainer) stopSosContainer.classList.remove('hidden');

                if (sosBtn) {
                  sosBtn.disabled = false;
                  sosBtn.classList.remove('from-red-500', 'to-rose-600', 'hover:from-red-600', 'hover:to-rose-700', 'border-red-100', 'cursor-not-allowed', 'opacity-85');
                  sosBtn.classList.add('from-red-600', 'to-red-800', 'hover:from-red-700', 'hover:to-red-900', 'border-red-300', 'animate-pulse', 'cursor-pointer');
                }
                if (sosBtnIcon) sosBtnIcon.className = "ph ph-siren text-6xl relative z-10 mb-2 animate-bounce";
                if (sosBtnText) {
                  sosBtnText.className = "text-3xl font-black relative z-10 tracking-widest";
                  sosBtnText.textContent = "ACTIVE";
                }
                if (sosBtnPing) sosBtnPing.classList.remove('hidden');

                if (sosCardHeading) sosCardHeading.textContent = "🚨 EMERGENCY DISTRESS ACTIVE";
                if (sosCardSubtext) sosCardSubtext.textContent = "Your live GPS position is transmitting to LGU responders. Tap STOP SOS below when you are safe.";

                // Compute & show Estimated Time of Arrival (ETA) ONLY when an actual online Rescuer account is assigned
                updateRescuerEtaDisplay({
                  status: (alertData && alertData.status) || 'ACTIVE',
                  responderName: (alertData && (alertData.handler_name || alertData.responder_name || alertData.responderName)) || (window._lastRescuerCoords && window._lastRescuerCoords.name) || null,
                  rescuerPhoto: (alertData && (alertData.rescuer_photo || alertData.handler_photo)) || (window._lastRescuerCoords && window._lastRescuerCoords.photo) || null,
                  rescuerLat: (alertData && alertData.rescuer_lat) || (window._lastRescuerCoords && window._lastRescuerCoords.lat) || null,
                  rescuerLng: (alertData && alertData.rescuer_lng) || (window._lastRescuerCoords && window._lastRescuerCoords.lng) || null
                });
              }

              /**
               * Computes Rescuer Distance (d) & Estimated Time of Arrival (ETA = d / v) strictly along the
               * San Rafael Orange Road Network and ONLY plots a rescuer when an online Rescuer account is assigned.
               */
              let rescuerMapMarker = null;
              window._residentSosActiveRouteCoords = null;
              window._residentSosLastDestKey = null;

              function isGenericOrFakeRescuerName(name) {
                if (!name) return true;
                const clean = String(name).trim().toLowerCase();
                return !clean || [
                  'barangay rescue team',
                  'rescue team',
                  'emergency rescuer',
                  'barangay emergency rescuer',
                  'rescuer unit',
                  'barangay hall',
                  'barangay hall / rescue team',
                  'hall gateway (!d88b1a58)',
                  'staff responder'
                ].includes(clean);
              }

              function updateRescuerEtaDisplay({ status = 'ACTIVE', responderName = null, rescuerPhoto = null, rescuerLat = null, rescuerLng = null } = {}) {
                const etaCard = document.getElementById('rescuerEtaCard');
                if (!etaCard) return;
                let st = String(status || 'ACTIVE').toUpperCase();
                if (st === 'RESOLVED' || st === 'CANCELLED') {
                  etaCard.classList.add('hidden');
                  window._residentSosActiveRouteCoords = null;
                  window._residentSosLastDestKey = null;
                  window._lastRescuerCoords = null;
                  return;
                }
                // Prevent status oscillation between RESPONDING and ACTIVE once a real online rescuer is already en route
                const prevSt = window._lastRescuerCoords ? String(window._lastRescuerCoords.status || '').toUpperCase() : '';
                if ((prevSt === 'RESPONDING' || prevSt === 'ACKNOWLEDGED') && st === 'ACTIVE') {
                  st = prevSt;
                }
                etaCard.classList.remove('hidden');

                const nameEl = document.getElementById('rescuerEtaResponderName');
                const avatarSlot = document.getElementById('rescuerEtaAvatarSlot');
                const badgeEl = document.getElementById('rescuerEtaStatusBadge');
                const distEl = document.getElementById('rescuerEtaDistanceVal');
                const vehEl = document.getElementById('rescuerEtaVehicleVal');
                const walkEl = document.getElementById('rescuerEtaWalkVal');
                const coordsEl = document.getElementById('rescuerEtaCoordsText');
                const heroMinsEl = document.getElementById('rescuerEtaHeroMins');
                const stageTitleEl = document.getElementById('rescuerEtaStageTitle');
                const stageSubEl = document.getElementById('rescuerEtaStatusSubtext');
                const progBarEl = document.getElementById('rescuerEtaProgressBar');
                const s1 = document.getElementById('stepSos1');
                const s2 = document.getElementById('stepSos2');
                const s3 = document.getElementById('stepSos3');
                const s4 = document.getElementById('stepSos4');

                const hasRealOnlineRescuer = !isGenericOrFakeRescuerName(responderName) && isValidCoordinate(rescuerLat, rescuerLng);

                // If NO online rescuer is connected/assigned yet, do NOT plot a fake rescuer marker or green line at the Elementary School!
                if (!hasRealOnlineRescuer) {
                  window._lastRescuerCoords = null;
                  window._residentSosActiveRouteCoords = null;
                  if (rescuerMapMarker && typeof rescuerMapMarker.remove === 'function') {
                    try { rescuerMapMarker.remove(); } catch (_) {}
                    rescuerMapMarker = null;
                  }
                  if (map && typeof map.getSource === 'function') {
                    try {
                      const src = map.getSource('rescuer-live-route-src');
                      if (src) src.setData({ type: 'FeatureCollection', features: [] });
                    } catch (_) {}
                  }
                  if (stageTitleEl) stageTitleEl.textContent = 'SOS Active — Waiting for Online Rescuer';
                  if (stageSubEl) stageSubEl.textContent = 'Waiting for an online rescuer in Barangay San Rafael to connect and receive your SOS...';
                  if (heroMinsEl) heroMinsEl.textContent = 'WAITING';
                  if (nameEl) nameEl.textContent = 'Waiting for Online Rescuer...';
                  if (avatarSlot) avatarSlot.innerHTML = `<i class="ph ph-spinner animate-spin text-base text-blue-600"></i>`;
                  if (badgeEl) badgeEl.textContent = 'WAITING';
                  if (distEl) distEl.textContent = '--';
                  if (vehEl) vehEl.textContent = '--';
                  if (walkEl) walkEl.textContent = '--';
                  if (coordsEl) coordsEl.textContent = 'Rescuer GPS: Waiting for online rescuer...';
                  if (progBarEl) progBarEl.style.width = '28%';
                  [s1, s2, s3, s4].forEach((el, idx) => {
                    if (!el) return;
                    el.className = (idx === 0)
                      ? 'text-emerald-700 font-black flex flex-col items-center gap-0.5'
                      : 'text-slate-400 font-bold flex flex-col items-center gap-0.5';
                  });
                  return;
                }

                const resLat = isValidCoordinate(currentLat, currentLng) ? Number(currentLat) : 13.51024;
                const resLng = isValidCoordinate(currentLat, currentLng) ? Number(currentLng) : 123.34701;
                const rLat = Number(rescuerLat);
                const rLng = Number(rescuerLng);
                const resolvedPhoto = rescuerPhoto || (window._lastRescuerCoords && window._lastRescuerCoords.photo) || null;
                window._lastRescuerCoords = { lat: rLat, lng: rLng, name: responderName, photo: resolvedPhoto, status: st };

                const havMeters = (a, b) => {
                  if (typeof window.computeHaversineKm === 'function') {
                    return window.computeHaversineKm(a[1], a[0], b[1], b[0]) * 1000;
                  }
                  const toRad = (deg) => (Number(deg) * Math.PI) / 180;
                  const R = 6371000;
                  const dLat = toRad(b[1] - a[1]);
                  const dLng = toRad(b[0] - a[0]);
                  const s = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a[1])) * Math.cos(toRad(b[1])) * Math.sin(dLng / 2) ** 2;
                  return 2 * R * Math.atan2(Math.sqrt(s), Math.sqrt(1 - s));
                };

                const projectPointOnSegment = (px, py, ax, ay, bx, by) => {
                  const dx = bx - ax;
                  const dy = by - ay;
                  const lenSq = dx * dx + dy * dy;
                  if (lenSq <= 1e-12) return { lng: ax, lat: ay, t: 0 };
                  const t = Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / lenSq));
                  return { lng: ax + t * dx, lat: ay + t * dy, t };
                };

                // 1. Compute full connected San Rafael Orange Road path from Rescuer -> Resident SOS Pin
                const destKey = `${resLat.toFixed(5)},${resLng.toFixed(5)}`;
                let fullOrangePath = null;
                if (typeof window.computeSanRafaelOrangeRoadPath === 'function') {
                  fullOrangePath = window.computeSanRafaelOrangeRoadPath(rLat, rLng, resLat, resLng);
                }

                let activeCoords = (fullOrangePath && Array.isArray(fullOrangePath.coordinates) && fullOrangePath.coordinates.length >= 2)
                  ? fullOrangePath.coordinates.slice()
                  : [[rLng, rLat], [resLng, resLat]];

                // 2. Live Route-Trimming: as Rescuer walks/drives toward SOS, erase passed segments behind the Rescuer!
                if (window._residentSosActiveRouteCoords && window._residentSosActiveRouteCoords.length >= 2 && window._residentSosLastDestKey === destKey) {
                  const prevCoords = window._residentSosActiveRouteCoords;
                  let bestIdx = 0;
                  let bestProj = { lng: prevCoords[0][0], lat: prevCoords[0][1] };
                  let bestDistM = Infinity;
                  for (let i = 0; i < prevCoords.length - 1; i++) {
                    const a = prevCoords[i];
                    const b = prevCoords[i + 1];
                    const proj = projectPointOnSegment(rLng, rLat, a[0], a[1], b[0], b[1]);
                    const dM = havMeters([rLng, rLat], [proj.lng, proj.lat]);
                    if (dM < bestDistM) {
                      bestDistM = dM;
                      bestIdx = i;
                      bestProj = proj;
                    }
                  }
                  if (bestDistM <= 95) {
                    const tail = prevCoords.slice(bestIdx + 1);
                    activeCoords = [[rLng, rLat], [bestProj.lng, bestProj.lat], ...tail];
                  }
                }
                window._residentSosActiveRouteCoords = activeCoords;
                window._residentSosLastDestKey = destKey;

                // 3. Calculate exact remaining distance along the trimmed Orange Road path
                let remMeters = 0;
                for (let i = 0; i < activeCoords.length - 1; i++) {
                  remMeters += havMeters(activeCoords[i], activeCoords[i + 1]);
                }
                const directToResM = havMeters([rLng, rLat], [resLng, resLat]);
                if (directToResM <= 28) {
                  remMeters = directToResM;
                }
                const distMeters = Math.round(remMeters);
                const distKm = remMeters / 1000;
                const arrivedAtSos = distMeters <= 25 || st === 'RESCUED';

                // Rescue vehicle average barangay speed ~24 km/h (400 m/min); On-foot rescuer ~4.5 km/h (75 m/min)
                const vehicleEtaMins = arrivedAtSos ? 0 : Math.max(1, Math.ceil((distKm / 24) * 60));
                const walkEtaMins = arrivedAtSos ? 0 : Math.max(1, Math.ceil((distKm / 4.5) * 60));

                const distLabel = distMeters < 1000 ? `${distMeters} m` : `${distKm.toFixed(2)} km`;
                if (nameEl) nameEl.textContent = responderName || 'Barangay Rescue Team';
                if (avatarSlot) {
                  const photoUrl = (typeof window.resolveEvakWarProfilePhotoUrl === 'function')
                    ? window.resolveEvakWarProfilePhotoUrl(resolvedPhoto)
                    : resolvedPhoto;
                  const initials = (responderName || 'R').split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase() || 'R';
                  avatarSlot.innerHTML = photoUrl
                    ? `<img src="${photoUrl}" alt="${responderName}" class="w-full h-full object-cover rounded-full" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');"><span class="hidden font-black text-blue-800 text-xs">${initials}</span>`
                    : `<span class="font-black text-blue-800 text-xs">${initials}</span>`;
                }
                if (badgeEl) badgeEl.textContent = st === 'ACTIVE' ? 'AUTO-ASSIGNED' : (st === 'ACKNOWLEDGED' ? 'ASSIGNED' : st);
                if (distEl) distEl.textContent = distLabel;
                if (vehEl) vehEl.textContent = arrivedAtSos ? 'Arrived' : `~${vehicleEtaMins} min`;
                if (walkEl) walkEl.textContent = arrivedAtSos ? 'Arrived' : `~${walkEtaMins} min`;
                if (heroMinsEl) heroMinsEl.textContent = arrivedAtSos ? 'ARRIVED' : (distMeters <= 45 ? 'ARRIVING' : `~${vehicleEtaMins} min`);
                if (coordsEl) coordsEl.textContent = `Rescuer GPS: ${rLat.toFixed(5)}° N, ${rLng.toFixed(5)}° E`;

                // Update 4-Stage Live Dispatch Progress Bar & Stepper (Clean White UI Theme)
                let progPct = '35%';
                let activeStep = 1;
                if (st === 'ACKNOWLEDGED') {
                  progPct = '58%';
                  activeStep = 2;
                  if (stageTitleEl) stageTitleEl.textContent = 'Nearest Rescuer Automatically Assigned';
                  if (stageSubEl) stageSubEl.textContent = `${responderName} is assigned (${distLabel} along San Rafael orange road) and heading to your location.`;
                } else if (st === 'RESPONDING') {
                  progPct = distMeters <= 80 ? '92%' : '80%';
                  activeStep = distMeters <= 80 ? 4 : 3;
                  if (stageTitleEl) stageTitleEl.textContent = distMeters <= 80 ? 'Rescuer Arriving Nearby!' : 'Rescuer En Route to Your Location';
                  if (stageSubEl) stageSubEl.textContent = `${responderName} is moving along the San Rafael road path (${distLabel} remaining • ~${vehicleEtaMins} min by vehicle / ~${walkEtaMins} min on foot).`;
                } else if (st === 'RESCUED' || arrivedAtSos) {
                  progPct = '100%';
                  activeStep = 4;
                  if (stageTitleEl) stageTitleEl.textContent = 'Rescuer Arrived at Your Location';
                  if (stageSubEl) stageSubEl.textContent = `${responderName} has reached your location for evacuation assistance.`;
                } else {
                  progPct = '50%';
                  activeStep = 2;
                  if (stageTitleEl) stageTitleEl.textContent = 'Nearest Rescuer Matched Along San Rafael Road';
                  if (stageSubEl) stageSubEl.textContent = `${responderName} is matched along the San Rafael orange road (${distLabel} away).`;
                }
                if (progBarEl) progBarEl.style.width = progPct;
                [s1, s2, s3, s4].forEach((el, idx) => {
                  if (!el) return;
                  el.className = (idx + 1) <= activeStep
                    ? 'text-emerald-700 font-black flex flex-col items-center gap-0.5'
                    : 'text-slate-400 font-bold flex flex-col items-center gap-0.5';
                });

                // Render Moving Rescuer Profile Picture Pin + Live Trimmed Green Orange-Road Route Line on #sosResidentMap
                if (map && typeof maplibregl !== 'undefined' && typeof map.getLayer === 'function') {
                  const pillText = arrivedAtSos
                    ? `${responderName} • ARRIVED`
                    : `${responderName} • ~${vehicleEtaMins}m (${distLabel})`;
                  const el = (typeof window.createMaplibreRescuerMarkerEl === 'function')
                    ? window.createMaplibreRescuerMarkerEl({
                        rescuer_name: responderName,
                        rescuer_photo: resolvedPhoto,
                        pill_text: pillText
                      })
                    : document.createElement('div');
                  if (!rescuerMapMarker) {
                    rescuerMapMarker = new maplibregl.Marker({ element: el, anchor: 'bottom' })
                      .setLngLat([rLng, rLat])
                      .addTo(map);
                  } else {
                    rescuerMapMarker.setLngLat([rLng, rLat]);
                    const mEl = rescuerMapMarker.getElement && rescuerMapMarker.getElement();
                    if (mEl) {
                      mEl.innerHTML = el.innerHTML;
                    }
                  }

                  // Draw / update live trimmed green route line along the San Rafael orange road network (erases passed path behind rescuer!)
                  const routeGeoJson = {
                    type: 'FeatureCollection',
                    features: arrivedAtSos ? [] : [{
                      type: 'Feature',
                      geometry: {
                        type: 'LineString',
                        coordinates: activeCoords
                      }
                    }]
                  };
                  const applyRescuerLiveRoute = () => {
                    try {
                      const existingSrc = map.getSource('rescuer-live-route-src');
                      if (existingSrc) {
                        existingSrc.setData(routeGeoJson);
                      } else {
                        map.addSource('rescuer-live-route-src', { type: 'geojson', data: routeGeoJson });
                        map.addLayer({
                          id: 'rescuer-live-route-glow',
                          type: 'line',
                          source: 'rescuer-live-route-src',
                          layout: { 'line-join': 'round', 'line-cap': 'round' },
                          paint: { 'line-color': '#10b981', 'line-width': 9, 'line-opacity': 0.3 }
                        });
                        map.addLayer({
                          id: 'rescuer-live-route-line',
                          type: 'line',
                          source: 'rescuer-live-route-src',
                          layout: { 'line-join': 'round', 'line-cap': 'round' },
                          paint: { 'line-color': '#10b981', 'line-width': 4.5, 'line-dasharray': [2, 1.5] }
                        });
                      }
                    } catch (_) {}
                  };
                  if (map.isStyleLoaded && map.isStyleLoaded()) {
                    applyRescuerLiveRoute();
                  } else if (typeof map.once === 'function') {
                    map.once('load', applyRescuerLiveRoute);
                  }

                  // Frame both Resident SOS pin and Moving Rescuer pin on the Live Location Map if user hasn't manually panned away
                  if (!userHasPannedMap && activeCoords.length >= 2 && maplibregl.LngLatBounds && typeof map.fitBounds === 'function') {
                    try {
                      const bounds = new maplibregl.LngLatBounds();
                      activeCoords.forEach(c => {
                        if (Array.isArray(c) && c.length >= 2) bounds.extend([c[0], c[1]]);
                      });
                      map.fitBounds(bounds, { padding: { top: 70, bottom: 55, left: 55, right: 55 }, maxZoom: 17.2, duration: 750 });
                    } catch (_) {}
                  }
                }
              }

              function setSosNormalState() {
                activeSosAlert = null;
                isAcquiringGps = false;
                if (sosActiveBanner) sosActiveBanner.classList.add('hidden');
                if (stopSosContainer) stopSosContainer.classList.add('hidden');
                const etaCard = document.getElementById('rescuerEtaCard');
                if (etaCard) etaCard.classList.add('hidden');
                if (rescuerMapMarker && typeof rescuerMapMarker.remove === 'function') {
                  try { rescuerMapMarker.remove(); } catch (_) {}
                  rescuerMapMarker = null;
                }
                if (map && typeof map.getSource === 'function') {
                  try {
                    const src = map.getSource('rescuer-live-route-src');
                    if (src) src.setData({ type: 'FeatureCollection', features: [] });
                  } catch (_) {}
                }

                if (sosBtn) {
                  sosBtn.disabled = false;
                  sosBtn.classList.remove('from-red-600', 'to-red-800', 'hover:from-red-700', 'hover:to-red-900', 'border-red-300', 'animate-pulse', 'cursor-not-allowed', 'opacity-85');
                  sosBtn.classList.add('from-red-500', 'to-rose-600', 'hover:from-red-600', 'hover:to-rose-700', 'border-red-100', 'cursor-pointer', 'active:scale-95', 'hover:scale-105');
                }
                if (sosBtnIcon) sosBtnIcon.className = "ph ph-warning-octagon text-6xl relative z-10 mb-2";
                if (sosBtnText) {
                  sosBtnText.className = "text-3xl font-black relative z-10 tracking-widest";
                  sosBtnText.textContent = "S O S";
                }
                if (sosBtnPing) sosBtnPing.classList.remove('hidden');

                if (sosCardHeading) sosCardHeading.textContent = "Press for Emergency Rescue";
                if (sosCardSubtext) sosCardSubtext.textContent = "Tapping this button will send your current location coordinates directly to the assigned rescuers for emergency response.";
              }

              function handleGpsFailure(errorMessage) {
                isAcquiringGps = false;

                // Restore normal button state
                if (sosBtn) {
                  sosBtn.disabled = false;
                  sosBtn.classList.remove('cursor-not-allowed', 'opacity-85');
                  sosBtn.classList.add('active:scale-95', 'hover:scale-105', 'cursor-pointer');
                }
                if (sosBtnText) {
                  sosBtnText.className = "text-3xl font-black relative z-10 tracking-widest";
                  sosBtnText.textContent = "S O S";
                }
                if (sosBtnIcon) {
                  sosBtnIcon.className = "ph ph-warning-octagon text-6xl relative z-10 mb-2";
                }
                if (sosBtnPing) {
                  sosBtnPing.classList.remove('hidden');
                }

                if (gpsStatusText) gpsStatusText.textContent = "Location Unavailable";
                if (gpsStatusBadge) {
                  gpsStatusBadge.className = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300 self-start sm:self-center";
                }

                const alertMsg = errorMessage || "Unable to get your location. Please enable location services and try again.";
                if (typeof window.EvacWarToast === 'function') {
                  window.EvacWarToast(alertMsg);
                }
                alert(alertMsg);
              }

              // Dispatch SOS alert payload to backend
              function dispatchSosPayload(lat, lng, acc) {
                const isOnline = Boolean(navigator.onLine || (socket && socket.connected));
                const lora = window.evakwarLoraClient;
                const isLoraActive = Boolean(lora && lora.connected && (lora.transport === 'BLE' || lora.transport === 'USB_SERIAL' || lora.transport === 'ESP_WIFI'));

                // If offline and NOT connected to LoRa hardware: Stop SOS!
                if (!isOnline && !isLoraActive) {
                  const offlineMsg = '⚠️ You are offline and not connected to a LoRa node. Please connect your LoRa node via Bluetooth or Wi-Fi to transmit an SOS alert offline.';
                  if (typeof window.EvacWarToast === 'function') {
                    window.EvacWarToast(offlineMsg);
                  }
                  alert(offlineMsg);
                  if (typeof window.openLoraHardwarePicker === 'function') {
                    window.openLoraHardwarePicker();
                  }
                  return;
                }

                if (typeof window.isInsideBarangaySanRafael === 'function' && !window.isInsideBarangaySanRafael(lat, lng)) {
                  const outsideMsg = '🚫 Outside Barangay San Rafael Jurisdiction: SOS & Rescue option is available ONLY within Barangay San Rafael boundary.';
                  if (typeof window.EvacWarToast === 'function') {
                    window.EvacWarToast(outsideMsg);
                  }
                  alert(outsideMsg);
                  return;
                }

                isAcquiringGps = false;
                currentLat = lat;
                currentLng = lng;
                currentAccuracy = acc;

                placeOrUpdateSosMarker(currentLat, currentLng);
                panMapTo(currentLat, currentLng, 17);

                if (gpsStatusText) gpsStatusText.textContent = isManuallyPinned ? "Pinned Manually on Map" : "GPS Connected (Live)";
                if (gpsStatusBadge) {
                  gpsStatusBadge.className = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 self-start sm:self-center";
                }
                if (gpsAccuracyText) {
                  gpsAccuracyText.textContent = isManuallyPinned
                    ? `Manual Pin: ${currentLat.toFixed(5)}, ${currentLng.toFixed(5)}`
                    : `Accuracy: ±${currentAccuracy}m`;
                }

                const payload = {
                  resident_id: residentId,
                  name: residentName,
                  latitude: currentLat,
                  longitude: currentLng,
                  accuracy: isManuallyPinned ? 0 : currentAccuracy,
                  profile_photo: residentPhoto
                };

                if (socket && socket.connected) {
                  socket.emit('sos:new', payload);
                }
                if (window.evakwarLoraClient && isLoraActive) {
                  window.evakwarLoraClient.sendSosAlert({
                    msgId: String(Date.now()).slice(-5),
                    residentId: residentId || 1,
                    name: residentName || 'Resident',
                    latitude: currentLat,
                    longitude: currentLng,
                    accuracy: isManuallyPinned ? 0 : currentAccuracy,
                    pinMode: isManuallyPinned ? 'M' : 'G',
                    vulnCode: 'N',
                    statusCode: 'ACT'
                  }).then(loraRes => {
                    const badge = document.getElementById('webLoraStatusBadge');
                    if (badge && loraRes) {
                      badge.textContent = `TX SENT VIA ${loraRes.transport} (433.875 MHz)`;
                    }
                    if (typeof window.EvacWarToast === 'function') {
                      window.EvacWarToast(`🚨 SOS Transmitted over 433.875 MHz LoRa Mesh (${loraRes.transport})! Waiting for Hall ACK...`);
                    }
                  }).catch(e => {
                    console.warn('LoRa SOS note:', e.message);
                    if (typeof window.EvacWarToast === 'function') {
                      window.EvacWarToast('⚠️ LoRa Transmission: ' + e.message);
                    }
                  });
                }
                if (isOnline && (!socket || !socket.connected)) {
                  fetch('/api/sos/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                  })
                    .then(res => res.json())
                    .then(data => {
                      if (data && data.success && data.alert) {
                        setSosActiveState(data.alert);
                      }
                    })
                    .catch(err => console.error("Error creating SOS via POST /api/sos/create:", err));
                }

                // Show active SOS state on UI
                setSosActiveState({
                  id: activeSosAlert ? activeSosAlert.id : Date.now(),
                  resident_id: residentId,
                  name: residentName,
                  latitude: currentLat,
                  longitude: currentLng,
                  accuracy: isManuallyPinned ? 0 : currentAccuracy,
                  created_at: new Date().toISOString()
                });
              }

              // Primary SOS Dispatch Flow (Works Online AND Offline via 433.875 MHz LoRa Mesh — 0ms Instant Dispatch)
              function triggerSos() {
                const isOnline = Boolean(navigator.onLine || (socket && socket.connected));
                const lora = window.evakwarLoraClient;
                const isLoraActive = Boolean(lora && lora.connected && (lora.transport === 'BLE' || lora.transport === 'USB_SERIAL' || lora.transport === 'ESP_WIFI'));

                // When OFFLINE without an active LoRa hardware connection:
                // Stop/prevent SOS from activating, alert resident, and prompt to connect LoRa!
                if (!isOnline && !isLoraActive) {
                  const offlineMsg = '⚠️ You are offline and not connected to a LoRa node. Please connect your LoRa node via Bluetooth or Wi-Fi to transmit an SOS alert offline.';
                  if (typeof window.EvacWarToast === 'function') {
                    window.EvacWarToast(offlineMsg);
                  }
                  alert(offlineMsg);
                  if (typeof window.openLoraHardwarePicker === 'function') {
                    window.openLoraHardwarePicker();
                  }
                  return;
                }
                // 1. If resident already manually pinned their house, respect their exact pin!
                if (isManuallyPinned && isValidCoordinate(currentLat, currentLng)) {
                  dispatchSosPayload(currentLat, currentLng, 0);
                  return;
                }

                // 2. If we already have a valid live GPS fix, dispatch immediately!
                if (isValidCoordinate(currentLat, currentLng)) {
                  dispatchSosPayload(currentLat, currentLng, currentAccuracy || 15);
                  return;
                }

                // 3. Check cached GPS coordinates or fallback to Barangay San Rafael (13.51024, 123.34701)
                // NEVER block for 8 seconds waiting for GPS when offline — transmit SOS over 433.875 MHz LoRa in 0ms!
                let initLat = 13.51024;
                let initLng = 123.34701;
                let initAcc = 20;
                try {
                  const lastGps = JSON.parse(localStorage.getItem('evw_last_gps') || 'null');
                  if (lastGps && isValidCoordinate(lastGps.lat, lastGps.lng)) {
                    initLat = Number(lastGps.lat);
                    initLng = Number(lastGps.lng);
                    initAcc = Number(lastGps.acc) || 15;
                  }
                } catch (_e) {}

                dispatchSosPayload(initLat, initLng, initAcc);

                // 4. Simultaneously request a fresh high-accuracy GPS fix in the background
                // and broadcast a LoRa UPD packet so Admin/Rescuer maps immediately move the pin off the fallback coordinate!
                if ("geolocation" in navigator) {
                  navigator.geolocation.getCurrentPosition(
                    (pos) => {
                      const lat = pos.coords.latitude;
                      const lng = pos.coords.longitude;
                      const acc = Math.round(pos.coords.accuracy || 10);
                      if (isValidCoordinate(lat, lng) && !isManuallyPinned) {
                        currentLat = lat;
                        currentLng = lng;
                        currentAccuracy = acc;
                        try {
                          localStorage.setItem('evw_last_gps', JSON.stringify({ lat, lng, acc, ts: Date.now() }));
                        } catch (_e) {}
                        placeOrUpdateSosMarker(lat, lng);
                        panMapTo(lat, lng, 17);
                        if (activeSosAlert) {
                          activeSosAlert.latitude = lat;
                          activeSosAlert.longitude = lng;
                          if (socket && socket.connected) {
                            socket.emit('sos:update', {
                              id: activeSosAlert.id,
                              resident_id: residentId,
                              name: residentName,
                              latitude: lat,
                              longitude: lng,
                              accuracy: acc
                            });
                          }
                          if (window.evakwarLoraClient && isLoraActive) {
                            window.evakwarLoraClient.sendSosAlert({
                              msgId: String(activeSosAlert.id || Date.now()).slice(-5),
                              residentId: residentId || 1,
                              name: residentName || 'Resident',
                              latitude: lat,
                              longitude: lng,
                              accuracy: acc,
                              pinMode: 'G',
                              vulnCode: 'N',
                              statusCode: 'UPD'
                            }).catch(() => {});
                          }
                        }
                      }
                    },
                    () => {},
                    { enableHighAccuracy: true, timeout: 8000, maximumAge: 10000 }
                  );
                }
              }

              // Cancel SOS Function (Works Online AND Offline via 433.875 MHz LoRa Mesh)
              function cancelSosImmediately() {
                window._residentCancelledSosAt = Date.now();
                const cancelPayload = {
                  id: (activeSosAlert && !isNaN(activeSosAlert.id)) ? activeSosAlert.id : null,
                  resident_id: residentId || currentUserId || 1
                };

                const lora = window.evakwarLoraClient;
                const isLoraActive = Boolean(
                  (window.AndroidBleBridge && typeof window.AndroidBleBridge.isConnected === 'function' && window.AndroidBleBridge.isConnected()) ||
                  (window.AndroidUsbSerialBridge && typeof window.AndroidUsbSerialBridge.isConnected === 'function' && window.AndroidUsbSerialBridge.isConnected()) ||
                  (lora && lora.connected && (lora.transport === 'BLE' || lora.transport === 'USB_SERIAL' || lora.transport === 'ESP_WIFI'))
                );
                if (lora && isLoraActive) {
                  lora.sendCancelSos({
                    sosId: cancelPayload.id || 0,
                    residentId: cancelPayload.resident_id || 1
                  }).then(loraRes => {
                    const badge = document.getElementById('webLoraStatusBadge');
                    if (badge && loraRes) {
                      badge.textContent = `SOS CANCELLED BY YOU (${loraRes.transport})`;
                    }
                  }).catch(e => console.warn('LoRa cancel SOS note:', e.message));
                } else {
                  const badge = document.getElementById('webLoraStatusBadge');
                  if (badge) badge.textContent = 'STANDBY (433.875 MHz)';
                }

                if (socket && socket.connected) {
                  socket.emit('sos:cancel', cancelPayload);
                }
                if (navigator.onLine) {
                  fetch('/api/sos/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(cancelPayload)
                  }).catch(e => console.warn('POST /api/sos/cancel sync note:', e));
                }

                setSosNormalState();
                if (typeof window.EvacWarToast === 'function') {
                  window.EvacWarToast('You cancelled your SOS distress signal.');
                }
              }

              // Handle SOS Button Trigger (with confirmation modal before sending)
              const sosConfirmModal = document.getElementById('sosConfirmModal');
              const btnCancelSosModal = document.getElementById('btnCancelSosModal');
              const btnConfirmSosSend = document.getElementById('btnConfirmSosSend');

              function closeSosConfirmModal() {
                if (sosConfirmModal) sosConfirmModal.classList.add('hidden');
              }

              if (btnCancelSosModal) {
                btnCancelSosModal.addEventListener('click', closeSosConfirmModal);
              }
              if (sosConfirmModal) {
                sosConfirmModal.addEventListener('click', (e) => {
                  if (e.target === sosConfirmModal) closeSosConfirmModal();
                });
              }
              if (btnConfirmSosSend) {
                btnConfirmSosSend.addEventListener('click', () => {
                  closeSosConfirmModal();
                  triggerSos();
                });
              }

              if (sosBtn) {
                sosBtn.addEventListener('click', () => {
                  if (activeSosAlert) {
                    cancelSosImmediately();
                    return;
                  }

                  if (sosConfirmModal) {
                    sosConfirmModal.classList.remove('hidden');
                  } else {
                    triggerSos();
                  }
                });
              }

              // Handle STOP SOS Button
              if (stopSosBtn) {
                stopSosBtn.addEventListener('click', () => {
                  cancelSosImmediately();
                });
              }

              if (cancelSosBtn) {
                cancelSosBtn.addEventListener('click', () => {
                  cancelSosImmediately();
                });
              }

              // Listen for socket events from server
              if (socket) {
                socket.on('sos:new', (data) => {
                  if (data && (
                    data.resident_id == residentId ||
                    (currentUserId && data.resident_id == currentUserId) ||
                    (currentUserId && data.user_id == currentUserId)
                  )) {
                    setSosActiveState(data);
                    if (isValidCoordinate(data.latitude, data.longitude)) {
                      currentLat = Number(data.latitude);
                      currentLng = Number(data.longitude);
                      placeOrUpdateSosMarker(currentLat, currentLng);
                      panMapTo(currentLat, currentLng, 17);
                    }
                  }
                });

                socket.on('sos:update', (data) => {
                  if (data && (
                    data.resident_id == residentId ||
                    (currentUserId && data.resident_id == currentUserId) ||
                    (activeSosAlert && data.id === activeSosAlert.id)
                  )) {
                    activeSosAlert = data;
                  }
                });

                socket.on('sos:cancel', (data) => {
                  if (data && (
                    (activeSosAlert && (data.id === activeSosAlert.id || data.sos_id === activeSosAlert.id)) ||
                    data.resident_id == residentId ||
                    (currentUserId && data.resident_id == currentUserId)
                  )) {
                    setSosNormalState();
                  }
                });

                socket.on('sos:update_status', (data) => {
                  if (!data) return;
                  const isMine = (
                    (activeSosAlert && (String(data.id) === String(activeSosAlert.id) || String(data.sos_id) === String(activeSosAlert.id))) ||
                    (data.resident_id && (data.resident_id == residentId || (currentUserId && data.resident_id == currentUserId)))
                  );
                  if (!isMine && !activeSosAlert) return;
                  const status = String(data.status || 'ACKNOWLEDGED').toUpperCase();
                  const responder = data.responder_name || 'Rescue Team';
                  if (status === 'CANCELLED') {
                    setSosNormalState();
                  } else if (status === 'RESOLVED' || status === 'RESCUED') {
                    if (typeof window.EvacWarToast === 'function') {
                      window.EvacWarToast(`SOS Status Updated: ${status} by ${responder}.`);
                    }
                    setSosNormalState();
                  } else {
                    const rPhoto = data.rescuer_photo || data.handler_photo || (data.alert && (data.alert.rescuer_photo || data.alert.handler_photo)) || null;
                    if (!activeSosAlert && isMine) {
                      setSosActiveState({
                        id: data.id || data.sos_id || Date.now(),
                        resident_id: residentId,
                        name: residentName,
                        latitude: currentLat || 13.51024,
                        longitude: currentLng || 123.34701,
                        status: status,
                        responder_name: responder,
                        rescuer_photo: rPhoto,
                        rescuer_lat: data.rescuer_lat,
                        rescuer_lng: data.rescuer_lng
                      });
                    }
                    if (sosCardHeading) sosCardHeading.textContent = `🚨 SOS ${status === 'ACKNOWLEDGED' ? 'AUTO-ASSIGNED' : status} (${responder})`;
                    if (sosCardSubtext) sosCardSubtext.textContent = `${responder} is assigned to your SOS (${status}). Help is on the way!`;
                    updateRescuerEtaDisplay({
                      status: status,
                      responderName: responder,
                      rescuerPhoto: rPhoto,
                      rescuerLat: data.rescuer_lat,
                      rescuerLng: data.rescuer_lng
                    });
                  }
                });

                socket.on('rescuer:location_update', (data) => {
                  if (!data || !activeSosAlert) return;
                  const rLat = data.latitude !== undefined ? data.latitude : data.lat;
                  const rLng = data.longitude !== undefined ? data.longitude : data.lng;
                  const rName = data.rescuer_name || data.name || (window._lastRescuerCoords ? window._lastRescuerCoords.name : null);
                  if (isValidCoordinate(rLat, rLng) && !isGenericOrFakeRescuerName(rName)) {
                    const effectiveSt = (activeSosAlert && ['ACKNOWLEDGED', 'RESPONDING', 'RESCUED'].includes(String(activeSosAlert.status || '').toUpperCase()))
                      ? String(activeSosAlert.status).toUpperCase()
                      : (data.status && String(data.status).toUpperCase() !== 'ACTIVE' ? String(data.status).toUpperCase() : 'RESPONDING');
                    updateRescuerEtaDisplay({
                      status: effectiveSt,
                      responderName: rName,
                      rescuerPhoto: data.rescuer_photo || (window._lastRescuerCoords ? window._lastRescuerCoords.photo : null),
                      rescuerLat: Number(rLat),
                      rescuerLng: Number(rLng)
                    });
                  }
                });

                socket.on('rescuer:location_cleared', () => {
                  if (!activeSosAlert) return;
                  updateRescuerEtaDisplay({ status: 'ACTIVE', responderName: null, rescuerLat: null, rescuerLng: null });
                });

                socket.on('sos:resolve', (data) => {
                  if (!data) return;
                  const resolvedSt = String(data.status || 'RESOLVED').toUpperCase();
                  if (!['RESOLVED', 'RESCUED', 'CANCELLED'].includes(resolvedSt)) return;
                  const isMine = (
                    (activeSosAlert && (String(data.id) === String(activeSosAlert.id) || String(data.sos_id) === String(activeSosAlert.id))) ||
                    (data.resident_id && (String(data.resident_id) === String(residentId) || (currentUserId && String(data.resident_id) === String(currentUserId))))
                  );
                  if (isMine || activeSosAlert) {
                    if (typeof window.EvacWarToast === 'function') {
                      window.EvacWarToast('Your SOS request has been marked as RESOLVED / RESCUED.');
                    }
                    setSosNormalState();
                  }
                });

                socket.on('sos:error', (data) => {
                  if (data && data.message) {
                    handleGpsFailure(data.message);
                  }
                });
              }

              // Listen for 433.875 MHz LoRa ACK / Rescuer Status Updates (EVW|ACK|<sosId>|<residentId>|<status>|<responderName>|<rescuerLat>,<rescuerLng>)
              if (window.evakwarLoraClient) {
                window.evakwarLoraClient.on('ack', (ackData) => {
                  if (!ackData) return;
                  const status = String(ackData.status || 'ACKNOWLEDGED').toUpperCase();
                  const responder = ackData.responderName || 'Barangay Hall';
                  const badge = document.getElementById('webLoraStatusBadge');

                  if (status === 'CANCELLED') {
                    if (badge) badge.textContent = 'SOS CANCELLED BY YOU';
                    setSosNormalState();
                  } else if (status === 'RESOLVED' || status === 'RESCUED') {
                    if (badge) badge.textContent = `LORA RX: ${status} BY ${responder}`;
                    if (typeof window.EvacWarToast === 'function') {
                      window.EvacWarToast(`LoRa Update: Your SOS was marked ${status} by ${responder}.`);
                    }
                    setSosNormalState();
                  } else {
                    if (!activeSosAlert) {
                      setSosActiveState({
                        id: ackData.sosId || Date.now(),
                        resident_id: residentId,
                        name: residentName,
                        latitude: currentLat || 13.51024,
                        longitude: currentLng || 123.34701,
                        status: status,
                        responder_name: responder,
                        rescuer_lat: ackData.rescuerLat,
                        rescuer_lng: ackData.rescuerLng
                      });
                    }
                    if (badge) badge.textContent = `LORA ACK: ${status} • ${responder}`;
                    if (sosCardHeading) sosCardHeading.textContent = `🚨 SOS ${status} (${responder})`;
                    if (sosCardSubtext) sosCardSubtext.textContent = `Barangay Hall / Rescuer (${responder}) acknowledged your SOS over 433.875 MHz LoRa Mesh! Help is on the way.`;
                    updateRescuerEtaDisplay({
                      status: status,
                      responderName: responder,
                      rescuerLat: ackData.rescuerLat,
                      rescuerLng: ackData.rescuerLng
                    });
                    if (typeof window.EvacWarToast === 'function') {
                      window.EvacWarToast(`LoRa ACK: ${status} by ${responder}!`);
                    }
                  }
                });
              }
            });
          </script>
      </main>
  </div>

  <%- include('../partials/footer') %>