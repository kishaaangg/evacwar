<style>
  body.chat-keyboard-active #residentBottomNav,
  body.chat-keyboard-active #staffBottomNav,
  body.chat-keyboard-active nav.fixed.bottom-0 {
    display: none !important;
  }
</style>
<%
  const rawRole = (typeof chatRole !== 'undefined' && chatRole)
    ? chatRole
    : ((user && user.staff_type === 'RESCUER') ? 'Rescuer'
      : ((user && (user.role === 'admin' || user.role === 'ADMIN')) ? 'Admin'
        : ((user && (user.role === 'staff' || user.role === 'barangay_council')) ? 'Staff' : 'Resident')));

  let resolvedName = (user && (user.full_name || user.name)) ? String(user.full_name || user.name).trim() : '';
  if (rawRole === 'Admin') {
    if (!resolvedName || resolvedName === 'Admin' || resolvedName === 'Administrator' || resolvedName === 'Super Admin' || resolvedName === 'Super Administrator') {
      resolvedName = 'Monette Bisenio';
    }
  } else if (!resolvedName) {
    resolvedName = rawRole;
  }
%>

<div id="loraChatContainer" class="max-w-4xl mx-auto w-full px-2 sm:px-3 pt-1 sm:pt-1.5 pb-0.5 sm:pb-1 flex flex-col flex-1" style="height: calc(100dvh - 118px); max-height: calc(100dvh - 118px); box-sizing: border-box;">

  <!-- Compact LoRa Mesh & Identity Header -->
  <div class="rounded-xl bg-slate-900 text-white px-3 py-2 border border-slate-800 shadow-sm mb-1.5 shrink-0">
    <div class="flex items-center justify-between gap-2">
      <!-- Title & Role Badge -->
      <div class="flex items-center gap-2 min-w-0">
        <div class="w-8 h-8 rounded-lg bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-blue-400 shrink-0">
          <i class="ph ph-chats-circle text-lg"></i>
        </div>
        <div class="min-w-0 leading-tight">
          <div class="flex items-center gap-1.5 flex-wrap">
            <h1 class="font-heading text-xs sm:text-sm font-extrabold text-white truncate">Offline LoRa Chat</h1>
            <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-400/35 shrink-0">Offline Only</span>
            <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase tracking-wider bg-blue-500/20 text-blue-300 border border-blue-400/30 shrink-0">433.875 MHz</span>
          </div>
          <div class="text-[10px] text-slate-300 truncate mt-0.5">
            <span class="text-slate-400">Sender:</span>
            <span id="chatIdentityBadgeText" class="font-bold text-emerald-300">
              <%= rawRole %> | <%= resolvedName %>
            </span>
          </div>
        </div>
      </div>

      <!-- Live Transport Status Pill & Optional LoRa Connect button -->
      <div class="flex items-center gap-1.5 shrink-0">
        <span id="chatTransportStatusBadge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-400/30 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span id="chatTransportStatusText">LoRa Required</span>
        </span>
        <% if (rawRole !== 'Admin') { %>
          <button type="button" onclick="window.openLoraHardwarePicker && window.openLoraHardwarePicker()"
            class="p-1 sm:px-2 sm:py-1 rounded-lg bg-white/10 hover:bg-white/15 text-white border border-white/15 text-[10px] font-bold flex items-center gap-1 cursor-pointer active:scale-95 transition-all"
            title="Connect LoRa Hardware">
            <i class="ph ph-broadcast text-xs text-blue-300"></i>
            <span class="hidden sm:inline">Connect LoRa</span>
          </button>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Main Chat Card -->
  <div class="flex-1 bg-white rounded-xl border border-slate-200 shadow-xs flex flex-col overflow-hidden min-h-0">

    <!-- Subheader with Refresh -->
    <div class="px-3 py-1.5 bg-slate-50 border-b border-slate-200/80 flex items-center justify-between text-[10.5px] text-slate-600 shrink-0">
      <div class="flex items-center gap-1.5 truncate">
        <i class="ph ph-broadcast text-purple-600 text-xs"></i>
        <span class="font-semibold text-slate-700 truncate">Offline Communication Only • 433.875 MHz LoRa Radio</span>
      </div>
      <button type="button" id="btnRefreshLoraChat" class="text-blue-600 hover:text-blue-700 font-bold flex items-center gap-1 cursor-pointer shrink-0 active:scale-95 transition-transform" title="Reload conversation">
        <i id="refreshLoraChatIcon" class="ph ph-arrows-clockwise text-xs"></i>
        <span>Refresh</span>
      </button>
    </div>

    <!-- LoRa-Only Warning Banner (shown whenever LoRa hardware is not connected) -->
    <div id="loraOnlyWarningBanner" class="px-3 py-2 bg-amber-50 border-b border-amber-200 flex items-center justify-between gap-2 text-[11px] text-amber-900 shrink-0">
      <div class="flex items-center gap-2 min-w-0">
        <i class="ph ph-warning-circle text-amber-600 text-base shrink-0"></i>
        <span class="font-semibold leading-snug">Offline LoRa Chat is for offline radio communication only (no Wi-Fi/internet sending). Connect your LoRa node to chat.</span>
      </div>
      <% if (rawRole !== 'Admin') { %>
        <button type="button" onclick="window.openLoraHardwarePicker && window.openLoraHardwarePicker()"
          class="px-2.5 py-1 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold text-[10px] shrink-0 cursor-pointer active:scale-95 transition-all">
          Connect LoRa
        </button>
      <% } %>
    </div>

    <!-- Scrollable Message Bubble List -->
    <div id="loraChatMessagesList" class="flex-1 overflow-y-auto p-3 space-y-3 bg-slate-50/60" style="-webkit-overflow-scrolling: touch;">
      <!-- Dynamic messages populated here -->
    </div>

    <!-- Quick Message Presets Strip -->
    <div class="px-2.5 py-1.5 bg-slate-50 border-t border-slate-200/70 flex items-center gap-1.5 overflow-x-auto no-scrollbar shrink-0">
      <button type="button" data-quick-msg="📍 Safe at Evacuation Center"
        class="lora-quick-chip shrink-0 px-2.5 py-1 rounded-full bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200 text-[11px] sm:text-xs font-medium transition-colors cursor-pointer shadow-2xs">
        📍 Safe at Evac Center
      </button>
      <button type="button" data-quick-msg="🌊 Floodwater rising in our zone"
        class="lora-quick-chip shrink-0 px-2.5 py-1 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-700 border border-slate-200 text-[11px] sm:text-xs font-medium transition-colors cursor-pointer shadow-2xs">
        🌊 Floodwater rising
      </button>
      <button type="button" data-quick-msg="🚑 Need rescue assistance"
        class="lora-quick-chip shrink-0 px-2.5 py-1 rounded-full bg-white hover:bg-rose-50 text-slate-700 hover:text-rose-700 border border-slate-200 text-[11px] sm:text-xs font-medium transition-colors cursor-pointer shadow-2xs">
        🚑 Need rescue assistance
      </button>
      <button type="button" data-quick-msg="📡 Radio check - copy 433.875 MHz"
        class="lora-quick-chip shrink-0 px-2.5 py-1 rounded-full bg-white hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 border border-slate-200 text-[11px] sm:text-xs font-medium transition-colors cursor-pointer shadow-2xs">
        📡 Radio check
      </button>
    </div>

    <!-- Message Composer Bar (Optimized for Mobile Typing & Large Touch Targets) -->
    <div id="loraChatForm" data-offline-enabled="true" data-lora-chat="true" class="p-2 sm:p-2.5 bg-white border-t border-slate-200/90 flex items-center gap-2 shrink-0 shadow-xs">
      <input
        type="text"
        id="loraChatInput" data-offline-enabled="true" data-lora-chat="true"
        maxlength="140"
        autocomplete="off"
        placeholder="Offline LoRa message only (433.875 MHz)..."
        class="flex-1 rounded-2xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 sm:py-3 text-[15px] sm:text-base text-slate-900 placeholder:text-slate-400 focus:border-blue-600 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:outline-none transition-all leading-normal min-h-[46px] sm:min-h-[50px]"
      />
      <button
        type="button"
        id="loraChatSendBtn"
        data-offline-enabled="true"
        data-lora-chat="true"
        class="rounded-2xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold px-4 sm:px-5 py-2.5 sm:py-3 text-sm sm:text-base flex items-center justify-center gap-1.5 shadow-sm transition-all cursor-pointer shrink-0 min-h-[46px] sm:min-h-[50px]">
        <i class="ph ph-paper-plane-right text-base sm:text-lg pointer-events-none"></i>
        <span class="pointer-events-none font-bold">Send</span>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const SERVER_ROLE = <%- JSON.stringify(rawRole) %>;
    const SERVER_NAME = <%- JSON.stringify(resolvedName) %>;

    const messagesListEl = document.getElementById('loraChatMessagesList');
    const chatFormEl = document.getElementById('loraChatForm');
    const chatInputEl = document.getElementById('loraChatInput');
    const identityBadgeEl = document.getElementById('chatIdentityBadgeText');
    const transportBadgeEl = document.getElementById('chatTransportStatusBadge');
    const transportTextEl = document.getElementById('chatTransportStatusText');
    const refreshBtn = document.getElementById('btnRefreshLoraChat');
    const chatContainerEl = document.getElementById('loraChatContainer');

    let currentRole = SERVER_ROLE;
    let currentName = SERVER_NAME;

    // Keyboard and bottom navbar visibility handler
    function hideBottomNav() {
      document.body.classList.add('chat-keyboard-active');
      const navs = document.querySelectorAll('#residentBottomNav, #staffBottomNav, nav.fixed.bottom-0');
      navs.forEach(n => { n.style.setProperty('display', 'none', 'important'); });
      adjustHeightForViewport();
    }

    function showBottomNav() {
      document.body.classList.remove('chat-keyboard-active');
      const navs = document.querySelectorAll('#residentBottomNav, #staffBottomNav, nav.fixed.bottom-0');
      navs.forEach(n => { n.style.removeProperty('display'); });
      adjustHeightForViewport();
    }

    function checkKeyboardState() {
      const isInputFocused = (document.activeElement === chatInputEl);
      const isVisualShrunk = (window.visualViewport && (window.visualViewport.height < window.innerHeight - 130));
      if (isInputFocused || isVisualShrunk) {
        hideBottomNav();
      } else {
        showBottomNav();
      }
    }

    function adjustHeightForViewport() {
      const isKeyboard = document.body.classList.contains('chat-keyboard-active') || 
                         (document.activeElement === chatInputEl) ||
                         (window.visualViewport && (window.visualViewport.height < window.innerHeight - 130));
      const vh = window.visualViewport ? window.visualViewport.height : window.innerHeight;
      const navEl = isKeyboard ? null : document.querySelector('nav.fixed.bottom-0, #residentBottomNav, #staffBottomNav');
      const navHeight = (navEl && navEl.offsetHeight && navEl.style.display !== 'none') ? navEl.offsetHeight : 0;
      const headerEl = document.querySelector('header.app-header');
      const headerHeight = (headerEl && headerEl.offsetHeight) ? headerEl.offsetHeight : 52;
      
      // Keep chat snug down right above the bottom nav without giant empty void
      const bottomGap = isKeyboard ? 4 : (navHeight > 0 ? (navHeight + 6) : 8);
      const available = vh - headerHeight - bottomGap;
      if (chatContainerEl && available > 200) {
        chatContainerEl.style.height = `${available}px`;
        chatContainerEl.style.maxHeight = `${available}px`;
      }
      if (messagesListEl) {
        messagesListEl.scrollTop = messagesListEl.scrollHeight;
      }
    }

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', checkKeyboardState);
      window.visualViewport.addEventListener('scroll', checkKeyboardState);
    }
    window.addEventListener('resize', checkKeyboardState);
    adjustHeightForViewport();
    setTimeout(adjustHeightForViewport, 50);
    setTimeout(adjustHeightForViewport, 180);

    if (chatInputEl) {
      chatInputEl.addEventListener('focus', () => {
        hideBottomNav();
        setTimeout(() => {
          adjustHeightForViewport();
          chatInputEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 150);
      });

      chatInputEl.addEventListener('blur', () => {
        setTimeout(() => {
          if (document.activeElement !== chatInputEl) {
            checkKeyboardState();
          }
        }, 120);
      });

      chatInputEl.addEventListener('input', () => {
        hideBottomNav();
      });
    }

    function resolveActiveIdentity() {
      try {
        const storedRole = localStorage.getItem('evw_user_role');
        if (SERVER_ROLE === 'Admin') {
          currentRole = 'Admin';
          if (!currentName || currentName === 'Admin' || currentName === 'Administrator' || currentName === 'Super Admin') {
            currentName = 'Monette Bisenio';
          }
        } else {
          if (storedRole === 'rescuer' || SERVER_ROLE === 'Rescuer') {
            currentRole = 'Rescuer';
          } else if (storedRole === 'staff' || SERVER_ROLE === 'Staff') {
            currentRole = 'Staff';
          } else {
            currentRole = 'Resident';
          }

          if (currentRole === 'Rescuer' || currentRole === 'Staff') {
            const cachedStaff = JSON.parse(localStorage.getItem('evw_cached_staff') || 'null');
            if (cachedStaff) {
              const fn = cachedStaff.full_name || cachedStaff.name || `${cachedStaff.first_name || ''} ${cachedStaff.last_name || ''}`.trim();
              if (fn) currentName = fn;
            }
          } else {
            const cachedRes = JSON.parse(localStorage.getItem('evw_cached_resident') || 'null');
            if (cachedRes) {
              const fn = cachedRes.full_name || cachedRes.name || `${cachedRes.first_name || ''} ${cachedRes.last_name || ''}`.trim();
              if (fn) currentName = fn;
            }
          }
        }
      } catch (_e) {}

      // Notify Android bridge so native background service suppresses self-notifications
      if (window.AndroidBleBridge && typeof window.AndroidBleBridge.setActiveUser === 'function') {
        try { window.AndroidBleBridge.setActiveUser(currentName, currentRole); } catch (_) {}
      }

      if (identityBadgeEl) {
        identityBadgeEl.textContent = `${currentRole} | ${currentName}`;
      }
    }

    function updateTransportUi() {
      resolveActiveIdentity();
      const lora = window.evakwarLoraClient;
      const isNativeBle = Boolean(typeof window !== 'undefined' && window.AndroidBleBridge && typeof window.AndroidBleBridge.isConnected === 'function' && window.AndroidBleBridge.isConnected());
      const isBleOrUsb = isNativeBle || Boolean(lora && lora.connected && (lora.transport === 'BLE' || lora.transport === 'USB_SERIAL' || lora.transport === 'ESP_WIFI'));
      const warnBanner = document.getElementById('loraOnlyWarningBanner');

      if (SERVER_ROLE === 'Admin') {
        const isGwConnected = Boolean(window._adminGatewayConnected) || isBleOrUsb;
        if (warnBanner) warnBanner.classList.toggle('hidden', isGwConnected);
        if (transportTextEl) {
          transportTextEl.textContent = isGwConnected ? 'LoRa Gateway (COM3)' : 'LoRa Required (No COM3)';
        }
        if (transportBadgeEl) {
          transportBadgeEl.className = isGwConnected
            ? 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 flex items-center gap-1'
            : 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-400/30 flex items-center gap-1';
        }
        return;
      }

      if (warnBanner) warnBanner.classList.toggle('hidden', isBleOrUsb);

      if (isBleOrUsb) {
        const modeLabel = (lora && lora.transport === 'USB_SERIAL') ? 'LoRa USB Active' : 'LoRa Mesh (BLE)';
        if (transportTextEl) transportTextEl.textContent = modeLabel;
        if (transportBadgeEl) {
          transportBadgeEl.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 flex items-center gap-1';
        }
      } else {
        if (transportTextEl) transportTextEl.textContent = 'LoRa Required';
        if (transportBadgeEl) {
          transportBadgeEl.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-400/30 flex items-center gap-1';
        }
      }
    }

    const CHAT_RESET_EPOCH = '2026-11-25-fresh-1';
    try {
      if (localStorage.getItem('evw_lora_chat_reset_epoch') !== CHAT_RESET_EPOCH) {
        localStorage.removeItem('evw_lora_chat_messages');
        localStorage.setItem('evw_lora_chat_reset_epoch', CHAT_RESET_EPOCH);
      }
    } catch (_e) {}

    const renderedMsgIds = new Set();
    let allMessages = [];

    function getLocalCachedMessages() {
      try {
        const raw = localStorage.getItem('evw_lora_chat_messages');
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed : [];
      } catch (_e) {
        return [];
      }
    }

    function saveLocalCachedMessages(list) {
      try {
        localStorage.setItem('evw_lora_chat_messages', JSON.stringify(list.slice(-100)));
      } catch (_e) {}
    }

    function getRoleBadgeStyle(roleStr) {
      const r = String(roleStr || '').toLowerCase();
      if (r.includes('admin')) {
        return 'bg-purple-100 text-purple-800 border-purple-300';
      }
      if (r.includes('rescuer')) {
        return 'bg-rose-100 text-rose-800 border-rose-300';
      }
      if (r.includes('staff')) {
        return 'bg-amber-100 text-amber-800 border-amber-300';
      }
      return 'bg-blue-100 text-blue-800 border-blue-300';
    }

    function getNormalizedTimestampMs(msg) {
      if (!msg) return Date.now();
      if (msg.timestamp) {
        const num = Number(msg.timestamp);
        if (!isNaN(num) && num > 0) {
          if (num < 10000000000) return num * 1000;
          if (num < 10000000000000) return num;
          return Math.floor(num / 1000);
        }
      }
      const iso = msg.created_at || msg.sent_at;
      if (iso) {
        const ms = new Date(iso).getTime();
        if (!isNaN(ms) && ms > 0) return ms;
      }
      return Date.now();
    }

    function formatTimeLabel(msg) {
      const ms = getNormalizedTimestampMs(msg);
      const d = new Date(ms);
      if (!isNaN(d.getTime())) {
        return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }
      return 'Just now';
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function getHallServerUrl() {
      if (window.location.protocol.startsWith('http') && window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1' && !(window.Capacitor && typeof window.Capacitor.isNativePlatform === 'function' && window.Capacitor.isNativePlatform())) {
        return window.location.origin;
      }
      try {
        const saved = localStorage.getItem('evw_server_url');
        if (saved && saved.startsWith('http') && !saved.includes('http://localhost/') && saved !== 'http://localhost') {
          return saved.replace(/\/$/, '');
        }
      } catch (_) {}
      if (window.location.port === '8080') return window.location.origin;
      return 'https://evacwar.onrender.com';
    }

    function getMessageUniqueKey(m) {
      if (!m) return '';
      if (m.msgId) return String(m.msgId);
      if (m.id) return String(m.id);
      return `${m.senderName || ''}_${getNormalizedTimestampMs(m)}_${m.text || ''}`;
    }

    function renderMessageBubble(msg, autoScroll = true) {
      if (!msg || !msg.text) return;
      const msgKey = getMessageUniqueKey(msg);
      
      const existingEl = document.getElementById(`chat_msg_${msgKey}`);
      if (existingEl) {
        updateMessageStatusInDom(existingEl, msg);
        return;
      }
      renderedMsgIds.add(msgKey);

      const sRole = msg.senderRole || 'Resident';
      let sName = msg.senderName || 'Resident';
      if (sName.includes(' | !')) {
        sName = sName.split(' | !')[0].trim();
      }
      const badgeText = `${sRole} | ${sName}`;

      const isMine = (
        String(sName).trim().toLowerCase() === String(currentName).trim().toLowerCase() &&
        String(sRole).trim().toLowerCase() === String(currentRole).trim().toLowerCase()
      );

      const pillClass = getRoleBadgeStyle(sRole);
      const timeStr = formatTimeLabel(msg);

      // Clean messenger status indicator: Sending... / Sent / Delivered / Not Sent (no LoRa/Wi-Fi clutter)
      let statusHtml = '';
      if (isMine) {
        if (msg.status === 'failed') {
          statusHtml = `<span class="text-rose-200 font-extrabold flex items-center gap-1"><i class="ph ph-warning-circle"></i> Not Sent · Tap to retry</span>`;
        } else if (msg.status === 'pending') {
          statusHtml = `<span class="text-amber-200 font-semibold flex items-center gap-1"><i class="ph ph-clock"></i> Sending...</span>`;
        } else if (msg.status === 'delivered' || msg.seq || msg.syncedToDb) {
          statusHtml = `<span class="flex items-center gap-1"><i class="ph ph-checks"></i> Delivered</span>`;
        } else {
          statusHtml = `<span class="flex items-center gap-1"><i class="ph ph-check"></i> Sent</span>`;
        }
      } else {
        statusHtml = `<span class="flex items-center gap-1"><i class="ph ph-checks text-emerald-500"></i> Delivered</span>`;
      }

      const wrapper = document.createElement('div');
      wrapper.id = `chat_msg_${msgKey}`;
      wrapper.setAttribute('data-msg-key', msgKey);
      wrapper.className = `chat-bubble-wrapper flex flex-col ${isMine ? 'items-end' : 'items-start'} animate-fade-in`;

      wrapper.innerHTML = `
        <div class="flex items-center gap-1.5 mb-1 px-1 max-w-[92%]">
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] sm:text-xs font-bold border ${pillClass} truncate shadow-2xs">
            <span>${escapeHtml(badgeText)}</span>
          </span>
          <span class="text-[10px] sm:text-[11px] text-slate-400 font-medium shrink-0">${escapeHtml(timeStr)}</span>
        </div>
        <div class="max-w-[90%] sm:max-w-[80%] rounded-2xl px-3.5 py-2.5 sm:px-4 sm:py-3 text-[14.5px] sm:text-[15.5px] leading-relaxed shadow-xs ${
          isMine
            ? (msg.status === 'failed' ? 'bg-red-700 text-white rounded-tr-xs' : 'bg-blue-600 text-white rounded-tr-xs')
            : 'bg-white text-slate-800 border border-slate-200/90 rounded-tl-xs'
        }">
          <div class="break-words font-normal tracking-normal">${escapeHtml(msg.text)}</div>
          <div class="msg-status-bar mt-1.5 flex items-center justify-end gap-1 text-[10px] sm:text-[11px] ${isMine ? 'text-blue-200' : 'text-slate-400'}">
            ${statusHtml}
          </div>
        </div>
      `;

      if (isMine && msg.status === 'failed') {
        wrapper.style.cursor = 'pointer';
        wrapper.title = 'Tap to retry sending';
        wrapper.onclick = () => retryMessage(msg);
      }

      messagesListEl.appendChild(wrapper);
      if (autoScroll) {
        messagesListEl.scrollTop = messagesListEl.scrollHeight;
      }
    }

    function updateMessageStatusInDom(el, msg) {
      const statusBar = el.querySelector('.msg-status-bar');
      if (!statusBar) return;

      const isMine = el.classList.contains('items-end');

      // Update bubble color if mine
      const bubbleCard = el.querySelector('.max-w-\\[90\\%\\]') || el.querySelector('.max-w-\\[88\\%\\]') || el.children[1];
      if (bubbleCard && isMine) {
        if (msg.status === 'failed') {
          bubbleCard.classList.remove('bg-blue-600');
          bubbleCard.classList.add('bg-red-700');
        } else {
          bubbleCard.classList.remove('bg-red-700');
          bubbleCard.classList.add('bg-blue-600');
        }
      }

      if (msg.status === 'failed') {
        statusBar.innerHTML = `<span class="text-rose-200 font-extrabold flex items-center gap-1 cursor-pointer"><i class="ph ph-warning-circle"></i> Not Sent · Tap to retry</span>`;
        el.style.cursor = 'pointer';
        el.title = 'Tap to retry sending';
        el.onclick = () => retryMessage(msg);
      } else if (msg.status === 'pending') {
        statusBar.innerHTML = `<span class="text-amber-200 font-semibold flex items-center gap-1"><i class="ph ph-clock"></i> Sending...</span>`;
        el.style.cursor = '';
        el.title = '';
        el.onclick = null;
      } else if (!isMine || msg.status === 'delivered' || msg.seq || msg.syncedToDb) {
        statusBar.innerHTML = `<span class="flex items-center gap-1"><i class="ph ph-checks ${isMine ? '' : 'text-emerald-500'}"></i> Delivered</span>`;
        el.style.cursor = '';
        el.title = '';
        el.onclick = null;
      } else {
        statusBar.innerHTML = `<span class="flex items-center gap-1"><i class="ph ph-check"></i> Sent</span>`;
        el.style.cursor = '';
        el.title = '';
        el.onclick = null;
      }
    }

    function mergeAndRenderMessages(serverMessages, forceScrollToBottom = false) {
      const isFromServer = Array.isArray(serverMessages) && serverMessages.length > 0;
      const localMsgs = getLocalCachedMessages();
      const mapById = new Map();

      // 1. Process server messages first (Server is authoritative source of truth!)
      const srvList = isFromServer ? serverMessages : [];
      for (const sm of srvList) {
        if (!sm || !sm.text) continue;
        const key = getMessageUniqueKey(sm);
        mapById.set(key, Object.assign({}, sm, { status: 'delivered', syncedToDb: true }));
      }

      // 2. Merge local cached messages
      // When server messages exist, DO NOT keep old stale unsequenced phantoms - ONLY keep actively pending/unsynced/failed messages!
      const nowMs = Date.now();
      for (const lm of localMsgs) {
        if (!lm || !lm.text) continue;
        const key = getMessageUniqueKey(lm);
        if (mapById.has(key)) {
          const srv = mapById.get(key);
          // If this message is still actively waiting for a real 433.875 MHz RF receipt (EVW|MACK), keep status as 'pending'
          const isStillWaitingRfAck = Boolean(
            lm.status === 'pending' &&
            window.evakwarLoraClient &&
            window.evakwarLoraClient._pendingChatArq &&
            window.evakwarLoraClient._pendingChatArq.has(key)
          );
          const mergedStatus = isStillWaitingRfAck ? 'pending' : (lm.status === 'failed' ? 'failed' : 'delivered');
          mapById.set(key, Object.assign({}, lm, srv, { status: mergedStatus, syncedToDb: true }));
        } else {
          if (isFromServer) {
            // Keep pending OR unsynced offline LoRa messages so they are never lost before syncing to DB
            if (lm.status === 'pending' || lm.syncedToDb === false || !lm.seq) {
              mapById.set(key, lm);
            }
          } else {
            // Offline mode (no server connection): preserve cached local messages
            const age = nowMs - getNormalizedTimestampMs(lm);
            if (age < 86400000 || lm.status === 'pending' || lm.syncedToDb === false) {
              mapById.set(key, lm);
            }
          }
        }
      }

      // Build conversation insertion / arrival order map
      const orderMap = new Map();
      let orderCounter = 0;
      for (const lm of localMsgs) {
        if (!lm || !lm.text) continue;
        const k = getMessageUniqueKey(lm);
        if (!orderMap.has(k)) orderMap.set(k, orderCounter++);
      }
      for (const sm of srvList) {
        if (!sm || !sm.text) continue;
        const k = getMessageUniqueKey(sm);
        if (!orderMap.has(k)) orderMap.set(k, orderCounter++);
      }

      allMessages = Array.from(mapById.values()).sort((a, b) => {
        const keyA = getMessageUniqueKey(a);
        const keyB = getMessageUniqueKey(b);
        const hasSeqA = (typeof a.seq === 'number' && a.seq > 0);
        const hasSeqB = (typeof b.seq === 'number' && b.seq > 0);

        // Rule 1: If both messages have monotonic server sequence numbers, sort by sequence
        if (hasSeqA && hasSeqB) {
          return a.seq - b.seq;
        }

        // Rule 2: Strictly preserve conversation arrival / insertion order!
        // Never sort by device clock timestamps (PC clock vs Mobile clock differences cause jumping).
        // Never place seq before non-seq (offline LoRa messages do not have sequence numbers yet).
        const ordA = orderMap.has(keyA) ? orderMap.get(keyA) : 999999;
        const ordB = orderMap.has(keyB) ? orderMap.get(keyB) : 999999;
        return ordA - ordB;
      });

      if (allMessages.length === 0) {
        saveLocalCachedMessages([]);
        messagesListEl.innerHTML = `
          <div class="flex flex-col items-center justify-center py-12 text-center text-slate-400">
            <i class="ph ph-chats-circle text-4xl text-slate-300 mb-2"></i>
            <p class="text-xs font-bold text-slate-500">No messages yet</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Start a fresh 433.875 MHz LoRa Mesh conversation below.</p>
          </div>
        `;
        renderedMsgIds.clear();
        return;
      }

      saveLocalCachedMessages(allMessages);

      // Check if message count or keys/order changed before resetting DOM
      const currentKeys = allMessages.map(m => getMessageUniqueKey(m));
      const renderedElements = Array.from(messagesListEl.querySelectorAll('.chat-bubble-wrapper'));
      const renderedKeys = renderedElements.map(el => el.getAttribute('data-msg-key'));

      let needsReorder = (currentKeys.length !== renderedKeys.length);
      if (!needsReorder) {
        for (let i = 0; i < currentKeys.length; i++) {
          if (currentKeys[i] !== renderedKeys[i]) {
            needsReorder = true;
            break;
          }
        }
      }

      if (needsReorder) {
        const wasAtBottom = (messagesListEl.scrollHeight - messagesListEl.scrollTop - messagesListEl.clientHeight) < 120;
        messagesListEl.innerHTML = '';
        renderedMsgIds.clear();
        allMessages.forEach(m => renderMessageBubble(m, false));
        if (forceScrollToBottom || wasAtBottom || renderedKeys.length === 0) {
          messagesListEl.scrollTop = messagesListEl.scrollHeight;
        }
      } else {
        allMessages.forEach(m => {
          const k = getMessageUniqueKey(m);
          const el = document.getElementById(`chat_msg_${k}`);
          if (el) updateMessageStatusInDom(el, m);
        });
        if (forceScrollToBottom) {
          messagesListEl.scrollTop = messagesListEl.scrollHeight;
        }
      }
    }

    // 100% PURE OFFLINE LORA CHAT: Never fetch, archive, or deliver chat messages over Wi-Fi / internet.
    async function fetchChatHistory() {
      updateTransportUi();
      mergeAndRenderMessages(null, (renderedMsgIds.size === 0));
    }

    function handleSendMessage(rawText, existingMsgId = null) {
      const cleanText = String(rawText || '').trim();
      if (!cleanText) return false;

      resolveActiveIdentity();
      const lora = window.evakwarLoraClient;
      const isNativeBle = Boolean(typeof window !== 'undefined' && window.AndroidBleBridge && typeof window.AndroidBleBridge.isConnected === 'function' && window.AndroidBleBridge.isConnected());
      const isLoraConnected = isNativeBle || Boolean(lora && lora.connected && (lora.transport === 'BLE' || lora.transport === 'USB_SERIAL' || lora.transport === 'ESP_WIFI'));
      const isAdminRole = Boolean(SERVER_ROLE === 'Admin');
      // STRICTLY DIRECT LORA HARDWARE ONLY (even Admin must use USB LoRa / BLE — never Wi-Fi!)
      const canLoRa = isLoraConnected;

      // STRICTLY LORA ONLY: If not connected to LoRa, show the message clearly as "Not Sent" so user can tap to retry once connected!
      if (!canLoRa) {
        const failedId = existingMsgId || (String(Date.now()).slice(-6) + String(Math.floor(Math.random() * 90 + 10)));
        const nowMs = Date.now();
        const failedMsg = {
          id: failedId,
          msgId: failedId,
          seq: null,
          senderRole: currentRole,
          senderName: currentName,
          text: cleanText,
          message: cleanText,
          timestamp: nowMs,
          sent_at: new Date(nowMs).toISOString(),
          created_at: new Date(nowMs).toISOString(),
          transport: 'OFFLINE',
          status: 'failed',
          syncedToDb: false
        };
        renderMessageBubble(failedMsg, true);
        if (messagesListEl) messagesListEl.scrollTop = messagesListEl.scrollHeight;
        const cached = getLocalCachedMessages();
        const exIdx = cached.findIndex(m => getMessageUniqueKey(m) === failedId);
        if (exIdx >= 0) cached[exIdx] = failedMsg;
        else cached.push(failedMsg);
        saveLocalCachedMessages(cached);

        const msg = isAdminRole
          ? 'Not Sent — Connect your USB LoRa Gateway (COM port) first, then tap the message to retry.'
          : 'Not Sent — Connect your LoRa node via Bluetooth first, then tap the message to retry.';
        if (typeof window.EvacWarToast === 'function') {
          window.EvacWarToast(msg, 'warning');
        }
        return true;
      }

      const msgId = existingMsgId || (String(Date.now()).slice(-6) + String(Math.floor(Math.random() * 90 + 10)));
      const nowMs = Date.now();
      const nowIso = new Date(nowMs).toISOString();

      const newMsg = {
        id: msgId,
        msgId: msgId,
        seq: null,
        senderRole: currentRole,
        senderName: currentName,
        text: cleanText,
        message: cleanText,
        timestamp: nowMs,
        sent_at: nowIso,
        created_at: nowIso,
        transport: 'LORA_433MHZ',
        status: 'pending'
      };

      // Instant optimistic rendering in 0ms
      renderMessageBubble(newMsg, true);
      if (messagesListEl) messagesListEl.scrollTop = messagesListEl.scrollHeight;
      const cached = getLocalCachedMessages();
      const existingIdx = cached.findIndex(m => getMessageUniqueKey(m) === msgId);
      if (existingIdx >= 0) cached[existingIdx] = newMsg;
      else cached.push(newMsg);
      saveLocalCachedMessages(cached);

      // Register self-sent ID immediately so sender is never self-notified
      if (window.AndroidBleBridge && typeof window.AndroidBleBridge.markMessageSentBySelf === 'function') {
        try { window.AndroidBleBridge.markMessageSentBySelf(msgId); } catch (_) {}
      }

      const tasks = [];

      // A. 433.875 MHz RF LoRa Transmission (Direct radio mesh ONLY)
      if (isLoraConnected) {
        if (lora && typeof lora.sendChatMessage === 'function') {
          tasks.push(
            lora.sendChatMessage({
              msgId: msgId,
              senderRole: currentRole,
              senderName: currentName,
              text: cleanText
            }).then(() => {
              newMsg.transport = 'LORA_433MHZ';
              // Stay in "Sending..." until real EVW|MACK RF delivery receipt arrives (or flips to Not Sent after 4 retries)
              const alreadyAcked = Boolean(lora._ackedChatIds && lora._ackedChatIds.has(msgId));
              newMsg.status = alreadyAcked ? 'delivered' : 'pending';
              newMsg.syncedToDb = false;
            }).catch(rfErr => {
              console.warn('[LoRaChat] RF transmit error:', rfErr.message);
              newMsg.transport = 'OFFLINE';
              newMsg.status = 'failed';
              if (typeof window.EvacWarToast === 'function') {
                window.EvacWarToast(rfErr.message || 'LoRa transmission failed. Check your LoRa connection.', 'warning');
              }
            })
          );
        } else if (isNativeBle && typeof window.AndroidBleBridge.writeHex === 'function') {
          try {
            const senderNodeId = (window.loraMesh && typeof window.loraMesh.getResolvedNodeId === 'function')
              ? window.loraMesh.getResolvedNodeId(currentRole)
              : ((currentRole.toLowerCase().includes('admin')) ? '!d88b1a58' : '');
            const rawPacket = `EVW|MSG|${msgId}|${currentRole}|${currentName}|${senderNodeId}|${Math.floor(Date.now() / 1000)}|${cleanText}`;
            if (typeof encodeMeshtasticTextToRadio === 'function') {
              const protoBytes = encodeMeshtasticTextToRadio(rawPacket);
              window.AndroidBleBridge.writeHex(bytesToHex(protoBytes));
            }
            newMsg.transport = 'LORA_433MHZ';
            newMsg.status = 'sent';
          } catch (_e) {
            newMsg.transport = 'OFFLINE';
            newMsg.status = 'failed';
          }
        }
      } else if (isAdminRole && isGatewayActive) {
        // Admin Hall Gateway COM3 LoRa transmission
        const hallBase = getHallServerUrl();
        const primaryUrl = (hallBase && !hallBase.includes('localhost') && window.location.origin !== hallBase)
          ? `${hallBase}/api/lora/chat`
          : '/api/lora/chat';
        tasks.push(
          fetch(primaryUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              msgId: msgId,
              senderRole: currentRole,
              senderName: currentName,
              text: cleanText,
              viaLoRa: true,
              isOfflineLora: true
            })
          }).then(async res => {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const resData = await res.json().catch(() => null);
            if (resData && resData.chatMessage) {
              const srv = resData.chatMessage;
              newMsg.seq = srv.seq || newMsg.seq;
              newMsg.timestamp = srv.timestamp || newMsg.timestamp;
            }
            newMsg.transport = 'LORA_433MHZ';
            newMsg.status = 'sent';
          }).catch(() => {
            newMsg.transport = 'OFFLINE';
            newMsg.status = 'failed';
          })
        );
      }

      Promise.allSettled(tasks).then(() => {
        const el = document.getElementById(`chat_msg_${msgId}`);
        if (el) updateMessageStatusInDom(el, newMsg);
        // Re-read latest localStorage so concurrent sent/received messages are NEVER wiped out!
        const latestCached = getLocalCachedMessages();
        const idx = latestCached.findIndex(m => getMessageUniqueKey(m) === msgId);
        if (idx >= 0) latestCached[idx] = Object.assign({}, latestCached[idx], newMsg);
        else latestCached.push(newMsg);
        saveLocalCachedMessages(latestCached);
      });
      return true;
    }

    function retryMessage(msg) {
      if (!msg) return;
      msg.status = 'pending';
      renderMessageBubble(msg, false);
      handleSendMessage(msg.text, msg.msgId || msg.id);
    }

    function submitCurrentMessage() {
      if (!chatInputEl) return;
      const val = chatInputEl.value;
      if (!val || !val.trim()) return;
      const sent = handleSendMessage(val);
      if (sent) {
        chatInputEl.value = '';
      }
    }

    if (chatFormEl) {
      chatFormEl.addEventListener('submit', function (e) {
        e.preventDefault();
        e.stopPropagation();
        submitCurrentMessage();
      });
    }

    const sendBtnEl = document.getElementById('loraChatSendBtn');
    if (sendBtnEl) {
      sendBtnEl.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        submitCurrentMessage();
      });
      sendBtnEl.addEventListener('touchend', function (e) {
        e.preventDefault();
        e.stopPropagation();
        submitCurrentMessage();
      });
    }

    if (chatInputEl) {
      chatInputEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          e.stopPropagation();
          submitCurrentMessage();
        }
      });
    }

    document.querySelectorAll('.lora-quick-chip').forEach(btn => {
      btn.addEventListener('click', function () {
        const preset = this.getAttribute('data-quick-msg');
        if (preset) {
          handleSendMessage(preset);
        }
      });
    });

    if (refreshBtn) {
      refreshBtn.addEventListener('click', function () {
        const icon = document.getElementById('refreshLoraChatIcon');
        if (icon) icon.classList.add('animate-spin');
        refreshBtn.disabled = true;
        try {
          if (window.evakwarLoraClient && typeof window.evakwarLoraClient._drainSerialBuffer === 'function') {
            window.evakwarLoraClient._drainSerialBuffer();
          }
        } catch (_) {}
        window.location.reload();
      });
    }

    // Listen for real 433.875 MHz RF Delivery Receipt (EVW|MACK|<msgId>) -> flip bubble to "Delivered"
    window.addEventListener('evakwar:lora-chat-ack', function (ev) {
      const ackId = ev && ev.detail && ev.detail.msgId ? String(ev.detail.msgId) : '';
      if (!ackId) return;
      const latestCached = getLocalCachedMessages();
      const idx = latestCached.findIndex(m => getMessageUniqueKey(m) === ackId);
      if (idx >= 0) {
        latestCached[idx].status = 'delivered';
        saveLocalCachedMessages(latestCached);
        const el = document.getElementById(`chat_msg_${ackId}`);
        if (el) updateMessageStatusInDom(el, latestCached[idx]);
      }
    });

    // Listen for ARQ retry exhaustion (0 ACKs after 4 RF attempts) -> flip bubble to red "Not Sent · Tap to retry"
    window.addEventListener('evakwar:lora-chat-failed', function (ev) {
      const failId = ev && ev.detail && ev.detail.msgId ? String(ev.detail.msgId) : '';
      if (!failId) return;
      const latestCached = getLocalCachedMessages();
      const idx = latestCached.findIndex(m => getMessageUniqueKey(m) === failId);
      if (idx >= 0 && latestCached[idx].status !== 'delivered') {
        latestCached[idx].status = 'failed';
        saveLocalCachedMessages(latestCached);
        const el = document.getElementById(`chat_msg_${failId}`);
        if (el) updateMessageStatusInDom(el, latestCached[idx]);
      }
    });

    // Listen for inbound 433.875 MHz LoRa chat packets (instant render + auto-scroll, 100% pure LoRa RF — zero Wi-Fi!)
    window.addEventListener('evakwar:lora-chat', function (ev) {
      if (ev && ev.detail) {
        const loraMsg = Object.assign({}, ev.detail, { status: 'delivered', syncedToDb: false });
        const cached = getLocalCachedMessages();
        const key = getMessageUniqueKey(loraMsg);
        const idx = cached.findIndex(m => getMessageUniqueKey(m) === key);
        if (idx >= 0) cached[idx] = Object.assign({}, cached[idx], loraMsg);
        else cached.push(loraMsg);
        saveLocalCachedMessages(cached);
        mergeAndRenderMessages(null, true);
      }
    });

    // Clear unread red dot on bottom nav when entering chat
    try {
      localStorage.removeItem('evw_chat_has_unread');
      if (window.AndroidBleBridge && typeof window.AndroidBleBridge.clearUnreadChat === 'function') {
        try { window.AndroidBleBridge.clearUnreadChat(); } catch (_) {}
      }
      document.querySelectorAll('.chat-nav-red-dot').forEach(d => d.classList.add('hidden'));
    } catch (_) {}

    // Tell Android BLE bridge chat is open in foreground (suppresses noisy notification banners)
    if (window.AndroidBleBridge && typeof window.AndroidBleBridge.setChatOpen === 'function') {
      try { window.AndroidBleBridge.setChatOpen(true); } catch (_) {}
    }
    window.addEventListener('beforeunload', function () {
      if (window.AndroidBleBridge && typeof window.AndroidBleBridge.setChatOpen === 'function') {
        try { window.AndroidBleBridge.setChatOpen(false); } catch (_) {}
      }
    });
    document.addEventListener('visibilitychange', function () {
      if (window.AndroidBleBridge && typeof window.AndroidBleBridge.setChatOpen === 'function') {
        try { window.AndroidBleBridge.setChatOpen(document.visibilityState === 'visible'); } catch (_) {}
      }
    });

    // Update status when LoRa hardware connects/disconnects (no Wi-Fi polling!)
    if (window.evakwarLoraClient && typeof window.evakwarLoraClient.on === 'function') {
      window.evakwarLoraClient.on('status', updateTransportUi);
    }
    window.addEventListener('online', updateTransportUi);
    window.addEventListener('offline', updateTransportUi);

    fetchChatHistory();
  })();
</script>
