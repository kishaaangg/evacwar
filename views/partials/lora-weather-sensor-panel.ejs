<%
  const _isAdminWeatherRole = (typeof user !== 'undefined' && user && user.role === 'admin');
  const _paneClass = _isAdminWeatherRole
    ? 'w-full max-w-[1800px] mx-auto px-2 sm:px-3 lg:px-4 pb-6 font-sans'
    : 'hidden w-full flex-1 min-h-0 overflow-y-auto bg-slate-50 text-slate-900 p-3 sm:p-5 pb-24 lg:pb-8 font-sans';
%>
<!-- MINIMALIST LORA SENSOR TELEMETRY PANEL (AHT20 + BMP280 ONLY) -->
<section id="loraSensorWeatherPane" data-inline-always="<%= _isAdminWeatherRole ? 'true' : 'false' %>" class="<%= _paneClass %>">
  <div class="<%= _isAdminWeatherRole ? 'space-y-3' : 'max-w-4xl mx-auto space-y-3' %>">

    <!-- Minimalist Header Bar -->
    <div class="bg-white border border-slate-200/90 rounded-2xl p-3.5 sm:p-4 shadow-xs flex flex-wrap items-center justify-between gap-2.5">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-xl bg-blue-50 border border-blue-200/70 text-blue-600 flex items-center justify-center text-lg shrink-0">
          <i class="ph ph-broadcast"></i>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-sm sm:text-base font-bold text-slate-900 tracking-tight">LoRa Weather Sensor</h2>
            <span id="lwsSourceBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-rose-50 text-rose-700 border border-rose-200">
              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
              <span>Offline</span>
            </span>
          </div>
          <p class="text-[11px] font-mono text-slate-400 truncate">
            <span id="lwsNodeId">!0f778ab0</span> &bull; AHT20 + BMP280
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="text-right">
          <div class="text-[10px] uppercase font-bold text-slate-400" id="lwsUpdatedLabel">Updated</div>
          <div id="lwsUpdatedAt" class="text-xs font-mono font-bold text-slate-700">--</div>
        </div>
        <button type="button" onclick="window.evwRefreshSensorWeather(this)"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-xs font-bold transition-colors cursor-pointer">
          <i class="ph ph-arrows-clockwise" id="lwsRefreshIcon"></i>
          <span>Refresh</span>
        </button>
      </div>
    </div>

    <!-- Offline State Card (Shown when Relay is OFFLINE - hides all sensor values) -->
    <div id="lwsOfflineStateBox" class="bg-white border border-slate-200/90 rounded-2xl p-8 text-center shadow-xs">
      <div class="w-11 h-11 rounded-2xl bg-rose-50 border border-rose-200 text-rose-500 flex items-center justify-center text-xl mx-auto mb-2.5">
        <i class="ph ph-wifi-slash"></i>
      </div>
      <div class="text-sm font-bold text-slate-800">Relay Offline</div>
      <div class="text-xs text-slate-400 mt-0.5">No live sensor data available</div>
    </div>

    <!-- Minimalist 4-Card Sensor Data Grid (Hidden when Relay is OFFLINE) -->
    <div id="lwsLiveDataGrid" class="hidden grid grid-cols-2 lg:grid-cols-4 gap-3">

      <!-- Weather Icon & Short Condition (Derived from Sensor Data) -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs flex items-center gap-3.5">
        <div id="lwsSkyIconBox" class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-200/70 text-amber-500 flex items-center justify-center text-3xl shrink-0">
          <i id="lwsSkyIcon" class="ph ph-sun"></i>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Sky</div>
          <div id="lwsSkyLabel" class="text-lg sm:text-xl font-black text-slate-900 truncate">--</div>
        </div>
      </div>

      <!-- Temperature (AHT20 / BMP280) -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs">
        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <span>Temperature</span>
          <i class="ph ph-thermometer-hot text-orange-500 text-base"></i>
        </div>
        <div class="mt-2.5 flex items-baseline gap-1">
          <span id="lwsTempValue" class="text-3xl sm:text-4xl font-black font-mono text-slate-900">--</span>
          <span class="text-sm font-bold text-slate-400">°C</span>
        </div>
      </div>

      <!-- Humidity (AHT20) -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs">
        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <span>Humidity</span>
          <i class="ph ph-drop-half-bottom text-cyan-500 text-base"></i>
        </div>
        <div class="mt-2.5 flex items-baseline gap-1">
          <span id="lwsHumidityValue" class="text-3xl sm:text-4xl font-black font-mono text-slate-900">--</span>
          <span class="text-sm font-bold text-slate-400">%</span>
        </div>
      </div>

      <!-- Barometric Pressure (BMP280) -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs">
        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 uppercase tracking-wider">
          <span>Pressure</span>
          <i class="ph ph-gauge text-indigo-500 text-base"></i>
        </div>
        <div class="mt-2.5 flex items-baseline gap-1">
          <span id="lwsPressureValue" class="text-3xl sm:text-4xl font-black font-mono text-slate-900">--</span>
          <span class="text-sm font-bold text-slate-400">hPa</span>
        </div>
      </div>

    </div>

    <!-- Minimalist Sensor Logs Table (Hidden when Relay is OFFLINE) -->
    <div id="lwsLiveHistoryCard" class="hidden bg-white border border-slate-200/90 rounded-2xl p-3.5 sm:p-4 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Recent Logs</span>
        <span class="text-[11px] font-mono text-slate-400" id="lwsSignalMeta">--</span>
      </div>
      <div class="overflow-x-auto max-h-56 overflow-y-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-slate-200 text-[10px] uppercase tracking-wider text-slate-400">
              <th class="py-2 pr-3">Time</th>
              <th class="py-2 pr-3">Temp</th>
              <th class="py-2 pr-3">Humidity</th>
              <th class="py-2">Pressure</th>
            </tr>
          </thead>
          <tbody id="lwsHistoryBody" class="divide-y divide-slate-100 text-slate-700 font-mono">
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    'use strict';

    function fmtManila(val) {
      if (!val) return '--';
      const d = new Date(val);
      if (isNaN(d.getTime())) return '--';
      return d.toLocaleString('en-US', {
        month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true
      });
    }

    function renderSensorDashboard(payload) {
      const state = payload || {};
      let rawCurrent = state.current || null;
      let hist = Array.isArray(state.history) ? state.history : null;

      if (!rawCurrent) {
        try { rawCurrent = JSON.parse(localStorage.getItem('evw_lora_sensor_weather') || 'null'); } catch (_) {}
      }
      if (!hist) {
        try { hist = JSON.parse(localStorage.getItem('evw_lora_sensor_history') || '[]') || []; } catch (_) { hist = []; }
      }

      const refNowMs = Number(state.serverNowMs) || Date.now();
      const readingTsMs = rawCurrent ? (Number(rawCurrent.timestampMs) || new Date(rawCurrent.updatedAt || 0).getTime() || 0) : 0;
      const ageMs = readingTsMs > 0 ? Math.max(0, refNowMs - readingTsMs) : 999999999;
      const isRelayOnline = (typeof state.relayOnline === 'boolean')
        ? state.relayOnline
        : Boolean(rawCurrent && !rawCurrent.i2cBusWarning && readingTsMs > 0 && ageMs <= 150000);

      const pillTempEl = document.getElementById('weatherToggleSensorTemp');
      if (pillTempEl) {
        if (isRelayOnline && rawCurrent && rawCurrent.temperature != null) {
          pillTempEl.textContent = `🟢 ${Number(rawCurrent.temperature).toFixed(1)}°C`;
        } else {
          pillTempEl.textContent = '🔴 Offline';
        }
      }

      const setTxt = (id, txt) => {
        const el = document.getElementById(id);
        if (el) el.textContent = txt;
      };

      const srcBadge = document.getElementById('lwsSourceBadge');
      const offlineBox = document.getElementById('lwsOfflineStateBox');
      const liveGrid = document.getElementById('lwsLiveDataGrid');
      const liveHist = document.getElementById('lwsLiveHistoryCard');

      if (!isRelayOnline || !rawCurrent) {
        if (srcBadge) {
          srcBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-rose-50 text-rose-700 border border-rose-200';
          srcBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500"></span><span>Offline</span>`;
        }
        setTxt('lwsUpdatedLabel', 'Status');
        setTxt('lwsUpdatedAt', 'Offline');
        setTxt('lwsTempValue', '--');
        setTxt('lwsHumidityValue', '--');
        setTxt('lwsPressureValue', '--');
        if (offlineBox) offlineBox.classList.remove('hidden');
        if (liveGrid) liveGrid.classList.add('hidden');
        if (liveHist) liveHist.classList.add('hidden');
        return;
      }

      // Relay is ONLINE -> show minimalist sensor data only
      if (srcBadge) {
        srcBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-50 text-emerald-700 border border-emerald-200';
        srcBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span>Online</span>`;
      }
      if (offlineBox) offlineBox.classList.add('hidden');
      if (liveGrid) liveGrid.classList.remove('hidden');
      if (liveHist) liveHist.classList.remove('hidden');

      setTxt('lwsUpdatedLabel', 'Updated');
      setTxt('lwsUpdatedAt', fmtManila(rawCurrent.updatedAt || rawCurrent.timestampMs));
      setTxt('lwsNodeId', rawCurrent.nodeId || '!0f778ab0');

      setTxt('lwsTempValue', rawCurrent.temperature != null ? Number(rawCurrent.temperature).toFixed(1) : '--');
      setTxt('lwsHumidityValue', rawCurrent.humidity != null ? Number(rawCurrent.humidity).toFixed(1) : '--');
      setTxt('lwsPressureValue', rawCurrent.pressure != null ? Number(rawCurrent.pressure).toFixed(1) : '--');

      // Minimalist sky icon + 1-word label strictly derived from live AHT20 + BMP280 readings
      const tVal = rawCurrent.temperature != null ? Number(rawCurrent.temperature) : null;
      const hVal = rawCurrent.humidity != null ? Number(rawCurrent.humidity) : null;
      const pVal = rawCurrent.pressure != null ? Number(rawCurrent.pressure) : null;
      let sky = { label: 'Fair', icon: 'ph-cloud-sun', box: 'bg-sky-50 border-sky-200/70 text-sky-500' };
      if (pVal != null && pVal < 1002) {
        sky = { label: 'Stormy', icon: 'ph-cloud-lightning', box: 'bg-rose-50 border-rose-200/70 text-rose-500' };
      } else if (pVal != null && pVal < 1007) {
        sky = { label: 'Windy', icon: 'ph-wind', box: 'bg-indigo-50 border-indigo-200/70 text-indigo-500' };
      } else if ((pVal != null && pVal < 1011) || (hVal != null && hVal >= 85)) {
        sky = { label: 'Rainy', icon: 'ph-cloud-rain', box: 'bg-blue-50 border-blue-200/70 text-blue-600' };
      } else if (hVal != null && hVal >= 78) {
        sky = { label: 'Cloudy', icon: 'ph-cloud', box: 'bg-slate-100 border-slate-200 text-slate-500' };
      } else if (tVal != null && tVal >= 30 && (hVal == null || hVal < 75)) {
        sky = { label: 'Sunny', icon: 'ph-sun', box: 'bg-amber-50 border-amber-200/70 text-amber-500' };
      }
      const skyBox = document.getElementById('lwsSkyIconBox');
      const skyIcon = document.getElementById('lwsSkyIcon');
      if (skyBox) skyBox.className = `w-12 h-12 rounded-2xl border flex items-center justify-center text-3xl shrink-0 ${sky.box}`;
      if (skyIcon) skyIcon.className = `ph ${sky.icon}`;
      setTxt('lwsSkyLabel', sky.label);

      const sigParts = [];
      if (rawCurrent.rssi != null) sigParts.push(`${rawCurrent.rssi} dBm`);
      if (rawCurrent.snr != null) sigParts.push(`SNR ${rawCurrent.snr} dB`);
      setTxt('lwsSignalMeta', sigParts.join(' • ') || '433.875 MHz');

      const body = document.getElementById('lwsHistoryBody');
      if (body) {
        if (!hist || hist.length === 0) {
          body.innerHTML = `<tr><td colspan="4" class="py-4 text-center text-slate-400 font-sans">--</td></tr>`;
        } else {
          body.innerHTML = hist.slice(0, 15).map((item) => `
            <tr class="hover:bg-slate-50">
              <td class="py-2 pr-3 text-[11px] text-slate-500 whitespace-nowrap">${fmtManila(item.updatedAt || item.timestampMs)}</td>
              <td class="py-2 pr-3 font-bold text-slate-900">${item.temperature != null ? Number(item.temperature).toFixed(1) + '°C' : '--'}</td>
              <td class="py-2 pr-3 text-cyan-700 font-semibold">${item.humidity != null ? Number(item.humidity).toFixed(1) + '%' : '--'}</td>
              <td class="py-2 text-indigo-700 font-semibold">${item.pressure != null ? Number(item.pressure).toFixed(1) + ' hPa' : '--'}</td>
            </tr>
          `).join('');
        }
      }
    }

    window.evwSwitchWeatherView = function (mode) {
      const sensorPane = document.getElementById('loraSensorWeatherPane');
      if (sensorPane && sensorPane.getAttribute('data-inline-always') === 'true') {
        renderSensorDashboard();
        return;
      }

      const target = mode === 'sensor' ? 'sensor' : 'viz';
      const vizPane = document.getElementById('weatherVisualizationPane');
      const btnViz = document.getElementById('btnSwitchWeatherViz');
      const btnSensor = document.getElementById('btnSwitchWeatherSensor');

      if (vizPane) vizPane.classList.toggle('hidden', target === 'sensor');
      if (sensorPane) sensorPane.classList.toggle('hidden', target !== 'sensor');

      if (btnViz && btnSensor) {
        const activeCls = 'bg-blue-600 text-white border-blue-600 shadow-xs';
        const inactiveCls = 'bg-slate-100 text-slate-700 hover:bg-slate-200 border-slate-200';
        btnViz.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer ' + (target === 'viz' ? activeCls : inactiveCls);
        btnSensor.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer ' + (target === 'sensor' ? activeCls : inactiveCls);
      }

      if (target === 'sensor') {
        renderSensorDashboard();
        if (window.evakwarLoraClient && typeof window.evakwarLoraClient.requestRelayWeatherTelemetry === 'function') {
          window.evakwarLoraClient.requestRelayWeatherTelemetry().catch(() => {});
        }
      }
    };

    window.evwRefreshSensorWeather = async function (btn) {
      const icon = document.getElementById('lwsRefreshIcon');
      if (icon) icon.classList.add('animate-spin');
      if (btn) btn.disabled = true;
      try {
        if (window.evakwarLoraClient && typeof window.evakwarLoraClient.requestRelayWeatherTelemetry === 'function') {
          window.evakwarLoraClient.requestRelayWeatherTelemetry().catch(() => {});
        }

        if (navigator.onLine) {
          const base = (localStorage.getItem('evw_server_url') || '').replace(/\/$/, '');
          const apiBase = (window.location.protocol === 'http:' || window.location.protocol === 'https:') && window.location.hostname !== 'localhost'
            ? ''
            : (base || 'https://evacwar.onrender.com');
          const res = await fetch(`${apiBase}/api/lora/weather-sensor`, { cache: 'no-store' });
          const data = await res.json();
          if (data && data.success) {
            if (data.relayOnline && data.current) {
              localStorage.setItem('evw_lora_sensor_weather', JSON.stringify(data.current));
              if (Array.isArray(data.history)) {
                localStorage.setItem('evw_lora_sensor_history', JSON.stringify(data.history));
              }
              renderSensorDashboard(data);
            } else {
              // Relay is offline on server -> check if we received a fresh direct RF packet locally within 2.5 minutes
              let localCur = null;
              try { localCur = JSON.parse(localStorage.getItem('evw_lora_sensor_weather') || 'null'); } catch (_) {}
              const localTs = (localCur && localCur.timestampMs) || 0;
              if (localCur && !localCur.i2cBusWarning && localTs > 0 && (Date.now() - localTs) <= 150000) {
                renderSensorDashboard({ relayOnline: true, current: localCur, history: data.history || [] });
              } else {
                renderSensorDashboard({ relayOnline: false, current: null, history: [] });
              }
            }
          }
        } else {
          renderSensorDashboard();
        }
      } catch (_) {
        renderSensorDashboard();
      } finally {
        if (icon) icon.classList.remove('animate-spin');
        if (btn) btn.disabled = false;
      }
    };

    window.addEventListener('evakwar:lora-weather', (ev) => {
      if (ev && ev.detail) {
        renderSensorDashboard({ current: ev.detail });
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const sensorPane = document.getElementById('loraSensorWeatherPane');
      const isInlineAlways = sensorPane && sensorPane.getAttribute('data-inline-always') === 'true';
      if (!isInlineAlways) {
        const params = new URLSearchParams(window.location.search || '');
        window.evwSwitchWeatherView(params.get('view') === 'sensor' ? 'sensor' : 'viz');
      }
      window.evwRefreshSensorWeather();
      setInterval(() => {
        if (navigator.onLine) window.evwRefreshSensorWeather();
        else renderSensorDashboard();
      }, 20000);
    });
  })();
</script>
