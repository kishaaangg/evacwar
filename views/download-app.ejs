<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Download EvakWar Mobile App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css">
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col items-center justify-center p-4">
  <div class="max-w-md w-full bg-slate-800/90 backdrop-blur-xl border border-slate-700/80 rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col items-center text-center">
    
    <!-- App Icon -->
    <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/30 mb-5 ring-4 ring-blue-500/20">
      <i class="ph-fill ph-broadcast text-4xl text-white"></i>
    </div>

    <!-- Title & Subtitle -->
    <h1 class="text-2xl font-black tracking-tight text-white mb-1">EvakWar Android APK</h1>
    <p class="text-xs font-semibold text-blue-400 uppercase tracking-widest mb-4">Official Release v2.9.7 (Build 36)</p>
    
    <!-- Info Box -->
    <div class="w-full bg-slate-900/80 border border-slate-700/60 rounded-2xl p-4 mb-6 text-left space-y-2 text-xs">
      <div class="flex items-center gap-2 text-emerald-400 font-bold">
        <i class="ph-fill ph-check-circle text-base"></i>
        <span>Universal v1 + v2 Signed APK (Android 7–15)</span>
      </div>
      <div class="flex items-center gap-2 text-emerald-400 font-bold">
        <i class="ph-fill ph-check-circle text-base"></i>
        <span>Full Offline QR Family Intake &amp; Auto-Sync</span>
      </div>
      <div class="flex items-center gap-2 text-emerald-400 font-bold">
        <i class="ph-fill ph-check-circle text-base"></i>
        <span>433MHz LoRa Mesh Chat &amp; Live SOS Rescue Map</span>
      </div>
      <div class="flex items-center gap-2 text-slate-400 pt-1 border-t border-slate-800 text-[11px]">
        <i class="ph ph-file-arrow-down text-sm"></i>
        <span>Size: ~16.2 MB · Package: ph.gov.baao.evakwar.resident</span>
      </div>
    </div>

    <!-- Instructions Notice -->
    <div class="w-full bg-amber-500/10 border border-amber-500/30 rounded-2xl p-3.5 mb-6 text-left flex items-start gap-3">
      <i class="ph-fill ph-warning-circle text-amber-400 text-lg shrink-0 mt-0.5"></i>
      <div class="text-[11.5px] leading-relaxed text-amber-200">
        <strong class="font-bold text-amber-300">Important:</strong> If an older test build is installed on your phone, please <span class="underline font-bold">uninstall the old EvakWar app first</span>, then install this release cleanly.
      </div>
    </div>

    <!-- Primary Download Button -->
    <a href="/evakwar-resident-v2.9.7.apk"
       download="evakwar-resident-v2.9.7.apk"
       class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 active:scale-95 text-white font-black text-base shadow-xl shadow-blue-600/30 flex items-center justify-center gap-2.5 transition-all">
      <i class="ph-bold ph-download-simple text-xl"></i>
      <span>Download EvakWar v2.9.7 APK</span>
    </a>

    <!-- Direct link fallback -->
    <div class="mt-4 text-[11px] text-slate-400">
      Direct Link: <a href="/evakwar-resident-v2.9.7.apk" class="text-blue-400 underline hover:text-blue-300 font-mono">/evakwar-resident-v2.9.7.apk</a>
    </div>
  </div>

  <div class="mt-6 text-slate-500 text-xs text-center font-medium">
    Barangay San Rafael · Emergency Disaster Warning &amp; Management System
  </div>
</body>
</html>
