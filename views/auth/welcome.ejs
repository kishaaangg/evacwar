<%- include('../partials/header') %>

  <main class="flex-1 flex flex-col justify-between relative w-full min-h-[calc(100vh-3.75rem)] overflow-y-auto">
    <!-- Full-screen Background Overlay -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <img loading="lazy" src="/images/sanrafael.jpg" class="w-full h-full object-cover opacity-20" alt="San Rafael Background" decoding="async" />
      <div class="absolute inset-0 bg-slate-950/65 z-0"></div>
    </div>

    <!-- CENTERED HERO SECTION -->
    <section class="relative z-10 flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16 flex flex-col items-center justify-center text-center">

      <!-- Registration Confirmation Notice (shown when redirected with ?registered=1) -->
      <div id="registerSuccess"
        class="hidden mb-6 w-full max-w-xl flex items-start gap-3 bg-amber-50/95 backdrop-blur-md border border-amber-300 text-amber-900 rounded-2xl px-4 py-3.5 text-xs sm:text-sm font-semibold shadow-lg text-left">
        <i class="ph ph-clock-counter-clockwise text-2xl text-amber-600 shrink-0 mt-0.5"></i>
        <div>
          <div class="font-extrabold text-amber-950">Registration Submitted!</div>
          <div class="text-xs text-amber-800 font-medium mt-0.5">
            Your resident account is pending verification by Barangay San Rafael staff. You can download the mobile app below while waiting for approval.
          </div>
        </div>
      </div>

      <!-- Dual Circular Logos -->
      <div class="flex items-center justify-center gap-4 sm:gap-5 mb-5">
        <div
          class="w-20 h-20 sm:w-24 sm:h-24 bg-white rounded-full p-2.5 shadow-[0_0_25px_rgba(255,255,255,0.4)] border-2 border-white/80 flex items-center justify-center shrink-0">
          <img decoding="async" src="/images/logo.png" alt="Evacwar Logo" class="w-full h-full object-contain rounded-full" />
        </div>
        <div
          class="w-20 h-20 sm:w-24 sm:h-24 bg-white rounded-full p-2.5 shadow-[0_0_25px_rgba(255,255,255,0.4)] border-2 border-white/80 flex items-center justify-center shrink-0">
          <img decoding="async" src="/images/brgy_logo.png" alt="Barangay San Rafael Logo" class="w-full h-full object-contain rounded-full" />
        </div>
      </div>

      <!-- Brand Subtitle -->
      <div class="text-2xl sm:text-3xl font-black uppercase tracking-[0.2em] text-white drop-shadow-md">
        EVACWAR
      </div>
      <p class="text-xs sm:text-sm font-bold tracking-[0.18em] uppercase text-blue-200/90 mt-1 mb-5 drop-shadow-sm">
        BARANGAY DISASTER RISK REDUCTION
      </p>

      <!-- Main Welcome Headline -->
      <div class="text-4xl sm:text-6xl md:text-7xl font-black text-[#FFD700] tracking-tight leading-none drop-shadow-[0_4px_8px_rgba(0,0,0,0.5)]">
        WELCOME KABARANGAY
      </div>

      <!-- Short, Clean Description -->
      <p class="mt-4 text-sm sm:text-base text-slate-200 font-medium max-w-xl leading-relaxed drop-shadow-sm">
        Keeping Barangay San Rafael informed, prepared, and connected with real-time alerts, evacuation guidance, and emergency response.
      </p>

      <!-- Primary CTA Button -->
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3.5">
        <a href="/evakwar-resident-v2.apk" download="evakwar-resident-v2.apk"
          class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-extrabold text-sm sm:text-base shadow-xl shadow-blue-600/35 transition-all active:scale-[0.98]">
          <i class="ph ph-android-logo text-xl"></i>
          <span>Download Resident App</span>
          <i class="ph ph-download-simple text-lg"></i>
        </a>
      </div>

      <!-- Live Clock & Date -->
      <div class="mt-8 pt-5 border-t border-white/15 flex flex-col items-center">
        <div class="text-xl sm:text-2xl font-bold font-mono tracking-widest text-white drop-shadow-md" id="live-time">
          00:00:00
        </div>
        <div class="text-xs sm:text-sm font-medium text-slate-300 mt-0.5 drop-shadow-sm" id="live-date">
          Monday, January 1, 2026
        </div>
      </div>

    </section>

    <!-- CLEAN FOOTER -->
    <footer class="relative z-10 w-full bg-[#0b1329]/90 backdrop-blur-md border-t border-white/10 py-4 px-4 sm:px-8 text-slate-400 text-xs shrink-0">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
        <div class="font-semibold text-slate-300">
          &copy; <%= new Date().getFullYear() %> Evacwar &bull; Barangay San Rafael, Baao, Camarines Sur
        </div>
        <div class="flex items-center gap-4 text-[11px] font-semibold">
          <a href="/register" class="hover:text-white transition-colors">Register</a>
          <span class="text-white/20">&bull;</span>
          <a href="/evakwar-resident-v2.apk" download="evakwar-resident-v2.apk" class="hover:text-white transition-colors">Download App</a>
          <span class="text-white/20">&bull;</span>
          <a href="/login" class="hover:text-white transition-colors">Admin Portal</a>
        </div>
      </div>
    </footer>

    <script>
      (function () {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('registered') || urlParams.has('success')) {
          const successBox = document.getElementById('registerSuccess');
          if (successBox) successBox.classList.remove('hidden');
        }

        function updateClock() {
          const now = new Date();
          const timeStr = now.toLocaleTimeString('en-US', { hour12: false });
          const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
          const timeEl = document.getElementById('live-time');
          const dateEl = document.getElementById('live-date');
          if (timeEl) timeEl.textContent = timeStr;
          if (dateEl) dateEl.textContent = dateStr;
        }
        setInterval(updateClock, 1000);
        updateClock();
      })();
    </script>
  </main>

<%- include('../partials/footer') %>
