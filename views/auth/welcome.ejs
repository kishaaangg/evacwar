<%- include('../partials/header') %>

  <main
    class="flex-1 overflow-y-auto relative py-6 sm:py-12 px-3.5 sm:px-6 flex flex-col justify-center items-center min-h-0 w-full">
    <!-- Background overlay -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <img loading="lazy" src="/images/sanrafael.jpg" class="w-full h-full object-cover opacity-25" alt="San Rafael Background" decoding="async" />
      <div class="absolute inset-0 bg-slate-950/75 z-0"></div>
    </div>

    <div class="w-full max-w-5xl mx-auto my-auto z-10 relative space-y-5">

      <!-- Registration Confirmation Notice (when redirected with ?registered=1) -->
      <div id="registerSuccess"
        class="hidden flex items-start gap-3 bg-amber-50/95 backdrop-blur-md border border-amber-300 text-amber-900 rounded-2xl px-4 py-3.5 text-xs sm:text-sm font-semibold shadow-lg">
        <i class="ph ph-clock-counter-clockwise text-2xl text-amber-600 shrink-0 mt-0.5"></i>
        <div>
          <div class="font-extrabold text-amber-950">Registration Submitted!</div>
          <div class="text-xs text-amber-800 font-medium mt-0.5">
            Your resident account is pending verification and approval by Barangay San Rafael staff. Download the Evacwar Mobile App below so you are ready once approved!
          </div>
        </div>
      </div>

      <!-- Main Welcome & About Evacwar Hero Banner -->
      <section
        class="bg-slate-900/80 backdrop-blur-xl rounded-3xl sm:rounded-[2.5rem] border border-white/15 shadow-2xl p-6 sm:p-10 lg:p-12 text-white">

        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 pb-8 border-b border-white/10">
          <div class="space-y-4">
            <!-- Dual Circular Logos -->
            <div class="flex items-center gap-3.5">
              <div
                class="w-16 h-16 sm:w-20 sm:h-20 bg-white rounded-full p-2 shadow-[0_0_25px_rgba(255,255,255,0.35)] border-2 border-white/70 flex items-center justify-center shrink-0">
                <img decoding="async" src="/images/logo.png" alt="Evacwar Logo" class="w-full h-full object-contain rounded-full" />
              </div>
              <div
                class="w-16 h-16 sm:w-20 sm:h-20 bg-white rounded-full p-2 shadow-[0_0_25px_rgba(255,255,255,0.35)] border-2 border-white/70 flex items-center justify-center shrink-0">
                <img decoding="async" src="/images/brgy_logo.png" alt="Barangay San Rafael Logo" class="w-full h-full object-contain rounded-full" />
              </div>
              <div class="inline-flex items-center gap-1.5 rounded-full bg-amber-400/15 border border-amber-300/30 px-3 py-1 text-[10px] sm:text-xs font-extrabold uppercase tracking-wider text-[#FFD700]">
                <i class="ph ph-broadcast text-sm"></i>
                <span>Barangay San Rafael, Baao &bull; DRRM</span>
              </div>
            </div>

            <div>
              <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-[#FFD700] tracking-tight leading-none drop-shadow-[0_4px_4px_rgba(0,0,0,0.45)]">
                WELCOME KABARANGAY
              </h1>
              <p class="mt-2.5 text-base sm:text-xl font-bold text-white/95">
                EVACWAR: Off-Grid LoRa Mesh &amp; Disaster Response System
              </p>
              <p class="mt-2 text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
                EvakWar is Barangay San Rafael's emergency preparedness and disaster response platform. Built for typhoons, floods, and power or cellular blackouts, it connects residents, rescuers, evacuation center staff, and the Barangay Command Center using Bluetooth + 433.875 MHz LoRa Mesh technology.
              </p>
            </div>
          </div>

          <!-- Live Barangay Clock Card -->
          <div class="shrink-0 bg-white/10 border border-white/15 rounded-2xl px-5 py-4 text-left lg:text-right backdrop-blur-md">
            <div class="text-[10px] font-bold uppercase tracking-widest text-blue-300 mb-1">Local Time (PHT)</div>
            <div class="text-2xl sm:text-3xl font-black font-mono tracking-widest text-white" id="live-time">00:00:00</div>
            <div class="text-xs sm:text-sm font-medium text-slate-300 mt-0.5" id="live-date">Monday, January 1, 2023</div>
          </div>
        </div>

        <!-- All About Evacwar: 3 Feature Highlights -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-8">
          <div class="rounded-2xl bg-white/5 border border-white/10 p-4 sm:p-5 hover:bg-white/10 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-400/30 text-blue-300 flex items-center justify-center mb-3">
              <i class="ph ph-radio text-xl"></i>
            </div>
            <h3 class="font-extrabold text-sm sm:text-base text-white">433.875 MHz LoRa Mesh Network</h3>
            <p class="mt-1.5 text-xs text-slate-300 leading-relaxed">
              Send emergency SOS alerts with GPS coordinates and communicate off-grid via Bluetooth-linked LoRa nodes even when internet and cellular signal are down.
            </p>
          </div>

          <div class="rounded-2xl bg-white/5 border border-white/10 p-4 sm:p-5 hover:bg-white/10 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 flex items-center justify-center mb-3">
              <i class="ph ph-map-trifold text-xl"></i>
            </div>
            <h3 class="font-extrabold text-sm sm:text-base text-white">Live Evacuation &amp; Hazard Map</h3>
            <p class="mt-1.5 text-xs text-slate-300 leading-relaxed">
              View real-time evacuation center occupancy, safest GIS routes, weather conditions, and official PAGASA typhoon advisories across Barangay San Rafael.
            </p>
          </div>

          <div class="rounded-2xl bg-white/5 border border-white/10 p-4 sm:p-5 hover:bg-white/10 transition-colors">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400/30 text-amber-300 flex items-center justify-center mb-3">
              <i class="ph ph-qr-code text-xl"></i>
            </div>
            <h3 class="font-extrabold text-sm sm:text-base text-white">Household QR Evacuation Pass</h3>
            <p class="mt-1.5 text-xs text-slate-300 leading-relaxed">
              Speed up evacuation shelter intake, household verification, and relief goods tracking using your unique digital Barangay QR pass inside the app.
            </p>
          </div>
        </div>

        <!-- Call-To-Action Buttons: Download Resident APK + Register -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-2">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a href="/evakwar-resident-v2.apk" download="evakwar-resident-v2.apk"
              class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-extrabold text-sm sm:text-base shadow-lg shadow-blue-600/30 transition-all active:scale-[0.98]">
              <i class="ph ph-android-logo text-xl"></i>
              <span>Download Resident App (APK)</span>
              <i class="ph ph-download-simple text-lg"></i>
            </a>

            <a href="/register"
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm border border-white/20 transition-all active:scale-[0.98]">
              <i class="ph ph-user-plus text-lg text-[#FFD700]"></i>
              <span>Register Resident Account</span>
            </a>
          </div>

          <p class="text-[11px] sm:text-xs text-slate-300 font-medium text-center sm:text-right">
            Residents, Rescuers &amp; Evacuation Staff log in directly inside the mobile app.
          </p>
        </div>

      </section>
    </div>

    <script>
      (function () {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('registered') || urlParams.has('success')) {
          const successBox = document.getElementById('registerSuccess');
          if (successBox) successBox.classList.remove('hidden');
        }

        function updateClock() {
          const now = new Date();
          const timeStr = now.toLocaleTimeString('en-US', { hour12: false });
          const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
          const timeEl = document.getElementById('live-time');
          const dateEl = document.getElementById('live-date');
          if (timeEl) timeEl.textContent = timeStr;
          if (dateEl) dateEl.textContent = dateStr;
        }
        setInterval(updateClock, 1000);
        updateClock();
      })();
    </script>
  </main>

<%- include('../partials/footer') %>
