<%- include('../partials/header') %>

  <main
    class="flex-1 overflow-y-auto relative py-6 sm:py-12 px-3.5 sm:px-6 flex flex-col justify-start md:justify-center items-center min-h-0 w-full">
    <!-- Background overlay of weather -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <img loading="lazy" src="/images/sanrafael.jpg" class="w-full h-full object-cover opacity-20" alt="San Rafael Background" / decoding="async">
      <div class="absolute inset-0 bg-slate-950/60 z-0"></div>
    </div>

    <!-- Centered Standalone Admin Login Container -->
    <div
      class="w-full max-w-md mx-auto my-auto flex flex-col items-center justify-center z-10 relative">

      <!-- Admin Login Card -->
      <div
        class="w-full bg-white/95 backdrop-blur-xl rounded-3xl sm:rounded-[2.5rem] shadow-2xl p-6 sm:p-10 border border-white/60 relative z-10 transition-all">
        <div class="text-center mb-6 sm:mb-8">
          <!-- Mobile Dual Logos: Evacwar Logo & Barangay Logo (Circular) -->
          <div class="flex md:hidden items-center justify-center gap-3.5 mb-4">
            <div
              class="w-18 h-18 sm:w-20 sm:h-20 w-[72px] h-[72px] bg-white rounded-full p-2 shadow-lg shadow-blue-900/10 border border-slate-200/80 flex items-center justify-center shrink-0">
              <img decoding="async" src="/images/logo.png" alt="Evacwar Logo" class="w-full h-full object-contain rounded-full" />
            </div>
            <div
              class="w-18 h-18 sm:w-20 sm:h-20 w-[72px] h-[72px] bg-white rounded-full p-2 shadow-lg shadow-blue-900/10 border border-slate-200/80 flex items-center justify-center shrink-0">
              <img decoding="async" src="/images/brgy_logo.png" alt="Barangay San Rafael Logo"
                class="w-full h-full object-contain rounded-full" />
            </div>
          </div>

          <!-- Desktop Hero Icon -->
          <div
            class="hidden md:flex w-16 h-16 bg-blue-600 rounded-2xl items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-500/30 transform hover:scale-105 transition-transform">
            <i class="ph ph-shield-check text-3xl text-white"></i>
          </div>
          <h1 id="loginHeading" class="text-2xl sm:text-3xl font-black font-heading text-slate-900 mb-1"><%= locals.isNativeApp ? 'EvakWar Login' : 'Admin Portal Login' %></h1>
          <p id="loginSubtitle" class="text-xs sm:text-sm text-slate-500 font-medium"><%= locals.isNativeApp ? 'Sign in as Resident, Staff, or Rescuer' : 'Sign in to the Evacwar Command Center' %></p>
        </div>

        <!-- Inline success toast for registration -->
        <div id="registerSuccess"
          class="hidden mb-4 flex items-start gap-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-2xl px-4 py-3 text-xs font-semibold shadow-xs">
          <i class="ph ph-clock-counter-clockwise text-xl text-amber-600 shrink-0 mt-0.5"></i>
          <div>
            <div class="font-bold text-amber-900">Registration Submitted!</div>
            <div class="text-[11px] text-amber-700 font-medium mt-0.5">Your resident account is pending verification and approval by Barangay San Rafael staff. You will be able to log in and generate your QR evacuation pass once approved.</div>
          </div>
        </div>

        <!-- Inline error toast -->
        <div id="loginError"
          class="<%= (locals.error || locals.errorMessage) ? '' : 'hidden' %> mb-4 flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 rounded-2xl px-4 py-3 text-xs font-semibold">
          <i class="ph ph-warning-circle text-xl shrink-0"></i>
          <span id="loginErrorMsg"><%= locals.error || locals.errorMessage || 'Invalid email or password.' %></span>
        </div>

        <form id="loginForm" action="/login" method="POST" class="space-y-4 sm:space-y-5">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <div class="space-y-1.5">
            <label for="email" class="text-xs sm:text-sm font-bold text-slate-700 block ml-1">
              <i class="ph ph-user text-blue-600 mr-1"></i> Email or Mobile
            </label>
            <div class="relative">
              <input type="text" id="email" name="email" placeholder="Enter your email or mobile number"
                class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-sm rounded-2xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-3.5 pl-11 transition-all"
                required autocomplete="username">
              <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                <i class="ph ph-user text-slate-400 text-lg"></i>
              </div>
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="password" class="text-xs sm:text-sm font-bold text-slate-700 block ml-1">
              <i class="ph ph-lock-key text-blue-600 mr-1"></i>Password
            </label>
            <div class="relative">
              <input type="password" id="password" name="password" placeholder="Enter your password"
                class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-sm rounded-2xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-3.5 pl-11 pr-11 transition-all"
                required autocomplete="current-password">
              <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                <i class="ph ph-lock-key text-slate-400 text-lg"></i>
              </div>
              <button type="button" onclick="togglePasswordVisibility('password', this)"
                class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600 transition-colors"
                title="Toggle password visibility">
                <i class="ph ph-eye text-lg"></i>
              </button>
            </div>
          </div>

          <button type="submit" id="loginBtn"
            class="w-full text-white bg-blue-600 hover:bg-blue-700 active:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-500/30 font-bold rounded-2xl text-sm px-5 py-3.5 text-center shadow-lg shadow-blue-500/25 transition-all active:scale-[0.98] mt-3 flex items-center justify-center gap-2">
            <span id="loginBtnText">Sign In</span>
            <i class="ph ph-arrow-right font-bold text-base"></i>
          </button>
        </form>

        <!-- Resident Registration Link (Visible in Native Mobile App) -->
        <div id="nativeRegisterRow" class="<%= locals.isNativeApp ? '' : 'hidden' %> mt-5 pt-4 border-t border-slate-100 text-center">
          <p class="text-xs text-slate-500 font-medium">
            Don't have a resident account yet?
            <a href="/register" class="font-extrabold text-blue-600 hover:text-blue-700 underline ml-1">Register Here</a>
          </p>
        </div>

        <script>
          // Also enforce Resident/Multi-User Login branding on client if running inside Android WebView bridge
          (function () {
            const isNative = Boolean(
              typeof window.AndroidBleBridge !== 'undefined' ||
              typeof window.AndroidSettingsBridge !== 'undefined' ||
              typeof window.AndroidUsbSerialBridge !== 'undefined' ||
              (window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform()) ||
              /; wv\)/i.test(navigator.userAgent || '')
            );
            if (isNative) {
              const h = document.getElementById('loginHeading');
              const s = document.getElementById('loginSubtitle');
              const r = document.getElementById('nativeRegisterRow');
              if (h) h.textContent = 'EvakWar Login';
              if (s) s.textContent = 'Sign in as Resident, Staff, or Rescuer';
              if (r) r.classList.remove('hidden');
            }
          })();
        </script>

        <script>
          function togglePasswordVisibility(fieldId, btn) {
            const input = document.getElementById(fieldId);
            if (!input) return;
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
              input.type = 'text';
              if (icon) { icon.classList.remove('ph-eye'); icon.classList.add('ph-eye-slash'); }
            } else {
              input.type = 'password';
              if (icon) { icon.classList.remove('ph-eye-slash'); icon.classList.add('ph-eye'); }
            }
          }

          // Immediately clear any old logout flag and transient session storage
          try {
            localStorage.removeItem('evacwar_logged_out');
            sessionStorage.clear();
          } catch (_) {}

          const urlParams = new URLSearchParams(window.location.search);
          if (urlParams.has('registered') || urlParams.has('success')) {
            const successBox = document.getElementById('registerSuccess');
            if (successBox) successBox.classList.remove('hidden');
          }

          document.getElementById('loginForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('loginBtnText');
            const submitBtn = document.getElementById('loginBtn');
            const errorBox = document.getElementById('loginError');
            const errorMsg = document.getElementById('loginErrorMsg');

            errorBox.classList.add('hidden');
            submitBtn.disabled = true;
            btn.textContent = 'Signing in...';

            try {
              const formData = new FormData(this);
              const res = await fetch('/login', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/x-www-form-urlencoded',
                  'Accept': 'application/json'
                },
                body: new URLSearchParams(formData)
              });

              const data = await res.json().catch(() => null);

              if (res.ok && data && data.success && data.redirect) {
                localStorage.removeItem('evacwar_logged_out');
                btn.textContent = 'Redirecting...';
                window.location.replace(data.redirect);
                return;
              }

              errorMsg.textContent = (data && data.message) ? data.message : 'Invalid username/email or password.';
              errorBox.classList.remove('hidden');
              submitBtn.disabled = false;
              btn.textContent = 'Sign In';
            } catch (err) {
              console.error('Login submit error:', err);
              errorMsg.textContent = 'Unable to connect to server. Please try again.';
              errorBox.classList.remove('hidden');
              submitBtn.disabled = false;
              btn.textContent = 'Sign In';
            }
          });
        </script>
      </div>
    </div>

    <!-- INSTALL APPLICATION MODAL (FOR DIRECT INSTALL OR DEVICE GUIDES) -->
    <div id="modalInstallApp" class="fixed inset-0 z-[120] hidden bg-slate-900/60 backdrop-blur-xs flex flex-col items-center justify-start overflow-y-auto p-3 sm:p-6 pt-4 sm:pt-8 pb-32 sm:pb-12" onclick="if(event.target===this)closeInstallAppModal()">
      <div class="modal-content-card bg-white w-full max-w-md rounded-3xl shadow-2xl border border-slate-200 overflow-hidden my-auto animate-scale-up">
        
        <!-- Header -->
        <div class="px-5 py-4 bg-white border-b border-slate-100 text-slate-900 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-base">
              <i class="ph ph-download-simple"></i>
            </div>
            <div>
              <h3 class="font-extrabold text-sm sm:text-base leading-tight">Install Evacwar App</h3>
              <p class="text-[10px] text-slate-400">Fast Home Screen & Emergency Access</p>
            </div>
          </div>
          <button type="button" onclick="closeInstallAppModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
            <i class="ph ph-x text-base"></i>
          </button>
        </div>

        <div class="p-5 space-y-4 text-xs text-slate-600">
          <!-- Direct Install Action (Visible when prompt is active) -->
          <div id="pwa-modal-direct-install-btn" class="hidden">
            <button type="button" onclick="window.EvakWarPWA && window.EvakWarPWA.triggerInstall()" class="w-full py-3 px-4 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs shadow-md flex items-center justify-center gap-2 transition-all active:scale-95 cursor-pointer">
              <i class="ph ph-download-simple text-base"></i>
              <span>Install Evacwar to Device</span>
            </button>
            <div class="text-center text-[10px] text-slate-400 mt-1.5">Tap to install directly with one click</div>
          </div>

          <!-- Already Installed Banner -->
          <div id="pwa-modal-installed-notice" class="hidden p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 space-y-1">
            <div class="flex items-center gap-2 font-bold text-xs">
              <i class="ph ph-check-circle text-emerald-600 text-base"></i>
              <span>Evacwar is Already Installed</span>
            </div>
            <p class="text-[11px] text-emerald-700/80 leading-relaxed">
              This app is installed in standalone mode. You have fast launch access from your home screen or application list.
            </p>
          </div>

          <!-- App Benefits Summary -->
          <div class="flex items-center gap-3 bg-blue-50/70 p-3.5 rounded-2xl border border-blue-100">
            <div class="w-11 h-11 rounded-2xl bg-white p-1 shadow-xs shrink-0 flex items-center justify-center">
              <img loading="lazy" src="/icons/icon-192x192.png" alt="Evacwar" class="w-full h-full object-contain" decoding="async">
            </div>
            <div class="min-w-0">
              <h4 class="font-extrabold text-slate-900 text-xs">Faster, Offline-Ready Emergency App</h4>
              <p class="text-[11px] text-slate-500 font-medium">Instant launch, offline evacuation maps & emergency alerts</p>
            </div>
          </div>

          <!-- Platform Tabs -->
          <div>
            <div class="text-[11px] font-bold text-slate-700 mb-1.5">Select your device guide:</div>
            <div class="flex p-1 rounded-2xl bg-slate-100 border border-slate-200 gap-1">
              <button type="button" id="pwa-tab-btn-android" onclick="window.EvakWarPWA && window.EvakWarPWA.setInstallModalTab('android')" class="flex-1 py-2 px-2.5 rounded-xl font-bold text-xs bg-blue-600 text-white shadow-xs transition-all">
                <i class="ph ph-android-logo"></i> Android
              </button>
              <button type="button" id="pwa-tab-btn-ios" onclick="window.EvakWarPWA && window.EvakWarPWA.setInstallModalTab('ios')" class="flex-1 py-2 px-2.5 rounded-xl font-semibold text-xs text-slate-600 hover:bg-slate-200 transition-all">
                <i class="ph ph-apple-logo"></i> iPhone / iPad
              </button>
              <button type="button" id="pwa-tab-btn-desktop" onclick="window.EvakWarPWA && window.EvakWarPWA.setInstallModalTab('desktop')" class="flex-1 py-2 px-2.5 rounded-xl font-semibold text-xs text-slate-600 hover:bg-slate-200 transition-all">
                <i class="ph ph-laptop"></i> PC / Mac
              </button>
            </div>
          </div>

          <!-- Platform Instructions -->
          <!-- Android Instructions -->
          <div id="pwa-tab-content-android" class="space-y-2.5 bg-slate-50 p-3.5 rounded-2xl border border-slate-200/70">
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">1</span>
              <div class="text-[11px] font-medium text-slate-700">
                Tap the browser menu button (<i class="ph ph-dots-three-vertical font-bold"></i> three dots) in Chrome or Edge.
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">2</span>
              <div class="text-[11px] font-medium text-slate-700">
                Select <strong>"Install app"</strong> or <strong>"Add to Home screen"</strong>.
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">3</span>
              <div class="text-[11px] font-medium text-slate-700">
                Confirm by tapping <strong>"Install"</strong> to add the Evacwar icon to your home screen.
              </div>
            </div>
          </div>

          <!-- iOS Instructions -->
          <div id="pwa-tab-content-ios" class="hidden space-y-2.5 bg-slate-50 p-3.5 rounded-2xl border border-slate-200/70">
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">1</span>
              <div class="text-[11px] font-medium text-slate-700">
                In Safari, tap the <strong>Share</strong> button (<i class="ph ph-export font-bold"></i> square with arrow up) at the bottom toolbar.
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">2</span>
              <div class="text-[11px] font-medium text-slate-700">
                Scroll down and select <strong>"Add to Home Screen"</strong> (<i class="ph ph-plus-square font-bold"></i>).
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">3</span>
              <div class="text-[11px] font-medium text-slate-700">
                Tap <strong>"Add"</strong> in the top-right corner to launch Evacwar full screen anytime.
              </div>
            </div>
          </div>

          <!-- Desktop Instructions -->
          <div id="pwa-tab-content-desktop" class="hidden space-y-2.5 bg-slate-50 p-3.5 rounded-2xl border border-slate-200/70">
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">1</span>
              <div class="text-[11px] font-medium text-slate-700">
                In Google Chrome or Microsoft Edge, look at the right side of the address bar.
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">2</span>
              <div class="text-[11px] font-medium text-slate-700">
                Click the <strong>Install Evacwar</strong> icon (<i class="ph ph-download-simple font-bold"></i> or computer monitor).
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">3</span>
              <div class="text-[11px] font-medium text-slate-700">
                Click <strong>"Install"</strong> to run Evacwar in its dedicated window with taskbar pinning.
              </div>
            </div>
          </div>

          <!-- Close Action -->
          <div class="pt-2 flex justify-end">
            <button type="button" onclick="closeInstallAppModal()" class="px-5 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-slate-800 transition-colors cursor-pointer">
              Close
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- PWA Installation & Clock Script -->
    <script>
      function triggerPwaInstallFromLogin() {
        window.location.href = '/evakwar-resident-v2.9.7.apk';
      }

      function openInstallAppModal() {
        window.location.href = '/evakwar-resident-v2.9.7.apk';
      }

      function closeInstallAppModal() {
        const modal = document.getElementById('modalInstallApp');
        if (modal) {
          modal.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      }

      // Hide install prompt if already operating in standalone installed mode
      document.addEventListener('DOMContentLoaded', () => {
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        if (isStandalone) {
          const container = document.getElementById('loginInstallContainer');
          if (container) container.classList.add('hidden');
        }
      });

      function updateClock() {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('en-US', { hour12: false });
        const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        const timeEl = document.getElementById('live-time');
        const dateEl = document.getElementById('live-date');

        if (timeEl) timeEl.textContent = timeStr;
        if (dateEl) dateEl.textContent = dateStr;
      }
      setInterval(updateClock, 1000);
      updateClock();
    </script>
  </main>

  <%- include('../partials/footer') %>