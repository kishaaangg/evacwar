<%- include('../partials/header') %>

  <main
    class="flex-1 overflow-y-auto relative py-4 sm:py-6 lg:py-8 px-3.5 sm:px-6 flex flex-col justify-start items-center min-h-0 w-full scroll-smooth">
    <!-- Background overlay of weather -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <img loading="lazy" src="/images/sanrafael.jpg" class="w-full h-full object-cover opacity-20" alt="San Rafael Background" / decoding="async">
      <div class="absolute inset-0 bg-slate-950/60 z-0"></div>
    </div>

    <!-- The 2-column container -->
    <div
      class="w-full max-w-6xl mx-auto my-auto flex flex-col md:flex-row items-center justify-center md:justify-between gap-6 md:gap-12 z-10 relative">

      <!-- Left Side: Desktop Branding (Hidden on mobile) -->
      <div class="hidden md:flex flex-1 flex-col items-start text-white text-left drop-shadow-md">
        <!-- Dual Circular Logos: Evacwar Logo & Barangay Logo -->
        <div class="flex items-center gap-4 mb-5">
          <div
            class="w-24 h-24 sm:w-28 sm:h-28 bg-white rounded-full p-2.5 sm:p-3 shadow-[0_0_25px_rgba(255,255,255,0.45)] border-2 border-white/70 flex items-center justify-center shrink-0">
            <img decoding="async" src="/images/logo.png" alt="Evacwar Logo" class="w-full h-full object-contain rounded-full" />
          </div>
          <div
            class="w-24 h-24 sm:w-28 sm:h-28 bg-white rounded-full p-2.5 sm:p-3 shadow-[0_0_25px_rgba(255,255,255,0.45)] border-2 border-white/70 flex items-center justify-center shrink-0">
            <img decoding="async" src="/images/brgy_logo.png" alt="Barangay San Rafael Logo" class="w-full h-full object-contain rounded-full" />
          </div>
        </div>
        <h2 class="text-3xl font-black uppercase tracking-widest mb-1 drop-shadow-md">Evacwar</h2>

        <div>
          <p class="text-base font-semibold mb-6 tracking-wide drop-shadow-md">BARANGAY DISASTER RISK REDUCTION</p>

          <h1
            class="text-5xl md:text-6xl font-black text-[#FFD700] mb-0 drop-shadow-[0_4px_4px_rgba(0,0,0,0.5)]">
            BE PREPARED</h1>
          <h1
            class="text-5xl md:text-6xl font-black text-[#FFD700] drop-shadow-[0_4px_4px_rgba(0,0,0,0.5)] mb-8 tracking-wide">
            CONNECT NOW</h1>

          <div class="flex flex-col items-start">
            <div class="text-2xl font-bold font-mono tracking-widest text-white drop-shadow-md mb-1 mt-6"
              id="live-time">00:00:00</div>
            <div class="text-sm sm:text-base font-medium text-white drop-shadow-md" id="live-date">Monday, January 1, 2023
            </div>
          </div>
        </div>
      </div>

      <!-- Right Side: Mobile-Optimized Register Card -->
      <div
        class="w-full max-w-lg mx-auto bg-white/95 backdrop-blur-xl rounded-3xl sm:rounded-[2rem] shadow-2xl p-5 sm:p-6 lg:p-7 border border-white/60 relative z-10 transition-all">

        <div class="text-center mb-3 sm:mb-4">
          <h1 class="text-xl sm:text-2xl font-black font-heading text-slate-900 mb-0.5">Create Your Account</h1>
          <p class="text-xs text-slate-500 font-medium">Register for barangay disaster alerts and evacuation support</p>
        </div>

        <!-- Inline Error Banner -->
        <div id="registerError" class="<%= locals.error ? '' : 'hidden' %> mb-3 flex items-start gap-2.5 bg-red-50 border border-red-200 text-red-700 rounded-xl p-3 text-xs font-semibold">
          <i class="ph ph-warning-circle text-base shrink-0 mt-0.5"></i>
          <span id="registerErrorMsg"><%= locals.error || 'Registration failed. Please check your inputs.' %></span>
        </div>

        <form id="registerForm" action="/register" method="POST" class="space-y-2.5 sm:space-y-3">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

          <!-- Name Section: First Name, Middle Name (Optional), Last Name -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-2.5">
            <div class="space-y-0.5 sm:col-span-1">
              <label for="first_name" class="text-xs font-bold text-slate-700 block ml-0.5">First Name</label>
              <div class="relative">
                <input type="text" id="first_name" name="first_name" placeholder="First Name"
                  class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-xs sm:text-sm rounded-xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-2 pl-8 transition-all"
                  required autocomplete="given-name">
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-user text-slate-400 text-sm"></i>
                </div>
              </div>
            </div>

            <div class="space-y-0.5 sm:col-span-1">
              <label for="middle_name" class="text-xs font-bold text-slate-700 block ml-0.5">Middle Name <span class="text-slate-400 font-normal">(Opt)</span></label>
              <div class="relative">
                <input type="text" id="middle_name" name="middle_name" placeholder="Middle Name"
                  class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-xs sm:text-sm rounded-xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-2 pl-8 transition-all"
                  autocomplete="additional-name">
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-user text-slate-400 text-sm"></i>
                </div>
              </div>
            </div>

            <div class="space-y-0.5 sm:col-span-1">
              <label for="last_name" class="text-xs font-bold text-slate-700 block ml-0.5">Last Name</label>
              <div class="relative">
                <input type="text" id="last_name" name="last_name" placeholder="Last Name"
                  class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-xs sm:text-sm rounded-xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-2 pl-8 transition-all"
                  required autocomplete="family-name">
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-user text-slate-400 text-sm"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Contact Number & Email Grid (2 Columns) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-2.5">
            <div class="space-y-0.5">
              <label for="contact" class="text-xs font-bold text-slate-700 block ml-0.5">Mobile Number</label>
              <div class="relative">
                <input type="tel" id="contact" name="contact" placeholder="09123456789"
                  pattern="09[0-9]{9}" maxlength="11"
                  title="Please enter an 11-digit Philippine mobile number starting with 09 (e.g. 09123456789)"
                  class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-xs sm:text-sm rounded-xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-2 pl-8 transition-all"
                  required autocomplete="tel">
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-device-mobile text-slate-400 text-sm"></i>
                </div>
              </div>
            </div>

            <div class="space-y-0.5">
              <label for="email" class="text-xs font-bold text-slate-700 block ml-0.5">Email Address</label>
              <div class="relative">
                <input type="email" id="email" name="email" placeholder="resident@example.com"
                  class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-xs sm:text-sm rounded-xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-2 pl-8 transition-all"
                  required autocomplete="email">
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-at text-slate-400 text-sm"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Location Details: Zone Location & Locked Barangay San Rafael (2 Columns) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-2.5">
            <!-- Dedicated Zone Dropdown (Zone 1 to Zone 7) -->
            <div class="space-y-0.5">
              <label for="zone" class="text-xs font-bold text-slate-700 block ml-0.5">Barangay Zone</label>
              <div class="relative">
                <select id="zone" name="zone"
                  class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-xs sm:text-sm rounded-xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-2 pl-8 pr-7 transition-all appearance-none cursor-pointer"
                  required>
                  <option value="" disabled selected>Select Zone (1 - 7)</option>
                  <option value="Zone 1">Zone 1</option>
                  <option value="Zone 2">Zone 2</option>
                  <option value="Zone 3">Zone 3</option>
                  <option value="Zone 4">Zone 4</option>
                  <option value="Zone 5">Zone 5</option>
                  <option value="Zone 6">Zone 6</option>
                  <option value="Zone 7">Zone 7</option>
                </select>
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-map-pin text-slate-400 text-sm"></i>
                </div>
                <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none text-slate-400">
                  <i class="ph ph-caret-down text-xs"></i>
                </div>
              </div>
            </div>

            <!-- Step 1: Locked Permanent Barangay San Rafael Field -->
            <div class="space-y-0.5">
              <div class="flex items-center justify-between">
                <label class="text-xs font-bold text-slate-700 block ml-0.5">Barangay</label>
                <span class="text-[9px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/80 px-1.5 py-0.2 rounded-md flex items-center gap-0.5">
                  <i class="ph ph-lock-key"></i> Locked
                </span>
              </div>
              <div class="relative">
                <input type="text" value="San Rafael (Baao)" readonly
                  class="w-full bg-slate-100/90 border border-slate-200 text-slate-700 font-semibold text-xs sm:text-sm rounded-xl block p-2 pl-8 cursor-not-allowed select-none truncate">
                <input type="hidden" id="barangay" name="barangay" value="Barangay San Rafael">
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-shield-check text-blue-600 text-sm"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Passwords (2 Columns) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-2.5">
            <div class="space-y-0.5">
              <label for="password" class="text-xs font-bold text-slate-700 block ml-0.5">Password</label>
              <div class="relative">
                <input type="password" id="password" name="password" placeholder="At least 8 chars"
                  class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-xs sm:text-sm rounded-xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-2 pl-8 pr-8 transition-all"
                  required minlength="8" autocomplete="new-password">
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-lock text-slate-400 text-sm"></i>
                </div>
                <button type="button" onclick="togglePasswordVisibility('password', this)" class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-slate-400 hover:text-slate-600 transition-colors" title="Toggle password visibility">
                  <i class="ph ph-eye text-sm"></i>
                </button>
              </div>
            </div>

            <div class="space-y-0.5">
              <label for="confirm_password" class="text-xs font-bold text-slate-700 block ml-0.5">Confirm Password</label>
              <div class="relative">
                <input type="password" id="confirm_password" name="confirm_password" placeholder="Repeat password"
                  class="w-full bg-slate-50/80 border border-slate-200 text-slate-900 text-xs sm:text-sm rounded-xl focus:ring-4 focus:ring-blue-500/15 focus:border-blue-600 block p-2 pl-8 pr-8 transition-all"
                  required minlength="8" autocomplete="new-password">
                <div class="absolute inset-y-0 left-0 flex items-center pl-2.5 pointer-events-none">
                  <i class="ph ph-check-circle text-slate-400 text-sm"></i>
                </div>
                <button type="button" onclick="togglePasswordVisibility('confirm_password', this)" class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-slate-400 hover:text-slate-600 transition-colors" title="Toggle password visibility">
                  <i class="ph ph-eye text-sm"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Valid ID Upload for Verification -->
          <div class="space-y-1.5 p-3 rounded-2xl bg-blue-50/60 border border-blue-100">
            <div class="flex items-center justify-between">
              <label class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                <i class="ph ph-identification-badge text-blue-600 text-sm"></i>
                Valid ID / Barangay ID Photo
              </label>
              <span class="text-[9px] font-bold text-blue-700 bg-blue-100/80 px-2 py-0.5 rounded-md flex items-center gap-0.5">
                Required for Verification
              </span>
            </div>

            <p class="text-[11px] text-slate-500 leading-tight">
              Upload a clear photo or copy of your valid ID (Barangay ID, National ID, Driver's License, etc.) for admin review.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-0.5">
              <div class="relative">
                <select id="id_type" name="id_type"
                  class="w-full bg-white border border-slate-200 text-slate-900 text-xs rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 block p-2 pl-7 pr-6 transition-all appearance-none cursor-pointer">
                  <option value="Barangay ID" selected>Barangay ID / Cert</option>
                  <option value="National ID (PhilSys)">National ID (PhilSys)</option>
                  <option value="Driver's License">Driver's License</option>
                  <option value="Voter's ID">Voter's ID / Cert</option>
                  <option value="Senior Citizen ID">Senior Citizen ID</option>
                  <option value="PWD ID">PWD ID</option>
                  <option value="Student ID">Student ID</option>
                  <option value="Other Valid ID">Other Government ID</option>
                </select>
                <div class="absolute inset-y-0 left-0 flex items-center pl-2 pointer-events-none">
                  <i class="ph ph-tag text-slate-400 text-xs"></i>
                </div>
                <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none text-slate-400">
                  <i class="ph ph-caret-down text-[10px]"></i>
                </div>
              </div>

              <!-- Upload Area trigger -->
              <label for="valid_id" id="uploadLabelBtn"
                class="flex items-center justify-center gap-1.5 p-2 bg-white hover:bg-slate-50 border border-dashed border-blue-300 hover:border-blue-500 rounded-xl cursor-pointer text-xs font-semibold text-blue-600 transition-all shadow-2xs">
                <i class="ph ph-upload-simple text-sm"></i>
                <span id="uploadLabelText">Choose ID Image</span>
              </label>
              <input type="file" id="valid_id" name="valid_id" accept="image/*,.jpg,.jpeg,.png,.webp" class="hidden"
                onchange="handleIdFileSelect(this)" required>
            </div>

            <!-- Upload File Preview & Status Box -->
            <div id="idFilePreviewContainer" class="hidden pt-1">
              <div class="flex items-center justify-between p-2 bg-white rounded-xl border border-blue-200 shadow-2xs">
                <div class="flex items-center gap-2 min-w-0">
                  <img loading="lazy" id="idImagePreview" src="" alt="Valid ID Preview"
                    class="w-10 h-10 object-cover rounded-lg border border-slate-200 shrink-0 bg-slate-100" / decoding="async">
                  <div class="min-w-0">
                    <p id="idFileName" class="text-xs font-bold text-slate-800 truncate max-w-[170px] sm:max-w-[220px]">id_photo.jpg</p>
                    <p id="idFileSize" class="text-[10px] text-slate-400 font-medium">0 KB</p>
                  </div>
                </div>
                <button type="button" onclick="removeSelectedIdFile()"
                  class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Remove photo">
                  <i class="ph ph-trash text-sm"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" id="registerBtn"
            class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-xs sm:text-sm py-2.5 sm:py-3 rounded-xl shadow-md shadow-blue-500/25 transition-all active:scale-[0.98] flex items-center justify-center gap-2 mt-2">
            <i class="ph ph-user-plus text-base"></i>
            <span>Complete Registration</span>
          </button>
        </form>

        <div class="mt-3 text-center text-xs font-medium text-slate-500">
          Already have a resident account?
          <a href="/login" class="font-bold text-blue-600 hover:text-blue-800 ml-1 underline">Sign In Here</a>
        </div>

      </div>
    </div>
  </main>

  <script>
    function handleIdFileSelect(input) {
      const previewContainer = document.getElementById('idFilePreviewContainer');
      const imgPreview = document.getElementById('idImagePreview');
      const fileNameEl = document.getElementById('idFileName');
      const fileSizeEl = document.getElementById('idFileSize');
      const labelText = document.getElementById('uploadLabelText');
      const errBanner = document.getElementById('registerError');
      const errText = document.getElementById('registerErrorMsg');

      if (!input.files || !input.files[0]) {
        return;
      }

      const file = input.files[0];

      // Validate file type
      if (!file.type.startsWith('image/')) {
        errText.textContent = 'Please upload an image file (JPG, PNG, WEBP) for your Valid ID.';
        errBanner.classList.remove('hidden');
        input.value = '';
        return;
      }

      // Validate file size (10MB)
      if (file.size > 10 * 1024 * 1024) {
        errText.textContent = 'Uploaded ID image is too large. Maximum allowed size is 10MB.';
        errBanner.classList.remove('hidden');
        input.value = '';
        return;
      }

      errBanner.classList.add('hidden');
      fileNameEl.textContent = file.name;
      fileSizeEl.textContent = (file.size / 1024 < 1024)
        ? (file.size / 1024).toFixed(1) + ' KB'
        : (file.size / (1024 * 1024)).toFixed(2) + ' MB';

      const reader = new FileReader();
      reader.onload = function(e) {
        imgPreview.src = e.target.result;
        previewContainer.classList.remove('hidden');
        if (labelText) labelText.textContent = 'Change ID Image';
      };
      reader.readAsDataURL(file);
    }

    function removeSelectedIdFile() {
      const input = document.getElementById('valid_id');
      const previewContainer = document.getElementById('idFilePreviewContainer');
      const labelText = document.getElementById('uploadLabelText');
      if (input) input.value = '';
      if (previewContainer) previewContainer.classList.add('hidden');
      if (labelText) labelText.textContent = 'Choose ID Image';
    }

    function togglePasswordVisibility(fieldId, btn) {
      const input = document.getElementById(fieldId);
      if (!input) return;
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        if (icon) { icon.classList.remove('ph-eye'); icon.classList.add('ph-eye-slash'); }
      } else {
        input.type = 'password';
        if (icon) { icon.classList.remove('ph-eye-slash'); icon.classList.add('ph-eye'); }
      }
    }
    // Live clock script
    function updateClock() {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('en-US', { hour12: false });
      const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

      const timeEl = document.getElementById('live-time');
      const dateEl = document.getElementById('live-date');
      if (timeEl) timeEl.textContent = timeStr;
      if (dateEl) dateEl.textContent = dateStr;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // AJAX Form Handling with error banner display
    document.getElementById('registerForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      const errBanner = document.getElementById('registerError');
      const errText = document.getElementById('registerErrorMsg');
      const submitBtn = document.getElementById('registerBtn');

      errBanner.classList.add('hidden');

      // Client-side Phone validation
      const contactVal = (document.getElementById('contact').value || '').trim();
      if (!/^09\d{9}$/.test(contactVal)) {
        errText.textContent = 'Mobile number must be a valid 11-digit Philippine number starting with 09 (e.g. 09123456789).';
        errBanner.classList.remove('hidden');
        document.getElementById('contact').focus();
        return;
      }

      // Client-side Zone validation (Zone 1 to Zone 7)
      const zoneEl = document.getElementById('zone');
      const zoneVal = zoneEl ? zoneEl.value : '';
      const validZones = ['Zone 1', 'Zone 2', 'Zone 3', 'Zone 4', 'Zone 5', 'Zone 6', 'Zone 7'];
      if (!zoneVal || !validZones.includes(zoneVal)) {
        errText.textContent = 'Please select your official Barangay Zone from the dropdown (Zone 1 to Zone 7).';
        errBanner.classList.remove('hidden');
        if (zoneEl) zoneEl.focus();
        return;
      }

      // Client-side Password validation
      const passVal = document.getElementById('password').value;
      if (!passVal || passVal.length < 8 || !/[a-zA-Z]/.test(passVal) || !/[0-9]/.test(passVal)) {
        errText.textContent = 'Password must be at least 8 characters long and contain both letters and numbers.';
        errBanner.classList.remove('hidden');
        document.getElementById('password').focus();
        return;
      }

      const confirmPassVal = document.getElementById('confirm_password').value;
      if (passVal !== confirmPassVal) {
        errText.textContent = 'Passwords do not match.';
        errBanner.classList.remove('hidden');
        document.getElementById('confirm_password').focus();
        return;
      }

      // Client-side Valid ID validation
      const idInput = document.getElementById('valid_id');
      if (!idInput || !idInput.files || idInput.files.length === 0) {
        errText.textContent = 'Please upload a clear photo or copy of your Valid ID / Barangay ID for verification.';
        errBanner.classList.remove('hidden');
        document.getElementById('uploadLabelBtn')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="ph ph-spinner animate-spin text-lg"></i> Optimizing photo & submitting...';

      try {
        const formData = new FormData(this);

        // Compress valid_id image if present to prevent upload timeouts & server size limit failures on mobile devices
        if (idInput.files && idInput.files[0]) {
          try {
            const compressedIdFile = await compressImageFile(idInput.files[0], 1200, 0.75);
            formData.set('valid_id', compressedIdFile);
          } catch (compressErr) {
            console.warn('Image compression warning, using original file:', compressErr);
          }
        }

        const res = await fetch('/register', {
          method: 'POST',
          headers: {
            'Accept': 'application/json'
          },
          body: formData
        });

        const json = await res.json();
        if (json.success) {
          window.location.href = json.redirect || '/login?registered=1';
        } else {
          errText.textContent = json.message || 'Registration failed. Please check inputs.';
          errBanner.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="ph ph-user-plus text-lg"></i> Complete Registration';
        }
      } catch (err) {
        console.error(err);
        errText.textContent = 'Server connection error. Please try again.';
        errBanner.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="ph ph-user-plus text-lg"></i> Complete Registration';
      }
    });

    // Helper function to compress high-res camera photos to ~200KB-500KB before uploading
    async function compressImageFile(file, maxDimension = 1200, quality = 0.75) {
      if (!file || !file.type || !file.type.startsWith('image/')) return file;
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            let width = img.width;
            let height = img.height;
            if (width > maxDimension || height > maxDimension) {
              if (width > height) {
                height = Math.round((height * maxDimension) / width);
                width = maxDimension;
              } else {
                width = Math.round((width * maxDimension) / height);
                height = maxDimension;
              }
            }
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            canvas.toBlob((blob) => {
              if (blob && blob.size < file.size) {
                const compressedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                  type: 'image/jpeg',
                  lastModified: Date.now()
                });
                resolve(compressedFile);
              } else {
                resolve(file);
              }
            }, 'image/jpeg', quality);
          };
          img.onerror = () => resolve(file);
          img.src = e.target.result;
        };
        reader.onerror = () => resolve(file);
        reader.readAsDataURL(file);
      });
    }
  </script>

