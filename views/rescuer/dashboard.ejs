<%- include('../partials/header') %>

  <% const staffMember=locals.staff || locals.user || {}; const isRescuer=true; const
    isEvacuation=staffMember.staff_type==='EVACUATION' ; const isBoth=false; const
    ecStats=locals.ecStats || null; const assignedCenter=isRescuer ? null : (staffMember.center || (locals.allCenters &&
    locals.allCenters.length> 0 ? locals.allCenters[0] : null));
    const ecBreakdown = (ecStats && ecStats.age_breakdown) || (ecStats && ecStats.age_groups) || {};
    const specialCats = (ecStats && ecStats.special_categories) || {};
    const seniorCount = (ecBreakdown['60+y'] && ecBreakdown['60+y'].total) || (ecBreakdown['60plus'] &&
    ecBreakdown['60plus'].total) || 0;
    const infantCount = ((ecBreakdown['0-11m'] && ecBreakdown['0-11m'].total) || (ecBreakdown['0_11m'] &&
    ecBreakdown['0_11m'].total) || 0) +
    ((ecBreakdown['1-3y'] && ecBreakdown['1-3y'].total) || (ecBreakdown['1_3y'] && ecBreakdown['1_3y'].total) || 0) +
    ((ecBreakdown['4-5y'] && ecBreakdown['4-5y'].total) || (ecBreakdown['4_5y'] && ecBreakdown['4_5y'].total) || 0);

    let rawPhoto = staffMember.profile_photo || (locals.user && locals.user.profile_photo) || null;
    let userPhoto = null;
    if (rawPhoto) {
    userPhoto = (rawPhoto.startsWith('http') || rawPhoto.startsWith('/')) ? rawPhoto : `/uploads/profiles/${rawPhoto}`;
    }
    const fullName = staffMember.name || (locals.user && locals.user.name) || 'Staff Member';
    const staffFirstName = staffMember.firstName || staffMember.first_name || fullName.split(' ')[0] || 'Staff';
    const staffOccupation = staffMember.occupation || (isRescuer ? 'Emergency Rescuer' : 'Emergency Staff');
    const staffContact = staffMember.contact_number || staffMember.contact || (locals.user &&
    locals.user.contact_number) || null;
    const staffInitial = staffFirstName.charAt(0).toUpperCase();

    const siteZone = (assignedCenter && assignedCenter.address) ? assignedCenter.address : (staffMember.zone ||
    (assignedCenter ? assignedCenter.name : 'Zone 2'));
    let siteLocation = siteZone;
    if (!siteLocation.toLowerCase().includes('san rafael')) {
    siteLocation = `${siteLocation}, Brgy. San Rafael`;
    }
    const staffRoleLabel = isRescuer ? 'Rescuer' : (isEvacuation ? 'Evacuation Staff' : 'Rescuer & Evac Staff');
    const hero3dImage = isRescuer ? '/images/rescuer.png' : '/images/rescuer.png';
    let timeGreeting = 'Good day';
    try {
    const currentHour = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Manila" })).getHours();
    if (currentHour < 12) timeGreeting='Good morning' ; else if (currentHour < 18) timeGreeting='Good afternoon' ; else
      timeGreeting='Good evening' ; } catch (e) { const h=new Date().getHours(); timeGreeting=h < 12 ? 'Good morning' :
      (h < 18 ? 'Good afternoon' : 'Good evening' ); } const now=new Date(); const
      currentDayName=now.toLocaleDateString('en-US', { weekday: 'long' , timeZone: 'Asia/Manila' }); const
      currentTimeStr=now.toLocaleTimeString('en-US', { hour: 'numeric' , minute: '2-digit' , hour12: true,
      timeZone: 'Asia/Manila' }).toLowerCase(); const currentTemp=(locals.weather && locals.weather.temperature !=null)
      ? Math.round(locals.weather.temperature) : 27; const realFeelTemp=(locals.weather &&
      locals.weather.apparent_temperature !=null) ? Math.round(locals.weather.apparent_temperature) :
      Math.round(currentTemp - 2); const currentWind=(locals.weather && locals.weather.wind_speed !=null) ?
      Math.round(locals.weather.wind_speed) : 18; const currentRainfall=(locals.weather && locals.weather.rainfall
      !=null) ? locals.weather.rainfall : 0.2; const currentHumidity=(locals.weather && locals.weather.humidity !=null)
      ? locals.weather.humidity : 89; const weatherStatus=(locals.weather && locals.weather.weather_status) ?
      locals.weather.weather_status : 'Scattered Rain Showers' ; const
      isRainyWeather=weatherStatus.toLowerCase().includes('rain') || weatherStatus.toLowerCase().includes('drizzle') ||
      weatherStatus.toLowerCase().includes('thunder') || weatherStatus.toLowerCase().includes('storm') ||
      weatherStatus.toLowerCase().includes('shower'); %>

      <div class="app-main-layout">
        <%- include('../partials/sidebar') %>

          <main
            class="app-content flex flex-col min-h-screen bg-slate-50 relative pb-36 sm:pb-32 lg:pb-12 overflow-x-hidden z-0">
            <!-- Decorative Ambient Gradients -->
            <div
              class="absolute top-0 left-0 w-full h-80 bg-gradient-to-b from-blue-100/60 via-indigo-50/30 to-transparent pointer-events-none -z-10">
            </div>
            <div
              class="absolute top-12 right-6 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl pointer-events-none -z-10">
            </div>
            <div
              class="absolute top-48 left-6 w-60 h-60 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none -z-10">
            </div>

            <div class="max-w-7xl mx-auto space-y-4 sm:space-y-5 flex-1 w-full px-3 sm:px-6 py-3 sm:py-4">

              <!-- TOP WELCOME BANNER (PROFESSIONAL EXECUTIVE MODERN HERO) -->
              <div
                class="rounded-3xl bg-gradient-to-br from-[#1e40af] via-[#2563eb] to-[#1d4ed8] text-white p-5 sm:p-7 md:p-8 shadow-xl shadow-blue-950/20 relative overflow-hidden flex flex-col justify-between min-h-[175px] sm:min-h-[195px] md:min-h-[210px] border border-white/20 shadow-[inset_0_1px_1px_rgba(255,255,255,0.25)]">
                <!-- Subtle atmospheric ambient glow accents -->
                <div
                  class="absolute -top-16 -left-16 w-64 h-64 bg-sky-300/20 rounded-full blur-3xl pointer-events-none">
                </div>
                <div
                  class="absolute -bottom-10 right-1/4 w-72 h-72 bg-indigo-400/20 rounded-full blur-3xl pointer-events-none">
                </div>

                <!-- Top Row: Staff Avatar & Official Role Status Capsule -->
                <div class="flex items-center gap-2.5 sm:gap-3 z-20">
                  <!-- Profile Avatar with Double Glass Ring & Online Dot -->
                  <div class="relative shrink-0">
                    <div
                      class="w-10 h-10 sm:w-11 sm:h-11 aspect-square rounded-full ring-2 ring-white/80 ring-offset-2 ring-offset-[#1e40af] shadow-md overflow-hidden bg-white/20 shrink-0 flex items-center justify-center backdrop-blur-xs">
                      <img loading="lazy" id="rescuerWelcomeAvatarImg" src="<%= userPhoto || '' %>" decoding="async" alt="<%= fullName %>" style="<%= userPhoto ? '' : 'display:none;' %>" class="rescuer-avatar-img staff-avatar-img w-full h-full object-cover"
                        onerror="this.style.display='none'; var fb = document.getElementById('rescuerAvatarInitial'); if (fb) fb.style.display='flex';" />
                      <span id="rescuerAvatarInitial" style="<%= userPhoto ? 'display:none;' : '' %>"
                        class="rescuer-avatar-initial staff-avatar-initial w-full h-full flex items-center justify-center font-black text-sm text-white">
                        <%= staffInitial %>
                      </span>
                    </div>
                    <!-- Online Status Dot on Avatar -->
                    <span
                      class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-400 ring-2 ring-[#1e40af] shadow-xs"
                      title="On Duty / Online"></span>
                  </div>

                  <!-- Refined Status Capsule Badge with Frosted Glass -->
                  <div
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/12 backdrop-blur-md border border-white/20 text-[10px] sm:text-xs font-bold text-white shadow-xs">
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_6px_rgba(52,211,153,0.8)]"></span>
                    <span
                      class="uppercase tracking-widest text-[9px] sm:text-[10px] font-black text-white flex items-center gap-1">
                      <i class="ph <%= isRescuer ? 'ph-lifebuoy' : 'ph-buildings' %> text-xs"></i>
                      <%= staffRoleLabel %>
                    </span>
                    <span class="text-white/35">•</span>
                    <span class="staff-occupation-display text-blue-100 font-medium text-[10px] sm:text-xs truncate max-w-[120px] sm:max-w-none">
                      <%= staffOccupation %>
                    </span>
                    <span class="text-white/35 hidden xs:inline">•</span>
                    <span class="text-blue-200/90 font-medium text-[10px] sm:text-xs hidden xs:inline">
                      Barangay San Rafael
                    </span>
                  </div>
                </div>

                <!-- Greeting Headline & Subtitle (Bounded to left column to balance with mascot) -->
                <div class="mt-3.5 sm:mt-4 z-20 max-w-[55%] xs:max-w-[58%] sm:max-w-[62%] md:max-w-[66%]">
                  <h1
                    class="text-lg xs:text-xl sm:text-2xl md:text-3xl font-black text-white tracking-tight leading-snug drop-shadow-xs">
                    <%= timeGreeting %>, <span id="rescuerGreetingName" class="rescuer-first-name-display staff-first-name-display"><%= staffFirstName %></span>! <span
                          class="inline-block text-lg xs:text-xl sm:text-2xl">👋</span>
                  </h1>
                  <p
                    class="text-[11px] sm:text-xs md:text-sm text-blue-100/90 font-normal mt-1 sm:mt-1.5 leading-relaxed max-w-sm sm:max-w-md">
                    <%= isRescuer
                      ? 'Ready to respond and keep Barangay San Rafael safe? Field rescue operations and SOS alerts are active.'
                      : 'Ready to help keep Barangay San Rafael safe? Evacuation center desk and resident check-ins are active.'
                      %>
                  </p>
                </div>

                <!-- Operational Pills: Assigned Center, Location & Contact -->
                <div
                  class="mt-3 sm:mt-3.5 flex flex-wrap items-center gap-1.5 sm:gap-2 z-20 max-w-[55%] xs:max-w-[58%] sm:max-w-[62%] md:max-w-[66%]">
                  <% if (!isRescuer) { %>
                    <% const myAssignedSites=(staffMember.assigned_centers && staffMember.assigned_centers.length> 0)
                      ? staffMember.assigned_centers : (assignedCenter ? [assignedCenter] : []); %>
                      <% if (myAssignedSites.length> 1) { %>
                        <div
                          class="flex items-center gap-1.5 bg-white/15 hover:bg-white/20 backdrop-blur-md text-white px-2.5 py-1 rounded-xl border border-white/25 shadow-xs transition-colors"
                          title="Active Evacuation Desk">
                          <i class="ph ph-buildings text-sky-200 text-xs sm:text-sm shrink-0"></i>
                          <span class="text-blue-200 font-extrabold text-[10px] sm:text-xs">Current Site:</span>
                          <div class="relative inline-block">
                            <select onchange="window.location.href = '/rescuer/dashboard?center_id=' + this.value"
                              class="text-xs font-black text-white bg-transparent pr-4 outline-none cursor-pointer appearance-none">
                              <% myAssignedSites.forEach(s=> { %>
                                <option value="<%= s.id %>" class="text-slate-900 bg-white"
                                  <%=Number(s.id)===Number(locals.activeCenterId || staffMember.assigned_center_id)
                                  ? 'selected' : '' %>>
                                  <%= s.name %>
                                </option>
                                <% }) %>
                            </select>
                            <i
                              class="ph ph-caret-down text-[10px] text-sky-200 absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                          </div>
                        </div>
                        <% } else { %>
                          <div
                            class="flex items-center gap-1 bg-white/15 backdrop-blur-md text-white px-2 sm:px-2.5 py-1 rounded-xl border border-white/25 shadow-xs max-w-full text-[10px] sm:text-xs font-semibold"
                            title="Assigned Evacuation Center">
                            <i class="ph ph-buildings text-sky-200 text-xs sm:text-sm shrink-0"></i>
                            <span class="truncate">
                              <%= assignedCenter ? assignedCenter.name : 'San Rafael Evacuation Center' %>
                            </span>
                          </div>
                          <% } %>
                            <div
                              class="flex items-center gap-1 bg-white/15 backdrop-blur-md text-white px-2 sm:px-2.5 py-1 rounded-xl border border-white/25 shadow-xs max-w-full text-[10px] sm:text-xs font-medium"
                              title="Site Location">
                              <i class="ph ph-map-pin text-rose-300 text-xs sm:text-sm shrink-0"></i>
                              <span class="truncate">
                                <%= siteLocation %>
                              </span>
                            </div>
                            <% } else { %>
                              <div
                                class="flex items-center gap-1 bg-rose-500/25 backdrop-blur-md text-white px-2.5 py-1 rounded-xl border border-rose-400/35 shadow-xs text-[10px] sm:text-xs font-bold"
                                title="Emergency SOS Response Unit">
                                <i class="ph ph-lifebuoy text-rose-300 text-xs sm:text-sm shrink-0"></i>
                                <span class="truncate">Emergency SOS Rescue Unit</span>
                              </div>
                              <div
                                class="flex items-center gap-1 bg-white/15 backdrop-blur-md text-white px-2 sm:px-2.5 py-1 rounded-xl border border-white/25 shadow-xs max-w-full text-[10px] sm:text-xs font-medium"
                                title="Operational Jurisdiction">
                                <i class="ph ph-map-pin text-rose-300 text-xs sm:text-sm shrink-0"></i>
                                <span class="truncate">Brgy. San Rafael Field Unit</span>
                              </div>
                              <% } %>
                                <% if (staffContact) { %>
                                  <div
                                    class="hidden sm:flex items-center gap-1 bg-white/15 backdrop-blur-md text-white/90 px-2 sm:px-2.5 py-1 rounded-xl border border-white/25 shadow-xs max-w-full text-[10px] sm:text-xs font-medium"
                                    title="Contact Number">
                                    <i class="ph ph-phone text-blue-200 text-xs shrink-0"></i>
                                    <span class="truncate">
                                      <%= staffContact %>
                                    </span>
                                  </div>
                                  <% } %>
                </div>

                <!-- Right: 3D Mascot Character (Bigger & prominent on mobile 360px+, flush to bottom edge) -->
                <div
                  class="absolute right-0 bottom-0 pointer-events-none select-none z-10 w-[48%] xs:w-[45%] sm:w-[40%] md:w-[34%] max-w-[220px] h-full flex items-end justify-end overflow-hidden">
                  <div
                    class="absolute right-1 bottom-0 w-40 h-40 <%= isRescuer ? 'bg-rose-400/25' : 'bg-amber-400/25' %> rounded-full blur-2xl">
                  </div>
                  <img loading="lazy" src="<%= hero3dImage %>" decoding="async" alt="<%= isRescuer ? 'Emergency Rescuer' : 'Evacuation Staff' %>"
                    class="relative z-10 w-full h-full max-h-[205px] xs:max-h-[220px] sm:max-h-[235px] md:max-h-[250px] object-contain object-bottom drop-shadow-2xl translate-y-[2px]" />
                </div>
              </div>
              <!-- 1. LIVE RESCUE DISPATCH READINESS STRIP (REPLACES BULKY RADAR) -->
              <% const initialActiveSosCount = (locals.activeSosAlerts && Array.isArray(locals.activeSosAlerts)) ? locals.activeSosAlerts.length : 0; %>
              <div id="rescuerDispatchStatusCard"
                class="rounded-3xl p-3.5 sm:p-4 shadow-sm border transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 <%= initialActiveSosCount > 0 ? 'bg-gradient-to-r from-rose-600 via-red-600 to-rose-700 text-white border-red-400/50 shadow-red-600/20' : 'bg-white text-slate-900 border-slate-200/90' %>">
                <div class="flex items-center gap-3 min-w-0">
                  <div id="rescuerDispatchIconBox"
                    class="w-11 h-11 rounded-2xl flex items-center justify-center shrink-0 text-xl shadow-xs <%= initialActiveSosCount > 0 ? 'bg-white/20 text-white animate-pulse' : 'bg-emerald-50 text-emerald-600 border border-emerald-200/80' %>">
                    <i id="rescuerDispatchIcon" class="ph <%= initialActiveSosCount > 0 ? 'ph-siren' : 'ph-shield-check' %>"></i>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <h2 id="rescuerDispatchTitle" class="font-black text-sm sm:text-base tracking-tight leading-tight">
                        <%= initialActiveSosCount > 0 ? (initialActiveSosCount + ' Active SOS ' + (initialActiveSosCount === 1 ? 'Call' : 'Calls') + ' — Dispatch Ready') : 'Sector Clear • Standby Ready' %>
                      </h2>
                      <span id="rescuerGpsStandbyPill"
                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9.5px] font-black uppercase tracking-wider <%= initialActiveSosCount > 0 ? 'bg-white/20 text-white' : 'bg-blue-50 text-blue-700 border border-blue-200/70' %>">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="rescuerGpsStandbyText">GPS Standby</span>
                      </span>
                    </div>
                    <p id="rescuerDispatchSub"
                      class="text-[11px] sm:text-xs font-medium mt-0.5 truncate <%= initialActiveSosCount > 0 ? 'text-rose-100' : 'text-slate-500' %>">
                      <%= initialActiveSosCount > 0 ? 'Tap Open SOS Map to view nearest auto-assigned rescue path & stops.' : 'Auto-assign is armed — nearest SOS alerts will route directly to your unit.' %>
                    </p>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-xs font-black <%= initialActiveSosCount > 0 ? 'bg-black/20 text-white' : 'bg-slate-100 text-slate-700' %>">
                    <span id="dashDispatchMineCount">0</span>
                    <span class="text-[10px] font-bold uppercase opacity-80">Assigned</span>
                  </div>
                  <a href="/rescuer/map"
                    id="rescuerDispatchMapBtn"
                    class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl font-extrabold text-xs transition-all active:scale-95 shrink-0 shadow-xs <%= initialActiveSosCount > 0 ? 'bg-white text-red-700 hover:bg-rose-50' : 'bg-blue-600 hover:bg-blue-700 text-white' %>">
                    <i class="ph ph-navigation-arrow-fill text-sm"></i>
                    <span>Open SOS Map</span>
                  </a>
                </div>
              </div>

                  <!-- 2. MY ASSIGNED SITES (CLEAN RESPONSIVE LAYOUT FOR SINGLE & MULTI-FACILITY) -->
                  <% if (!isRescuer) { %>
                    <% const assignedSitesList=(typeof assignedCentersWithSituations !=='undefined' &&
                      assignedCentersWithSituations) ? assignedCentersWithSituations :
                      (locals.assignedCentersWithSituations || []); %>
                      <% if (assignedSitesList.length===1) { const site=assignedSitesList[0]; const
                        isActive=site.is_active || (site.id===(locals.activeCenterId ||
                        staffMember.assigned_center_id)); let pColor="bg-blue-600" ; if (site.occupancy_pct>= 90) pColor
                        = "bg-red-500";
                        else if (site.occupancy_pct >= 75) pColor = "bg-amber-500";
                        %>
                        <!-- SINGLE ASSIGNED FACILITY: FULL-WIDTH CLEAN CARD -->
                        <div class="space-y-2.5">
                          <div class="flex items-center justify-between px-1">
                            <div class="flex items-center gap-2">
                              <span
                                class="w-6 h-6 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-xs border border-blue-100/80 shrink-0 shadow-2xs">
                                <i class="ph ph-buildings"></i>
                              </span>
                              <h2 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-slate-600">
                                Assigned Facility</h2>
                            </div>
                            <span
                              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] sm:text-xs font-black uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200/80 shadow-2xs">
                              <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span> Active Desk
                            </span>
                          </div>

                          <!-- Full-Width Card matching modern government aesthetics -->
                          <div id="assignedSiteCard-<%= site.id %>" data-center-id="<%= site.id %>"
                            class="w-full bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-300 space-y-4 relative overflow-hidden group">
                            
                            <!-- Subtle top ambient accent line -->
                            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-600 via-indigo-500 to-emerald-500 opacity-90"></div>

                            <div class="flex items-start justify-between gap-3 pt-0.5">
                              <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                  <h3
                                    class="text-base sm:text-lg font-black text-slate-900 leading-snug tracking-tight truncate">
                                    <%= site.name %>
                                  </h3>
                                  <span class="w-2.5 h-2.5 rounded-full bg-blue-600 shrink-0 shadow-xs"
                                    title="Active Evacuation Desk"></span>
                                </div>
                                <p class="text-xs text-slate-500 font-semibold flex items-center gap-1.5 mt-0.5">
                                  <i class="ph ph-map-pin text-rose-500 shrink-0"></i>
                                  <span class="truncate">
                                    <%= site.address || site.zone %>
                                  </span>
                                </p>
                              </div>
                              <span id="assignedSiteStatusBadge-<%= site.id %>"
                                class="text-[10px] sm:text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full shrink-0 flex items-center gap-1.5 shadow-2xs transition-all duration-300 <%= site.is_full ? 'bg-rose-50 text-rose-700 border border-rose-200/80 ring-2 ring-rose-500/10' : 'bg-emerald-50 text-emerald-700 border border-emerald-200/80 ring-2 ring-emerald-500/10' %>">
                                <span id="assignedSiteStatusDot-<%= site.id %>"
                                  class="w-1.5 h-1.5 rounded-full <%= site.is_full ? 'bg-rose-600 animate-pulse' : 'bg-emerald-600 animate-pulse' %>"></span>
                                <span id="assignedSiteStatusText-<%= site.id %>"><%= site.status %></span>
                              </span>
                            </div>

                            <!-- Occupancy Bar -->
                            <div class="space-y-1.5">
                              <div class="flex items-center justify-between text-xs">
                                <span class="font-extrabold text-slate-600 flex items-center gap-1.5">
                                  <i class="ph ph-chart-bar text-slate-400"></i> Shelter Capacity & Occupancy
                                </span>
                                <span class="font-black text-slate-900 font-mono">
                                  <span id="assignedSiteOccupancy-<%= site.id %>"><%= site.occupancy %></span> / 
                                  <span id="assignedSiteCapacity-<%= site.id %>"><%= site.capacity %></span> 
                                  <span id="assignedSitePctBadge-<%= site.id %>" class="text-slate-400 font-semibold text-[11px]">(<span id="assignedSitePct-<%= site.id %>"><%= site.occupancy_pct %></span>%)</span>
                                </span>
                              </div>
                              <div
                                class="w-full bg-slate-100 rounded-full h-2.5 sm:h-3 overflow-hidden p-0.5 border border-slate-200/80 shadow-inner">
                                <% const occWidthStyle='style="width: ' + Number(site.occupancy_pct || 0) + '%;"' ; %>
                                  <div id="assignedSiteProgressBar-<%= site.id %>" class="<%= pColor %> h-full rounded-full transition-all duration-700 ease-out relative" <%-
                                    occWidthStyle %>>
                                    <div class="absolute inset-0 bg-white/20 w-full h-full"></div>
                                  </div>
                              </div>
                            </div>

                            <!-- Mini Stats Grid -->
                            <div class="grid grid-cols-3 gap-2 sm:gap-3 py-0.5 text-center">
                              <div
                                class="bg-gradient-to-b from-slate-50 to-slate-100/70 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 border border-slate-200/60 shadow-2xs hover:border-slate-300 transition-all">
                                <div id="assignedSiteAvailable-<%= site.id %>" class="text-base sm:text-xl font-black font-mono <%= site.available_slots === 0 ? 'text-rose-600' : 'text-emerald-600' %>">
                                  <%= site.available_slots %>
                                </div>
                                <div
                                  class="text-[9px] sm:text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mt-0.5">
                                  Available</div>
                              </div>
                              <div
                                class="bg-gradient-to-b from-slate-50 to-slate-100/70 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 border border-slate-200/60 shadow-2xs hover:border-slate-300 transition-all">
