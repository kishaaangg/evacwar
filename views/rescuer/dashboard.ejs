      <%- include('../partials/footer') %>

        <!-- Realtime Socket listener for Center Updates -->
        <script>
          if (typeof io !== 'undefined') {
            const socket = window.__appSocket || io();
            const currentCenterId = Number('<%= staffMember.assigned_center_id || 1 %>');

            function updateAssignedFacilityCard(centerData) {
              if (!centerData || !centerData.id) return;
              const cId = centerData.id;

              const cap = parseInt(centerData.max_capacity || centerData.capacity || 25, 10);
              const occ = parseInt(centerData.current_occupancy !== undefined ? centerData.current_occupancy : (centerData.occupancy !== undefined ? centerData.occupancy : 0), 10);
              const avail = Math.max(0, cap - occ);
              const pct = cap > 0 ? Math.min(100, Math.round((occ / cap) * 100)) : 0;
              const isFull = occ >= cap;

              // 1. Update Single Facility Card if present
              const singleCard = document.getElementById(`assignedSiteCard-${cId}`);
              if (singleCard) {
                const occEl = document.getElementById(`assignedSiteOccupancy-${cId}`);
                if (occEl) occEl.textContent = occ;

                const capEl = document.getElementById(`assignedSiteCapacity-${cId}`);
                if (capEl) capEl.textContent = cap;

                const pctEl = document.getElementById(`assignedSitePct-${cId}`);
                if (pctEl) pctEl.textContent = pct;

                const bar = document.getElementById(`assignedSiteProgressBar-${cId}`);
                if (bar) {
                  bar.style.width = pct + '%';
                  bar.className = `${pct >= 90 ? 'bg-red-500' : (pct >= 75 ? 'bg-amber-500' : 'bg-blue-600')} h-full rounded-full transition-all duration-700 ease-out relative`;
                }

                const availEl = document.getElementById(`assignedSiteAvailable-${cId}`);
                if (availEl) {
                  availEl.textContent = avail;
                  availEl.className = `text-base sm:text-xl font-black font-mono ${avail === 0 ? 'text-rose-600' : 'text-emerald-600'}`;
                }

                if (centerData.families !== undefined || centerData.total_families !== undefined) {
                  const famEl = document.getElementById(`assignedSiteFamilies-${cId}`);
                  if (famEl) famEl.textContent = centerData.families !== undefined ? centerData.families : centerData.total_families;
                }

                if (centerData.assigned_staff_count !== undefined) {
                  const staffEl = document.getElementById(`assignedSiteStaff-${cId}`);
                  if (staffEl) staffEl.textContent = centerData.assigned_staff_count;
                }

                const statusBadge = document.getElementById(`assignedSiteStatusBadge-${cId}`);
                const statusDot = document.getElementById(`assignedSiteStatusDot-${cId}`);
                const statusText = document.getElementById(`assignedSiteStatusText-${cId}`);
                if (statusBadge && statusDot && statusText) {
                  statusBadge.className = `text-[10px] sm:text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full shrink-0 flex items-center gap-1.5 shadow-2xs transition-all duration-300 ${isFull ? 'bg-rose-50 text-rose-700 border border-rose-200/80 ring-2 ring-rose-500/10' : 'bg-emerald-50 text-emerald-700 border border-emerald-200/80 ring-2 ring-emerald-500/10'}`;
                  statusDot.className = `w-1.5 h-1.5 rounded-full ${isFull ? 'bg-rose-600 animate-pulse' : 'bg-emerald-600 animate-pulse'}`;
                  statusText.textContent = isFull ? 'FULL CAPACITY' : 'ACCEPTING EVACUEES';
                }

                // Subtle visual feedback ping
                singleCard.classList.add('ring-2', 'ring-blue-500/50');
                setTimeout(() => singleCard.classList.remove('ring-2', 'ring-blue-500/50'), 1500);
              }

              // 2. Update Carousel Card if present
              const carouselCard = document.getElementById(`carouselSiteCard-${cId}`);
              if (carouselCard) {
                const cOccEl = document.getElementById(`carouselSiteOccupancy-${cId}`);
                if (cOccEl) cOccEl.textContent = occ;

                const cCapEl = document.getElementById(`carouselSiteCapacity-${cId}`);
                if (cCapEl) cCapEl.textContent = cap;

                const cPctEl = document.getElementById(`carouselSitePct-${cId}`);
                if (cPctEl) cPctEl.textContent = pct;

                const cBar = document.getElementById(`carouselSiteProgressBar-${cId}`);
                if (cBar) {
                  cBar.style.width = pct + '%';
                  cBar.className = `${pct >= 90 ? 'bg-red-500' : (pct >= 75 ? 'bg-amber-500' : 'bg-blue-600')} h-full rounded-full transition-all duration-700 ease-out`;
                }

                const cAvailEl = document.getElementById(`carouselSiteAvailable-${cId}`);
                if (cAvailEl) {
                  cAvailEl.textContent = avail;
                  cAvailEl.className = `text-xs sm:text-sm font-black font-mono ${avail === 0 ? 'text-rose-600' : 'text-emerald-600'}`;
                }

                if (centerData.families !== undefined || centerData.total_families !== undefined) {
                  const cFamEl = document.getElementById(`carouselSiteFamilies-${cId}`);
                  if (cFamEl) cFamEl.textContent = centerData.families !== undefined ? centerData.families : centerData.total_families;
                }

                const cBadge = document.getElementById(`carouselSiteStatusBadge-${cId}`);
                if (cBadge) {
                  cBadge.className = `text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full shrink-0 ${isFull ? 'bg-red-50 text-red-700 border border-red-200/80' : 'bg-emerald-50 text-emerald-700 border border-emerald-200/80'}`;
                  cBadge.textContent = isFull ? 'FULL CAPACITY' : 'ACCEPTING EVACUEES';
                }
              }

              // 3. Update Dashboard Header & Summary Counter if active center
              if (Number(cId) === Number(currentCenterId)) {
                if (document.getElementById('centerOccupancyCount')) {
                  document.getElementById('centerOccupancyCount').innerText = occ;
                }
                if (document.getElementById('heroOccupancy')) {
                  document.getElementById('heroOccupancy').innerText = occ;
                }
              }
            }

            async function refreshAllAssignedCentersLive() {
              try {
                const res = await fetch('/api/centers/active');
                const data = await res.json();
                if (data.success && Array.isArray(data.centers)) {
                  data.centers.forEach(c => updateAssignedFacilityCard(c));
                }
              } catch (e) {
                console.warn('[RescuerDashboard] Live refresh error:', e);
              }
            }

            socket.on('center_updated', function (data) {
              if (data) {
                if (data.center) {
                  updateAssignedFacilityCard(data.center);
                } else if (data.centerId) {
                  updateAssignedFacilityCard({
                    id: data.centerId,
                    occupancy: data.occupancy
                  });
                }
                if (Array.isArray(data.centers)) {
                  data.centers.forEach(c => updateAssignedFacilityCard(c));
                }
                refreshAllAssignedCentersLive();
              }
            });

            socket.on('map_centers_updated', function (data) {
              if (data && Array.isArray(data.centers)) {
                data.centers.forEach(c => updateAssignedFacilityCard(c));
              } else {
                refreshAllAssignedCentersLive();
              }
            });

            socket.on('checkin:new', function (data) {
              if (data && data.center) {
                updateAssignedFacilityCard(data.center);
              }
              if (data && Array.isArray(data.centers)) {
                data.centers.forEach(c => updateAssignedFacilityCard(c));
              }
              refreshAllAssignedCentersLive();
            });

            socket.on('ec_board_updated', function (data) {
              if (data && data.center) {
                updateAssignedFacilityCard(data.center);
              } else {
                refreshAllAssignedCentersLive();
              }
            });

            const isRescuerUser = (window.userStaffType === 'RESCUER' || window.location.pathname.startsWith('/rescuer') || window.location.pathname.startsWith('/staff'));
            if (isRescuerUser) {
              function showStaffSosBanner(sosData) {
                if (typeof window.showGlobalDistressNotification === 'function') {
                  window.showGlobalDistressNotification(sosData);
                }
              }

              function createRadarCardHtml(alert) {
                const alertLat = alert.latitude || alert.lat || 13.5102;
                const alertLng = alert.longitude || alert.lng || 123.3470;
                const alertName = alert.name || (alert.first_name ? `${alert.first_name} ${alert.last_name || ''}`.trim() : 'Resident in Distress');
                const alertInitial = (alertName.charAt(0) || 'R').toUpperCase();
                let alertPhoto = alert.resident_profile_photo || alert.profile_photo || null;
                if (alertPhoto && !alertPhoto.startsWith('http') && !alertPhoto.startsWith('/')) {
                  alertPhoto = `/uploads/profiles/${alertPhoto}`;
                }
                const isPending = alert.status === 'ACTIVE' || !alert.status;
                const isAck = alert.status === 'ACKNOWLEDGED';
                const isResp = alert.status === 'RESPONDING';
                
                let badgeHtml = '';
                if (isPending) {
                  badgeHtml = `<span class="px-1.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-red-100 text-red-700 border border-red-200 shrink-0 inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-pulse"></span> ACTIVE SOS</span>`;
                } else if (isAck) {
                  badgeHtml = `<span class="px-1.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200 shrink-0 inline-flex items-center gap-0.5"><i class="ph ph-check-circle text-[10px]"></i> ACKNOWLEDGED</span>`;
                } else if (isResp) {
                  badgeHtml = `<span class="px-1.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-700 border border-indigo-200 shrink-0 inline-flex items-center gap-0.5"><i class="ph ph-paper-plane-tilt text-[10px]"></i> RESPONDING</span>`;
                } else {
                  badgeHtml = `<span class="px-1.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-700 border border-emerald-200 shrink-0 inline-flex items-center gap-0.5"><i class="ph ph-shield-check text-[10px]"></i> RESCUED</span>`;
                }

                const mapUrl = '<%= isRescuer ? "/rescuer/map" : "/staff/map" %>?sos_id=' + alert.id + '&lat=' + alertLat + '&lng=' + alertLng + '&focus=1';
                const nowTime = new Date().toLocaleTimeString('en-US', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit', hour12: true });

                const phoneHtml = alert.contact_number ? `
                  <span class="text-slate-300 shrink-0">•</span>
                  <span class="text-slate-700 font-mono text-[10.5px] font-semibold flex items-center gap-0.5 shrink-0 hover:text-blue-600">
                    <i class="ph ph-phone text-xs text-slate-400"></i>
                    <span>${alert.contact_number}</span>
                  </span>
                ` : '';

                return `
                  <a href="${mapUrl}"
                    id="dash_sos_card_${alert.id}"
                    data-sos-id="${alert.id}"
                    data-resident-id="${alert.resident_id || alert.residentId || ''}"
                    class="block bg-white hover:bg-slate-50/95 active:scale-[0.99] rounded-2xl p-2.5 xs:p-3 border border-red-400 ring-2 ring-red-400/30 shadow-md transition-all duration-300 group cursor-pointer text-slate-900">
                    <div class="flex items-center justify-between gap-2.5">
                      <div class="w-9 h-9 xs:w-10 xs:h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black text-sm shrink-0 overflow-hidden shadow-xs border border-slate-200">
                        ${alertPhoto ? `<img loading="lazy" src="${alertPhoto}" alt="${alertName}" class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');" /><span class="hidden font-black">${alertInitial}</span>` : `<span class="font-black">${alertInitial}</span>`}
                      </div>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5 flex-wrap">
                          <h3 class="font-black text-slate-950 text-xs xs:text-sm leading-tight truncate group-hover:text-red-700 transition-colors">
                            ${alertName}
                          </h3>
                          <div class="status-badge-wrapper inline-flex items-center">
                            ${badgeHtml}
                          </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[11px] text-slate-500 mt-0.5 leading-snug">
                          <span class="font-bold text-rose-600 flex items-center gap-0.5 shrink-0">
                            <i class="ph ph-map-pin text-xs"></i>
                            <span>${alert.barangay || 'San Rafael'}</span>
                          </span>
                          <span class="text-slate-300 shrink-0">•</span>
                          <span class="font-mono text-[10.5px] text-slate-400 flex items-center gap-0.5 shrink-0">
                            <i class="ph ph-clock text-xs"></i>
                            <span>${nowTime}</span>
                          </span>
                          ${phoneHtml}
                        </div>
                      </div>
                      <div class="w-8 h-8 rounded-xl bg-red-50 group-hover:bg-red-600 text-red-600 group-hover:text-white border border-red-200/90 group-hover:border-red-600 flex items-center justify-center transition-all shrink-0 shadow-2xs" title="Focus on map">
                        <i class="ph ph-navigation-arrow-fill text-xs group-hover:scale-110 transition-transform"></i>
                      </div>
                    </div>
                  </a>
                `;
              }

              function handleIncomingSosAlert(data) {
                if (!data || !data.id) return;
                
                if (typeof showStaffSosBanner === 'function') {
                  showStaffSosBanner(data);
                }
                
                if (typeof playDistressChime === 'function') {
                  try { playDistressChime(); } catch (e) {}
                }

                const existingCard = document.getElementById(`dash_sos_card_${data.id}`);
                if (existingCard) return;

                const container = document.getElementById('dashSosListContainer');
                if (container) {
                  const temp = document.createElement('div');
                  temp.innerHTML = createRadarCardHtml(data).trim();
                  const newCard = temp.firstElementChild;
                  newCard.style.opacity = '0';
                  newCard.style.transform = 'translateY(-8px)';
                  container.prepend(newCard);

                  requestAnimationFrame(() => {
                    newCard.style.transition = 'all 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
                    newCard.style.opacity = '1';
                    newCard.style.transform = 'translateY(0)';
                  });

                  setTimeout(() => {
                    if (newCard) {
                      newCard.classList.remove('ring-2', 'ring-red-400/30', 'border-red-400');
                      newCard.classList.add('border-slate-200/90');
                    }
                  }, 4000);
                }

                updateRadarCountAndEmptyState();
              }

              function removeRadarCard(sosId, residentId) {
                let card = null;
                if (sosId) card = document.getElementById(`dash_sos_card_${sosId}`);
                if (!card && residentId) {
                  card = document.querySelector(`[data-resident-id="${residentId}"]`);
                }
                if (!card && sosId) {
                  card = document.querySelector(`[data-sos-id="${sosId}"]`);
                }
                
                if (card) {
                  card.style.transition = 'all 0.35s ease-out';
                  card.style.opacity = '0';
                  card.style.transform = 'scale(0.95)';
                  setTimeout(() => {
                    if (card && card.parentElement) card.remove();
                    updateRadarCountAndEmptyState();
                  }, 350);
                } else {
                  updateRadarCountAndEmptyState();
                }

                if (typeof window.dismissGlobalDistressBanner === 'function') {
                  window.dismissGlobalDistressBanner(sosId, residentId);
                }
              }

              function updateRadarCountAndEmptyState() {
                const container = document.getElementById('dashSosListContainer');
                const remainingCards = container ? container.querySelectorAll('[id^="dash_sos_card_"]').length : 0;
                const badge = document.getElementById('activeSosCountBadge');
                const pulseDot = document.getElementById('dashRadarPulseDot');
                const emptyState = document.getElementById('dashSosEmptyState');

                if (badge) {
                  if (remainingCards > 0) {
                    badge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] xs:text-[11px] font-black uppercase tracking-wider bg-red-500 text-white shadow-xs';
                    badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> ${remainingCards} Active ${remainingCards === 1 ? 'Signal' : 'Signals'}`;
                  } else {
                    badge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] xs:text-[11px] font-black uppercase tracking-wider bg-slate-800 text-slate-300 border border-slate-700';
                    badge.innerHTML = `0 Active Signals`;
                  }
                }

                if (pulseDot) {
                  if (remainingCards > 0) {
                    pulseDot.classList.remove('hidden');
                  } else {
                    pulseDot.classList.add('hidden');
                  }
                }

                if (remainingCards === 0) {
                  if (container) container.classList.add('hidden');
                  if (emptyState) emptyState.classList.remove('hidden');
                } else {
                  if (container) container.classList.remove('hidden');
                  if (emptyState) emptyState.classList.add('hidden');
                }
              }

              socket.on('sos:new', function (data) {
                if (data) handleIncomingSosAlert(data);
              });

              socket.on('sos_alert', function (data) {
                if (data) handleIncomingSosAlert(data);
              });

              socket.on('sos:cancel', function (data) {
                if (data) {
                  removeRadarCard(data.id || data.sos_id, data.resident_id || data.residentId);
                }
              });

              socket.on('sos:resolve', function (data) {
                if (data) {
                  removeRadarCard(data.id || data.sos_id, data.resident_id || data.residentId);
                }
              });

              socket.on('sos:update_status', function (data) {
                if (data && data.id) {
                  const status = (data.status || '').toUpperCase();
                  if (status === 'RESOLVED' || status === 'CANCELLED') {
                    removeRadarCard(data.id || data.sos_id, data.resident_id || data.residentId);
                  } else {
                    const card = document.getElementById(`dash_sos_card_${data.id}`);
                    if (card) {
                      const badgeWrapper = card.querySelector('.status-badge-wrapper');
                      if (badgeWrapper) {
                        if (status === 'ACKNOWLEDGED') {
                          badgeWrapper.innerHTML = `<span class="px-1.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200 shrink-0 inline-flex items-center gap-0.5"><i class="ph ph-check-circle text-[10px]"></i> ACKNOWLEDGED</span>`;
                        } else if (status === 'RESPONDING') {
                          badgeWrapper.innerHTML = `<span class="px-1.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-indigo-100 text-indigo-700 border border-indigo-200 shrink-0 inline-flex items-center gap-0.5"><i class="ph ph-paper-plane-tilt text-[10px]"></i> RESPONDING</span>`;
                        } else if (status === 'RESCUED') {
                          badgeWrapper.innerHTML = `<span class="px-1.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-700 border border-emerald-200 shrink-0 inline-flex items-center gap-0.5"><i class="ph ph-shield-check text-[10px]"></i> RESCUED</span>`;
                        }
                      }
                    }
                  }
                }
              });
            }
          }

          // Rescuer SOS Lifecycle Button Handler
          window.handleSosLifecycleBtn = async function (btnEl) {
            const sosId = btnEl.getAttribute('data-sos-id');
            const nextStatus = btnEl.getAttribute('data-next-status');
            if (!sosId || !nextStatus) return;

            if (nextStatus === 'RESOLVED' && !confirm('Mark this SOS distress call as resolved?')) {
              return;
            }

            btnEl.disabled = true;
            btnEl.classList.add('opacity-50');

            try {
              const res = await fetch('/rescuer/sos/status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: sosId, status: nextStatus })
              });
              const data = await res.json();
              if (data.success) {
                if (nextStatus === 'RESPONDING' || nextStatus === 'RESCUED') {
                  if (window.EvakWarRescuerTracker) window.EvakWarRescuerTracker.startTracking(sosId);
                } else if (nextStatus === 'RESOLVED') {
                  if (window.EvakWarRescuerTracker) window.EvakWarRescuerTracker.stopTracking();
                }
                if (window.EvakwarWeatherLocation) {
                  window.EvakwarWeatherLocation.showToast(data.message || `Status updated to ${nextStatus}!`);
                }
                setTimeout(() => window.location.reload(), 400);
              } else {
                alert(data.message || 'This SOS has already been assigned to another rescuer.');
                setTimeout(() => window.location.reload(), 400);
              }
            } catch (err) {
              console.error('Error updating SOS status:', err);
              alert('Network error communicating with server.');
              btnEl.disabled = false;
              btnEl.classList.remove('opacity-50');
            }
          };

          // Live ticking clock for Regional Weather Telemetry Card (Asia/Manila)
          function tickStaffWeatherClock() {
            const timeEl = document.getElementById('weatherTime');
            const dayEl = document.getElementById('weatherDay');
            if (timeEl) {
              timeEl.textContent = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Manila' }).toLowerCase();
            }
            if (dayEl) {
              dayEl.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', timeZone: 'Asia/Manila' });
            }
          }
          setInterval(tickStaffWeatherClock, 1000);
          tickStaffWeatherClock();

