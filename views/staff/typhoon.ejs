<%- include('../partials/header') %>

  <% const pagasaData=(locals.weather && locals.weather.pagasa) ? locals.weather.pagasa : {
    warningType: '24-Hour Public Weather Forecast' , affectedArea: 'San Rafael, Baao & Camarines Sur' ,
    issuedAt: 'Updated Today' ,
    residentExplanation: 'Normal to localized rainy weather. Low-lying areas in San Rafael should monitor water levels during heavy downpours.'
    , actionLevel: { level: 'MONITOR' , badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200' , icon: 'ph-eye'
    }, officialBulletinUrl: 'https://bagong.pagasa.dost.gov.ph/' }; %>

    <div class="app-main-layout">
      <%- include('../partials/sidebar') %>

        <main class="app-content h-[calc(100dvh-4rem)] max-h-[calc(100dvh-4rem)] overflow-hidden relative !p-0 !m-0 flex flex-col font-sans bg-slate-900 text-white">

          <!-- RADAR DISCLAIMER BAR -->
            <div
              class="z-10 bg-amber-500/10 backdrop-blur-xs border-b border-amber-500/20 px-3 py-1.5 text-center text-[11px] font-semibold text-amber-200 shrink-0">
              <span><i class="ph ph-info font-bold"></i> LIVE WEATHER MAP (Windy): Visual reference only — refer to
                official PAGASA warnings above for official guidance.</span>
            </div>

            <!-- Live Radar Tracker Full Screen Map -->
            <div id="radarIframeContainer"
              class="relative flex-1 min-h-0 w-full z-0 flex flex-col bg-slate-900 mb-[66px] sm:mb-20 lg:mb-0">
              <iframe id="windyIframe"
                src="https://embed.windy.com/embed.html?type=map&location=coordinates&metricRain=mm&metricTemp=°C&metricWind=km/h&zoom=5&overlay=wind&product=ecmwf&level=surface&lat=13.5102&lon=123.3470&detailLat=13.5102&detailLon=123.3470&detail=true&pressure=true"
                width="100%" height="100%" frameborder="0" class="absolute inset-0 w-full h-full border-0"
                style="max-width: 100%;"></iframe>
            </div>

        </main>
    </div>

    <%- include('../partials/footer') %>