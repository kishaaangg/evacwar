  <!-- JAVASCRIPT LOGIC & HANDLERS -->
  <script>
    // Modal Management
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) {
        el.classList.remove('hidden');
        el.style.display = 'flex';
        document.body.classList.add('overflow-hidden');
      }
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) {
        el.classList.add('hidden');
        el.style.display = 'none';
        document.body.classList.remove('overflow-hidden');
      }
    }

    function openEditStaffModal() { openModal('modalEditStaffProfile'); }
    function openStaffIdentityModal() { openModal('modalStaffIdentity'); }
    function openStaffAssignmentModal() { openModal('modalStaffAssignment'); }
    function openStaffScopeModal() { openModal('modalStaffScope'); }
    function openChangePasswordModal() { openModal('modalChangePassword'); }
    function openLanguageModal() { openModal('modalLanguage'); }
    function openAboutModal() { openModal('modalAbout'); }
    function openStaffProtocolsModal() { openModal('modalStaffProtocols'); }
    function openInstallAppModal() {
      if (window.EvakWarPWA && window.EvakWarPWA.openInstallModal) {
        window.EvakWarPWA.openInstallModal();
      } else {
        openModal('modalInstallApp');
      }
    }
    function closeInstallAppModal() {
      if (window.EvakWarPWA && window.EvakWarPWA.closeInstallModal) {
        window.EvakWarPWA.closeInstallModal();
      } else {
        closeModal('modalInstallApp');
      }
    }

    // Live avatar preview in modal
    function previewModalAvatar(input, targetId) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        if (!file.type.startsWith('image/')) {
          alert('Please select a valid image file.');
          input.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          alert('Image file size must be less than 10MB.');
          input.value = '';
          return;
        }
        const reader = new FileReader();
        reader.onload = function (e) {
          const preview = document.getElementById(targetId);
          if (preview) preview.src = e.target.result;
        };
        reader.readAsDataURL(file);
      }
    }

    // Avatar Upload Trigger
    function previewAndSubmitAvatar(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        if (!file.type.startsWith('image/')) {
          alert('Please select a valid image file.');
          input.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          alert('Image file size must be less than 10MB.');
          input.value = '';
          return;
        }
        document.getElementById('avatarUploadForm').submit();
      }
    }

    // Shared Centralized Language Engine Trigger
    function chooseLanguage(lang, label) {
      if (window.setAppLanguage) {
        window.setAppLanguage(lang, label);
      }
      closeModal('modalLanguage');
    }

    // Theme (Light / Dark) Toggle
    function toggleDarkMode(isDark) {
      const label = document.getElementById('theme-mode-label');
      const icon = document.getElementById('theme-icon');
      
      if (isDark) {
        document.documentElement.classList.add('dark');
        localStorage.setItem('Evacwar_theme', 'dark');
        if (label) label.innerText = 'Dark Mode Active';
        if (icon) icon.className = 'ph ph-sun text-xl text-amber-500';
      } else {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('Evacwar_theme', 'light');
        if (label) label.innerText = 'Light Mode Active';
        if (icon) icon.className = 'ph ph-moon-stars text-xl text-amber-600';
      }
    }

    // Initialize Preferences on Load
    document.addEventListener('DOMContentLoaded', () => {
      // Theme
      const savedTheme = localStorage.getItem('Evacwar_theme');
      const toggleInput = document.getElementById('theme-toggle-input');
      if (savedTheme === 'dark') {
        if (toggleInput) toggleInput.checked = true;
        toggleDarkMode(true);
      } else {
        if (toggleInput) toggleInput.checked = false;
        toggleDarkMode(false);
      }

      // Shared Language
      if (window.applyCurrentLanguage) {
        window.applyCurrentLanguage();
      }

      // Sync PWA status badges
      if (window.EvakWarPWA && window.EvakWarPWA.syncUI) {
        window.EvakWarPWA.syncUI();
      }

      // Support auto-opening edit modal via query param ?openModal=editProfile
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('openModal') === 'editProfile' || urlParams.get('edit') === '1') {
        openEditStaffModal();
      }

      // Validation for Staff Edit Profile Form
      const formEditStaff = document.getElementById('formEditStaffProfile');
      if (formEditStaff) {
        formEditStaff.addEventListener('submit', function (e) {
          let contact = (document.getElementById('staff_edit_contact')?.value || '').trim();
          if (contact) {
            contact = contact.replace(/[\s\-\(\)]/g, '');
            if (contact.startsWith('+63')) contact = '0' + contact.slice(3);
            if (contact.startsWith('63')) contact = '0' + contact.slice(2);
            if (!/^09\d{9}$/.test(contact)) {
              e.preventDefault();
              alert('Please enter a valid 11-digit Philippine mobile number starting with 09 (e.g., 09123456789).');
              document.getElementById('staff_edit_contact')?.focus();
              return false;
            }
          }
        });
      }

      // Validation for Staff Change Password Form
      const formStaffPass = document.getElementById('formStaffChangePassword');
      if (formStaffPass) {
        formStaffPass.addEventListener('submit', function (e) {
          const newPass = (document.getElementById('staff_new_password')?.value || '').trim();
          const confPass = (document.getElementById('staff_confirm_password')?.value || '').trim();

          if (newPass.length < 8 || !/[a-zA-Z]/.test(newPass) || !/[0-9]/.test(newPass)) {
            e.preventDefault();
            alert('Password must be at least 8 characters long and contain both letters and numbers.');
            document.getElementById('staff_new_password')?.focus();
            return false;
          }

          if (newPass !== confPass) {
            e.preventDefault();
            alert('New password and confirmation password do not match.');
            document.getElementById('staff_confirm_password')?.focus();
            return false;
          }
        });
      }

      // Close modal on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          ['modalEditStaffProfile', 'modalStaffIdentity', 'modalStaffAssignment', 'modalStaffScope', 'modalChangePassword', 'modalLanguage', 'modalAbout', 'modalStaffProtocols', 'modalInstallApp'].forEach(id => {
            closeModal(id);
          });
        }
      });
    });
  </script>

