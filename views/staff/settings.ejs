  <!-- 5. MODAL: CHANGE PASSWORD -->
  <div id="modalChangePassword" class="fixed inset-0 z-[120] hidden bg-slate-900/60 backdrop-blur-sm overflow-y-auto pt-6 sm:pt-10 pb-36 px-3.5 flex justify-center items-start" onclick="if(event.target===this)closeModal('modalChangePassword')">
    <div class="modal-content-card bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full overflow-hidden animate-scale-in">
      <div class="px-5 py-4 bg-white border-b border-slate-100 flex items-center justify-between">
