<%- include('../partials/header') %>

  <style>
    .custom-scrollbar::-webkit-scrollbar {
      width: 5px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 20px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background-color: #cbd5e1;
      border-radius: 20px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background-color: #94a3b8;
    }

  </style>

  <div class="app-main-layout">
    <%- include('../partials/sidebar') %>

      <main class="app-content flex flex-col min-h-screen bg-slate-100/80 relative pb-44 lg:pb-16 overflow-x-hidden">
        
        <!-- Ambient background aura -->
        <div class="absolute top-0 left-0 w-full h-72 bg-gradient-to-b from-blue-900/15 via-indigo-900/5 to-transparent pointer-events-none -z-10"></div>
        <div class="absolute top-12 right-4 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

        <div class="max-w-xl mx-auto w-full px-3.5 sm:px-6 py-4 sm:py-6 space-y-4 relative z-10">

          <!-- TOP BAR WITH BACK BUTTON & TITLE -->
          <div class="flex items-center justify-between px-1 mb-1">
            <a href="/staff" class="w-10 h-10 rounded-full bg-white shadow-xs border border-slate-200/80 flex items-center justify-center text-slate-700 hover:bg-slate-50 transition-transform active:scale-95 profile-card">
              <i class="ph ph-arrow-left text-lg font-bold"></i>
            </a>
            <h1 class="text-xl sm:text-2xl font-black font-heading text-slate-900 tracking-tight profile-text-dark" data-i18n="page_title_staff">Staff Profile</h1>
            <div class="w-10 h-10"></div>
          </div>

          <!-- FEEDBACK NOTIFICATIONS -->
          <% if (locals.statusMsg) { %>
            <div class="p-3.5 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-2xl shadow-xs flex items-center justify-between gap-3 animate-fade-in">
              <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold">
                <i class="ph ph-check-circle text-xl text-emerald-600 shrink-0"></i>
                <span><%= locals.statusMsg %></span>
              </div>
              <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-950 text-base"><i class="ph ph-x"></i></button>
            </div>
          <% } %>

          <% if (locals.errorMsg) { %>
            <div class="p-3.5 bg-red-50 border border-red-200 text-red-900 rounded-2xl shadow-xs flex items-center justify-between gap-3 animate-fade-in">
              <div class="flex items-center gap-2.5 text-xs sm:text-sm font-bold">
                <i class="ph ph-warning-circle text-xl text-red-600 shrink-0"></i>
                <span><%= locals.errorMsg %></span>
              </div>
              <button onclick="this.parentElement.remove()" class="text-red-700 hover:text-red-950 text-base"><i class="ph ph-x"></i></button>
            </div>
          <% } %>

          <!-- 1. STAFF PROFILE HERO CARD -->
          <div class="profile-card bg-white rounded-3xl p-4 sm:p-5 shadow-sm border border-slate-200/90 relative overflow-hidden transition-all hover:shadow-md">
            
            <form id="avatarUploadForm" action="/staff/profile" method="POST" enctype="multipart/form-data" class="hidden">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <input type="file" id="photo-upload-input" name="profile_photo" accept="image/*" onchange="previewAndSubmitAvatar(this)" />
            </form>

            <div class="flex items-center gap-3.5 sm:gap-4 min-w-0">
              
              <!-- Avatar Circle with Camera Overlay (Strictly Fixed 72px Dimensions) -->
              <div class="relative shrink-0 w-16 h-16 sm:w-20 sm:h-20" style="width: 72px; height: 72px; min-width: 72px; min-height: 72px; max-width: 72px; max-height: 72px;">
                <div class="w-full h-full rounded-full overflow-hidden bg-slate-100 border-2 border-white shadow-md ring-2 ring-blue-200 flex items-center justify-center relative">
                  <% 
                    let rawProfilePhoto = (staff && staff.profile_photo) ? staff.profile_photo : (user && user.profile_photo ? user.profile_photo : null);
                    let profilePhotoSrc = null;
                    if (rawProfilePhoto) {
                      profilePhotoSrc = (rawProfilePhoto.startsWith('http') || rawProfilePhoto.startsWith('/')) ? rawProfilePhoto : `/uploads/profiles/${rawProfilePhoto}`;
                    }
                  %>
                  <% if (profilePhotoSrc) { %>
                    <img loading="lazy" id="profile-avatar-display" src="<%= profilePhotoSrc %>" decoding="async" alt="<%= staff ? staff.full_name : user.name %>" class="w-full h-full object-cover rounded-full aspect-square block bg-white" onerror="this.style.display='none'; document.getElementById('profile-avatar-fallback').classList.remove('hidden');" />
                    <div id="profile-avatar-fallback" class="w-full h-full rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-black text-xl hidden">
                      <%= ((staff && staff.first_name) || user.name || 'S').charAt(0).toUpperCase() %>
                    </div>
                  <% } else { %>
                    <div class="w-full h-full rounded-full bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center font-black text-2xl shadow-inner">
                      <%= ((staff && staff.first_name) || user.name || 'S').charAt(0).toUpperCase() %>
                    </div>
                  <% } %>
                </div>
                
                <label for="photo-upload-input" title="Upload new photo" class="absolute bottom-0 right-0 w-6 h-6 rounded-full bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center cursor-pointer shadow-md border-2 border-white transition-transform active:scale-90">
                  <i class="ph ph-camera text-xs"></i>
                </label>
              </div>

              <!-- Staff Information Details -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap mb-0.5">
                  <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight truncate max-w-[200px] sm:max-w-xs profile-text-dark">
                    <%= staff && staff.full_name ? staff.full_name : user.name %>
                  </h2>
                  <i class="ph ph-seal-check-fill text-blue-600 text-base shrink-0" title="Verified Staff Responder"></i>
                </div>

                <div class="flex items-center gap-1.5 flex-wrap text-xs text-slate-500 font-semibold mb-1.5 profile-text-muted">
                  <span class="truncate"><%= staff && staff.occupation ? staff.occupation : 'Emergency Response Staff' %></span>
                  <span>•</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-100 text-blue-700 border border-blue-200/80">
                    <%= staff && staff.staff_type ? staff.staff_type : 'BOTH' %>
                  </span>
                </div>

                <div class="flex items-center gap-2 flex-wrap text-[11px] text-slate-600 profile-text-muted">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-slate-100 font-bold border border-slate-200/80 profile-sub-bg">
                    <i class="ph ph-map-pin text-red-500"></i>
                    <%= staff && staff.assigned_barangay ? ('Brgy. ' + staff.assigned_barangay) : 'Brgy. San Rafael' %>
                  </span>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 font-bold border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <%= staff && staff.status ? staff.status : 'ACTIVE' %>
                  </span>
                </div>
              </div>

            </div>

            <!-- Manage Profile CTA Button -->
            <div class="mt-4 pt-3.5 border-t border-slate-100 flex items-center justify-between gap-3">
              <span class="text-xs text-slate-500 font-medium profile-text-muted truncate">
                <i class="ph ph-shield-check text-blue-600 mr-1"></i>
                <span data-i18n="verified_staff_account">Verified Staff Account</span>
              </span>
              <button type="button" onclick="openEditStaffModal()" class="px-3.5 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 font-extrabold text-xs transition-colors flex items-center gap-1.5 active:scale-95 shrink-0 border border-blue-200/70">
                <i class="ph ph-pencil-simple text-sm"></i>
                <span data-i18n="btn_manage_profile">Manage Profile</span>
              </button>
            </div>

          </div>

          <!-- 2. SECTION: STAFF ACCOUNT -->
          <div class="profile-section-card bg-white rounded-3xl p-2 shadow-xs border border-slate-200/90 space-y-1">
            <div class="px-3.5 pt-2.5 pb-1 text-[11px] font-black uppercase tracking-wider text-slate-400" data-i18n="sec_staff_account">
              STAFF ACCOUNT
            </div>

            <!-- Manage Profile Option -->
            <button type="button" onclick="openEditStaffModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-user-gear text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark" data-i18n="row_manage_staff_profile">Manage Staff Profile</div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted" data-i18n="sub_manage_staff_profile">Update name, occupation, contact number, and email</div>
                </div>
              </div>
              <i class="ph ph-caret-right text-slate-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
            </button>

            <!-- Staff Identity Option -->
            <button type="button" onclick="openStaffIdentityModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-identification-card text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark" data-i18n="row_staff_identity">Staff Identity Information</div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted" data-i18n="sub_staff_identity">View staff role, user ID, and system credentials</div>
                </div>
              </div>
              <i class="ph ph-caret-right text-slate-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
            </button>
          </div>

          <!-- 3. SECTION: ASSIGNMENT & OPERATIONS -->
          <div class="profile-section-card bg-white rounded-3xl p-2 shadow-xs border border-slate-200/90 space-y-1">
            <div class="px-3.5 pt-2.5 pb-1 text-[11px] font-black uppercase tracking-wider text-slate-400" data-i18n="sec_assignment">
              ASSIGNMENT & OPERATIONS
            </div>

            <!-- Assigned Evacuation Center -->
            <button type="button" onclick="openStaffAssignmentModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-buildings text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark" data-i18n="row_assigned_center">Assigned Evacuation Center</div>
                  <div class="text-xs text-slate-500 font-semibold truncate profile-text-muted">
                    <%= (staff && staff.assigned_centers && staff.assigned_centers.length > 0) ? staff.assigned_centers.map(c => c.name).join(' • ') : (staff && staff.assigned_center_name ? staff.assigned_center_name : 'San Rafael Evacuation Center') %>
                  </div>
                </div>
              </div>
              <span class="text-[10px] uppercase font-black px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200 shrink-0" data-i18n="admin_assigned">Admin Assigned</span>
            </button>

            <!-- Operational Scope & Role -->
            <button type="button" onclick="openStaffScopeModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-crosshair text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark" data-i18n="row_staff_scope">Operational Scope & Role</div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted" data-i18n="all_operations">Evacuation & Rescue Operations</div>
                </div>
              </div>
              <i class="ph ph-caret-right text-slate-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
            </button>
          </div>

          <!-- 4. SECTION: APP SETTINGS -->
          <div class="profile-section-card bg-white rounded-3xl p-2 shadow-xs border border-slate-200/90 space-y-1">
            <div class="px-3.5 pt-2.5 pb-1 text-[11px] font-black uppercase tracking-wider text-slate-400" data-i18n="sec_app_settings">
              APP SETTINGS
            </div>

            <!-- Language Modal Trigger -->
            <button type="button" onclick="openLanguageModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-translate text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark" data-i18n="row_language">Language Settings</div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted" id="current-language-label">English (Default)</div>
                </div>
              </div>
              <i class="ph ph-caret-right text-slate-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
            </button>

            <!-- Install Application -->
            <button type="button" onclick="window.EvakWarPWA ? window.EvakWarPWA.triggerInstall() : openInstallAppModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0 flex-1">
                <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-download-simple text-xl"></i>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark">
                    <span data-i18n="row_install_app">Install Application</span>
                  </div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted mt-0.5" data-i18n="sub_install_app">Install Evacwar on your phone or desktop for quick offline & emergency access</div>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0 ml-2">
                <span data-pwa-install-btn class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-blue-600 text-white shadow-xs group-hover:bg-blue-700 transition-colors shrink-0">
                  <i class="ph ph-download-simple"></i> <span data-i18n="btn_install">Install</span>
                </span>
                <i class="ph ph-caret-right text-slate-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
              </div>
            </button>
          </div>

          <!-- 5. SECTION: SECURITY -->
          <div class="profile-section-card bg-white rounded-3xl p-2 shadow-xs border border-slate-200/90 space-y-1">
            <div class="px-3.5 pt-2.5 pb-1 text-[11px] font-black uppercase tracking-wider text-slate-400" data-i18n="sec_security">
              SECURITY
            </div>

            <!-- Change Password Modal Trigger -->
            <button type="button" onclick="openChangePasswordModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-lock-key text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark" data-i18n="row_change_password">Change Password</div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted" data-i18n="sub_change_password">Update your account login password securely</div>
                </div>
              </div>
              <i class="ph ph-caret-right text-slate-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
            </button>

            <!-- Direct Logout Trigger -->
            <a href="/logout" onclick="openLogoutModal(event)" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-red-50/70 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-sign-out text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-red-600" data-i18n="row_logout">Logout</div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted" data-i18n="sub_logout">Sign out of your account</div>
                </div>
              </div>
              <i class="ph ph-caret-right text-red-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
            </a>
          </div>

          <!-- 6. SECTION: ABOUT -->
          <div class="profile-section-card bg-white rounded-3xl p-2 shadow-xs border border-slate-200/90 space-y-1">
            <div class="px-3.5 pt-2.5 pb-1 text-[11px] font-black uppercase tracking-wider text-slate-400" data-i18n="sec_about">
              ABOUT
            </div>

            <!-- About Evacwar Modal Trigger -->
            <button type="button" onclick="openAboutModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-info text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark" data-i18n="row_about">About Evacwar</div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted" data-i18n="sub_about">Barangay disaster preparedness & SOS assistance system</div>
                </div>
              </div>
              <i class="ph ph-caret-right text-slate-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
            </button>

            <!-- Responder Protocols & Privacy Trigger -->
            <button type="button" onclick="openStaffProtocolsModal()" class="profile-row w-full flex items-center justify-between p-3 rounded-2xl hover:bg-slate-50 transition-colors text-left group">
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="w-10 h-10 rounded-2xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <i class="ph ph-shield-check text-xl"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-slate-800 profile-text-dark" data-i18n="row_protocols">Staff Protocols & Privacy</div>
                  <div class="text-xs text-slate-400 truncate profile-text-muted" data-i18n="sub_protocols">Emergency responder conduct and data protection</div>
                </div>
              </div>
              <i class="ph ph-caret-right text-slate-400 text-base shrink-0 group-hover:translate-x-0.5 transition-transform"></i>
            </button>
          </div>

        </div>
        <%- include('../partials/footer-visible') %>
      </main>
  </div>

  <!-- ==================== MODALS (TOP-ALIGNED, LIGHT HEADERS, ZERO BOTTOM NAVBAR OVERLAP) ==================== -->

  <!-- 1. MODAL: MANAGE STAFF PROFILE -->
  <div id="modalEditStaffProfile" class="fixed inset-0 z-[120] hidden bg-slate-900/60 backdrop-blur-sm overflow-y-auto pt-6 sm:pt-10 pb-36 px-3.5 flex justify-center items-start" onclick="if(event.target===this)closeModal('modalEditStaffProfile')">
    <div class="modal-content-card bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-lg w-full overflow-hidden animate-scale-in">
      <div class="px-5 py-4 bg-white border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-bold text-slate-900 text-base flex items-center gap-2 profile-text-dark">
          <i class="ph ph-user-gear text-blue-600 text-xl"></i>
          <span data-i18n="btn_manage_profile">Manage Staff Profile</span>
        </h3>
        <button type="button" onclick="closeModal('modalEditStaffProfile')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
          <i class="ph ph-x text-sm font-bold"></i>
        </button>
      </div>

      <form id="formEditStaffProfile" action="/staff/profile" method="POST" enctype="multipart/form-data" class="p-5 space-y-4">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

        <!-- Avatar Preview & Upload inside Modal -->
        <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-blue-50/60 border border-blue-100 profile-sub-bg">
          <div class="relative w-14 h-14 rounded-full overflow-hidden bg-slate-100 border-2 border-white shadow-xs shrink-0">
            <img id="staffModalAvatarPreview" src="<%= profilePhotoSrc || '/images/default-avatar.svg' %>" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/images/default-avatar.svg';">
          </div>
          <div class="flex-1 min-w-0">
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1 profile-text-dark">Profile Photo</label>
            <input type="file" name="profile_photo" accept="image/*" class="w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer" onchange="previewModalAvatar(this, 'staffModalAvatarPreview')">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1" data-i18n="lbl_first_name">First Name</label>
            <input type="text" name="first_name" required class="form-control w-full text-sm font-semibold rounded-xl border border-slate-200 p-2.5" value="<%= staff ? (staff.first_name || '') : '' %>" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1" data-i18n="lbl_middle_name">Middle Name (Optional)</label>
            <input type="text" name="middle_name" class="form-control w-full text-sm font-semibold rounded-xl border border-slate-200 p-2.5" value="<%= staff ? (staff.middle_name || '') : '' %>" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1" data-i18n="lbl_last_name">Last Name</label>
