        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/70 space-y-2.5 text-xs profile-sub-bg">
          <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
            <span class="text-slate-500 font-bold" data-i18n="lbl_first_name">First Name</span>
