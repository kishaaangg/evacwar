                <span class="font-black text-sm text-teal-900"><%= c.name %></span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase <%= idx === 0 ? 'bg-teal-200 text-teal-900' : 'bg-teal-100 text-teal-800' %>"><%= idx === 0 ? 'Primary Center' : 'Assigned Site #' + (idx + 1) %></span>
              </div>
              <p class="text-teal-800 font-medium text-xs">
                <i class="ph ph-map-pin mr-1 text-teal-600"></i>
                <%= c.address || 'San Rafael, Baao, Camarines Sur' %>
