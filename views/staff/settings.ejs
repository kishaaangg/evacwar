          </div>
          <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
            <span class="text-slate-500 font-bold" data-i18n="lbl_occupation">Occupation</span>
            <span class="font-black text-slate-900 profile-text-dark"><%= staff && staff.occupation ? staff.occupation : 'Emergency Response Staff' %></span>
          </div>
          <div class="flex justify-between items-center py-1 border-b border-slate-200/60">
            <span class="text-slate-500 font-bold" data-i18n="lbl_contact_number">Contact Number</span>
            <span class="font-black text-slate-900 profile-text-dark"><%= staff && staff.contact_number ? staff.contact_number : '0919-882-1400' %></span>
          </div>
          <div class="flex justify-between items-center py-1">
            <span class="text-slate-500 font-bold" data-i18n="lbl_email">Email</span>
            <span class="font-black text-slate-900 profile-text-dark"><%= staff && staff.email ? staff.email : (user ? user.email : 'N/A') %></span>
          </div>
        </div>

        <div class="flex justify-end pt-2">
          <button type="button" onclick="closeModal('modalStaffIdentity')" class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold" data-i18n="btn_close">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. MODAL: ASSIGNED EVACUATION CENTER -->
