          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1" data-i18n="lbl_occupation">Occupation / Position</label>
            <input type="text" name="occupation" class="form-control w-full text-sm font-semibold rounded-xl border border-slate-200 p-2.5" value="<%= staff ? (staff.occupation || 'Emergency Response Staff') : 'Emergency Response Staff' %>" />
