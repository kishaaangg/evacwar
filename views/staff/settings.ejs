  <!-- 4. MODAL: OPERATIONAL SCOPE -->
  <div id="modalStaffScope" class="fixed inset-0 z-[120] hidden bg-slate-900/60 backdrop-blur-sm overflow-y-auto pt-6 sm:pt-10 pb-36 px-3.5 flex justify-center items-start" onclick="if(event.target===this)closeModal('modalStaffScope')">
