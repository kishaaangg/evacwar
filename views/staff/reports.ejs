<%- include('../partials/header') %>

  <% const staffMember=locals.staff || locals.user || {}; 
     const isRescuer = locals.isRescuer || staffMember.staff_type === 'RESCUER';
     const assignedCenter=staffMember.center || (locals.allCenters && locals.allCenters.length> 0 ? locals.allCenters[0] : null);
  %>

    <div class="app-main-layout">
      <%- include('../partials/sidebar') %>

        <main
          class="app-content flex flex-col !px-0 !pt-0 pb-28 lg:pb-12 relative overflow-x-hidden bg-slate-100/70 min-h-screen">

          <div class="max-w-7xl mx-auto w-full px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4 flex-1">

            <% const assignedSites=(staffMember.assigned_centers && staffMember.assigned_centers.length> 0)
              ? staffMember.assigned_centers : (assignedCenter ? [assignedCenter] : []);
              const activeCenterId = locals.selectedCenterId || (assignedCenter ? assignedCenter.id : (assignedSites[0]
              ? assignedSites[0].id : 1));
              const currentSiteObj = assignedSites.find(s => Number(s.id) === Number(activeCenterId)) || assignedCenter
              || { name: 'Evacuation Center', address: 'San Rafael' };
              %>

              <!-- Professional Header & Facility Switcher Bar -->
              <div
                class="bg-white border border-slate-200 rounded-lg p-3.5 sm:p-4 shadow-2xs flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div
                    class="w-10 h-10 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-lg shrink-0 border border-slate-800">
                    <i class="ph ph-file-text"></i>
                  </div>
                  <div>
                    <div class="flex items-center gap-2 flex-wrap">
                      <h1 class="text-base sm:text-lg font-black text-slate-900 tracking-tight">Evacuee Masterlist &
                        Reports</h1>
                      <span
                        class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase tracking-wider bg-slate-100 text-slate-700 border border-slate-200">DSWD
                        Standard</span>
                    </div>
                    <p class="text-xs text-slate-500 font-medium mt-0.5">
                      Real-time shelter registry, demographic disaggregation, and occupancy tracking
                    </p>
                  </div>
                </div>

                <!-- Site Switcher & Scanner Action -->
                <div class="flex flex-wrap items-center gap-2 pt-2 md:pt-0 border-t md:border-t-0 border-slate-100">
                  <!-- Staff-Only Offline Saved Check-Ins Pill -->
                  <span id="staffOfflineCountHeaderPill"
                    class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-bold bg-slate-50 text-slate-600 border border-slate-200">
                    <i class="ph ph-cloud-check text-emerald-600 text-sm" id="staffOfflineHeaderIcon"></i>
                    <span id="staffOfflineHeaderText">0 Saved Offline</span>
                  </span>
                  <% if (assignedSites.length> 1) { %>
                    <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-300 rounded-md px-2.5 py-1.5">
                      <i class="ph ph-buildings text-blue-700 font-bold text-sm"></i>
                      <span class="text-xs font-bold text-slate-600 shrink-0">Site:</span>
                      <select id="reportSiteSwitch"
                        onchange="window.location.href = '/staff/reports?center_id=' + this.value"
                        class="text-xs font-black text-blue-950 bg-transparent border-0 outline-none cursor-pointer pr-1">
                        <% assignedSites.forEach(s=> { %>
                          <option value="<%= s.id %>" <%=Number(s.id)===Number(activeCenterId) ? 'selected' : '' %>>
                            <%= s.name %>
                          </option>
                          <% }) %>
                      </select>
                    </div>
                    <% } else if (assignedCenter) { %>
                      <div
                        class="inline-flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-md px-3 py-1.5 text-xs text-slate-800 font-bold">
                        <i class="ph ph-map-pin text-blue-600"></i>
                        <span>
                          <%= assignedCenter.name %>
                        </span>
                      </div>
                      <% } %>

                        <a href="/staff/qr?center_id=<%= activeCenterId %>"
                          class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-3.5 py-1.5 rounded-md transition-colors shadow-2xs"
                          title="Open Scanner for this site">
                          <i class="ph ph-qr-code text-sm"></i>
                          <span>Intake Scanner</span>
                        </a>
                </div>
              </div>

              <% const ecStats=locals.ecStats || null; const ecSummary=(ecStats && ecStats.summary) || {
                total_checked_in: 0, total_families: 0, four_ps_count: 0, capacity: 25, occupancy_rate: '0%' ,
                available_slots: 25, today_checkins: 0, today_checkouts: 0 }; const ecBreakdown=(ecStats &&
                ecStats.age_breakdown) || (ecStats && ecStats.age_groups) || {}; const specialCats=(ecStats &&
                ecStats.special_categories) || { pregnant: 0, lactating: 0, pwd: 0, single_headed: 0, serious_illness: 0
                }; const ageLabels=[ { key: '0-11m' , label: '0 – 11 months (Infants)' , icon: 'ph-baby' }, {
                key: '1-3y' , label: '1 – 3 years old (Toddlers)' , icon: 'ph-baby' }, { key: '4-5y' ,
                label: '4 – 5 years old (Preschool)' , icon: 'ph-smiley' }, { key: '6-12y' ,
                label: '6 – 12 years old (Childhood)' , icon: 'ph-student' }, { key: '13-18y' ,
                label: '13 – 18 years old (Adolescents)' , icon: 'ph-person' }, { key: '19-59y' ,
                label: '19 – 59 years old (Adults)' , icon: 'ph-users' }, { key: '60+y' ,
                label: '60+ years old (Senior Citizens)' , icon: 'ph-person' } ]; %>

                <!-- STAFF-ONLY OFFLINE SAVED CHECK-INS TRACKER (Auto-syncs to Official Admin Reports when online) -->
                <div id="staffOfflineQueueReportCard" class="hidden bg-amber-50/90 border border-amber-300 rounded-lg shadow-2xs overflow-hidden">
                  <div class="px-4 py-3 bg-amber-100/80 border-b border-amber-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                    <div class="flex items-start sm:items-center gap-2.5">
                      <div class="w-9 h-9 rounded-lg bg-amber-600 text-white flex items-center justify-center shrink-0 shadow-2xs">
                        <i class="ph ph-cloud-arrow-up text-lg"></i>
                      </div>
                      <div>
                        <div class="flex items-center gap-2 flex-wrap">
                          <h2 class="text-sm font-black text-amber-950 tracking-tight">Saved Offline Check-Ins (Pending Sync)</h2>
                          <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-200/90 text-amber-900 border border-amber-300">
                            Staff Device Only
                          </span>
                        </div>
                        <p class="text-[11px] text-amber-900/80 font-medium mt-0.5">
                          <strong id="offlineSavedRecordsCount">0</strong> check-in record(s) &bull;
                          <strong id="offlineSavedPeopleCount">0</strong> evacuee(s) saved locally. Will automatically sync to Official Admin Reports when internet returns.
                        </p>
                      </div>
                    </div>
                    <button type="button" id="btnSyncStaffOfflineReports" onclick="syncStaffOfflineReportsNow()"
                      class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-black shadow-xs transition-all cursor-pointer active:scale-95 shrink-0">
                      <i class="ph ph-arrows-clockwise text-sm" id="iconSyncStaffOfflineReports"></i>
                      <span id="textSyncStaffOfflineReports">Sync to Official Reports</span>
                    </button>
                  </div>
                  <div id="staffOfflineQueueList" class="divide-y divide-amber-200/70 max-h-60 overflow-y-auto bg-white/80"></div>
                </div>

                <!-- Sync Completed Confirmation Banner -->
                <div id="staffOfflineSyncSuccessBanner" class="hidden bg-emerald-50 border border-emerald-300 text-emerald-900 rounded-lg px-4 py-2.5 text-xs font-bold flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <i class="ph ph-check-circle-fill text-emerald-600 text-base"></i>
                    <span id="staffOfflineSyncSuccessText">Offline check-ins synced to Official Admin Reports!</span>
                  </div>
                  <button type="button" onclick="window.location.reload()" class="px-2.5 py-1 rounded bg-emerald-600 text-white text-[11px] font-black cursor-pointer">
                    Refresh Board
                  </button>
                </div>

                <!-- SECTION 1: Professional Digital Evacuation Center Information Board (Crisp, Non-Rounded Edges) -->
                <div class="bg-white border border-slate-200 rounded-lg shadow-2xs overflow-hidden">
                  <!-- Command Board Header -->
                  <div
                    class="bg-slate-900 text-white p-4 sm:p-5 border-b border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-3">
                    <div>
                      <div class="flex items-center gap-2 flex-wrap">
                        <span
                          class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-amber-400/20 text-amber-300 border border-amber-400/30">
                          <i class="ph ph-presentation-chart"></i> DSWD Field Office V Standard
                        </span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Official Center
                          Board</span>
                      </div>
                      <h2 class="text-lg sm:text-xl font-black tracking-tight text-white mt-1">
                        <%= currentSiteObj.name %>
                      </h2>
                      <p class="text-xs text-slate-300 font-medium flex items-center gap-1.5 mt-0.5">
                        <i class="ph ph-map-pin text-blue-400"></i>
                        <%= currentSiteObj.address || currentSiteObj.name || 'San Rafael' %>
                      </p>
                    </div>

                    <div class="flex items-center gap-2 self-start md:self-auto">
                      <span
                        class="text-xs font-bold px-2.5 py-1 rounded <%= (ecSummary.is_full || ecSummary.available_slots <= 0) ? 'bg-red-950/80 text-red-300 border border-red-800' : 'bg-emerald-950/80 text-emerald-300 border border-emerald-800' %>">
                        <i
                          class="ph <%= (ecSummary.is_full || ecSummary.available_slots <= 0) ? 'ph-warning-circle' : 'ph-check-circle' %>"></i>
                        <%= (ecSummary.is_full || ecSummary.available_slots <=0) ? 'FULL CAPACITY'
                          : 'ACCEPTING EVACUEES' %>
                      </span>
                      <span
                        class="text-xs font-bold text-slate-300 bg-slate-800/90 px-2.5 py-1 rounded border border-slate-700 hidden sm:inline-flex items-center gap-1">
                        <i class="ph ph-clock"></i> Live System Metrics
                      </span>
                    </div>
                  </div>

                  <!-- Key Indicators Grid (Crisp Bordered Tiles) -->
                  <div class="p-4 sm:p-5 bg-slate-50/70 border-b border-slate-200">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
                      <div class="bg-white rounded-md p-3.5 border border-slate-200 shadow-2xs">
                        <div
                          class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">
                          <span>Total Evacuees</span>
                          <i class="ph ph-users text-slate-500 text-base"></i>
                        </div>
                        <div class="text-2xl sm:text-3xl font-black text-slate-900">
                          <%= ecSummary.total_checked_in %>
                        </div>
                        <div class="text-[11px] text-slate-500 font-semibold mt-0.5">Checked-in individuals</div>
                      </div>

                      <div class="bg-white rounded-md p-3.5 border border-slate-200 shadow-2xs">
                        <div
                          class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">
                          <span>Total Families</span>
                          <i class="ph ph-house-line text-blue-600 text-base"></i>
                        </div>
                        <div class="text-2xl sm:text-3xl font-black text-blue-700">
                          <%= ecSummary.total_families %>
                        </div>
                        <div class="text-[11px] text-slate-500 font-semibold mt-0.5">Sheltered household units</div>
                      </div>

                      <div class="bg-white rounded-md p-3.5 border border-slate-200 shadow-2xs">
                        <div
                          class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">
                          <span>Available Slots</span>
                          <i class="ph ph-bed text-emerald-600 text-base"></i>
                        </div>
                        <div class="text-2xl sm:text-3xl font-black text-emerald-700">
                          <%= ecSummary.available_slots %>
                        </div>
                        <div class="text-[11px] text-slate-500 font-semibold mt-0.5">Capacity limit: <%=
                            ecSummary.capacity %>
                        </div>
                      </div>

                      <div class="bg-white rounded-md p-3.5 border border-slate-200 shadow-2xs">
                        <div
                          class="flex items-center justify-between text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">
                          <span>4Ps Beneficiaries</span>
                          <i class="ph ph-certificate text-amber-600 text-base"></i>
                        </div>
                        <div class="text-2xl sm:text-3xl font-black text-amber-700">
                          <%= ecSummary.four_ps_count %>
                        </div>
                        <div class="text-[11px] text-slate-500 font-semibold mt-0.5">Government welfare program</div>
                      </div>
                    </div>
                  </div>

                  <!-- DSWD Age & Sex Disaggregated Matrix Table -->
                  <div class="p-4 sm:p-5 border-b border-slate-200 space-y-3">
                    <div class="flex items-center justify-between">
                      <h3
                        class="font-extrabold text-slate-900 text-xs sm:text-sm uppercase tracking-wider flex items-center gap-2">
                        <i class="ph ph-table text-slate-700 text-base"></i> Age & Sex Disaggregated Demographic Matrix
                        (DSWD)
                      </h3>
                    </div>

                    <div class="overflow-x-auto rounded-md border border-slate-200">
                      <table class="w-full text-left text-xs sm:text-sm border-collapse">
                        <thead class="bg-slate-800 text-white font-bold text-xs uppercase tracking-wider">
                          <tr>
                            <th class="py-2.5 px-3.5 border-r border-slate-700">Age Bracket</th>
                            <th class="py-2.5 px-3.5 text-center bg-blue-900/80 border-r border-slate-700"><i
                                class="ph ph-gender-male"></i> Male (M)</th>
                            <th class="py-2.5 px-3.5 text-center bg-rose-900/80 border-r border-slate-700"><i
                                class="ph ph-gender-female"></i> Female (F)</th>
                            <th class="py-2.5 px-3.5 text-center bg-slate-900 font-black">Subtotal (M + F)</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 font-semibold text-slate-700 bg-white">
                          <% let totalM=0, totalF=0, totalGrand=0; ageLabels.forEach(grp=> {
                            const grpData = ecBreakdown[grp.key] || ecBreakdown[grp.key.replace('-', '_')] || {};
                            const m = grpData.male || 0;
                            const f = grpData.female || 0;
                            const t = m + f;
                            totalM += m;
                            totalF += f;
                            totalGrand += t;
                            %>
                            <tr class="hover:bg-slate-50 transition-colors">
                              <td
                                class="py-2 px-3.5 border-r border-slate-200 flex items-center gap-2 font-bold text-slate-800">
                                <i class="ph <%= grp.icon %> text-slate-400"></i>
                                <%= grp.label %>
                              </td>
                              <td
                                class="py-2 px-3.5 text-center font-bold text-blue-800 bg-blue-50/30 border-r border-slate-200">
                                <%= m %>
                              </td>
                              <td
                                class="py-2 px-3.5 text-center font-bold text-rose-800 bg-rose-50/30 border-r border-slate-200">
                                <%= f %>
                              </td>
                              <td class="py-2 px-3.5 text-center font-black text-slate-900 bg-slate-50/80">
                                <%= t %>
                              </td>
                            </tr>
                            <% }) %>
                        </tbody>
                        <tfoot
                          class="bg-slate-100 border-t-2 border-slate-300 font-black text-slate-900 text-xs sm:text-sm">
                          <tr>
                            <td class="py-2.5 px-3.5 uppercase border-r border-slate-300">Grand Total</td>
                            <td
                              class="py-2.5 px-3.5 text-center text-blue-900 bg-blue-100/70 border-r border-slate-300 font-black">
                              <%= totalM %>
                            </td>
                            <td
                              class="py-2.5 px-3.5 text-center text-rose-900 bg-rose-100/70 border-r border-slate-300 font-black">
                              <%= totalF %>
                            </td>
                            <td class="py-2.5 px-3.5 text-center text-slate-950 bg-slate-200 font-black">
                              <%= totalGrand %>
                            </td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  </div>

                  <!-- Vulnerabilities & Special Sector Demographics -->
                  <div class="p-4 sm:p-5 bg-white">
                    <div
                      class="text-xs font-black uppercase tracking-wider text-slate-600 mb-2.5 flex items-center gap-1.5">
                      <i class="ph ph-heart-straight text-rose-600"></i> Vulnerable & High-Risk Sector Breakdown
                    </div>
                    <div
                      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 text-slate-900 text-xs font-extrabold">
                      <div class="bg-slate-50 rounded-md p-3 border border-slate-200 text-center">
                        <div class="text-xl font-black text-rose-700">
                          <%= specialCats.pregnant || 0 %>
                        </div>
                        <div class="text-[10px] uppercase font-bold text-slate-600 tracking-wider mt-0.5">Pregnant Women
                        </div>
                      </div>

                      <div class="bg-slate-50 rounded-md p-3 border border-slate-200 text-center">
                        <div class="text-xl font-black text-pink-700">
                          <%= specialCats.lactating || 0 %>
                        </div>
                        <div class="text-[10px] uppercase font-bold text-slate-600 tracking-wider mt-0.5">Lactating
                          Mothers</div>
                      </div>

                      <div class="bg-slate-50 rounded-md p-3 border border-slate-200 text-center">
                        <div class="text-xl font-black text-purple-700">
                          <%= specialCats.pwd || 0 %>
                        </div>
                        <div class="text-[10px] uppercase font-bold text-slate-600 tracking-wider mt-0.5">PWD</div>
                      </div>

                      <div class="bg-slate-50 rounded-md p-3 border border-slate-200 text-center">
                        <div class="text-xl font-black text-indigo-700">
                          <%= specialCats.single_headed || 0 %>
                        </div>
                        <div class="text-[10px] uppercase font-bold text-slate-600 tracking-wider mt-0.5">Single-Headed
                        </div>
                      </div>

                      <div
                        class="bg-slate-50 rounded-md p-3 border border-slate-200 text-center col-span-2 sm:col-span-1">
                        <div class="text-xl font-black text-red-700">
                          <%= specialCats.serious_illness || 0 %>
                        </div>
                        <div class="text-[10px] uppercase font-bold text-slate-600 tracking-wider mt-0.5">Serious
                          Illness</div>
                      </div>
                    </div>
                  </div>

                </div>

                <!-- Filter & Tab Toolbar (Clean, Crisp Styling) -->
                <div
                  class="bg-white rounded-lg p-3.5 sm:p-4 shadow-2xs border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3">
                  <!-- Active / Departed Tabs -->
                  <div class="flex items-center bg-slate-100 p-1 rounded-md">
                    <button type="button" id="tabActiveBtn" onclick="switchMasterTab('active')"
                      class="px-3.5 py-1.5 rounded text-xs font-bold bg-white text-slate-900 shadow-2xs flex items-center gap-1.5 transition-all">
                      <i class="ph ph-users-three text-sm text-blue-600"></i> Active Evacuees
                      <span class="ml-1 px-1.5 py-0.2 rounded text-[10px] bg-blue-100 text-blue-800 font-black"
                        id="activeCountBadge">
                        <%= locals.activeEvacuees ? locals.activeEvacuees.length : 0 %>
                      </span>
                    </button>
                    <button type="button" id="tabDepartedBtn" onclick="switchMasterTab('departed')"
                      class="px-3.5 py-1.5 rounded text-xs font-bold text-slate-600 hover:text-slate-900 flex items-center gap-1.5 transition-all">
                      <i class="ph ph-sign-out text-sm"></i> Departed
                      <span class="ml-1 px-1.5 py-0.2 rounded text-[10px] bg-slate-200 text-slate-700 font-black">
                        <%= locals.departedEvacuees ? locals.departedEvacuees.length : 0 %>
                      </span>
                    </button>
                  </div>

                  <!-- Search and Filter Inputs -->
                  <div class="flex flex-col sm:flex-row items-center gap-2.5 w-full md:w-auto">
                    <div class="relative w-full sm:w-64">
                      <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                      <input type="text" id="evacueeSearchInput" oninput="filterTable()"
                        placeholder="Search name, purok..."
                        class="form-control pl-9 py-1.5 text-xs w-full rounded-md border-slate-300" />
                    </div>

                    <select id="vulnerabilityFilter" onchange="filterTable()"
                      class="form-control text-xs py-1.5 bg-slate-50 font-semibold border-slate-300 rounded-md w-full sm:w-auto">
                      <option value="all">All Categories</option>
                      <option value="4ps">4Ps Beneficiaries</option>
                      <option value="pwd">PWD</option>
                      <option value="pregnant">Pregnant / Lactating</option>
                      <option value="illness">Serious Illness</option>
                    </select>
                  </div>
                </div>

                <!-- 1. ACTIVE EVACUEES SECTION -->
                <div id="sectionActive" class="space-y-4">
                  <div class="bg-white rounded-lg shadow-2xs border border-slate-200 overflow-hidden">

                    <!-- Desktop Table -->
                    <div class="hidden md:block overflow-x-auto">
                      <table class="data-table w-full text-sm">
                        <thead
                          class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wider text-slate-600">
                          <tr>
                            <th>Evacuee Name</th>
                            <th>Family / Household</th>
                            <th>Age / Sex</th>
                            <th>Special Needs</th>
                            <th>Intake Method</th>
                            <th>Check-in Time</th>
                            <th class="text-right">Actions</th>
                          </tr>
                        </thead>
                        <tbody id="activeTableBody" class="divide-y divide-slate-100">
                          <% if (locals.activeEvacuees && locals.activeEvacuees.length> 0) { %>
                            <% locals.activeEvacuees.forEach(person=> { %>
                              <tr class="hover:bg-slate-50 transition-colors evacuee-row"
                                data-name="<%= person.name.toLowerCase() %>"
                                data-purok="<%= person.purok.toLowerCase() %>"
                                data-4ps="<%= person.is_4ps ? '1' : '0' %>" data-pwd="<%= person.is_pwd ? '1' : '0' %>"
                                data-pregnant="<%= person.is_pregnant ? '1' : '0' %>"
                                data-illness="<%= person.has_serious_illness ? '1' : '0' %>">
                                <td>
                                  <div class="flex items-center gap-3">
                                    <div
                                      class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs">
                                      <%= person.name.charAt(0) %>
                                    </div>
                                    <div>
                                      <div class="font-bold text-slate-800">
                                        <%= person.name %>
                                      </div>
                                      <div class="text-xs text-slate-400">
                                        <%= person.purok %>
                                      </div>
                                    </div>
                                  </div>
                                </td>
                                <td>
                                  <div>
                                    <span
                                      class="inline-flex items-center gap-1 text-xs font-bold <%= person.is_head ? 'text-blue-700 bg-blue-50 px-2 py-0.5 rounded' : 'text-slate-600' %>">
                                      <%= person.is_head ? 'Household Head' : person.relation %>
                                    </span>
                                    <% if (!person.is_head) { %>
