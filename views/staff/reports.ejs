      <script>
        // SITE STAFF EVACUEE MASTERLIST FILTER & CHECKOUT SCRIPTS
        // =========================================================================
        function switchMasterTab(tab) {
          const activeBtn = document.getElementById('tabActiveBtn');
          const departedBtn = document.getElementById('tabDepartedBtn');
          const secActive = document.getElementById('sectionActive');
          const secDeparted = document.getElementById('sectionDeparted');

          if (!activeBtn || !departedBtn || !secActive || !secDeparted) return;

          if (tab === 'departed') {
            departedBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-white text-blue-900 shadow-sm flex items-center gap-1.5 transition-all';
            activeBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 flex items-center gap-1.5 transition-all';
            secActive.classList.add('hidden');
            secDeparted.classList.remove('hidden');
          } else {
            activeBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-white text-blue-900 shadow-sm flex items-center gap-1.5 transition-all';
            departedBtn.className = 'px-4 py-2 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 flex items-center gap-1.5 transition-all';
            secDeparted.classList.add('hidden');
            secActive.classList.remove('hidden');
          }
        }

        function filterTable() {
          const query = (document.getElementById('evacueeSearchInput')?.value || '').toLowerCase().trim();
          const vulFilter = document.getElementById('vulnerabilityFilter')?.value;

          const rows = document.querySelectorAll('.evacuee-row');
          rows.forEach(r => {
            const name = r.getAttribute('data-name') || '';
            const purok = r.getAttribute('data-purok') || '';
            const is4ps = r.getAttribute('data-4ps') === '1';
            const isPwd = r.getAttribute('data-pwd') === '1';
            const isPreg = r.getAttribute('data-pregnant') === '1';
            const isIll = r.getAttribute('data-illness') === '1';

            const matchesQuery = !query || name.includes(query) || purok.includes(query);
            let matchesVul = true;
            if (vulFilter === '4ps') matchesVul = is4ps;
            else if (vulFilter === 'pwd') matchesVul = isPwd;
            else if (vulFilter === 'pregnant') matchesVul = isPreg;
            else if (vulFilter === 'illness') matchesVul = isIll;

            if (matchesQuery && matchesVul) {
              r.style.display = '';
            } else {
              r.style.display = 'none';
            }
          });
        }

        function handleCheckoutBtn(btn) {
          const checkInId = parseInt(btn.getAttribute('data-checkin-id'), 10);
          const residentId = parseInt(btn.getAttribute('data-resident-id'), 10);
          const checkoutFamily = btn.getAttribute('data-family') === 'true';
          const displayName = btn.getAttribute('data-name') || 'Evacuee';
          processCheckout(checkInId, residentId, checkoutFamily, displayName);
        }

        function processCheckout(checkInId, residentId, checkoutFamily, displayName) {
          const promptText = checkoutFamily
            ? `Are you sure you want to CHECK OUT all active members of "${displayName}"?`
            : `Are you sure you want to CHECK OUT "${displayName}" from the evacuation center?`;

          if (!confirm(promptText)) return;

          fetch('/staff/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              check_in_id: checkInId,
              resident_id: residentId,
              checkout_all_family: checkoutFamily
            })
          })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                alert(data.message || 'Evacuee successfully checked out.');
                window.location.reload();
              } else {
                alert('Check-out failed: ' + data.message);
              }
            })
            .catch(err => {
              console.error("Checkout error:", err);
              alert('Server or network error during check-out.');
            });
        }
      </script>


      <script>
        // =========================================================================
        // STAFF-ONLY OFFLINE SAVED CHECK-INS TRACKER & AUTO-SYNC TO ADMIN REPORTS
        // =========================================================================
        async function collectOfflineSavedCheckins() {
          const items = [];

          // 1. Read Dexie EvakWarLocalDB.pending_operations
          try {
            let dexieOps = [];
            if (window.EvakWarDB && typeof window.EvakWarDB.getPendingOperations === 'function') {
              dexieOps = await window.EvakWarDB.getPendingOperations();
            } else {
              const DexieClass = (typeof Dexie !== 'undefined' ? Dexie : null) || window.Dexie;
              if (DexieClass) {
                const d = new DexieClass('EvakWarLocalDB');
                d.version(1).stores({
                  pending_operations: 'clientOperationId, operationType, centerId, staffId, syncStatus, createdAt',
                  staff_assigned_sites: 'id, name, is_active',
                  resident_roster: 'lookupKey, residentId, qrUuid, nameLower',
                  map_data: 'id, updatedAt',
                  app_state: 'key'
                });
                await d.open();
                dexieOps = await d.pending_operations.where('syncStatus').anyOf(['PENDING', 'FAILED', 'SYNCING']).toArray();
              }
            }
            (dexieOps || []).forEach(op => {
              const p = op.payload || {};
              let peopleCount = 1;
              if (op.operationType === 'CHECK_IN') {
                const headCnt = (p.check_in_head === true || p.check_in_head === 'true' || p.check_in_head === 1) ? 1 : 0;
                const memCnt = Array.isArray(p.member_ids) ? p.member_ids.length : 0;
                peopleCount = Math.max(1, headCnt + memCnt);
              } else if (op.operationType === 'WALK_IN') {
                peopleCount = 1 + (Array.isArray(p.members) ? p.members.length : 0);
              }
              items.push({
                source: 'dexie',
                type: op.operationType || 'CHECK_IN',
                label: op.description || (p.first_name ? `${p.first_name} ${p.last_name || ''}`.trim() : `Resident #${p.resident_id || 'N/A'}`),
                peopleCount: peopleCount,
                method: (p.check_in_method || (op.operationType === 'WALK_IN' ? 'WALK-IN' : 'QR')).toUpperCase(),
                savedAt: op.createdAt || new Date().toISOString()
              });
            });
          } catch (e) {
            console.warn('[Staff Reports] Dexie offline queue read warning:', e.message);
          }

          // 2. Read Capacitor bridge localStorage fallback queue (evw_offline_checkins)
          try {
            const rawLs = JSON.parse(localStorage.getItem('evw_offline_checkins') || '[]');
            if (Array.isArray(rawLs)) {
              rawLs.forEach(entry => {
                const p = entry.payload || {};
                const headCnt = (p.check_in_head === false) ? 0 : 1;
                const memCnt = Array.isArray(p.member_ids) ? p.member_ids.length : 0;
                items.push({
                  source: 'localStorage',
                  type: entry.action || 'CHECKIN',
                  label: p.resident_name || (p.first_name ? `${p.first_name} ${p.last_name || ''}`.trim() : `Resident #${p.resident_id || 'Offline'}`),
                  peopleCount: Math.max(1, headCnt + memCnt),
                  method: (p.check_in_method || 'QR').toUpperCase(),
                  savedAt: entry.timestamp ? new Date(entry.timestamp).toISOString() : new Date().toISOString()
                });
              });
            }
          } catch (_) {}

          return items;
        }

        async function renderStaffOfflineCheckinsPanel() {
          const items = await collectOfflineSavedCheckins();
          const totalRecords = items.length;
          const totalPeople = items.reduce((sum, it) => sum + (Number(it.peopleCount) || 1), 0);

          const card = document.getElementById('staffOfflineQueueReportCard');
          const listEl = document.getElementById('staffOfflineQueueList');
          const recCountEl = document.getElementById('offlineSavedRecordsCount');
          const pplCountEl = document.getElementById('offlineSavedPeopleCount');
          const headerPill = document.getElementById('staffOfflineCountHeaderPill');
          const headerIcon = document.getElementById('staffOfflineHeaderIcon');
          const headerText = document.getElementById('staffOfflineHeaderText');
          const syncBtn = document.getElementById('btnSyncStaffOfflineReports');

          if (headerPill && headerText && headerIcon) {
            if (totalRecords > 0) {
              headerPill.className = 'inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-black bg-amber-100 text-amber-900 border border-amber-300';
              headerIcon.className = 'ph ph-cloud-arrow-up text-amber-700 text-sm';
              headerText.textContent = `${totalRecords} Saved Offline (${totalPeople} Evacuee${totalPeople > 1 ? 's' : ''})`;
            } else {
              headerPill.className = 'inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-bold bg-slate-50 text-slate-600 border border-slate-200';
              headerIcon.className = 'ph ph-cloud-check text-emerald-600 text-sm';
              headerText.textContent = '0 Saved Offline';
            }
          }

          if (!card || !listEl) return;

          if (totalRecords === 0) {
            card.classList.add('hidden');
            listEl.innerHTML = '';
            return;
          }

          card.classList.remove('hidden');
          if (recCountEl) recCountEl.textContent = String(totalRecords);
          if (pplCountEl) pplCountEl.textContent = String(totalPeople);

          if (syncBtn) {
            syncBtn.disabled = !navigator.onLine;
            if (!navigator.onLine) {
              syncBtn.classList.add('opacity-60', 'cursor-not-allowed');
              const txt = document.getElementById('textSyncStaffOfflineReports');
              if (txt) txt.textContent = 'Waiting for Internet...';
            } else {
              syncBtn.classList.remove('opacity-60', 'cursor-not-allowed');
              const txt = document.getElementById('textSyncStaffOfflineReports');
              if (txt) txt.textContent = 'Sync to Official Reports';
            }
          }

          listEl.innerHTML = items.map(it => {
            let timeStr = 'Saved Offline';
            try {
              timeStr = new Date(it.savedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
            } catch (_) {}
            return `
              <div class="px-4 py-2.5 flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-xs font-black text-slate-900 truncate">${String(it.label).replace(/</g, '&lt;')}</span>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-black bg-amber-100 text-amber-900 border border-amber-200">
                      ${it.peopleCount} Person${it.peopleCount > 1 ? 's' : ''}
                    </span>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">
                      ${it.method}
                    </span>
                  </div>
                  <p class="text-[11px] text-slate-500 mt-0.5">Saved at ${timeStr} &bull; Pending upload to Official Admin Report</p>
                </div>
                <span class="shrink-0 px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-50 text-amber-800 border border-amber-300">
                  Offline Queue
                </span>
              </div>
            `;
          }).join('');
        }

        async function syncStaffOfflineReportsNow() {
          if (!navigator.onLine) {
            alert('You are currently offline. Check-ins will automatically sync once internet connection returns.');
            return;
          }
          const btn = document.getElementById('btnSyncStaffOfflineReports');
          const icon = document.getElementById('iconSyncStaffOfflineReports');
          const text = document.getElementById('textSyncStaffOfflineReports');
          if (btn) btn.disabled = true;
          if (icon) icon.className = 'ph ph-spinner animate-spin text-sm';
          if (text) text.textContent = 'Syncing...';

          let totalSynced = 0;
          try {
            if (window.EvakWarDB && typeof window.EvakWarDB.syncPending === 'function') {
              const r = await window.EvakWarDB.syncPending();
              if (r && (r.syncedCount || r.synced)) {
                totalSynced += Number(r.syncedCount || r.synced || 0);
              }
            }
            if (typeof window.syncOfflineStaffCheckins === 'function') {
              const beforeLs = JSON.parse(localStorage.getItem('evw_offline_checkins') || '[]').length;
              await window.syncOfflineStaffCheckins();
              const afterLs = JSON.parse(localStorage.getItem('evw_offline_checkins') || '[]').length;
              if (beforeLs > afterLs) totalSynced += (beforeLs - afterLs);
            }
          } catch (e) {
            console.warn('[Staff Reports] Sync error:', e);
          } finally {
            if (btn) btn.disabled = false;
            if (icon) icon.className = 'ph ph-arrows-clockwise text-sm';
            if (text) text.textContent = 'Sync to Official Reports';
            await renderStaffOfflineCheckinsPanel();
            if (totalSynced > 0) {
              const banner = document.getElementById('staffOfflineSyncSuccessBanner');
              const bannerTxt = document.getElementById('staffOfflineSyncSuccessText');
              if (bannerTxt) bannerTxt.textContent = `Synced ${totalSynced} offline check-in(s) to Official Admin Reports!`;
              if (banner) banner.classList.remove('hidden');
            }
          }
        }
        window.syncStaffOfflineReportsNow = syncStaffOfflineReportsNow;

        document.addEventListener('DOMContentLoaded', () => {
          renderStaffOfflineCheckinsPanel();
          if (navigator.onLine) {
            setTimeout(() => {
              collectOfflineSavedCheckins().then(items => {
                if (items.length > 0) syncStaffOfflineReportsNow();
              });
            }, 1800);
          }
        });
        window.addEventListener('online', () => {
          renderStaffOfflineCheckinsPanel();
          setTimeout(() => syncStaffOfflineReportsNow(), 1500);
        });
        window.addEventListener('offline', () => renderStaffOfflineCheckinsPanel());
        window.addEventListener('Evacwar:queue-changed', () => renderStaffOfflineCheckinsPanel());
        window.addEventListener('Evacwar:sync-completed', (ev) => {
          renderStaffOfflineCheckinsPanel();
          const synced = (ev && ev.detail && ev.detail.syncedCount) || 0;
          if (synced > 0) {
            const banner = document.getElementById('staffOfflineSyncSuccessBanner');
            const bannerTxt = document.getElementById('staffOfflineSyncSuccessText');
            if (bannerTxt) bannerTxt.textContent = `Synced ${synced} offline check-in(s) to Official Admin Reports!`;
            if (banner) banner.classList.remove('hidden');
          }
        });
      </script>
