<%- include('../partials/header') %>

  <% const staffMember=locals.staff || locals.user || {}; const isRescuer=false; const currentUserId=Number((locals.staff && locals.staff.userId) || (locals.user && locals.user.id) || 0); const currentUserRole=String((locals.user && locals.user.role) || (locals.staff && locals.staff.role) || 'staff').toLowerCase(); const
    isEvacuation=staffMember.staff_type==='EVACUATION' ; const isBoth=false; const
    ecStats=locals.ecStats || null; const assignedCenter=isRescuer ? null : (staffMember.center || (locals.allCenters &&
    locals.allCenters.length> 0 ? locals.allCenters[0] : null));
