                </div>
              </div>              <!-- 1. RESCUER EMERGENCY RADAR (FORCED EVACUATION ONLY) -->
              <% if (isRescuer || isBoth) { %>
                <div
                  class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-900/95 to-slate-950 text-white rounded-3xl p-3.5 xs:p-4 sm:p-6 shadow-2xl border border-red-500/30 space-y-3.5 sm:space-y-4">
