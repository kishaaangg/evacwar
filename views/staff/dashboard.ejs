                                  <i class="ph ph-shield-check text-xs"></i>
                                  <span>RESCUED</span>
                                </span>
                              <% } %>

                              <!-- Tap to Call Button -->
                              <% if (alert.contact_number) { %>
                                <a href="tel:<%= alert.contact_number %>"
                                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-blue-50 hover:bg-blue-100 active:scale-95 text-blue-700 font-bold text-xs border border-blue-200/80 transition-all font-mono"
                                  title="Call <%= alertName %>">
                                  <i class="ph ph-phone-call text-xs text-blue-600"></i>
                                  <span><%= alert.contact_number %></span>
                                </a>
                              <% } %>
                            </div>
                          </div>

                          <!-- Situation / Responder Status Notice -->
                          <% if (alert.handler_name) { %>
                            <div class="bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs font-semibold flex items-center justify-between gap-2">
                              <div class="flex items-center gap-1.5 min-w-0">
                                <div class="w-5 h-5 rounded-md bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 text-xs">
                                  <i class="ph ph-user-check"></i>
                                </div>
                                <span class="text-slate-600 truncate">Handled by: <strong class="text-slate-900 font-bold"><%= alert.handler_name %></strong></span>
                              </div>
                              <% if (alert.handler_contact) { %>
                                <a href="tel:<%= alert.handler_contact %>" class="text-blue-600 hover:underline font-mono font-bold shrink-0 flex items-center gap-1 text-[11px]">
                                  <i class="ph ph-phone text-xs"></i>
                                  <span><%= alert.handler_contact %></span>
                                </a>
                              <% } %>
                            </div>
                          <% } else if (isPending) { %>
                            <div class="bg-red-50/90 border border-red-200/80 rounded-xl p-2.5 text-xs font-bold text-red-800 flex items-center gap-2">
                              <div class="w-5 h-5 rounded-md bg-red-100 text-red-600 flex items-center justify-center shrink-0 text-xs">
                                <i class="ph ph-clock"></i>
                              </div>
                              <span>Situation: <strong class="text-red-900">Awaiting Rescuer Acknowledgment</strong></span>
                            </div>
                          <% } %>

                          <!-- Distress Report Note (if present) -->
                          <% if (alert.message || alert.emergency_notes) { %>
                            <div class="bg-amber-50/70 border border-amber-200/80 rounded-xl p-2.5 text-xs text-amber-950">
                              <span class="font-extrabold text-amber-900 flex items-center gap-1 mb-0.5">
                                <i class="ph ph-chat-text text-amber-600 text-xs"></i>
                                <span>Distress Message:</span>
                              </span>
                              <p class="font-medium italic text-slate-800">"<%= alert.message || alert.emergency_notes %>"</p>
                            </div>
                          <% } %>

                          <!-- Rescuer Mobile Tactical Action Buttons -->
                          <div class="pt-2 border-t border-slate-100 space-y-2">
                            <% 
                              const alertHandlerId = alert.handled_by ? Number(alert.handled_by) : null;
                              const isAssigned = alertHandlerId && alertHandlerId > 0;
                              const isMine = isAssigned && (alertHandlerId === currentUserId);
                              const isOther = isAssigned && !isMine && (currentUserRole !== 'admin');
                            %>
                            <% if (isOther) { %>
                              <div class="w-full min-h-[44px] py-2 px-3 rounded-xl bg-slate-100 text-slate-600 border border-slate-200 text-xs font-bold flex items-center justify-center gap-1.5 shadow-2xs">
                                <i class="ph ph-lock-key text-slate-400 text-base"></i>
                                <span>Assigned to <strong class="text-slate-800"><%= alert.handler_name || 'Another Rescuer' %></strong></span>
                              </div>
                            <% } else { %>
                            <!-- Row 1: Primary Lifecycle Progression (Touch Target >= 44px) -->
                            <div class="grid grid-cols-2 gap-2">
                              <% if (isPending) { %>
                                <button type="button" data-sos-id="<%= alert.id %>" data-next-status="ACKNOWLEDGED"
                                  onclick="handleSosLifecycleBtn(this)"
                                  class="min-h-[44px] py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-600 active:scale-95 text-white font-black text-xs sm:text-sm shadow-sm flex items-center justify-center gap-1.5 transition-all cursor-pointer">
                                  <i class="ph ph-check-circle text-base"></i>
                                  <span>Acknowledge</span>
                                </button>
                                <button type="button" data-sos-id="<%= alert.id %>" data-next-status="RESPONDING"
                                  onclick="handleSosLifecycleBtn(this)"
                                  class="min-h-[44px] py-2.5 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-black text-xs sm:text-sm shadow-sm flex items-center justify-center gap-1.5 transition-all cursor-pointer">
                                  <i class="ph ph-paper-plane-tilt text-base"></i>
                                  <span>Dispatch Unit</span>
                                </button>
                              <% } else if (isAck) { %>
                                <button type="button" data-sos-id="<%= alert.id %>" data-next-status="RESPONDING"
                                  onclick="handleSosLifecycleBtn(this)"
                                  class="col-span-2 min-h-[44px] py-2.5 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-black text-xs sm:text-sm shadow-sm flex items-center justify-center gap-1.5 transition-all cursor-pointer">
                                  <i class="ph ph-paper-plane-tilt text-base"></i>
                                  <span>Dispatch Rescuer Unit</span>
                                </button>
                              <% } else if (isResp) { %>
                                <button type="button" data-sos-id="<%= alert.id %>" data-next-status="RESCUED"
                                  onclick="handleSosLifecycleBtn(this)"
                                  class="col-span-2 min-h-[44px] py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xs sm:text-sm shadow-sm flex items-center justify-center gap-1.5 transition-all cursor-pointer">
                                  <i class="ph ph-shield-check text-base"></i>
                                  <span>Mark as Rescued</span>
                                </button>
                              <% } else if (isDone) { %>
                                <div class="col-span-2 min-h-[40px] py-2 px-3 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold flex items-center justify-center gap-1.5">
                                  <i class="ph ph-check-circle text-sm text-emerald-600"></i>
                                  <span>Resident Rescued & Secured</span>
                                </div>
                              <% } %>
                            </div>
                            <% } %>

                            <!-- Row 2: Tactical Navigation & Resolution -->
                            <div class="flex items-center gap-2">
                              <!-- Tactical Navigation on Internal Map -->
                              <a href="/staff/map?sos_id=<%= alert.id %>&lat=<%= alertLat %>&lng=<%= alertLng %>&navigate=1"
                                class="flex-1 min-h-[42px] py-2.5 px-3 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-black text-xs shadow-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer">
                                <i class="ph ph-navigation-arrow text-sm"></i>
                                <span>Show Route on Map</span>
                              </a>

                              <!-- Focus Location (Compact on Mobile) -->
                              <a href="/staff/map?sos_id=<%= alert.id %>&lat=<%= alertLat %>&lng=<%= alertLng %>"
                                class="min-h-[42px] px-3 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 font-bold text-xs flex items-center justify-center gap-1 transition-all cursor-pointer border border-slate-200/80 shrink-0"
                                title="Focus Map Pin">
                                <i class="ph ph-map-pin text-sm text-slate-600"></i>
                                <span class="hidden xs:inline">Focus</span>
                              </a>

                              <!-- Resolve Button (Compact on Mobile) -->
                              <% if (!isOther) { %>
                              <button type="button" data-sos-id="<%= alert.id %>" data-next-status="RESOLVED"
                                onclick="handleSosLifecycleBtn(this)"
                                class="min-h-[42px] px-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 active:scale-95 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-xs shrink-0"
                                title="Mark alert resolved">
                                <i class="ph ph-check-square text-sm"></i>
                                <span>Resolve</span>
                              </button>
                              <% } %>
                            </div>
                          </div>

                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <div
                      class="bg-white/5 rounded-2xl p-6 text-center border border-white/10 space-y-1.5 relative z-10">
                      <div
                        class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto text-xl shadow-inner">
                        <i class="ph ph-shield-check"></i>
                      </div>
                      <h3 class="font-bold text-white text-sm">No Active Distress Signals</h3>
                      <p class="text-xs text-slate-400">Emergency distress signals during forced evacuation will appear here.</p>
                    </div>
                  <% } %>
                </div>
              <% } %>

                  <!-- 2. MY ASSIGNED SITES (CLEAN RESPONSIVE LAYOUT FOR SINGLE & MULTI-FACILITY) -->
                  <% if (!isRescuer) { %>
                    <% const assignedSitesList=(typeof assignedCentersWithSituations !=='undefined' &&
                      assignedCentersWithSituations) ? assignedCentersWithSituations :
                      (locals.assignedCentersWithSituations || []); %>
                      <% if (assignedSitesList.length===1) { const site=assignedSitesList[0]; const
                        isActive=site.is_active || (site.id===(locals.activeCenterId ||
                        staffMember.assigned_center_id)); let pColor="bg-blue-600" ; if (site.occupancy_pct>= 90) pColor
                        = "bg-red-500";
                        else if (site.occupancy_pct >= 75) pColor = "bg-amber-500";
                        %>
                        <!-- SINGLE ASSIGNED FACILITY: FULL-WIDTH CLEAN CARD -->
                        <div class="space-y-2.5">
                          <div class="flex items-center justify-between px-1">
                            <div class="flex items-center gap-2">
                              <span
                                class="w-6 h-6 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-xs border border-blue-100/80 shrink-0 shadow-2xs">
                                <i class="ph ph-buildings"></i>
                              </span>
                              <h2 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-slate-600">
                                Assigned Facility</h2>
                            </div>
                            <span
                              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] sm:text-xs font-black uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200/80 shadow-2xs">
                              <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span> Active Desk
                            </span>
                          </div>

                          <!-- Full-Width Card matching modern government aesthetics -->
                          <div id="assignedSiteCard-<%= site.id %>" data-center-id="<%= site.id %>"
                            class="w-full bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-300 space-y-4 relative overflow-hidden group">
                            
                            <!-- Subtle top ambient accent line -->
                            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-600 via-indigo-500 to-emerald-500 opacity-90"></div>

                            <div class="flex items-start justify-between gap-3 pt-0.5">
                              <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                  <h3
                                    class="text-base sm:text-lg font-black text-slate-900 leading-snug tracking-tight truncate">
                                    <%= site.name %>
                                  </h3>
                                  <span class="w-2.5 h-2.5 rounded-full bg-blue-600 shrink-0 shadow-xs"
                                    title="Active Evacuation Desk"></span>
                                </div>
                                <p class="text-xs text-slate-500 font-semibold flex items-center gap-1.5 mt-0.5">
                                  <i class="ph ph-map-pin text-rose-500 shrink-0"></i>
                                  <span class="truncate">
                                    <%= site.address || site.zone %>
                                  </span>
                                </p>
                              </div>
                              <span id="assignedSiteStatusBadge-<%= site.id %>"
                                class="text-[10px] sm:text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full shrink-0 flex items-center gap-1.5 shadow-2xs transition-all duration-300 <%= site.is_full ? 'bg-rose-50 text-rose-700 border border-rose-200/80 ring-2 ring-rose-500/10' : 'bg-emerald-50 text-emerald-700 border border-emerald-200/80 ring-2 ring-emerald-500/10' %>">
                                <span id="assignedSiteStatusDot-<%= site.id %>"
                                  class="w-1.5 h-1.5 rounded-full <%= site.is_full ? 'bg-rose-600 animate-pulse' : 'bg-emerald-600 animate-pulse' %>"></span>
                                <span id="assignedSiteStatusText-<%= site.id %>"><%= site.status %></span>
                              </span>
                            </div>

                            <!-- Occupancy Bar -->
                            <div class="space-y-1.5">
                              <div class="flex items-center justify-between text-xs">
                                <span class="font-extrabold text-slate-600 flex items-center gap-1.5">
                                  <i class="ph ph-chart-bar text-slate-400"></i> Shelter Capacity & Occupancy
                                </span>
                                <span class="font-black text-slate-900 font-mono">
                                  <span id="assignedSiteOccupancy-<%= site.id %>"><%= site.occupancy %></span> / 
                                  <span id="assignedSiteCapacity-<%= site.id %>"><%= site.capacity %></span> 
                                  <span id="assignedSitePctBadge-<%= site.id %>" class="text-slate-400 font-semibold text-[11px]">(<span id="assignedSitePct-<%= site.id %>"><%= site.occupancy_pct %></span>%)</span>
                                </span>
                              </div>
                              <div
                                class="w-full bg-slate-100 rounded-full h-2.5 sm:h-3 overflow-hidden p-0.5 border border-slate-200/80 shadow-inner">
                                <% const occWidthStyle='style="width: ' + Number(site.occupancy_pct || 0) + '%;"' ; %>
                                  <div id="assignedSiteProgressBar-<%= site.id %>" class="<%= pColor %> h-full rounded-full transition-all duration-700 ease-out relative" <%-
                                    occWidthStyle %>>
                                    <div class="absolute inset-0 bg-white/20 w-full h-full"></div>
                                  </div>
                              </div>
                            </div>

                            <!-- Mini Stats Grid -->
                            <div class="grid grid-cols-3 gap-2 sm:gap-3 py-0.5 text-center">
                              <div
                                class="bg-gradient-to-b from-slate-50 to-slate-100/70 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 border border-slate-200/60 shadow-2xs hover:border-slate-300 transition-all">
                                <div id="assignedSiteAvailable-<%= site.id %>" class="text-base sm:text-xl font-black font-mono <%= site.available_slots === 0 ? 'text-rose-600' : 'text-emerald-600' %>">
                                  <%= site.available_slots %>
                                </div>
                                <div
                                  class="text-[9px] sm:text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mt-0.5">
                                  Available</div>
                              </div>
                              <div
                                class="bg-gradient-to-b from-slate-50 to-slate-100/70 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 border border-slate-200/60 shadow-2xs hover:border-slate-300 transition-all">
                                <div id="assignedSiteFamilies-<%= site.id %>" class="text-base sm:text-xl font-black font-mono text-amber-600">
                                  <%= site.families %>
                                </div>
                                <div
                                  class="text-[9px] sm:text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mt-0.5">
                                  Families</div>
                              </div>
                              <div
                                class="bg-gradient-to-b from-slate-50 to-slate-100/70 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 border border-slate-200/60 shadow-2xs hover:border-slate-300 transition-all">
                                <div id="assignedSiteStaff-<%= site.id %>" class="text-base sm:text-xl font-black font-mono text-blue-600">
                                  <%= site.assigned_staff_count %>
                                </div>
                                <div
                                  class="text-[9px] sm:text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mt-0.5">
                                  Staff On Duty</div>
                              </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="pt-2 sm:pt-3 border-t border-slate-100 flex items-center gap-2.5">
                              <a href="/staff/dashboard?center_id=<%= site.id %>"
                                class="flex-1 py-2.5 px-3 rounded-xl bg-blue-50/90 text-blue-700 hover:bg-blue-100 font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 border border-blue-200/80 transition-all active:scale-[0.98]">
                                <i class="ph ph-check-circle text-base text-blue-600"></i>
                                <span>Active Desk</span>
                              </a>
                              <a href="/staff/qr?center_id=<%= site.id %>"
                                class="py-2.5 px-5 sm:px-6 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 transition-all shadow-xs hover:shadow-sm active:scale-[0.98]"
                                title="Open Scanner for this site">
                                <i class="ph ph-qr-code text-base"></i>
                                <span>Scan QR</span>
                              </a>
                            </div>
                          </div>
                        </div>
                        <% } else if (assignedSitesList.length> 1) { %>
                          <!-- MULTIPLE SITES: SWIPEABLE CAROUSEL -->
                          <div class="space-y-2.5">
                            <div class="flex items-center justify-between px-1">
                              <div class="flex items-center gap-2">
                                <span
                                  class="w-6 h-6 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-xs border border-blue-100/80 shrink-0">
                                  <i class="ph ph-buildings"></i>
                                </span>
                                <h2 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-slate-600">My
                                  Assigned Sites</h2>
                                <span
                                  class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase bg-blue-50 text-blue-700 border border-blue-200/80">
                                  <span id="siteCarouselCurrentNum">1</span> / <%= assignedSitesList.length %>
                                </span>
                              </div>
                              <span
                                class="text-[11px] font-bold text-blue-700 bg-blue-50/90 px-3 py-1 rounded-full border border-blue-200/80 flex items-center gap-1.5 shadow-2xs">
                                <i class="ph ph-hand-swipe text-xs text-blue-600 animate-pulse"></i> Swipe to explore
                              </span>
                            </div>

                            <!-- Carousel Track: Clean margins, visible card peek with smooth swipe animation -->
                            <div id="siteCarouselTrack"
                              class="w-full flex gap-3 sm:gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 pt-1 no-scrollbar touch-pan-x select-none cursor-grab active:cursor-grabbing"
                              style="scrollbar-width: none; -ms-overflow-style: none;">
                              <% assignedSitesList.forEach((site, idx)=> {
                                const isActive = site.is_active || (Number(site.id) === Number(locals.activeCenterId ||
                                staffMember.assigned_center_id));
                                let pColor = "bg-blue-600";
                                if (site.occupancy_pct >= 90) pColor = "bg-red-500";
                                else if (site.occupancy_pct >= 75) pColor = "bg-amber-500";
                                %>
                                <div id="carouselSiteCard-<%= site.id %>" data-center-id="<%= site.id %>"
                                  class="carousel-card w-[88%] sm:w-[calc(50%-8px)] lg:w-[calc(33.333%-10px)] max-w-[420px] shrink-0 snap-center rounded-2xl sm:rounded-3xl p-5 flex flex-col justify-between relative overflow-hidden transition-all duration-300 <%= isActive ? 'bg-white border-2 border-blue-500 shadow-md shadow-blue-500/10 ring-2 ring-blue-500/20' : 'bg-white border border-slate-200/90 shadow-2xs hover:border-slate-300' %>"
                                  data-site-idx="<%= idx %>"
                                  style="transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease, box-shadow 0.3s ease;">
                                  <div class="space-y-3">
                                    <div class="flex items-start justify-between gap-2">
                                      <div class="min-w-0 flex-1">
                                        <div class="flex items-center gap-1.5">
                                          <h3
                                            class="text-sm sm:text-base font-black text-slate-900 leading-snug tracking-tight truncate">
                                            <%= site.name %>
                                          </h3>
                                          <% if (isActive) { %>
                                            <span class="w-2 h-2 rounded-full bg-blue-600 shrink-0 shadow-xs"
                                              title="Active Evacuation Desk"></span>
                                            <% } %>
                                        </div>
                                        <p class="text-xs text-slate-500 font-semibold flex items-center gap-1 mt-0.5">
                                          <i class="ph ph-map-pin text-rose-500 shrink-0"></i>
                                          <span class="truncate">
                                            <%= site.address || site.zone %>
                                          </span>
                                        </p>
                                      </div>
                                      <span id="carouselSiteStatusBadge-<%= site.id %>"
                                        class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full shrink-0 <%= site.is_full ? 'bg-red-50 text-red-700 border border-red-200/80' : 'bg-emerald-50 text-emerald-700 border border-emerald-200/80' %>">
                                        <%= site.status %>
                                      </span>
                                    </div>

                                    <!-- Occupancy Bar -->
                                    <div class="space-y-1">
                                      <div class="flex items-center justify-between text-xs">
                                        <span class="font-extrabold text-slate-600">Occupancy</span>
                                        <span class="font-black text-slate-900 font-mono">
                                          <span id="carouselSiteOccupancy-<%= site.id %>"><%= site.occupancy %></span> / 
                                          <span id="carouselSiteCapacity-<%= site.id %>"><%= site.capacity %></span> 
                                          <span class="text-slate-400 font-semibold">(<span id="carouselSitePct-<%= site.id %>"><%= site.occupancy_pct %></span>%)</span>
                                        </span>
                                      </div>
                                      <div
                                        class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden p-0.5 border border-slate-200/80 shadow-inner">
                                        <% const occWidthStyle='style="width: ' + Number(site.occupancy_pct || 0)
                                          + '%;"' ; %>
                                          <div id="carouselSiteProgressBar-<%= site.id %>" class="<%= pColor %> h-full rounded-full transition-all duration-700 ease-out" <%-
                                            occWidthStyle %>></div>
                                      </div>
                                    </div>

                                    <!-- Mini Stats Grid -->
                                    <div class="grid grid-cols-3 gap-1.5 py-0.5 text-center">
                                      <div class="bg-slate-50 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                        <div id="carouselSiteAvailable-<%= site.id %>" class="text-xs sm:text-sm font-black font-mono <%= site.available_slots === 0 ? 'text-rose-600' : 'text-emerald-600' %>">
                                          <%= site.available_slots %>
                                        </div>
                                        <div class="text-[9px] font-extrabold text-slate-400 uppercase">Available</div>
                                      </div>
                                      <div class="bg-slate-50 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                        <div id="carouselSiteFamilies-<%= site.id %>" class="text-xs sm:text-sm font-black font-mono text-amber-600">
                                          <%= site.families %>
                                        </div>
                                        <div class="text-[9px] font-extrabold text-slate-400 uppercase">Families</div>
                                      </div>
                                      <div class="bg-slate-50 rounded-xl p-2 border border-slate-100 shadow-2xs">
                                        <div id="carouselSiteStaff-<%= site.id %>" class="text-xs sm:text-sm font-black font-mono text-blue-600">
                                          <%= site.assigned_staff_count %>
                                        </div>
                                        <div class="text-[9px] font-extrabold text-slate-400 uppercase">Staff</div>
                                      </div>
                                    </div>
                                  </div>

                                  <!-- Action Buttons -->
                                  <div class="pt-3 mt-3 border-t border-slate-100 flex items-center gap-2">
                                    <% if (!isActive) { %>
                                      <a href="/staff/dashboard?center_id=<%= site.id %>"
