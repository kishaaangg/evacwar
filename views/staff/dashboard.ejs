                    <defs>
                      <radialGradient id="dashSunGrad" cx="35%" cy="30%" r="65%">
                        <stop offset="0%" stop-color="#FFF5A0" />
                        <stop offset="30%" stop-color="#FFC800" />
                        <stop offset="75%" stop-color="#FF8A00" />
                        <stop offset="100%" stop-color="#FF5D00" />
                      </radialGradient>
                      <filter id="dashSunRayGlow" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="2" result="blur" />
