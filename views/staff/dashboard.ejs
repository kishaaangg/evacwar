    const staffFirstName = staffMember.firstName || staffMember.first_name || fullName.split(' ')[0] || 'Staff';
    const staffOccupation = staffMember.occupation || (isRescuer ? 'Emergency Rescuer' : 'Emergency Staff');
    const staffContact = staffMember.contact_number || staffMember.contact || (locals.user &&
    locals.user.contact_number) || null;
    const staffInitial = staffFirstName.charAt(0).toUpperCase();

    const siteZone = (assignedCenter && assignedCenter.address) ? assignedCenter.address : (staffMember.zone ||
    (assignedCenter ? assignedCenter.name : 'Zone 2'));
    let siteLocation = siteZone;
    if (!siteLocation.toLowerCase().includes('san rafael')) {
    siteLocation = `${siteLocation}, Brgy. San Rafael`;
    }
    const staffRoleLabel = isRescuer ? 'Rescuer' : (isEvacuation ? 'Evacuation Staff' : 'Rescuer & Evac Staff');
    const hero3dImage = isRescuer ? '/images/rescuer.png' : '/images/staff.png';
    let timeGreeting = 'Good day';
    try {
    const currentHour = new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Manila" })).getHours();
    if (currentHour < 12) timeGreeting='Good morning' ; else if (currentHour < 18) timeGreeting='Good afternoon' ; else
      timeGreeting='Good evening' ; } catch (e) { const h=new Date().getHours(); timeGreeting=h < 12 ? 'Good morning' :
      (h < 18 ? 'Good afternoon' : 'Good evening' ); } const now=new Date(); const
      currentDayName=now.toLocaleDateString('en-US', { weekday: 'long' , timeZone: 'Asia/Manila' }); const
      currentTimeStr=now.toLocaleTimeString('en-US', { hour: 'numeric' , minute: '2-digit' , hour12: true,
      timeZone: 'Asia/Manila' }).toLowerCase(); const currentTemp=(locals.weather && locals.weather.temperature !=null)
      ? Math.round(locals.weather.temperature) : 27; const realFeelTemp=(locals.weather &&
      locals.weather.apparent_temperature !=null) ? Math.round(locals.weather.apparent_temperature) :
      Math.round(currentTemp - 2); const currentWind=(locals.weather && locals.weather.wind_speed !=null) ?
      Math.round(locals.weather.wind_speed) : 18; const currentRainfall=(locals.weather && locals.weather.rainfall
      !=null) ? locals.weather.rainfall : 0.2; const currentHumidity=(locals.weather && locals.weather.humidity !=null)
      ? locals.weather.humidity : 89; const weatherStatus=(locals.weather && locals.weather.weather_status) ?
      locals.weather.weather_status : 'Scattered Rain Showers' ; const
      isRainyWeather=weatherStatus.toLowerCase().includes('rain') || weatherStatus.toLowerCase().includes('drizzle') ||
      weatherStatus.toLowerCase().includes('thunder') || weatherStatus.toLowerCase().includes('storm') ||
      weatherStatus.toLowerCase().includes('shower'); %>

      <div class="app-main-layout">
