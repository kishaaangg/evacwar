                    </g>
                    <g filter="url(#dashCloudSoftShadow)">
                      <path d="M30 92 C18 92 8 82 8 70 C8 59 16 50 27 48 C30 34 43 24 57 24 C70 24 81 32 86 44 C90 42 95 41 100 41 C113 41 124 51 124 64 C124 77 114 88 101 92 Z" fill="url(#dashCloudGrad)" />
                      <path d="M30 92 C18 92 8 82 8 70 C8 59 16 50 27 48 C30 34 43 24 57 24 C70 24 81 32 86 44 C90 42 95 41 100 41 C113 41 124 51 124 64 C124 77 114 88 101 92 Z" fill="url(#dashCloudWarmth)" />
                      <ellipse cx="58" cy="36" rx="18" ry="10" fill="#FFFFFF" opacity="0.65" />
                      <ellipse cx="98" cy="52" rx="14" ry="8" fill="#FFFFFF" opacity="0.55" />
                    </g>
                  </svg>`;
              }
            }
          }

          window.useMyLocationDashboard = async function (btn) {
            const icon = document.getElementById('dashLocIcon') || (btn ? btn.querySelector('i') : null);
            if (icon) icon.classList.add('animate-spin');
            if (btn) btn.disabled = true;

            try {
              if (!window.EvakwarWeatherLocation) {
                throw new Error('Location manager is still loading. Please try again in a moment.');
              }
              const coords = await window.EvakwarWeatherLocation.getCurrentPosition();
              const weather = await window.EvakwarWeatherLocation.fetchWeather(coords);
              updateStaffWeatherUI(weather);
              window.EvakwarWeatherLocation.showToast('Updated weather for your device location!');
            } catch (err) {
              console.warn('GPS location error:', err.message);
              if (window.EvakwarWeatherLocation) {
                window.EvakwarWeatherLocation.showToast(err.message, true);
              } else {
                alert(err.message);
              }
            } finally {
              if (icon) icon.classList.remove('animate-spin');
              if (btn) btn.disabled = false;
            }
          };

          window.refreshWeatherData = async function (btn) {
            const icon = document.getElementById('weatherRefreshIcon') || (btn ? btn.querySelector('i') : null);
            if (icon) icon.classList.add('animate-spin');
            if (btn) btn.disabled = true;

            try {
              const saved = (window.EvakwarWeatherLocation) ? window.EvakwarWeatherLocation.getSavedLocation() : null;
              const res = await fetch('/api/weather/refresh', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(saved || {})
              });
              const data = await res.json();
              if (data && data.success && data.weather) {
                updateStaffWeatherUI(data.weather);
                if (window.EvakwarWeatherLocation) {
                  window.EvakwarWeatherLocation.showToast('Live weather telemetry updated!');
                }
              }
            } catch (err) {
              console.error('Failed to refresh weather telemetry:', err);
            } finally {
              if (icon) {
                setTimeout(() => icon.classList.remove('animate-spin'), 500);
              }
              if (btn) btn.disabled = false;
            }
          };

          // Quick Actions & Weather Horizontal Swipeable Carousel Logic
          (function () {
            const track = document.getElementById('quickActionsTrack');
            const dotsContainer = document.getElementById('quickActionsDots');
            if (!track) return;

            const slides = track.querySelectorAll('.qa-slide');
            if (!slides || slides.length === 0) return;

            let ticking = false;

            function updateQACarouselVisuals() {
              const trackRect = track.getBoundingClientRect();
              const trackCenter = trackRect.left + trackRect.width / 2;
              let activeIdx = 0;
              let minDistance = Infinity;

              slides.forEach((slide, idx) => {
                const slideRect = slide.getBoundingClientRect();
                const slideCenter = slideRect.left + slideRect.width / 2;
                const distance = Math.abs(trackCenter - slideCenter);
                if (distance < minDistance) {
                  minDistance = distance;
                  activeIdx = idx;
                }
              });

              if (dotsContainer) {
                const dots = dotsContainer.querySelectorAll('.qa-dot');
                dots.forEach((d, idx) => {
                  if (idx === activeIdx) {
                    d.className = 'qa-dot transition-all duration-300 rounded-full w-6 h-1.5 bg-blue-600 shadow-xs cursor-pointer';
                  } else {
                    d.className = 'qa-dot transition-all duration-300 rounded-full w-1.5 h-1.5 bg-slate-300 hover:bg-slate-400 cursor-pointer';
                  }
                });
              }
              ticking = false;
            }

            track.addEventListener('scroll', () => {
              if (!ticking) {
                window.requestAnimationFrame(updateQACarouselVisuals);
                ticking = true;
              }
            }, { passive: true });

            window.goToQACarouselSlide = function (idx) {
              if (!track || !slides[idx]) return;
              const slide = slides[idx];
              const scrollOffset = slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2;
              track.scrollTo({ left: Math.max(0, scrollOffset), behavior: 'smooth' });
            };

            if (dotsContainer) {
              dotsContainer.addEventListener('click', (e) => {
                const dot = e.target.closest('.qa-dot');
                if (dot && dot.dataset.qaSlide !== undefined) {
                  const idx = parseInt(dot.dataset.qaSlide, 10);
                  window.goToQACarouselSlide(idx);
                }
              });
            }

            slides.forEach((slide, idx) => {
              slide.addEventListener('click', (e) => {
                if (isDragging) return;
                if (!e.target.closest('a') && !e.target.closest('button') && !e.target.closest('select')) {
                  window.goToQACarouselSlide(idx);
                }
              });
            });

            // Mouse Drag-to-Swipe for Quick Actions on Desktop
            let isDown = false;
            let startX = 0;
            let scrollLeftPos = 0;
            let isDragging = false;
            let dragDistance = 0;

            track.addEventListener('mousedown', (e) => {
              if (e.target.closest('a') || e.target.closest('button') || e.target.closest('select')) return;
              isDown = true;
              isDragging = false;
              dragDistance = 0;
              startX = e.pageX - track.offsetLeft;
              scrollLeftPos = track.scrollLeft;
              track.style.scrollBehavior = 'auto';
              track.style.scrollSnapType = 'none';
            });

            window.addEventListener('mouseup', () => {
              if (!isDown) return;
              isDown = false;
              track.style.scrollBehavior = 'smooth';
              track.style.scrollSnapType = 'x mandatory';

              if (Math.abs(dragDistance) > 35) {
                const direction = dragDistance > 0 ? -1 : 1;
                const approxWidth = slides[0] ? slides[0].offsetWidth : 300;
                track.scrollBy({ left: direction * approxWidth * 0.85, behavior: 'smooth' });
              }

              setTimeout(() => { isDragging = false; }, 60);
            });

            track.addEventListener('mouseleave', () => {
              if (isDown) {
                isDown = false;
                track.style.scrollBehavior = 'smooth';
                track.style.scrollSnapType = 'x mandatory';
                setTimeout(() => { isDragging = false; }, 60);
              }
            });

            track.addEventListener('mousemove', (e) => {
              if (!isDown) return;
              e.preventDefault();
              const x = e.pageX - track.offsetLeft;
              dragDistance = x - startX;
              if (Math.abs(dragDistance) > 6) isDragging = true;
              track.scrollLeft = scrollLeftPos - dragDistance;
            });

            track.addEventListener('click', (e) => {
              if (isDragging) {
                e.preventDefault();
                e.stopPropagation();
              }
            }, true);

            updateQACarouselVisuals();
          })();

          // Assigned Sites Horizontal Swipeable Carousel Logic (Visible Swiping Animation, Depth Scaling & Drag)
          (function () {
            const track = document.getElementById('siteCarouselTrack');
            const dotsContainer = document.getElementById('siteCarouselDots');
            const counterNum = document.getElementById('siteCarouselCurrentNum');
            if (!track) return;

            const cards = track.querySelectorAll('.carousel-card');
            if (!cards || cards.length === 0) return;

            let ticking = false;

            function updateCarouselVisuals() {
              const trackRect = track.getBoundingClientRect();
              const trackCenter = trackRect.left + trackRect.width / 2;
              let activeIdx = 0;
              let minDistance = Infinity;

              cards.forEach((card, idx) => {
                const cardRect = card.getBoundingClientRect();
                const cardCenter = cardRect.left + cardRect.width / 2;
                const distance = Math.abs(trackCenter - cardCenter);

                if (distance < minDistance) {
                  minDistance = distance;
                  activeIdx = idx;
                }

                // Dynamic scale & opacity based on distance from center for prominent swiping visual
                const normalizedDist = Math.min(1, distance / (trackRect.width * 0.7));
                const scale = 1 - (normalizedDist * 0.05); // Scales between 1.0 and 0.95
                const opacity = 1 - (normalizedDist * 0.2); // Opacity between 1.0 and 0.8
                card.style.transform = `scale(${scale.toFixed(3)})`;
                card.style.opacity = opacity.toFixed(2);
              });

              // Update Counter Pill
              if (counterNum) {
                counterNum.textContent = activeIdx + 1;
              }

              // Update Pagination Dots
              if (dotsContainer) {
                const dots = dotsContainer.querySelectorAll('.carousel-dot');
                dots.forEach((d, i) => {
                  if (i === activeIdx) {
                    d.className = 'carousel-dot transition-all duration-300 rounded-full w-6 h-2 bg-blue-600 shadow-xs';
                  } else {
                    d.className = 'carousel-dot transition-all duration-300 rounded-full w-2 h-2 bg-slate-300 hover:bg-slate-400';
                  }
                });
              }

              ticking = false;
            }

            track.addEventListener('scroll', () => {
              if (!ticking) {
                window.requestAnimationFrame(updateCarouselVisuals);
                ticking = true;
              }
            }, { passive: true });

            // Dot click navigation
            if (dotsContainer) {
              dotsContainer.addEventListener('click', function (e) {
                const dot = e.target.closest('.carousel-dot');
                if (dot && dot.dataset.slideIndex !== undefined) {
                  window.goToSiteCarouselSlide(parseInt(dot.dataset.slideIndex, 10));
                }
              });
            }

            window.goToSiteCarouselSlide = function (idx) {
              if (!track || !cards[idx]) return;
              const card = cards[idx];
              const trackRect = track.getBoundingClientRect();
              const cardRect = card.getBoundingClientRect();
              const scrollOffset = card.offsetLeft - (track.clientWidth - card.clientWidth) / 2;
              track.scrollTo({ left: Math.max(0, scrollOffset), behavior: 'smooth' });
            };

            // Tap on peeking card to smoothly center it
            cards.forEach((card, idx) => {
              card.addEventListener('click', (e) => {
                if (isDragging) return;
                // If not clicking an interactive anchor/button, scroll card into view
                if (!e.target.closest('a') && !e.target.closest('button')) {
                  window.goToSiteCarouselSlide(idx);
                }
              });
            });

            // Mouse Drag-to-Swipe Physics for Desktop/Laptop
            let isDown = false;
            let startX = 0;
            let scrollLeftPos = 0;
            let isDragging = false;
            let dragDistance = 0;

            track.addEventListener('mousedown', (e) => {
              // Don't drag if clicked on button or link directly
              if (e.target.closest('a') || e.target.closest('button') || e.target.closest('select')) return;
              isDown = true;
              isDragging = false;
              dragDistance = 0;
              startX = e.pageX - track.offsetLeft;
              scrollLeftPos = track.scrollLeft;
              track.style.scrollBehavior = 'auto'; // Instant response while dragging
              track.style.scrollSnapType = 'none'; // Temporarily disable snap during drag for fluidity
            });

            window.addEventListener('mouseup', () => {
              if (!isDown) return;
              isDown = false;
              track.style.scrollBehavior = 'smooth';
              track.style.scrollSnapType = 'x mandatory';

              // Snap to next/prev card if dragged sufficiently
              if (Math.abs(dragDistance) > 40) {
                const cardWidth = cards[0] ? cards[0].offsetWidth + 14 : 320;
                const direction = dragDistance > 0 ? -1 : 1;
                const currentScroll = track.scrollLeft;
                const targetIdx = Math.max(0, Math.min(cards.length - 1, Math.round((currentScroll + direction * cardWidth * 0.4) / cardWidth)));
                window.goToSiteCarouselSlide(targetIdx);
              }

              setTimeout(() => { isDragging = false; }, 60);
            });

            track.addEventListener('mouseleave', () => {
              if (isDown) {
                isDown = false;
                track.style.scrollBehavior = 'smooth';
                track.style.scrollSnapType = 'x mandatory';
                setTimeout(() => { isDragging = false; }, 60);
              }
            });

            track.addEventListener('mousemove', (e) => {
              if (!isDown) return;
              e.preventDefault();
              const x = e.pageX - track.offsetLeft;
              dragDistance = x - startX;
              if (Math.abs(dragDistance) > 6) isDragging = true;
              track.scrollLeft = scrollLeftPos - dragDistance;
            });

            // Prevent clicking links inside cards if user was actively dragging
            track.addEventListener('click', (e) => {
              if (isDragging) {
                e.preventDefault();
                e.stopPropagation();
              }
            }, true);

            // Initial visual setup
            updateCarouselVisuals();

            // Smooth Auto-Teaser / Nudge Animation on initial load if more than 1 site
            if (cards.length > 1) {
              setTimeout(() => {
                if (track.scrollLeft < 10) {
                  track.scrollTo({ left: 60, behavior: 'smooth' });
                  setTimeout(() => {
                    track.scrollTo({ left: 0, behavior: 'smooth' });
                  }, 400);
                }
              }, 750);
            }
          })();
        </script>