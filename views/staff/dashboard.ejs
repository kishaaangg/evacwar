                                  <span class="flex items-center gap-1 font-bold text-rose-600">
                                    <i class="ph ph-map-pin text-sm"></i>
                                    <span class="truncate"><%= alert.barangay || 'San Rafael' %></span>
                                  </span>
                                  <span class="text-slate-300">•</span>
                                  <span class="text-slate-500 font-semibold flex items-center gap-1 font-mono text-[11px]">
                                    <i class="ph ph-clock text-xs text-slate-400"></i>
                                    <%= (locals.formatManilaTime ? locals.formatManilaTime(alert.created_at) : 'Just now') %>
                                  </span>
                                </div>
                              </div>
                            </div>

                            <!-- Right: Direct Phone Call & Status Badge -->
                            <div class="flex flex-col items-end gap-1.5 shrink-0">
                              <!-- Status Badge -->
                              <% if (isPending) { %>
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-black bg-red-100 text-red-700 border border-red-200 shadow-2xs">
                                  <span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-pulse"></span>
                                  <span>ACTIVE SOS</span>
                                </span>
                              <% } else if (isAck) { %>
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-black bg-amber-100 text-amber-800 border border-amber-200 shadow-2xs">
                                  <i class="ph ph-check-circle text-xs"></i>
                                  <span>ACKNOWLEDGED</span>
