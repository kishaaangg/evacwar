                      <filter id="dashCloudSoftShadow" x="-25%" y="-15%" width="150%" height="145%">
                        <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#5B7EAC" flood-opacity="0.22" />
                      </filter>
                    </defs>
                    <g transform="translate(88, 38)">
                      <g filter="url(#dashSunRayGlow)" opacity="0.95">
                        <path d="M0 -30 L3.5 -22 L11 -27 L9 -18 L18 -18 L13 -11 L21 -7 L14 -1 L21 6 L13 9 L18 17 L9 16 L11 25 L3.5 21 L0 28 L-3.5 21 L-11 25 L-9 16 L-18 17 L-13 9 L-21 6 L-14 -1 L-21 -7 L-13 -11 L-18 -18 L-9 -18 L-11 -27 L-3.5 -22 Z" fill="#FFA500" />
