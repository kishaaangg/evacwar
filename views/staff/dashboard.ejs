                      </filter>
                      <linearGradient id="dashCloudGrad" x1="20%" y1="10%" x2="70%" y2="100%">
                        <stop offset="0%" stop-color="#FFFFFF" />
                        <stop offset="45%" stop-color="#F2F8FD" />
                        <stop offset="85%" stop-color="#C5DDFB" />
                        <stop offset="100%" stop-color="#A5C9F7" />
                      </linearGradient>
                      <linearGradient id="dashDropGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#73D0FF" />
                        <stop offset="100%" stop-color="#2196F3" />
                      </linearGradient>
                      <filter id="dashCloudSoftShadow" x="-25%" y="-15%" width="150%" height="145%">
                        <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#5B7EAC" flood-opacity="0.22" />
                      </filter>
                    </defs>
                    <g transform="translate(88, 38)">
                      <g filter="url(#dashSunRayGlow)" opacity="0.95">
                        <path d="M0 -30 L3.5 -22 L11 -27 L9 -18 L18 -18 L13 -11 L21 -7 L14 -1 L21 6 L13 9 L18 17 L9 16 L11 25 L3.5 21 L0 28 L-3.5 21 L-11 25 L-9 16 L-18 17 L-13 9 L-21 6 L-14 -1 L-21 -7 L-13 -11 L-18 -18 L-9 -18 L-11 -27 L-3.5 -22 Z" fill="#FFA500" />
                      </g>
                      <circle cx="0" cy="0" r="20" fill="url(#dashSunGrad)" />
                      <circle cx="-5" cy="-6" r="6" fill="#FFFFFF" opacity="0.5" />
                    </g>
                    <g filter="url(#dashCloudSoftShadow)">
                      <path d="M30 84 C18 84 8 74 8 62 C8 51 16 42 27 40 C30 26 43 16 57 16 C70 16 81 24 86 36 C90 34 95 33 100 33 C113 33 124 43 124 56 C124 69 114 80 101 84 Z" fill="url(#dashCloudGrad)" />
                      <ellipse cx="58" cy="28" rx="18" ry="10" fill="#FFFFFF" opacity="0.65" />
                      <ellipse cx="98" cy="44" rx="14" ry="8" fill="#FFFFFF" opacity="0.55" />
                    </g>
                    <path d="M38 90 C36 93 35 98 37 101 C38 103 41 103 42 101 C44 98 42 93 40 90 Z" fill="url(#dashDropGrad)" />
                    <path d="M54 95 C52 98 51 103 53 106 C54 108 57 108 58 106 C60 103 58 98 56 95 Z" fill="url(#dashDropGrad)" />
                    <path d="M72 90 C70 93 69 98 71 101 C72 103 75 103 76 101 C78 98 76 93 74 90 Z" fill="url(#dashDropGrad)" />
                    <path d="M88 95 C86 98 85 103 87 106 C88 108 91 108 92 106 C94 103 92 98 90 95 Z" fill="url(#dashDropGrad)" />
                  </svg>`;
              } else {
                visualContainer.innerHTML = `
                  <svg viewBox="0 0 140 120" class="w-24 h-20 sm:w-28 sm:h-24 drop-shadow-md select-none pointer-events-none" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <radialGradient id="dashSunGrad" cx="35%" cy="30%" r="65%">
                        <stop offset="0%" stop-color="#FFF5A0" />
                        <stop offset="30%" stop-color="#FFC800" />
                        <stop offset="75%" stop-color="#FF8A00" />
                        <stop offset="100%" stop-color="#FF5D00" />
                      </radialGradient>
                      <filter id="dashSunRayGlow" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="2" result="blur" />
                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                      </filter>
                      <linearGradient id="dashCloudGrad" x1="20%" y1="10%" x2="70%" y2="100%">
                        <stop offset="0%" stop-color="#FFFFFF" />
                        <stop offset="45%" stop-color="#F2F8FD" />
                        <stop offset="85%" stop-color="#C5DDFB" />
                        <stop offset="100%" stop-color="#A5C9F7" />
                      </linearGradient>
                      <linearGradient id="dashCloudWarmth" x1="80%" y1="10%" x2="20%" y2="90%">
                        <stop offset="0%" stop-color="#FFE8A3" stop-opacity="0.6" />
