    const specialCats = (ecStats && ecStats.special_categories) || {};
    const seniorCount = (ecBreakdown['60+y'] && ecBreakdown['60+y'].total) || (ecBreakdown['60plus'] &&
    ecBreakdown['60plus'].total) || 0;
    const infantCount = ((ecBreakdown['0-11m'] && ecBreakdown['0-11m'].total) || (ecBreakdown['0_11m'] &&
    ecBreakdown['0_11m'].total) || 0) +
    ((ecBreakdown['1-3y'] && ecBreakdown['1-3y'].total) || (ecBreakdown['1_3y'] && ecBreakdown['1_3y'].total) || 0) +
    ((ecBreakdown['4-5y'] && ecBreakdown['4-5y'].total) || (ecBreakdown['4_5y'] && ecBreakdown['4_5y'].total) || 0);

    let rawPhoto = staffMember.profile_photo || (locals.user && locals.user.profile_photo) || null;
    let userPhoto = null;
