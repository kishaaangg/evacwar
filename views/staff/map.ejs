      window.resolveSosAlert = async function (sosId) {
        if (!sosId) return;
        if (!confirm('Mark this emergency SOS request as RESOLVED?')) return;
        try {
          const res = await fetch('/api/sos/resolve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: sosId })
          });
          const data = await res.json();
          if (data.success) {
            removeSosMarker(sosId);
            if (window.EvakWarRescuerTracker) window.EvakWarRescuerTracker.stopTracking();
            showSosToast('SOS alert marked as resolved.', 'success');
          } else {
            showSosToast(data.message || 'Error resolving SOS alert', 'error');
            if (data.alert) {
              addOrUpdateSosMarker(data.alert, false);
              if (typeof updateSosFeedCard === 'function') updateSosFeedCard(data.alert);
            }
          }
        } catch (err) {
          console.error("Error resolving SOS alert:", err);
          showSosToast('Network error resolving SOS alert', 'error');
        }
      };

      function flyToSosAndFocus(btnEl) {
        const lng = parseFloat(btnEl.getAttribute('data-lng'));
        const lat = parseFloat(btnEl.getAttribute('data-lat'));
        const sosId = btnEl.getAttribute('data-sos-id');
        if (!isNaN(lng) && !isNaN(lat)) {
          flyToSosLocation(lng, lat);
          let markerObj = sosMarkersMap[`sos_${sosId}`] || sosMarkersMap[`res_${sosId}`];
          if (!markerObj && sosId) {
            for (const k in sosMarkersMap) {
              const m = sosMarkersMap[k];
              if (m && (m.id == sosId || m.resident_id == sosId)) {
                markerObj = m;
                break;
              }
            }
          }
          if (markerObj && mapInstance) {
            if (markerObj.marker && typeof markerObj.marker.togglePopup === 'function') {
              const p = markerObj.marker.getPopup();
              if (p && !p.isOpen()) markerObj.marker.togglePopup();
              if (p && typeof window.bringMaplibrePopupToFront === 'function') {
                window.bringMaplibrePopupToFront(p);
              }
            } else if (markerObj.pos) {
              const infowindow = getStaffInfoWindow();
              if (infowindow) {
                infowindow.setContent(markerObj.popupHtml);
                infowindow.setPosition(markerObj.pos);
                infowindow.open(mapInstance, markerObj.marker);
              }
            }
          }
          if (staffSheet && staffSheet.isExpanded) staffSheet.setCollapsed();
        }
      }
      window.flyToSosAndFocus = flyToSosAndFocus;

      // Duplicate SOS Signal Debounce & Unified Real-Time Socket Sync
      const recentSosAlertAnnouncements = new Map();

      function handleIncomingSosAlert(data, isNew = true) {
        if (!data) return;
        const sosId = data.id || data.sos_id;
        const resId = data.resident_id || data.residentId;
        const dedupeKey = sosId ? `id_${sosId}` : (resId ? `res_${resId}` : null);
        const now = Date.now();

        // Check if this SOS record was already processed/announced recently (< 5000ms)
        const isRecentDuplicate = dedupeKey && recentSosAlertAnnouncements.has(dedupeKey) && (now - recentSosAlertAnnouncements.get(dedupeKey) < 5000);

        if (dedupeKey) {
          recentSosAlertAnnouncements.set(dedupeKey, now);
          if (recentSosAlertAnnouncements.size > 50) {
            for (const [k, timestamp] of recentSosAlertAnnouncements.entries()) {
              if (now - timestamp > 30000) recentSosAlertAnnouncements.delete(k);
            }
          }
        }

        if (isNew && !isRecentDuplicate) {
          playEmergencyChime();
          showSosToast('🚨 EMERGENCY SOS DISTRESS SIGNAL: ' + (data.name || data.residentName || 'Resident'), 'error');
        }

        // Always update the marker uniquely by ID:
        addOrUpdateSosMarker(data, isNew && !isRecentDuplicate, isNew && !isRecentDuplicate);
      }

      function initStaffSocketSync() {
        if (window.__staffSocketInitialized || typeof io === 'undefined') return;
        window.__staffSocketInitialized = true;
        const socket = window.__staffSocket || (window.__staffSocket = io());

        async function fetchAndRefreshCenters() {
          try {
            const res = await fetch('/api/centers/active');
            const data = await res.json();
            if (data.success && Array.isArray(data.centers) && mapInstance) {
              renderStaffCenters(data.centers, mapInstance);
            }
          } catch (e) {
            console.warn('[StaffMap] Failed to refresh centers live:', e);
          }
        }

        async function fetchAndRefreshSosAlerts() {
          try {
            const res = await fetch('/api/sos/active');
            const data = await res.json();
            if (data.success && Array.isArray(data.alerts)) {
              const activeIds = new Set();
              data.alerts.forEach(alert => {
                const sId = alert.id || alert.sos_id;
                if (sId) activeIds.add(String(sId));
                addOrUpdateSosMarker(alert, false, false);
              });
              Object.keys(sosMarkersMap).forEach(key => {
                const item = sosMarkersMap[key];
                if (item && item.id && !activeIds.has(String(item.id))) {
                  removeSosMarker(item.id, item.resident_id);
                }
              });
            }
          } catch (e) {
            console.warn('[StaffMap] Failed to refresh active SOS live:', e);
          }
        }

        // Live Evacuation Centers & Resident Listed Updates
        socket.on('center_updated', (data) => {
          if (data && Array.isArray(data.centers) && mapInstance) {
            renderStaffCenters(data.centers, mapInstance);
          } else {
            fetchAndRefreshCenters();
          }
        });

        socket.on('checkin:new', () => {
          fetchAndRefreshCenters();
        });

        socket.on('ec_board_updated', (data) => {
          if (data && Array.isArray(data.centers) && mapInstance) {
            renderStaffCenters(data.centers, mapInstance);
          } else {
            fetchAndRefreshCenters();
          }
        });

        socket.on('map_centers_updated', (data) => {
          if (data && Array.isArray(data.centers) && mapInstance) {
            renderStaffCenters(data.centers, mapInstance);
          } else {
            fetchAndRefreshCenters();
          }
        });

        // Live SOS Emergency Signals (Unconditionally active for all tactical map views)
        socket.on('sos:new', function (data) {
          handleIncomingSosAlert(data, true);
        });

        socket.on('sos_alert', function (data) {
          handleIncomingSosAlert(data, true);
        });

        socket.on('sos:update', function (data) {
          if (data) handleIncomingSosAlert(data, false);
        });

        socket.on('sos:cancel', function (data) {
          showSosToast('SOS Alert Cancelled by Resident', 'info');
          removeSosMarker(data ? (data.id || data.sos_id) : null, data ? (data.resident_id || data.residentId) : null);
        });

        socket.on('sos:resolve', function (data) {
          removeSosMarker(data ? (data.id || data.sos_id) : null, data ? (data.resident_id || data.residentId) : null);
        });

        socket.on('sos:update_status', function (data) {
          if (data) {
            const status = (data.status || '').toUpperCase();
            if (status === 'RESOLVED' || status === 'CANCELLED') {
              removeSosMarker(data.id || data.sos_id, data.resident_id || data.residentId);
            } else {
              handleIncomingSosAlert(data, false);
            }
          }
        });

        socket.on('map_features_updated', (data) => {
          if (mapInstance) {
            if (typeof mapInstance.getLayer === 'function') {
              renderStaffDrawnFeatures(data, mapInstance);
            } else if (staffDrawnShapes) {
              staffDrawnShapes.forEach(s => s.setMap(null));
              staffDrawnShapes = [];
              renderStaffDrawnFeatures(data, mapInstance);
            }
          }
        });

        // 433.875 MHz LoRa Mesh SOS Inbound Receiver (100% Offline / Off-Grid)
        window.addEventListener('evakwar:lora-sos', function (ev) {
          const pkt = ev && ev.detail;
          if (!pkt) return;
          console.log('[Staff Map] 🚨 Processing LoRa Mesh SOS packet:', pkt);
          const sosAlertObj = {
            id: pkt.sosId || ('lora_' + (pkt.residentId || Date.now())),
            sos_id: pkt.sosId || ('lora_' + (pkt.residentId || Date.now())),
            resident_id: pkt.residentId || 0,
            residentId: pkt.residentId || 0,
            name: pkt.residentName || pkt.sender || 'Resident in Distress',
            residentName: pkt.residentName || pkt.sender || 'Resident in Distress',
            contact_number: pkt.contact || '',
            emergency_type: pkt.emergencyType || 'EMERGENCY',
            barangay: pkt.zone || pkt.barangay || 'San Rafael',
            latitude: pkt.latitude || 13.456,
            longitude: pkt.longitude || 123.361,
            status: 'PENDING',
            transport: 'LORA_MESH_433MHZ',
            is_lora: true,
            created_at: new Date().toISOString()
          };
          if (typeof handleIncomingSosAlert === 'function') {
            handleIncomingSosAlert(sosAlertObj, true);
          }
        });

        // Resilience Heartbeat: catch up live data if tab was sleeping or network dropped
        setInterval(() => {
          fetchAndRefreshCenters();
          fetchAndRefreshSosAlerts();
        }, 12000);

        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) {
            fetchAndRefreshCenters();
            fetchAndRefreshSosAlerts();
          }
        });
      }

      class MobileBottomSheet {
        constructor(sheetId, handleId, scrollAreaId, peekHeight = 48) {
          this.sheet = document.getElementById(sheetId);
          this.handle = document.getElementById(handleId);
          this.scrollArea = document.getElementById(scrollAreaId);
          this.peekHeight = peekHeight;
          this.isExpanded = false;
          this.startY = 0;
          this.isDragging = false;
          if (!this.sheet || !this.handle) return;
          this.init();
        }

        init() {
          this.setCollapsed();
          this.handle.addEventListener('click', (e) => {
            e.stopPropagation();
            this.toggle();
          });
          this.handle.addEventListener('touchstart', (e) => {
            this.startY = e.touches[0].clientY;
            this.isDragging = true;
            this.sheet.style.transition = 'none';
          }, { passive: true });
          window.addEventListener('touchmove', (e) => {
            if (!this.isDragging) return;
            const clientY = e.touches[0].clientY;
            const deltaY = clientY - this.startY;
            if (!this.isExpanded) {
              if (deltaY < 0) {
                const sheetHeight = this.sheet.offsetHeight;
                const targetTranslate = Math.max(0, (sheetHeight - this.peekHeight) + deltaY);
                this.sheet.style.transform = `translateY(${targetTranslate}px)`;
                if (e.cancelable) e.preventDefault();
              }
            } else {
              if (deltaY > 0 && (!this.scrollArea || this.scrollArea.scrollTop <= 0)) {
                this.sheet.style.transform = `translateY(${deltaY}px)`;
                if (e.cancelable) e.preventDefault();
              }
            }
          }, { passive: false });
          window.addEventListener('touchend', (e) => {
            if (!this.isDragging) return;
            this.isDragging = false;
            const deltaY = (e.changedTouches[0].clientY) - this.startY;
            if (!this.isExpanded) {
              if (deltaY < -30) this.setExpanded(); else this.setCollapsed();
            } else {
              if (deltaY > 30) this.setCollapsed(); else this.setExpanded();
            }
          }, { passive: true });
        }

        setCollapsed() {
          this.isExpanded = false;
          this.sheet.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
          this.sheet.style.transform = `translateY(calc(100% - ${this.peekHeight}px))`;
          if (this.scrollArea) { this.scrollArea.scrollTop = 0; this.scrollArea.style.overflowY = 'hidden'; }
        }

        setExpanded() {
          this.isExpanded = true;
          this.sheet.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
          this.sheet.style.transform = 'translateY(0)';
          if (this.scrollArea) this.scrollArea.style.overflowY = 'auto';
        }

        toggle() { if (this.isExpanded) this.setCollapsed(); else this.setExpanded(); }
      }

      async function initStaffMaplibreMap() {
