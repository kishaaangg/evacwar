            type: 'line',
            source: 'staff-features',
            filter: ['==', '$type', 'LineString'],
            paint: { 'line-color': '#f97316', 'line-width': 4.5, 'line-opacity': 0.95 }
          }
        ];

        const map = window.createEvakWarMaplibreMap(container, {
          center: [123.3485, 13.5135],
          zoom: 15.5,
          initialSources: initialSources,
          initialLayers: initialLayers,
          initialBasemap: 'hybrid'
        });

        mapInstance = map;
        window.mapInstance = map;



        // Render Evacuation Centers immediately on creation
        if (Array.isArray(centersData) && centersData.length > 0) {
          renderStaffCenters(centersData, map);
        }

        // Render Active SOS Distress Markers immediately from embedded data
        let activeSos = [];
        try { activeSos = JSON.parse(document.getElementById('active-sos-data').textContent || '[]'); } catch (e) { }
        if (Array.isArray(activeSos)) {
          activeSos.forEach(alert => addOrUpdateSosMarker(alert, false));
        }

        // Parallel non-blocking fresh SOS fetch
        fetch('/api/sos/active')
          .then(res => res.json())
          .then(data => {
            if (data.success && Array.isArray(data.alerts)) {
              data.alerts.forEach(alert => addOrUpdateSosMarker(alert, false));
              checkUrlForSosFocus();
            }
          })
          .catch(err => {
            console.warn('[Evacwar MapLibre] Offline mode SOS fetch notice:', err.message);
            checkUrlForSosFocus();
          });

        map.on('load', () => {
          renderStaffDrawnFeatures(initialFeatures, map);
          renderStaffCenters(centersData, map);
          checkUrlForSosFocus();

          if (!navigator.onLine) {
            let badge = document.getElementById('mapOfflineBadge');
            if (!badge) {
              badge = document.createElement('div');
              badge.id = 'mapOfflineBadge';
              badge.className = 'absolute top-3 left-3 z-30 bg-slate-900/90 backdrop-blur-md border border-slate-700 text-white px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-lg';
              badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span><span>Offline</span>';
              container.parentElement.appendChild(badge);
            }
          }
        });

        // Unified Real-time Socket.io Sync
        initStaffSocketSync();
      }

      let staffSheet = null;
      if (document.getElementById('evacuationMap') && window.MAP_CONFIG && window.MAP_CONFIG.provider === 'maplibre') {
        window._staffMapReady = true;
        initStaffMaplibreMap();
      }
      document.addEventListener('DOMContentLoaded', () => {
        initStaffSocketSync();
        staffSheet = new MobileBottomSheet('staffBottomSheet', 'staffSheetHandle', 'staffSheetScrollArea', 48);

        if (window.MAP_CONFIG && window.MAP_CONFIG.provider === 'maplibre' && !mapInstance) {
          window._staffMapReady = true;
          initStaffMaplibreMap();
        }
      });

      whenGoogleMapsReady(() => {
        window._staffMapReady = true;
        initStaffCommandMap();
      });

      // Dual-mode offline fallback if Google Maps fails or offline
      async function initOfflineStaffMap() {
        if (window._staffMapReady) return;
        const container = document.getElementById('evacuationMap');
        if (!container || typeof L === 'undefined') return;

        let centersData = [];
        try { centersData = JSON.parse(document.getElementById('centers-data').textContent || '[]'); } catch (e) { }

        let initialFeatures = { type: 'FeatureCollection', features: [] };
        try {
          const raw = document.getElementById('map-features-data').textContent;
          initialFeatures = typeof raw === 'string' ? JSON.parse(raw) : raw;
        } catch (e) { }

        // If embedded data is empty, query local Dexie DB
        if ((!centersData || centersData.length === 0) && window.EvakWarDB && typeof window.EvakWarDB.getMapData === 'function') {
          const cached = await window.EvakWarDB.getMapData();
          if (cached) {
            if (cached.centers && cached.centers.length > 0) centersData = cached.centers;
            if (cached.mapFeatures && cached.mapFeatures.features) initialFeatures = cached.mapFeatures;
          }
        }

        try {
          container.innerHTML = '';
          const lMap = L.map(container, { zoomControl: true }).setView([13.5135, 123.3485], 16);
          const osmTileUrl = (window.MAP_CONFIG && window.MAP_CONFIG.osmUrl) || 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
          L.tileLayer(osmTileUrl, { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(lMap);

          // GeoJSON Features (hazards and routes)
          if (initialFeatures && initialFeatures.features) {
            L.geoJSON(initialFeatures, {
              style: function (feature) {
                const isBoundary = feature.properties && feature.properties.type === 'boundary';
                if (feature.geometry.type === 'Polygon') {
                  if (isBoundary) {
                    return { color: '#f87171', weight: 1.5, dashArray: '3, 2', fillColor: 'transparent', fillOpacity: 0 };
                  }
                  return { color: '#ef4444', weight: 2.5, dashArray: '6, 3', fillColor: '#ef4444', fillOpacity: 0.25 };
                } else if (feature.geometry.type === 'LineString') {
                  return { color: '#f97316', weight: 4.5, dashArray: '8, 4', opacity: 0.85 };
                }
              }
            }).addTo(lMap);
          }

          // Evacuation Centers
          centersData.forEach(center => {
            const lat = parseFloat(center.latitude) || 13.5102;
            const lng = parseFloat(center.longitude) || 123.3470;
            const occ = parseInt(center.current_occupancy, 10) || 0;
            const cap = parseInt(center.max_capacity, 10) || 25;
            const pct = Math.round((occ / cap) * 100);
            let col = '#10b981';
            if (pct >= 100) col = '#ef4444';
            else if (pct >= 80) col = '#f97316';

            const m = L.circleMarker([lat, lng], {
              radius: 10,
              color: '#ffffff',
              weight: 2,
              fillColor: col,
              fillOpacity: 1
            }).addTo(lMap);

            m.bindPopup(`
              <div style="font-family: system-ui; min-width: 220px;">
                <div style="font-weight: 800; font-size: 13px; color: #0f172a;">${center.name}</div>
                <div style="font-size: 11px; color: #64748b; margin-bottom: 4px;">${center.address || 'San Rafael'}</div>
                <div style="font-size: 11px; font-weight: 700; color: ${col};">Occupancy: ${occ} / ${cap} (${pct}%)</div>
                <div style="font-size: 11px; color: #475569; margin-top: 4px;">Contact: ${center.contact_number || 'N/A'}</div>
              </div>
            `);
          });

          // Active SOS Alerts
          let activeSos = [];
          try { activeSos = JSON.parse(document.getElementById('active-sos-data').textContent || '[]'); } catch (e) { }
          if (Array.isArray(activeSos)) {
            activeSos.forEach(alert => {
              const lat = parseFloat(alert.latitude || alert.lat);
              const lng = parseFloat(alert.longitude || alert.lng);
              if (!isNaN(lat) && !isNaN(lng)) {
                const sosMarker = L.circleMarker([lat, lng], {
                  radius: 11,
                  color: '#ffffff',
                  weight: 2,
                  fillColor: '#ef4444',
                  fillOpacity: 0.95
                }).addTo(lMap);
                sosMarker.bindPopup(`
                  <div style="font-family: system-ui; min-width: 200px;">
                    <div style="font-weight: 800; font-size: 12px; color: #ef4444;">🚨 SOS DISTRESS: ${alert.name || alert.first_name || 'Resident'}</div>
                    <div style="font-size: 11px; color: #475569; margin: 4px 0;">Status: <b>${alert.status || 'ACTIVE'}</b></div>
                    <div style="font-size: 11px; color: #64748b;">Phone: ${alert.contact_number || 'N/A'}</div>
                  </div>
                `);
              }
            });
          }

          // Show non-blocking offline badge
          let badge = document.getElementById('mapOfflineBadge');
          if (!badge) {
            badge = document.createElement('div');
            badge.id = 'mapOfflineBadge';
            badge.className = 'absolute top-3 left-3 z-30 bg-slate-900/90 backdrop-blur-md border border-slate-700 text-white px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5 shadow-lg';
            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span><span>Offline</span>';
            container.parentElement.appendChild(badge);
          } else {
            badge.classList.remove('hidden');
          }

          window._staffMapReady = true;
          console.log('[Evacwar Map] Dual-mode Leaflet offline map successfully activated.');
        } catch (err) {
          console.warn('[Evacwar Map] Leaflet offline error:', err);
        }
      }

      window.__triggerOfflineMapFallback = initOfflineStaffMap;

      setTimeout(() => {
        if (!window._staffMapReady && (!navigator.onLine || typeof google === 'undefined' || !google.maps)) {
          initOfflineStaffMap();
        }
      }, 1800);

      async function handleSosLifecycleBtn(btnEl) {
        const sosId = btnEl.getAttribute('data-sos-id');
        const nextStatus = btnEl.getAttribute('data-next-status');
        if (!sosId || !nextStatus) return;

        if (nextStatus === 'RESOLVED' && !confirm('Mark this emergency SOS request as RESOLVED?')) {
          return;
        }

        const rCoords = (window._lastKnownUserGps && typeof window._lastKnownUserGps.lat === 'number')
          ? { lat: window._lastKnownUserGps.lat, lng: window._lastKnownUserGps.lng }
          : { lat: 13.51037, lng: 123.34810 };

        btnEl.disabled = true; btnEl.classList.add('opacity-50');
        try {
          if (window.evakwarLoraClient && window.evakwarLoraClient.isConnected && typeof window.evakwarLoraClient.sendText === 'function') {
            const rName = (localStorage.getItem('evw_user_full_name') || 'Rescue Team').replace(/\|/g, '/').slice(0, 22);
            const pkt = `EVW|ACK|${sosId}|0|${nextStatus}|${rName}|${Number(rCoords.lat).toFixed(5)},${Number(rCoords.lng).toFixed(5)}`;
            window.evakwarLoraClient.sendText(pkt).catch(() => {});
          }
          const res = await fetch('/staff/sos/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: sosId, status: nextStatus, rescuer_lat: rCoords.lat, rescuer_lng: rCoords.lng })
          });
          const data = await res.json();
          if (data.success) {
            showSosToast(data.message || 'Status updated!', 'success');
            if (nextStatus === 'ACKNOWLEDGED' || nextStatus === 'RESPONDING' || nextStatus === 'RESCUED') {
              if (window.EvakWarRescuerTracker) window.EvakWarRescuerTracker.startTracking(Number(sosId));
            } else if (nextStatus === 'RESOLVED') {
              if (window.EvakWarRescuerTracker) window.EvakWarRescuerTracker.stopTracking(Number(sosId));
            }
            if (data.alert) addOrUpdateSosMarker(data.alert, false); else setTimeout(() => window.location.reload(), 600);
          } else {
            showSosToast(data.message || 'Unable to update SOS status.', 'error');
            if (data.alert) {
              addOrUpdateSosMarker(data.alert, false);
              if (typeof updateSosFeedCard === 'function') updateSosFeedCard(data.alert);
            }
            btnEl.disabled = false; btnEl.classList.remove('opacity-50');
          }
        } catch (err) {
          showSosToast('Offline / LoRa ACK transmitted', 'info');
          btnEl.disabled = false; btnEl.classList.remove('opacity-50');
        }
      }
      window.handleSosLifecycleBtn = handleSosLifecycleBtn;
    </script>

