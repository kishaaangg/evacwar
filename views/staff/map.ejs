            filter: ['all', ['==', '$type', 'Polygon'], ['==', 'type', 'zone']],
            paint: {
              'line-color': ['coalesce', ['get', 'strokeColor'], '#ffffff'],
              'line-width': 1.5,
              'line-dasharray': [3, 2],
              'line-opacity': 0.9
            }
          },
          {
